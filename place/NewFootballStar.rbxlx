      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">PassConfig</string>
          <string name="Source"><![CDATA[-- Tuning for the Stage 2 pass, shared by the server (outcome) and the client (visuals).
--
-- The pass is played on the same pitch as the shot, further from the goal: the passer stands at
-- Origin and passes along the ground (Y is ignored) towards teammates nearer the goal (-Z).

local PassConfig = {}

PassConfig.Origin = Vector3.new(0, 0, 66) -- ball at the passer's feet

-- Higher, steeper camera than the shot so the whole move fits on screen.
PassConfig.Camera = {
	Position = Vector3.new(0, 48, 110),
	LookAt = Vector3.new(0, 0, 58), -- ball at ~60% of the screen height, clear of the bottom panel on phones
	FieldOfView = 42,
}

PassConfig.Ball = {
	Friction = 20, -- stud/s^2, rolling deceleration
	-- The ball is played to stop this far past the release point, so it arrives with some pace.
	Overrun = 6,
	MinRange = 8, -- shorter drags don't pass (accidental taps)
	MaxRange = 50, -- drag length for 100% power
}

PassConfig.Teammate = {
	Reach = 2.2, -- studs from the body that the foot covers
	Speed = 12, -- stud/s when stepping to the ball
	Reaction = 0.12,
	MaxMove = 4, -- how far a teammate comes off his spot for a pass
	ControlMaxSpeed = 25, -- faster balls bounce off ("too hard")
}

PassConfig.Defender = {
	Reach = 2.4, -- includes the lunge
	Speed = 10,
	Reaction = 0.32, -- after the pass is played
	ReactionJitter = 0.05,
}

PassConfig.Accuracy = {
	-- Standard deviation of the direction error (degrees) and distance error (fraction), by Passing skill.
	AngleAtZeroSkill = 6,
	AngleAtMaxSkill = 1,
	DistanceAtZeroSkill = 0.1,
	DistanceAtMaxSkill = 0.02,
	MaxSigmas = 2.5,
}

-- Placeholder until career data exists.
PassConfig.DefaultPassing = 45

-- Prepared situations, relative to Origin (studs; -Z is towards the goal). The defender walks back
-- and forth between `from` and `to`; where he is when the pass is played is up to the player.
PassConfig.Layouts = {
	-- 1: tutorial. Left teammate free, defender out on the right.
	{ teammates = { { -14, -18 }, { 18, -26 } }, defender = { from = { 12, -12 }, to = { 20, -12 }, speed = 4 } },
	-- 2: left free, right lane patrolled.
	{ teammates = { { -16, -20 }, { 18, -26 } }, defender = { from = { -2, -13 }, to = { 11, -13 }, speed = 6 } },
	-- 3: short pass is easy, the long one needs timing.
	{ teammates = { { -12, -12 }, { 10, -34 } }, defender = { from = { -6, -21 }, to = { 10, -21 }, speed = 7 } },
	-- 4: defender in the middle covers both lanes in turn.
	{ teammates = { { -19, -23 }, { 19, -23 } }, defender = { from = { -10, -12 }, to = { 10, -12 }, speed = 8 } },
	-- 5: through ball or a safe square pass.
	{ teammates = { { -6, -32 }, { 20, -12 } }, defender = { from = { -12, -20 }, to = { 4, -20 }, speed = 6 } },
}

PassConfig.Training = {
	TutorialLayout = 1,
	TutorialTarget = 1, -- teammate the finger shows
	RingRadius = 4.2, -- studs, the ring around that teammate
	TapRadius = 7, -- releases this close to him count on the guided pass
	TaskPasses = 5, -- good passes needed (any number of attempts)
}

PassConfig.SimStep = 1 / 120
PassConfig.SampleStep = 1 / 60

return PassConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">PassPhysics</string>
          <string name="Source"><![CDATA[-- Ground pass simulation, shared by the server (decides the outcome) and the client (layouts,
-- the defender's patrol and the aiming line). Pure functions: same inputs, same result.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PassConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PassConfig"))

local BallCfg = PassConfig.Ball
local Mate = PassConfig.Teammate
local Defender = PassConfig.Defender

export type Patrol = { from: Vector3, to: Vector3, speed: number, phase: number }
export type Layout = { index: number, origin: Vector3, teammates: { Vector3 }, defender: Patrol }
export type PassSim = {
	detail: string, -- GOOD | INTERCEPTED | TOO_HARD | SHORT | WIDE
	outcome: string, -- GOOD | INTERCEPTED | MISS
	eventTime: number, -- when the result is decided (received, intercepted, missed, ball stops)
	endTime: number,
	receiver: number?, -- teammate index for GOOD / TOO_HARD
	speed: number, -- launch speed, stud/s
	ball: { Vector3 }, -- samples every PassConfig.SampleStep
	defender: { Vector3 },
	receiverTrack: { Vector3 }?,
}

local PassPhysics = {}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function offset(origin: Vector3, xz: { number }): Vector3
	return origin + Vector3.new(xz[1], 0, xz[2])
end

-- Absolute positions for a prepared situation. phase (0..2) sets where the patrol starts.
function PassPhysics.layout(index: number, phase: number): Layout
	local spec = PassConfig.Layouts[index]
	local origin = PassConfig.Origin
	local teammates = {}
	for i, xz in spec.teammates do
		teammates[i] = offset(origin, xz)
	end
	return {
		index = index,
		origin = origin,
		teammates = teammates,
		defender = {
			from = offset(origin, spec.defender.from),
			to = offset(origin, spec.defender.to),
			speed = spec.defender.speed,
			phase = phase,
		},
	}
end

-- Defender on his back-and-forth route, t seconds after the episode started.
function PassPhysics.patrolAt(patrol: Patrol, t: number): Vector3
	local span = (patrol.to - patrol.from).Magnitude
	if span < 1e-3 then
		return patrol.from
	end
	local k = (patrol.phase + t * patrol.speed / span) % 2
	if k > 1 then
		k = 2 - k
	end
	return patrol.from:Lerp(patrol.to, k)
end

-- Drag length -> pass distance (and back), both clamped to the playable range.
function PassPhysics.distanceForPower(power: number): number
	return math.clamp(power * BallCfg.MaxRange, BallCfg.MinRange, BallCfg.MaxRange)
end

function PassPhysics.powerForDistance(distance: number): number
	return math.clamp(distance / BallCfg.MaxRange, 0, 1)
end

function PassPhysics.launchSpeed(distance: number): number
	return math.sqrt(2 * BallCfg.Friction * (distance + BallCfg.Overrun))
end

-- Where the ball is t seconds after a pass of launch speed v0, and its speed.
function PassPhysics.ballAt(start: Vector3, dir: Vector3, v0: number, t: number): (Vector3, number)
	local a = BallCfg.Friction
	t = math.clamp(t, 0, v0 / a)
	return start + dir * (v0 * t - a * t * t / 2), v0 - a * t
end

-- Samples f(t) every SampleStep from 0 to endTime.
local function sample(endTime: number, f: (number) -> Vector3): { Vector3 }
	local out = {}
	local step = PassConfig.SampleStep
	local count = math.ceil(endTime / step)
	for i = 0, count do
		out[i + 1] = f(math.min(i * step, endTime))
	end
	return out
end

-- start: ball spot; dir: unit direction on the ground; distance: intended length;
-- releaseTime: seconds since the episode started (where the patrol is); reaction: defender's
-- reaction time; guided: the defender can't intercept and any reachable ball is controlled.
function PassPhysics.simulate(layout: Layout, start: Vector3, dir: Vector3, distance: number, releaseTime: number, reaction: number, guided: boolean?): PassSim
	local v0 = PassPhysics.launchSpeed(distance)
	local tStop = v0 / BallCfg.Friction
	local patrol = layout.defender
	local function defenderAt(t: number): Vector3
		return PassPhysics.patrolAt(patrol, releaseTime + t)
	end
	local defenderSet = defenderAt(reaction)

	local interceptT, receiveT, receiver, heavyT, heavyIndex
	local step = PassConfig.SimStep
	local t = 0
	while t <= tStop + 1e-9 do
		local p, speed = PassPhysics.ballAt(start, dir, v0, t)
		if not guided then
			local reachable
			if t <= reaction then
				reachable = flat(p - defenderAt(t)).Magnitude <= Defender.Reach
			else
				reachable = flat(p - defenderSet).Magnitude - Defender.Reach <= Defender.Speed * (t - reaction)
			end
			if reachable then
				interceptT = t
				break
			end
		end
		for i, mate in layout.teammates do
			local need = flat(p - mate).Magnitude - Mate.Reach
			if need <= 0 or (t > Mate.Reaction and need <= Mate.Speed * (t - Mate.Reaction) and need <= Mate.MaxMove) then
				if guided or speed <= Mate.ControlMaxSpeed then
					receiveT, receiver = t, i
					break
				elseif not heavyT then
					heavyT, heavyIndex = t, i
				end
			end
		end
		if receiveT then
			break
		end
		t += step
	end

	local detail, eventTime
	if interceptT then
		detail, eventTime = "INTERCEPTED", interceptT
	elseif receiveT then
		detail, eventTime = "GOOD", receiveT
	elseif heavyT then
		detail, eventTime, receiver = "TOO_HARD", heavyT, heavyIndex
	else
		-- Nobody got there: short of the teammate it was meant for, or wide / past him.
		local best, bestDot = layout.teammates[1], -math.huge
		for _, mate in layout.teammates do
			local d = flat(mate - start).Unit:Dot(dir)
			if d > bestDot then
				best, bestDot = mate, d
			end
		end
		local along = flat(best - start):Dot(dir)
		detail = if distance + BallCfg.Overrun < along - Mate.Reach then "SHORT" else "WIDE"
		eventTime = tStop
	end
	local outcome = if detail == "GOOD" then "GOOD" elseif detail == "INTERCEPTED" then "INTERCEPTED" else "MISS"
	local endTime = if detail == "GOOD" or detail == "INTERCEPTED" then eventTime + 0.7 else math.max(eventTime, tStop) + 0.3

	-- Receiver: steps from his spot to meet the ball, then stays with it.
	local receiverTrack, meetPoint
	if receiver then
		local mate = layout.teammates[receiver]
		local at = PassPhysics.ballAt(start, dir, v0, eventTime)
		local toMate = flat(mate - at)
		meetPoint = if toMate.Magnitude > Mate.Reach * 0.7 then at + toMate.Unit * Mate.Reach * 0.7 else mate
		local moveFrom = math.min(Mate.Reaction, eventTime)
		receiverTrack = sample(endTime, function(time)
			if time <= moveFrom then
				return mate
			end
			return mate:Lerp(meetPoint, math.clamp((time - moveFrom) / math.max(eventTime - moveFrom, 1e-3), 0, 1))
		end)
	end

	-- Defender: patrols until he reacts, then runs to the interception point (or chases the ball).
	local interceptPoint
	if interceptT then
		local at = PassPhysics.ballAt(start, dir, v0, interceptT)
		local from = if interceptT <= reaction then defenderAt(interceptT) else defenderSet
		local toDef = flat(from - at)
		interceptPoint = if toDef.Magnitude > Defender.Reach * 0.6 then at + toDef.Unit * Defender.Reach * 0.6 else from
	end
	local chase = defenderSet
	local lastChaseT = reaction
	local defenderTrack = sample(endTime, function(time)
		if time <= reaction and not (interceptT and time >= interceptT) then
			return defenderAt(time)
		end
		if interceptT then
			if interceptT <= reaction then
				return defenderAt(interceptT)
			end
			return defenderSet:Lerp(interceptPoint, math.clamp((time - reaction) / (interceptT - reaction), 0, 1))
		end
		-- Chase the ball until the result is decided, then pull up.
		local until_ = math.min(time, eventTime)
		if until_ > lastChaseT then
			local ballPos = PassPhysics.ballAt(start, dir, v0, until_)
			local towards = flat(ballPos - chase)
			local stepLen = math.min(towards.Magnitude, Defender.Speed * 0.85 * (until_ - lastChaseT))
			if towards.Magnitude > 1e-3 then
				chase += towards.Unit * stepLen
			end
			lastChaseT = until_
		end
		return chase
	end)

	-- Ball: rolls along its line, then stays at the feet of whoever got it.
	local ball = sample(endTime, function(time)
		if time <= eventTime or not (detail == "GOOD" or detail == "INTERCEPTED") then
			return (PassPhysics.ballAt(start, dir, v0, time))
		end
		local holder = if detail == "GOOD" then meetPoint else interceptPoint
		local at = PassPhysics.ballAt(start, dir, v0, eventTime)
		return at:Lerp(holder :: Vector3, math.clamp((time - eventTime) / 0.15, 0, 1) * 0.6)
	end)

	return {
		detail = detail,
		outcome = outcome,
		eventTime = eventTime,
		endTime = endTime,
		receiver = receiver,
		speed = v0,
		ball = ball,
		defender = defenderTrack,
		receiverTrack = receiverTrack,
	}
end

return PassPhysics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">ShotConfig</string>
          <string name="Source"><![CDATA[-- Tuning values for the Stage 1 shot, shared by the server (outcome) and the client (visuals)
-- so both sides agree on goal geometry and ball flight.
--
-- World layout (studs): the goal line is the plane Z = 0, the goal is centred on X = 0,
-- the ground is Y = 0, and the shooter stands at +Z shooting towards -Z.

local ShotConfig = {}

ShotConfig.Goal = {
	Width = 30, -- inside width, post to post (oversized for readability; real ratio 3:1)
	Height = 10, -- inside height, ground to crossbar
	PostRadius = 0.4,
	NetDepth = 7,
	-- Fraction of the ball radius that must overlap the frame to count as POST;
	-- lighter touches deflect in (goal side) or out (wide side).
	FrameHitDepth = 0.5,
}

ShotConfig.Ball = {
	Radius = 1,
}

ShotConfig.ShotDistance = 40 -- goal line to ball spot

-- Positions of solid things the ball can bounce off after crossing the line.
ShotConfig.Arena = {
	BoardZ = -20, -- front face of the advertising boards / wall behind the goal
	BoardHeight = 4,
}

ShotConfig.Physics = {
	-- Lower than workspace.Gravity on purpose: weak shots get a visible loop, hard shots stay flat.
	Gravity = 55,
	MinBallSpeed = 45, -- power 0
	MaxBallSpeed = 120, -- power 1
	Drag = 0.0032, -- quadratic air drag, per stud
	Magnus = 0.022, -- curve per (rad/s * stud/s)
	SpinDecay = 0.35, -- per second
	CurlSpin = 9, -- rad/s of side spin for a shot aimed at the post (curls back towards the centre)
	DipSpin = 7, -- rad/s of top spin at full power (hard shots dip)
	SpinJitter = 1.5, -- rad/s random spin, makes no two shots identical
	GroundRestitution = 0.5,
	GroundFriction = 0.35, -- fraction of horizontal speed lost per bounce
	RollingFriction = 9, -- stud/s^2 while rolling
	FrameRestitution = 0.65, -- posts and crossbar
	NetDamping = 0.15, -- fraction of speed kept when the ball hits the net
	BoardRestitution = 0.45,
	SimStep = 1 / 240,
	SampleStep = 1 / 60,
	MaxSimTime = 3.2,
}

ShotConfig.Accuracy = {
	-- Standard deviation (studs) of the random offset from the aim point, by Shooting skill.
	ScatterAtZeroSkill = 3.2,
	ScatterAtMaxSkill = 0.6,
	MaxSigmas = 2.5, -- cap so a single shot is never wildly off
	-- Power above this threshold is less accurate and tends to rise over the bar.
	OverpowerFrom = 0.85,
	OverpowerScatter = 1.8,
	OverpowerLift = 3,
}

ShotConfig.Goalkeeper = {
	Enabled = true,
	Skill = 60, -- 0..100, opponent goalkeeper rating
	ModelScale = 1.4, -- R15 rig scale; ~7.5 studs tall next to the 10-stud goal
	HomeX = 0,
	HomeY = 4.2, -- body centre (root part) height when standing
	HomeZ = 1.6, -- stands just in front of the line
	Reach = 4.2, -- distance from the body centre the gloves cover without moving
	ReactionTime = 0.2,
	ReactionJitter = 0.06, -- +/- random part of the reaction time
	DiveSpeedAtZeroSkill = 12,
	DiveSpeedAtMaxSkill = 30,
	CatchMaxSpeed = 85, -- slower shots that reach the keeper comfortably are held, not parried
	CatchMargin = 1.5, -- studs of spare reach needed to hold the ball
}

-- Placeholder until career data exists (GDD: new players start around OVR 40).
ShotConfig.DefaultShooting = 42

-- Shot training: one guided shot that always scores, then the task (score TaskGoals in any number
-- of shots). The pass training (PassConfig) follows; after it the career goes on to the first match.
ShotConfig.Training = {
	TutorialAim = { X = 0.62, Y = 0.62 }, -- where the finger shows to press (aim coordinates)
	TutorialRingRadius = 2.6, -- studs, the ring drawn on the goal
	TutorialTapRadius = 4.5, -- studs around that point that accept the press (a bit larger than the ring)
	GuidedPowerMin = 0.55, -- the green zone on the power bar during the guided shot
	GuidedPowerMax = 0.8,
	GuidedSafeMargin = 2, -- studs kept clear of the frame and the keeper's reach on the guided shot
	GuidedKeeperDelay = 0.45, -- keeper reacts this much later on guided shots (also from an angle after a pass)
	TaskGoals = 5,
	-- Training keeper: still saves central shots, beatable in the corners.
	TaskKeeperSkill = 15,
	TaskKeeperDelay = 0.12, -- good corner shots score ~90-97%, central ones are still saved
	-- Where a new career's training starts: "SHOT" (shot training) or "PASS" (pass training).
	-- Set "PASS" to test the pass stage without replaying the shot training.
	StartStage = "SHOT",
}

ShotConfig.Episode = {
	MinThinkTime = 0.3, -- seconds between episode start and an accepted input
	Timeout = 120, -- an unanswered episode expires after this
	MinRemoteInterval = 0.2, -- per-player rate limit for remote calls
	InputTolerance = 1e-3, -- float slack allowed on input ranges
}

ShotConfig.Input = {
	PowerCycleSeconds = 1.6, -- power meter goes 0 -> 1 -> 0 over this time while held
	ReadyDelay = 0.35, -- pause after a new episode before input is accepted
}

-- Far and narrow, so the ball sits just above the bottom panel and the goal fills the middle.
ShotConfig.Camera = {
	Position = Vector3.new(0, 6, 82),
	LookAt = Vector3.new(0, 3, 0),
	FieldOfView = 28,
}

return ShotConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">ShotPhysics</string>
          <string name="Source"><![CDATA[-- Shot geometry and ball physics, shared by server and client.
-- The server runs `simulate` to decide the outcome and sends the sampled path to the client,
-- which replays it; the client also uses the free-flight solver for the aiming preview.

local ShotConfig = require(script.Parent.ShotConfig)

local Goal = ShotConfig.Goal
local Arena = ShotConfig.Arena
local P = ShotConfig.Physics
local BALL_RADIUS = ShotConfig.Ball.Radius
local GRAVITY = Vector3.new(0, -P.Gravity, 0)

local HALF_WIDTH = Goal.Width / 2
local POST_X = HALF_WIDTH + Goal.PostRadius
local BAR_Y = Goal.Height + Goal.PostRadius
local FRAME_CONTACT = BALL_RADIUS + Goal.PostRadius

local ShotPhysics = {}

-- Where the ball crosses the goal plane relative to the frame.
ShotPhysics.Zone = {
	OnTarget = "ON_TARGET", -- fully inside the goal mouth
	Frame = "FRAME", -- solid contact with a post or the crossbar
	Wide = "WIDE", -- wide or over
}

export type Event = { kind: string, t: number, pos: Vector3, part: string? }
export type KeeperResponse = { kind: string, velocity: Vector3? } -- kind: "CATCH" | "PARRY"
export type SimResult = {
	path: { Vector3 }, -- ball centre every P.SampleStep seconds, from t = 0
	events: { Event },
	goalTime: number?,
	frameTime: number?,
	framePart: string?, -- "Post" | "Crossbar"
	crossTime: number?, -- first time the ball centre reaches the goal plane (z = 0)
	crossPoint: Vector3?,
	keeperTime: number?, -- when the ball reached the keeper's plane
	keeperPoint: Vector3?,
	keeperKind: string?, -- response returned by the keeper callback, if any
	held: boolean, -- caught: the path ends in the keeper's hands
	duration: number,
}

function ShotPhysics.ballSpot(): Vector3
	return Vector3.new(0, BALL_RADIUS, ShotConfig.ShotDistance)
end

-- Aim X in -1..1 and Y in 0..1 cover exactly the area where the whole ball fits inside the
-- goal mouth, so aiming at the edge means grazing the frame.
function ShotPhysics.aimToGoalPoint(aimX: number, aimY: number): Vector3
	local halfWidth = HALF_WIDTH - BALL_RADIUS
	local x = math.clamp(aimX, -1, 1) * halfWidth
	local y = BALL_RADIUS + math.clamp(aimY, 0, 1) * (Goal.Height - 2 * BALL_RADIUS)
	return Vector3.new(x, y, 0)
end

function ShotPhysics.goalPointToAim(point: Vector3): (number, number)
	local halfWidth = HALF_WIDTH - BALL_RADIUS
	local aimX = math.clamp(point.X / halfWidth, -1, 1)
	local aimY = math.clamp((point.Y - BALL_RADIUS) / (Goal.Height - 2 * BALL_RADIUS), 0, 1)
	return aimX, aimY
end

function ShotPhysics.ballSpeed(power: number): number
	return P.MinBallSpeed + (P.MaxBallSpeed - P.MinBallSpeed) * math.clamp(power, 0, 1)
end

function ShotPhysics.gravity(): Vector3
	return GRAVITY
end

-- Spin chosen for a shot: side spin curls shots aimed at a post back towards the middle,
-- top spin makes hard shots dip. Jitter (from the server's seeded RNG) varies each shot.
function ShotPhysics.spinFor(aimX: number, power: number, jitterX: number?, jitterY: number?): Vector3
	local top = -P.DipSpin * math.max(0, (power - 0.5) / 0.5)
	local side = P.CurlSpin * math.clamp(aimX, -1, 1)
	return Vector3.new(top + (jitterX or 0), side + (jitterY or 0), 0)
end

local function acceleration(v: Vector3, spin: Vector3): Vector3
	return GRAVITY - v * (P.Drag * v.Magnitude) + spin:Cross(v) * P.Magnus
end

-- One midpoint (RK2) step of free flight.
local function step(p: Vector3, v: Vector3, spin: Vector3, dt: number): (Vector3, Vector3)
	local mid = v + acceleration(v, spin) * (dt / 2)
	return p + mid * dt, v + acceleration(mid, spin) * dt
end

-- Free flight (no collisions) until the ball centre reaches the goal plane.
local function crossFree(start: Vector3, v0: Vector3, spin: Vector3, dt: number): (Vector3?, number)
	local p, v, w, t = start, v0, spin, 0
	local decay = 1 - P.SpinDecay * dt
	while t < P.MaxSimTime do
		local nextP, nextV = step(p, v, w, dt)
		t += dt
		if nextP.Z <= 0 then
			local f = p.Z / (p.Z - nextP.Z)
			return p:Lerp(nextP, f), t - dt * (1 - f)
		end
		p, v, w = nextP, nextV, w * decay
	end
	return nil, t
end

-- Launch velocity whose free flight (with drag and spin) crosses the goal plane at `target`.
function ShotPhysics.solveLaunch(start: Vector3, target: Vector3, power: number, spin: Vector3, dt: number?): Vector3
	local stepSize = dt or P.SimStep
	local flightTime = (target - start).Magnitude / ShotPhysics.ballSpeed(power)
	-- Drag-free ballistic guess, then correct the miss a few times.
	local v = (target - start) / flightTime - GRAVITY * (flightTime / 2)
	for _ = 1, 8 do
		local cross, t = crossFree(start, v, spin, stepSize)
		if not cross then
			break
		end
		local miss = target - cross
		if math.abs(miss.X) + math.abs(miss.Y) < 0.01 then
			break
		end
		v += Vector3.new(miss.X, miss.Y, 0) / t
	end
	return v
end

-- Free-flight points from the ball spot (or `from`) to the goal plane, for the aiming preview.
function ShotPhysics.previewPath(target: Vector3, power: number, spin: Vector3, count: number, from: Vector3?): { Vector3 }
	local dt = 1 / 120
	local start = from or ShotPhysics.ballSpot()
	local v0 = ShotPhysics.solveLaunch(start, target, power, spin, dt)
	local _, total = crossFree(start, v0, spin, dt)
	local points = table.create(count)
	local p, v, w, t = start, v0, spin, 0
	local nextSample = total / (count + 1)
	while #points < count and t < total do
		p, v = step(p, v, w, dt)
		w *= 1 - P.SpinDecay * dt
		t += dt
		if t >= nextSample then
			table.insert(points, p)
			nextSample += total / (count + 1)
		end
	end
	return points
end

local function closestOnSegment(p: Vector3, a: Vector3, b: Vector3): Vector3
	local ab = b - a
	local t = math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1)
	return a + ab * t
end

local FRAME_SEGMENTS = {
	{ "Post", Vector3.new(-POST_X, 0, 0), Vector3.new(-POST_X, BAR_Y, 0) },
	{ "Post", Vector3.new(POST_X, 0, 0), Vector3.new(POST_X, BAR_Y, 0) },
	{ "Crossbar", Vector3.new(-POST_X, BAR_Y, 0), Vector3.new(POST_X, BAR_Y, 0) },
}

-- Full flight with collisions: keeper (via callback), posts, crossbar, net, boards and ground.
-- `keeperPlaneZ`/`keeper` are optional; the callback is called once, when the ball first reaches
-- that plane, and may return CATCH (path ends there) or PARRY with a new velocity.
function ShotPhysics.simulate(
	start: Vector3,
	v0: Vector3,
	spin: Vector3,
	keeperPlaneZ: number?,
	keeper: ((t: number, pos: Vector3, vel: Vector3) -> KeeperResponse?)?
): SimResult
	local dt = P.SimStep
	local stepsPerSample = math.max(1, math.round(P.SampleStep / dt))
	local decay = 1 - P.SpinDecay * dt
	local result: SimResult = { path = { start }, events = {}, held = false, duration = 0 }
	local events = result.events

	local p, v, w, t = start, v0, spin, 0
	local stepCount, restTime = 0, 0
	local keeperChecked = keeperPlaneZ == nil
	local touchedNet, touchedBoard = false, false

	local function event(kind: string, at: Vector3, part: string?)
		table.insert(events, { kind = kind, t = t, pos = at, part = part })
	end

	while t < P.MaxSimTime do
		local prev = p
		p, v = step(p, v, w, dt)
		w *= decay
		t += dt
		stepCount += 1

		-- Keeper plane
		if not keeperChecked and prev.Z > keeperPlaneZ and p.Z <= keeperPlaneZ then
			keeperChecked = true
			local f = (prev.Z - keeperPlaneZ) / (prev.Z - p.Z)
			local at = prev:Lerp(p, f)
			result.keeperTime, result.keeperPoint = t - dt * (1 - f), at
			local response = keeper and keeper(result.keeperTime, at, v)
			if response then
				result.keeperKind = response.kind
				event("keeper", at, response.kind)
				if response.kind == "CATCH" then
					p = at
					result.held = true
					table.insert(result.path, p)
					break
				elseif response.velocity then
					p, v, w = at, response.velocity, w * 0.3
				end
			end
		end

		-- Goal frame: sphere against the post / crossbar cylinders.
		for _, segment in FRAME_SEGMENTS do
			local closest = closestOnSegment(p, segment[2], segment[3])
			local offset = p - closest
			local distance = offset.Magnitude
			if distance < FRAME_CONTACT and distance > 1e-4 then
				local normal = offset / distance
				local approach = v:Dot(normal)
				p = closest + normal * FRAME_CONTACT
				if approach < 0 then
					local tangent = v - normal * approach
					v = tangent * 0.9 - normal * (approach * P.FrameRestitution)
					w = w * 0.5
					if not result.frameTime then
						result.frameTime, result.framePart = t, segment[1]
					end
					event("frame", p, segment[1])
				end
			end
		end

		-- Goal line
		if not result.crossTime and prev.Z > 0 and p.Z <= 0 then
			local f = prev.Z / (prev.Z - p.Z)
			result.crossTime, result.crossPoint = t - dt * (1 - f), prev:Lerp(p, f)
		end
		if not result.goalTime and prev.Z >= -BALL_RADIUS and p.Z < -BALL_RADIUS
			and math.abs(p.X) < HALF_WIDTH and p.Y < Goal.Height then
			result.goalTime = t
			event("goal", p)
		end

		-- Net: back, sides and roof, from inside the goal; side netting and roof from outside.
		local inDepth = p.Z < 0 and p.Z > -Goal.NetDepth
		local function netHit(at: Vector3)
			if not touchedNet then
				touchedNet = true
				event("net", at)
			end
		end
		if math.abs(p.X) < HALF_WIDTH and p.Y < Goal.Height and p.Z < -Goal.NetDepth + BALL_RADIUS and prev.Z >= -Goal.NetDepth + BALL_RADIUS then
			p = Vector3.new(p.X, p.Y, -Goal.NetDepth + BALL_RADIUS)
			v = Vector3.new(v.X * 0.4, v.Y * 0.4, -v.Z * P.NetDamping)
			netHit(p)
		end
		if inDepth and p.Y < Goal.Height then
			local inner = HALF_WIDTH - BALL_RADIUS
			local outer = HALF_WIDTH + BALL_RADIUS
			if math.abs(prev.X) <= inner and math.abs(p.X) > inner then
				p = Vector3.new(math.sign(p.X) * inner, p.Y, p.Z)
				v = Vector3.new(-v.X * P.NetDamping, v.Y, v.Z * 0.6)
				netHit(p)
			elseif math.abs(prev.X) >= outer and math.abs(p.X) < outer then
				p = Vector3.new(math.sign(p.X) * outer, p.Y, p.Z)
				v = Vector3.new(-v.X * P.NetDamping, v.Y, v.Z * 0.5)
				netHit(p)
			end
		end
		if inDepth and math.abs(p.X) < HALF_WIDTH then
			local under, over = Goal.Height - BALL_RADIUS, Goal.Height + BALL_RADIUS
			if prev.Y <= under and p.Y > under then
				p = Vector3.new(p.X, under, p.Z)
				v = Vector3.new(v.X * 0.6, -v.Y * P.NetDamping, v.Z * 0.6)
				netHit(p)
			elseif prev.Y >= over and p.Y < over then
				p = Vector3.new(p.X, over, p.Z)
				v = Vector3.new(v.X * 0.5, -v.Y * 0.15, v.Z * 0.5)
				netHit(p)
			end
		end

		-- Advertising boards behind the goal
		if p.Z < Arena.BoardZ + BALL_RADIUS and prev.Z >= Arena.BoardZ + BALL_RADIUS and p.Y < Arena.BoardHeight + BALL_RADIUS then
			p = Vector3.new(p.X, p.Y, Arena.BoardZ + BALL_RADIUS)
			v = Vector3.new(v.X * 0.8, v.Y, -v.Z * P.BoardRestitution)
			if not touchedBoard then
				touchedBoard = true
				event("board", p)
			end
		end

		-- Ground: bounce, then roll with friction.
		if p.Y < BALL_RADIUS then
			p = Vector3.new(p.X, BALL_RADIUS, p.Z)
			if v.Y < -3 then
				local keep = 1 - P.GroundFriction
				v = Vector3.new(v.X * keep, -v.Y * P.GroundRestitution, v.Z * keep)
				event("bounce", p)
			else
				local flat = Vector3.new(v.X, 0, v.Z)
				local speed = flat.Magnitude
				local slowed = math.max(0, speed - P.RollingFriction * dt)
				v = if speed > 1e-3 then flat * (slowed / speed) else Vector3.zero
				w = Vector3.new(v.Z, 0, -v.X) / BALL_RADIUS -- rolling, no more curl
			end
		end

		if stepCount % stepsPerSample == 0 then
			table.insert(result.path, p)
		end

		-- Stop when the ball is resting or has flown into the stands.
		if v.Magnitude < 0.5 and p.Y <= BALL_RADIUS + 0.01 then
			restTime += dt
			if restTime > 0.25 then
				break
			end
		else
			restTime = 0
		end
		if p.Z < Arena.BoardZ - 12 or p.Y < -5 then
			break
		end
	end

	result.duration = t
	return result
end

local function distanceToSegment(px: number, py: number, ax: number, ay: number, bx: number, by: number): number
	local abx, aby = bx - ax, by - ay
	local t = math.clamp(((px - ax) * abx + (py - ay) * aby) / (abx * abx + aby * aby), 0, 1)
	local dx, dy = px - (ax + abx * t), py - (ay + aby * t)
	return math.sqrt(dx * dx + dy * dy)
end

-- Classifies the ball centre where it crosses the goal plane (Z = 0), ignoring collisions.
function ShotPhysics.classify(point: Vector3): string
	local x, y = point.X, point.Y
	local frameDistance = math.min(
		distanceToSegment(x, y, -POST_X, 0, -POST_X, BAR_Y),
		distanceToSegment(x, y, POST_X, 0, POST_X, BAR_Y),
		distanceToSegment(x, y, -POST_X, BAR_Y, POST_X, BAR_Y)
	)
	if frameDistance < Goal.PostRadius + BALL_RADIUS * (1 - Goal.FrameHitDepth) then
		return ShotPhysics.Zone.Frame
	end
	if math.abs(x) < POST_X and y < BAR_Y then
		return ShotPhysics.Zone.OnTarget
	end
	return ShotPhysics.Zone.Wide
end

return ShotPhysics
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="14">
      <Properties>
        <string name="Name">KeeperBuilder</string>
        <string name="Source"><![CDATA[-- Builds the goalkeeper on the server: the blocky footballer (Shared/FigureBuilder) with the
-- character sheet's kit painted on. The client fills the decals in (ImageLoader) and animates the
-- rig locally (KeeperAnimator); the server never moves it.
-- Part colours match the kit, so the keeper still looks right if images are unavailable.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local FigureBuilder = require(Shared:WaitForChild("FigureBuilder"))

local Keeper = ShotConfig.Goalkeeper

local KIT = {
	skin = Color3.fromRGB(214, 132, 82),
	shirt = Color3.fromRGB(30, 22, 40), -- black/purple camo shirt and shorts
	sleeves = Color3.fromRGB(30, 22, 40),
	shorts = Color3.fromRGB(30, 22, 40),
	socks = Color3.fromRGB(22, 18, 28),
	boots = Color3.fromRGB(232, 228, 242),
	hands = Color3.fromRGB(236, 232, 244), -- gloves
	hair = Color3.fromRGB(52, 32, 26),
}

local KeeperBuilder = {}

function KeeperBuilder.build(scene: Instance): Model?
	if not Keeper.Enabled then
		return nil
	end
	local model, rootHeight = FigureBuilder.build("Goalkeeper", KIT, Keeper.ModelScale, "kit")
	model:SetAttribute("Rig", "R15 blocks")
	-- Face the shooter (+Z) and stand with the feet on the ground.
	model:PivotTo(CFrame.new(Keeper.HomeX, rootHeight, Keeper.HomeZ) * CFrame.Angles(0, math.pi, 0))
	model.Parent = scene
	local _, size = model:GetBoundingBox()
	print(string.format("[KeeperBuilder] Goalkeeper ready (%s, %.1f studs tall)", model:GetAttribute("Rig"), size.Y))
	return model
end

return KeeperBuilder
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="15">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Server entry point for the shot and pass training prototype.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- First, before anything can yield: no avatar in Stage 1 (fixed camera, and phones would
-- otherwise show the thumbstick and jump button over the goal).
Players.CharacterAutoLoads = false
for _, player in Players:GetPlayers() do
	if player.Character then
		player.Character:Destroy()
	end
end

if ReplicatedStorage:GetAttribute("ShotServerRunning") then
	warn("[Main] Another copy of the Main script is already running. Delete the duplicate.")
	return
end
ReplicatedStorage:SetAttribute("ShotServerRunning", true)

-- Modules are looked up by name anywhere under ServerScriptService, so it doesn't matter
-- whether they sit next to this script or inside a Services folder.
local function requireServerModule(name: string)
	local module = ServerScriptService:FindFirstChild(name, true)
	if not (module and module:IsA("ModuleScript")) then
		error(string.format("[Main] ModuleScript '%s' was not found in ServerScriptService. See README > Setup.", name), 0)
	end
	return require(module)
end

local shared = ReplicatedStorage:FindFirstChild("Shared")
for _, name in { "ShotConfig", "ShotPhysics", "PassConfig", "PassPhysics", "FigureBuilder", "CareerConfig" } do
	if not (shared and shared:FindFirstChild(name)) then
		error(string.format("[Main] ReplicatedStorage > Shared > %s (ModuleScript) is missing. See README > Setup.", name), 0)
	end
end

local REMOTE_NAMES = { "RequestEpisode", "EpisodeStarted", "SubmitEpisodeInput", "EpisodeResult" }

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local remotes = {}
for _, name in REMOTE_NAMES do
	local remote = remotesFolder:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = remotesFolder
	end
	remotes[name] = remote
end

-- Menus talk to the career over a RemoteFunction: each request needs exactly one answer.
local careerRequest = remotesFolder:FindFirstChild("CareerRequest")
if not careerRequest then
	careerRequest = Instance.new("RemoteFunction")
	careerRequest.Name = "CareerRequest"
	careerRequest.Parent = remotesFolder
end

local SceneBuilder = requireServerModule("SceneBuilder")
local KeeperBuilder = requireServerModule("KeeperBuilder")
local EpisodeService = requireServerModule("EpisodeService")
local CareerService = requireServerModule("CareerService")

local scene = SceneBuilder.build()
KeeperBuilder.build(scene)
EpisodeService.init(remotes, { onStageCompleted = CareerService.onStageCompleted })
CareerService.init(careerRequest, { beginTraining = EpisodeService.beginTraining, stopTraining = EpisodeService.stopTraining })

print("[Main] Career menu, shot and pass training ready")
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="16">
      <Properties>
        <string name="Name">SceneBuilder</string>
        <string name="Source"><![CDATA[-- Builds the evening stadium at runtime: striped pitch and markings, goal with net, LED boards,
-- a two-tier stand with crowd, floodlights, a city skyline, a sunset backdrop and dusk lighting.
-- Goal dimensions come from ShotConfig so the visuals always match the geometry the server uses.
--
-- Framed for the fixed shot camera (ShotConfig.Camera): inside the pitch area there are only
-- flat ground details and the goal; the stand fills the band above the goal and the sky,
-- floodlights and skyline show above the stand roof.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShotConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShotConfig"))

local Goal = ShotConfig.Goal
local Arena = ShotConfig.Arena
local CameraConfig = ShotConfig.Camera
local VERTICAL = CFrame.Angles(0, 0, math.pi / 2) -- cylinder parts are long along X

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Palette from the New Football Star UI kit.
local NAVY = rgb(18, 11, 36)
local PURPLE = rgb(43, 18, 80)
local VIOLET = rgb(90, 47, 194)
local VIOLET_BRIGHT = rgb(123, 77, 255)
local RED = rgb(255, 45, 85)
local GOLD = rgb(255, 191, 31)
local CREAM = rgb(247, 236, 214)
local PINK = rgb(255, 79, 163)
local WHITE = Color3.new(1, 1, 1)

local GRASS_A = rgb(58, 128, 60)
local GRASS_B = rgb(50, 114, 54)
local GRASS_EDGE = rgb(42, 96, 47)
local STEP_A = rgb(43, 18, 80)
local STEP_B = rgb(36, 15, 66)
local AISLE = rgb(74, 44, 120)
local HEAVY_ITALIC = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)

local SEED = 7404 -- fixed so the crowd, skyline and clouds look the same every session

-- Pitch
local PITCH_HALF_WIDTH = 120
local STRIPE_DEPTH = 8
local PITCH_BACK = -24 -- a stripe boundary lands on the goal line
local PITCH_FRONT = 104

-- Stand behind the goal (z is negative behind the goal line).
local STAND_HALF_WIDTH = 105
local STAND_FRONT_Z = Arena.BoardZ - 3 -- walkway between the boards and the stand
local STAND_WALL_HEIGHT = 4.8
local AISLES = { -56, -20, 20, 56 }
local AISLE_WIDTH = 2.4
local SEAT_SPACING = 1.65

local CROWD_SHIRTS = { VIOLET, VIOLET, VIOLET_BRIGHT, RED, RED, GOLD, CREAM, PINK, PURPLE, WHITE, rgb(255, 140, 40) }
local CROWD_SKIN = { rgb(240, 196, 150), rgb(214, 160, 112), rgb(160, 104, 66), rgb(104, 64, 40) }
local WINDOW_COLOURS = { GOLD, GOLD, CREAM, rgb(255, 214, 140), PINK, VIOLET_BRIGHT }
local BUILDING_COLOURS = { rgb(34, 16, 64), rgb(43, 18, 80), rgb(28, 14, 54), rgb(52, 24, 96) }

-- Horizontal half-width the shot camera sees at depth z on screens up to 2.25:1, so crowd
-- blocks are only spent where they can appear.
local VIEW_SLOPE = math.tan(math.rad(CameraConfig.FieldOfView / 2)) * 2.25
local function visibleHalfWidth(z: number): number
	return (CameraConfig.Position.Z - z) * VIEW_SLOPE
end

local SceneBuilder = {}

-- Decorative, anchored, no collisions: nothing in Stage 1 relies on Roblox physics.
-- Shadows are opt-in so the low dusk sun cannot throw the stand's shadow over the goal.
local function makePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	part.Parent = parent
	return part
end

local function create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function folder(name: string, parent: Instance): Folder
	return create("Folder", { Name = name, Parent = parent })
end

local function corner(parent: Instance)
	create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = parent })
end

-- Thin axis-aligned bar between two points.
local function bar(parent: Instance, name: string, from: Vector3, to: Vector3, thickness: number, color: Color3): Part
	local delta = to - from
	return makePart({
		Name = name,
		Size = Vector3.new(math.abs(delta.X) + thickness, math.abs(delta.Y) + thickness, math.abs(delta.Z) + thickness),
		CFrame = CFrame.new((from + to) / 2),
		Color = color,
		Parent = parent,
	})
end

-- The default "Baseplate" template has a baseplate at ground level (flickers through the
-- pitch) and a SpawnLocation in the goal mouth. Removed for this play session only.
local function clearDefaultTemplate()
	for _, child in workspace:GetChildren() do
		if child:IsA("SpawnLocation") or (child.Name == "Baseplate" and child:IsA("BasePart")) then
			child:Destroy()
		end
	end
end

type LedStyle = { from: Color3, to: Color3, textColor: Color3, text: string }

local IMAGE_TAG = "NfsImage" -- see ShotClient/ImageLoader
local BOARD_IMAGES = { "Wide", "NfsShield", "StarBall" }

-- Self-lit LED panel drawn on the face pointing at the pitch (+Z).
local function ledFace(part: BasePart, style: LedStyle, pixelsPerStud: number, textHeight: number, image: string?, tiles: number?)
	local gui = create("SurfaceGui", {
		Face = Enum.NormalId.Back,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = pixelsPerStud,
		LightInfluence = 0,
		Brightness = 1.6,
		Parent = part,
	})
	-- The inset leaves a dark seam between neighbouring panels.
	local panel = create("Frame", {
		Name = "Panel",
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = gui,
	})
	create("UIGradient", { Color = ColorSequence.new(style.from, style.to), Rotation = 90, Parent = panel })
	create("Frame", {
		Name = "Shine",
		Size = UDim2.fromScale(1, 0.14),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Parent = panel,
	})
	create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.54),
		Size = UDim2.fromScale(0.92, textHeight),
		BackgroundTransparency = 1,
		RichText = true,
		TextScaled = true,
		FontFace = HEAVY_ITALIC,
		TextColor3 = style.textColor,
		TextStrokeColor3 = NAVY,
		TextStrokeTransparency = 0.15,
		Text = style.text,
		Parent = panel,
	})
	if image then
		-- Banner artwork from Images/Banners.lua; the client fills it in and shows it (ImageLoader).
		-- tiles > 1 repeats the image across the panel (the long balcony ribbon).
		local art = create("ImageLabel", {
			Name = "Art",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ScaleType = if tiles then Enum.ScaleType.Tile else Enum.ScaleType.Stretch,
			TileSize = UDim2.fromScale(1 / (tiles or 1), 1),
			Visible = false,
			ZIndex = 2,
			Parent = panel,
		})
		art:SetAttribute("Image", "Banners/" .. image)
		art:AddTag(IMAGE_TAG)
	end
end

local BOARD_STYLES: { LedStyle } = {
	{ from = VIOLET_BRIGHT, to = PURPLE, textColor = CREAM, text = 'NEW FOOTBALL <font color="#FF2D55">STAR</font> <font color="#FFBF1F">★</font>' },
	{ from = GOLD, to = rgb(255, 138, 20), textColor = NAVY, text = '<font color="#FF2D55">★</font> SHOOTING DRILL' },
	{ from = RED, to = rgb(140, 12, 60), textColor = CREAM, text = 'NFS <font color="#FFBF1F">★</font>' },
	{ from = PURPLE, to = NAVY, textColor = GOLD, text = "PLAY ▶" },
	{ from = NAVY, to = VIOLET, textColor = CREAM, text = '<font color="#FFBF1F">NFS</font> ARENA' },
}

local RIBBON_STYLE: LedStyle = {
	from = PINK,
	to = VIOLET,
	textColor = CREAM,
	text = 'NEW FOOTBALL STAR  <font color="#FFBF1F">★</font>  NFS  <font color="#FFBF1F">★</font>',
}

local function buildPitch(scene: Instance)
	local pitch = folder("Pitch", scene)
	makePart({
		Name = "Surround",
		Size = Vector3.new(700, 1, 700),
		CFrame = CFrame.new(0, -0.6, 0),
		Color = GRASS_EDGE,
		Material = Enum.Material.Grass,
		Parent = pitch,
	})
	local stripes = math.ceil((PITCH_FRONT - PITCH_BACK) / STRIPE_DEPTH)
	for i = 0, stripes - 1 do
		makePart({
			Name = "Stripe",
			Size = Vector3.new(PITCH_HALF_WIDTH * 2, 1, STRIPE_DEPTH),
			CFrame = CFrame.new(0, -0.5, PITCH_BACK + STRIPE_DEPTH * (i + 0.5)),
			Color = if i % 2 == 0 then GRASS_A else GRASS_B,
			Material = Enum.Material.Grass,
			Parent = pitch,
		})
	end
end

local function buildMarkings(scene: Instance)
	-- Real-world scale (3.28 studs per metre) measured from the posts, so the boxes keep their
	-- proportions if the goal is resized.
	local markings = folder("Markings", scene)
	local width = 0.45
	local hw = Goal.Width / 2
	local function line(x1: number, z1: number, x2: number, z2: number)
		makePart({
			Name = "Line",
			Size = Vector3.new(math.abs(x2 - x1) + width, 0.06, math.abs(z2 - z1) + width),
			CFrame = CFrame.new((x1 + x2) / 2, 0, (z1 + z2) / 2),
			Color = WHITE,
			Parent = markings,
		})
	end
	line(-PITCH_HALF_WIDTH + 5, 0, PITCH_HALF_WIDTH - 5, 0)
	local penaltyDepth = 54
	for _, box in { { hw + 15, 18 }, { hw + 51, penaltyDepth } } do -- six-yard box, penalty box
		local halfWidth, depth = box[1], box[2]
		line(-halfWidth, 0, -halfWidth, depth)
		line(halfWidth, 0, halfWidth, depth)
		line(-halfWidth, depth, halfWidth, depth)
	end

	-- Penalty arc: the part of a 30-stud circle around the penalty mark outside the box.
	local spotZ, radius = 36, 30
	local limit = math.acos((penaltyDepth - spotZ) / radius)
	local segments = 10
	local function arcPoint(angle: number): Vector3
		return Vector3.new(radius * math.sin(angle), 0, spotZ + radius * math.cos(angle))
	end
	for i = 0, segments - 1 do
		local a = arcPoint(-limit + 2 * limit * i / segments)
		local b = arcPoint(-limit + 2 * limit * (i + 1) / segments)
		makePart({
			Name = "Arc",
			Size = Vector3.new(width, 0.06, (b - a).Magnitude + 0.1),
			CFrame = CFrame.lookAt((a + b) / 2, b),
			Color = WHITE,
			Parent = markings,
		})
	end

	-- Glowing gold ring around the ball spot, drawn as a crisp SurfaceGui circle.
	local spot = makePart({
		Name = "BallSpotRing",
		Size = Vector3.new(5, 0.05, 5),
		CFrame = CFrame.new(0, 0.04, ShotConfig.ShotDistance),
		Transparency = 1,
		Parent = markings,
	})
	local gui = create("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 50,
		LightInfluence = 0,
		Brightness = 2,
		Parent = spot,
	})
	local glow = create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = GOLD,
		BackgroundTransparency = 0.84,
		BorderSizePixel = 0,
		Parent = gui,
	})
	corner(glow)
	local ring = create("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.74, 0.74),
		BackgroundColor3 = VIOLET_BRIGHT,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		Parent = gui,
	})
	corner(ring)
	create("UIStroke", { Color = GOLD, Thickness = 7, Parent = ring })
	local dot = create("Frame", {
		Name = "Spot",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.16, 0.16),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = gui,
	})
	corner(dot)
end

-- Transparent panel with a 1-stud grid of lines drawn on one face. SurfaceGui lines are
-- filtered like a texture, so they stay crisp at distance instead of flickering like thin parts.
local function netPanel(parent: Instance, name: string, size: Vector3, cframe: CFrame, face: Enum.NormalId, u: number, v: number)
	local part = makePart({ Name = name, Size = size, CFrame = cframe, Transparency = 1, Parent = parent })
	local gui = create("SurfaceGui", {
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 32,
		LightInfluence = 0.4,
		Parent = part,
	})
	create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.94, BorderSizePixel = 0, Parent = gui })
	local cellsU, cellsV = math.max(1, math.round(u)), math.max(1, math.round(v))
	for i = 0, cellsU do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(i / cellsU, 0),
			Size = UDim2.new(0, 3, 1, 0),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			Parent = gui,
		})
	end
	for j = 0, cellsV do
		create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, j / cellsV),
			Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			Parent = gui,
		})
	end
	return part
end

local function buildGoal(scene: Instance)
	local goal = Instance.new("Model")
	goal.Name = "Goal"

	local W, H, D = Goal.Width, Goal.Height, Goal.NetDepth
	local hw = W / 2
	local postX = hw + Goal.PostRadius
	local postLength = H + 2 * Goal.PostRadius
	local diameter = 2 * Goal.PostRadius
	for _, side in { -1, 1 } do
		makePart({
			Name = if side < 0 then "LeftPost" else "RightPost",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(postLength, diameter, diameter),
			CFrame = CFrame.new(side * postX, postLength / 2, 0) * VERTICAL,
			Color = WHITE,
			Reflectance = 0.05,
			CastShadow = true,
			Parent = goal,
		})
	end
	makePart({
		Name = "Crossbar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(W + 4 * Goal.PostRadius, diameter, diameter),
		CFrame = CFrame.new(0, H + Goal.PostRadius, 0),
		Color = WHITE,
		Reflectance = 0.05,
		CastShadow = true,
		Parent = goal,
	})

	-- Box frame holding the net: back uprights and top, side rails and ground bars.
	local support = rgb(222, 222, 230)
	local function rod(from: Vector3, to: Vector3)
		bar(goal, "Support", from, to, 0.18, support)
	end
	rod(Vector3.new(-hw, 0, -D), Vector3.new(-hw, H, -D))
	rod(Vector3.new(hw, 0, -D), Vector3.new(hw, H, -D))
	rod(Vector3.new(-hw, H, -D), Vector3.new(hw, H, -D))
	rod(Vector3.new(-hw, H, 0), Vector3.new(-hw, H, -D))
	rod(Vector3.new(hw, H, 0), Vector3.new(hw, H, -D))
	rod(Vector3.new(-hw, 0.05, -D), Vector3.new(hw, 0.05, -D))
	rod(Vector3.new(-hw, 0.05, 0), Vector3.new(-hw, 0.05, -D))
	rod(Vector3.new(hw, 0.05, 0), Vector3.new(hw, 0.05, -D))

	local net = folder("Net", goal)
	-- Faces point into the goal, towards the camera.
	netPanel(net, "NetBack", Vector3.new(W, H, 0.05), CFrame.new(0, H / 2, -D), Enum.NormalId.Back, W, H)
	netPanel(net, "NetLeft", Vector3.new(0.05, H, D), CFrame.new(-hw, H / 2, -D / 2), Enum.NormalId.Right, D, H)
	netPanel(net, "NetRight", Vector3.new(0.05, H, D), CFrame.new(hw, H / 2, -D / 2), Enum.NormalId.Left, D, H)
	netPanel(net, "NetTop", Vector3.new(W, 0.05, D), CFrame.new(0, H, -D / 2), Enum.NormalId.Bottom, W, D)

	goal.Parent = scene
end

-- LED advertising boards. Their front face is the plane the ball bounces off (Arena.BoardZ).
local function buildBoards(scene: Instance)
	local boards = folder("Boards", scene)
	local height = Arena.BoardHeight
	local width = 20
	for index = -5, 5 do
		local board = makePart({
			Name = "Board",
			Size = Vector3.new(width, height, 1),
			CFrame = CFrame.new(index * width, height / 2, Arena.BoardZ - 0.5),
			Color = NAVY,
			Parent = boards,
		})
		ledFace(board, BOARD_STYLES[index % #BOARD_STYLES + 1], 30, 0.6, BOARD_IMAGES[index % #BOARD_IMAGES + 1])
	end
	makePart({
		Name = "TopStrip",
		Size = Vector3.new(width * 11, 0.18, 0.9),
		CFrame = CFrame.new(0, height + 0.09, Arena.BoardZ - 0.5),
		Color = VIOLET_BRIGHT,
		Material = Enum.Material.Neon,
		Parent = boards,
	})
	makePart({
		Name = "Walkway",
		Size = Vector3.new(STAND_HALF_WIDTH * 2, 0.1, Arena.BoardZ - 1 - STAND_FRONT_Z),
		CFrame = CFrame.new(0, 0.02, (Arena.BoardZ - 1 + STAND_FRONT_Z) / 2),
		Color = NAVY,
		Material = Enum.Material.Concrete,
		Parent = boards,
	})
end

local function inAisle(x: number): boolean
	for _, aisle in AISLES do
		if math.abs(x - aisle) < AISLE_WIDTH / 2 + 0.6 then
			return true
		end
	end
	return false
end

-- One fan: shirt block with a head on top.
local function addFan(crowd: Instance, rng: Random, x: number, floorY: number, z: number)
	local body = rng:NextNumber(1.0, 1.5)
	local shirt = CROWD_SHIRTS[rng:NextInteger(1, #CROWD_SHIRTS)]
	makePart({ Name = "Fan", Size = Vector3.new(1.25, body, 0.8), CFrame = CFrame.new(x, floorY + body / 2, z), Color = shirt, Parent = crowd })
	makePart({
		Name = "Head",
		Size = Vector3.new(0.7, 0.7, 0.7),
		CFrame = CFrame.new(x, floorY + body + 0.35, z),
		Color = CROWD_SKIN[rng:NextInteger(1, #CROWD_SKIN)],
		Parent = crowd,
	})
end

-- Stepped seating rows with fans; returns the z behind the last row and its floor height.
local function buildTier(stand: Instance, crowd: Instance, rng: Random, frontZ: number, baseY: number, rows: number, tread: number, rise: number): (number, number)
	local z, top = frontZ, baseY
	for row = 1, rows do
		top += rise
		local centreZ = z - tread / 2
		makePart({
			Name = "Step",
			Size = Vector3.new(STAND_HALF_WIDTH * 2, top, tread),
			CFrame = CFrame.new(0, top / 2, centreZ),
			Color = if row % 2 == 0 then STEP_A else STEP_B,
			Parent = stand,
		})
		for _, x in AISLES do
			makePart({ Name = "AisleStep", Size = Vector3.new(AISLE_WIDTH, 0.06, tread), CFrame = CFrame.new(x, top + 0.03, centreZ), Color = AISLE, Parent = stand })
		end
		local halfWidth = math.min(visibleHalfWidth(centreZ) + 4, STAND_HALF_WIDTH - 1)
		local x = -halfWidth
		while x <= halfWidth do
			-- A few empty seats keep the crowd from reading as a solid wall.
			if not inAisle(x) and rng:NextNumber() > 0.07 then
				addFan(crowd, rng, x + rng:NextNumber(-0.15, 0.15), top, centreZ + rng:NextNumber(-0.25, 0.2))
			end
			x += SEAT_SPACING
		end
		z -= tread
	end
	return z, top
end

local function neonStrip(parent: Instance, name: string, y: number, z: number, color: Color3, halfWidth: number?)
	local width = 2 * (halfWidth or STAND_HALF_WIDTH)
	makePart({ Name = name, Size = Vector3.new(width, 0.28, 0.3), CFrame = CFrame.new(0, y, z), Color = color, Material = Enum.Material.Neon, Parent = parent })
end

local function buildStand(scene: Instance, rng: Random)
	local stand = folder("Stand", scene)
	local crowd = folder("Crowd", stand)
	local width = STAND_HALF_WIDTH * 2

	makePart({
		Name = "FrontWall",
		Size = Vector3.new(width, STAND_WALL_HEIGHT, 1),
		CFrame = CFrame.new(0, STAND_WALL_HEIGHT / 2, STAND_FRONT_Z - 0.5),
		Color = PURPLE,
		Parent = stand,
	})
	neonStrip(stand, "WallGlow", STAND_WALL_HEIGHT - 0.1, STAND_FRONT_Z - 0.1, PINK)

	-- Lower tier.
	local lowerBack, lowerTop = buildTier(stand, crowd, rng, STAND_FRONT_Z - 1, STAND_WALL_HEIGHT, 5, 1.9, 0.8)

	-- Balcony front of the upper tier with an LED ribbon, lifted clear of the lower crowd's heads.
	local ribbonBottom, ribbonHeight = lowerTop + 2.2, 1.8
	makePart({
		Name = "BalconyWall",
		Size = Vector3.new(width, ribbonBottom, 0.8),
		CFrame = CFrame.new(0, ribbonBottom / 2, lowerBack - 0.4),
		Color = NAVY,
		Parent = stand,
	})
	for index = -2, 2 do
		local ribbon = makePart({
			Name = "Ribbon",
			Size = Vector3.new(42, ribbonHeight, 0.8),
			CFrame = CFrame.new(index * 42, ribbonBottom + ribbonHeight / 2, lowerBack - 0.4),
			Color = NAVY,
			Parent = stand,
		})
		ledFace(ribbon, RIBBON_STYLE, 20, 0.7, "Ribbon", 4)
	end
	neonStrip(stand, "RibbonGlow", ribbonBottom + ribbonHeight + 0.14, lowerBack - 0.3, VIOLET_BRIGHT)

	-- Upper tier.
	local upperBack, upperTop = buildTier(stand, crowd, rng, lowerBack - 0.8, ribbonBottom + ribbonHeight, 4, 2, 0.85)

	-- Roof canopy over the upper tier: dark underside with lamps, neon-trimmed fascia on the front.
	-- Kept low so the sky, floodlights and skyline get the top fifth of the shot camera's view.
	local roofY = upperTop + 2.6
	local roofFront = upperBack + 5
	local roofDepth = roofFront - (upperBack - 1)
	makePart({
		Name = "BackWall",
		Size = Vector3.new(width, roofY, 1),
		CFrame = CFrame.new(0, roofY / 2, upperBack - 0.5),
		Color = NAVY,
		Parent = stand,
	})
	makePart({
		Name = "Roof",
		Size = Vector3.new(width, 0.6, roofDepth),
		CFrame = CFrame.new(0, roofY + 0.3, roofFront - roofDepth / 2),
		Color = NAVY,
		Material = Enum.Material.Metal,
		Parent = stand,
	})
	makePart({
		Name = "Fascia",
		Size = Vector3.new(width, 1.4, 0.5),
		CFrame = CFrame.new(0, roofY + 0.3, roofFront - 0.25),
		Color = PURPLE,
		Parent = stand,
	})
	neonStrip(stand, "FasciaGlowLow", roofY - 0.25, roofFront + 0.1, VIOLET_BRIGHT)
	neonStrip(stand, "FasciaGlowHigh", roofY + 0.85, roofFront + 0.1, PINK)
	for x = -80, 80, 10 do
		makePart({
			Name = "RoofLamp",
			Size = Vector3.new(2.4, 0.2, 1),
			CFrame = CFrame.new(x, roofY - 0.1, roofFront - roofDepth * 0.45),
			Color = CREAM,
			Material = Enum.Material.Neon,
			Parent = stand,
		})
	end
end

-- Floodlight towers rising above the roof, heads tilted at the penalty area.
local FLOODLIGHTS = {
	Vector3.new(-38, 28.5, -62),
	Vector3.new(38, 28.5, -62),
	Vector3.new(-66, 34.5, -100),
	Vector3.new(66, 34.5, -100),
}

local function buildFloodlights(scene: Instance)
	local lights = folder("Floodlights", scene)
	local aim = Vector3.new(0, 0, 20)
	for _, head in FLOODLIGHTS do
		local poleHeight = head.Y - 2.5
		makePart({
			Name = "Pole",
			Size = Vector3.new(1.3, poleHeight, 1.3),
			CFrame = CFrame.new(head.X, poleHeight / 2, head.Z),
			Color = PURPLE,
			Material = Enum.Material.Metal,
			Parent = lights,
		})
		local frame = CFrame.lookAt(head, aim)
		local panel = makePart({
			Name = "Head",
			Size = Vector3.new(10.5, 6.4, 1),
			CFrame = frame,
			Color = NAVY,
			Material = Enum.Material.Metal,
			Parent = lights,
		})
		makePart({
			Name = "Trim",
			Size = Vector3.new(10.9, 0.35, 1.1),
			CFrame = frame * CFrame.new(0, 3.3, 0),
			Color = VIOLET_BRIGHT,
			Material = Enum.Material.Neon,
			Parent = lights,
		})
		for col = 0, 3 do
			for row = 0, 2 do
				makePart({
					Name = "Lamp",
					Size = Vector3.new(2.1, 1.5, 0.3),
					-- Front face (-Z) of the head points at the pitch.
					CFrame = frame * CFrame.new(-3.75 + col * 2.5, -1.9 + row * 1.9, -0.55),
					Color = rgb(255, 248, 230),
					Material = Enum.Material.Neon,
					Parent = lights,
				})
			end
		end
		create("PointLight", { Brightness = 1.6, Range = 45, Color = rgb(255, 236, 214), Shadows = false, Parent = panel })
	end
end

-- Dark purple towers far behind the stadium; lit windows only where they rise above the roof.
local function buildSkyline(scene: Instance, rng: Random)
	local skyline = folder("Skyline", scene)
	local rowsOfTowers = {
		{ z = -240, minHeight = 44, maxHeight = 60 },
		{ z = -292, minHeight = 52, maxHeight = 76 },
	}
	for rowIndex, row in rowsOfTowers do
		local x = -225 + (rowIndex - 1) * 11
		while x < 225 do
			local width = rng:NextNumber(14, 30)
			local height = rng:NextNumber(row.minHeight, row.maxHeight)
			local landmark = rng:NextNumber() < 0.15
			if landmark then
				height += 14
			end
			local centreX = x + width / 2
			local z = row.z - rng:NextNumber(0, 10)
			local building = makePart({
				Name = "Building",
				Size = Vector3.new(width, height, 16),
				CFrame = CFrame.new(centreX, height / 2, z),
				Color = BUILDING_COLOURS[rng:NextInteger(1, #BUILDING_COLOURS)],
				Parent = skyline,
			})
			local gui = create("SurfaceGui", {
				Face = Enum.NormalId.Back,
				SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
				PixelsPerStud = 3,
				LightInfluence = 0,
				Brightness = 1.3,
				Parent = building,
			})
			local cols = math.floor((width - 2) / 3)
			local floors = math.floor(math.min(height - 4, 30) / 3.5)
			for f = 0, floors - 1 do
				for c = 0, cols - 1 do
					if rng:NextNumber() < 0.3 then
						create("Frame", {
							Position = UDim2.fromScale((1.6 + c * 3) / width, (2 + f * 3.5) / height),
							Size = UDim2.fromScale(1.6 / width, 2 / height),
							BackgroundColor3 = WINDOW_COLOURS[rng:NextInteger(1, #WINDOW_COLOURS)],
							BorderSizePixel = 0,
							Parent = gui,
						})
					end
				end
			end
			if landmark then
				makePart({
					Name = "Spire",
					Size = Vector3.new(0.8, 9, 0.8),
					CFrame = CFrame.new(centreX, height + 4.5, z),
					Color = PURPLE,
					Parent = skyline,
				})
				makePart({
					Name = "Beacon",
					Size = Vector3.new(1.2, 1.2, 1.2),
					CFrame = CFrame.new(centreX, height + 9.4, z),
					Color = RED,
					Material = Enum.Material.Neon,
					Parent = skyline,
				})
			end
			x += width + rng:NextNumber(3, 9)
		end
	end
end

-- Painted sunset behind the skyline. The camera is fixed, so a self-lit card gives a reliable
-- purple-to-orange sky without sky textures.
local SKY_Z, SKY_BOTTOM, SKY_TOP, SKY_HALF_WIDTH = -420, 30, 150, 300

local function buildSkyBackdrop(scene: Instance, rng: Random)
	local sky = folder("Sky", scene)
	local height = SKY_TOP - SKY_BOTTOM
	local card = makePart({
		Name = "SunsetCard",
		Size = Vector3.new(SKY_HALF_WIDTH * 2, height, 1),
		CFrame = CFrame.new(0, SKY_BOTTOM + height / 2, SKY_Z),
		Color = NAVY,
		Parent = sky,
	})
	local gui = create("SurfaceGui", {
		Face = Enum.NormalId.Back,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(1500, 300),
		LightInfluence = 0,
		Brightness = 1.15,
		Parent = card,
	})
	local function scaleY(y: number): number
		return (SKY_TOP - y) / height
	end
	local function scaleX(x: number): number
		return (x + SKY_HALF_WIDTH) / (SKY_HALF_WIDTH * 2)
	end
	local gradient = create("Frame", { Name = "Gradient", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = gui })
	create("UIGradient", {
		Rotation = 90, -- keypoint 0 at the top
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, NAVY),
			ColorSequenceKeypoint.new(scaleY(124), PURPLE),
			ColorSequenceKeypoint.new(scaleY(108), VIOLET),
			ColorSequenceKeypoint.new(scaleY(96), rgb(170, 60, 190)),
			ColorSequenceKeypoint.new(scaleY(86), rgb(255, 79, 140)),
			ColorSequenceKeypoint.new(scaleY(76), rgb(255, 122, 70)),
			ColorSequenceKeypoint.new(scaleY(66), rgb(255, 170, 50)),
			ColorSequenceKeypoint.new(1, rgb(255, 214, 120)),
		}),
		Parent = gradient,
	})

	-- Setting sun peeking over the roof, right of the goal.
	for _, disc in { { size = 72, color = GOLD, transparency = 0.75 }, { size = 36, color = rgb(255, 230, 160), transparency = 0 } } do
		local sun = create("Frame", {
			Name = "Sun",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(scaleX(85), scaleY(64)),
			Size = UDim2.fromScale(disc.size / (SKY_HALF_WIDTH * 2), disc.size / height),
			BackgroundColor3 = disc.color,
			BackgroundTransparency = disc.transparency,
			BorderSizePixel = 0,
			Parent = gui,
		})
		corner(sun)
	end

	-- Blocky two-tone cloud streaks, dark above and lit by the sunset underneath.
	for _ = 1, 12 do
		local y = rng:NextNumber(84, 114)
		local x = rng:NextNumber(-280, 280)
		local length = rng:NextNumber(40, 120)
		local thickness = rng:NextNumber(2.5, 5)
		local high = y > 98
		create("Frame", {
			Name = "Cloud",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(scaleX(x), scaleY(y)),
			Size = UDim2.fromScale(length / (SKY_HALF_WIDTH * 2), thickness / height),
			BackgroundColor3 = if high then rgb(64, 28, 128) else rgb(150, 50, 160),
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			Parent = gui,
		})
		create("Frame", {
			Name = "CloudLit",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(scaleX(x + length * 0.08), scaleY(y)),
			Size = UDim2.fromScale(length * 0.7 / (SKY_HALF_WIDTH * 2), 1.2 / height),
			BackgroundColor3 = if high then PINK else rgb(255, 150, 80),
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			Parent = gui,
		})
	end
end

-- Non-shadow floodlighting on the goal mouth and ball spot, mounted above the top of the frame.
local function buildPlayLights(scene: Instance)
	local rig = folder("PlayLights", scene)
	local lamps = {
		{ from = Vector3.new(-30, 42, 30), to = Vector3.new(0, 4, 0), brightness = 3, angle = 70 },
		{ from = Vector3.new(30, 42, 30), to = Vector3.new(0, 4, 0), brightness = 3, angle = 70 },
		{ from = Vector3.new(0, 38, 62), to = Vector3.new(0, 0, ShotConfig.ShotDistance), brightness = 2, angle = 60 },
	}
	for _, lamp in lamps do
		local anchor = makePart({
			Name = "LightRig",
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.lookAt(lamp.from, lamp.to),
			Transparency = 1,
			Parent = rig,
		})
		create("SpotLight", {
			Face = Enum.NormalId.Front,
			Angle = lamp.angle,
			Brightness = lamp.brightness,
			Range = 60,
			Color = rgb(255, 244, 228),
			Shadows = false,
			Parent = anchor,
		})
	end
end

local function ensureChild(parent: Instance, className: string, name: string): any
	local existing = parent:FindFirstChildOfClass(className)
	if existing then
		return existing
	end
	return create(className, { Name = name, Parent = parent })
end

-- Dusk with floodlit brightness: ambient stays high so the goal and keeper read clearly.
local function setupLighting()
	Lighting.ClockTime = 17.9
	Lighting.GeographicLatitude = 20
	Lighting.Brightness = 2.4
	Lighting.Ambient = rgb(96, 82, 132)
	Lighting.OutdoorAmbient = rgb(156, 138, 190)
	Lighting.ColorShift_Top = rgb(255, 214, 180)
	Lighting.ColorShift_Bottom = rgb(90, 60, 160)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.ExposureCompensation = 0.2
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3

	local atmosphere = ensureChild(Lighting, "Atmosphere", "Atmosphere")
	atmosphere.Density = 0.24
	atmosphere.Offset = 0.1
	atmosphere.Color = rgb(205, 120, 190)
	atmosphere.Decay = rgb(110, 70, 170)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.6

	local bloom = ensureChild(Lighting, "BloomEffect", "Bloom")
	bloom.Intensity = 0.9
	bloom.Size = 30
	bloom.Threshold = 1.45

	local grading = ensureChild(Lighting, "ColorCorrectionEffect", "ColorCorrection")
	grading.Saturation = 0.2
	grading.Contrast = 0.16
	grading.Brightness = 0.02
	grading.TintColor = rgb(246, 234, 255)

	local rays = ensureChild(Lighting, "SunRaysEffect", "SunRays")
	rays.Intensity = 0.02
	rays.Spread = 0.5
end

function SceneBuilder.build(): Folder
	local old = workspace:FindFirstChild("FootballScene")
	if old then
		old:Destroy()
	end
	clearDefaultTemplate()

	local rng = Random.new(SEED)
	local scene = Instance.new("Folder")
	scene.Name = "FootballScene"
	buildPitch(scene)
	buildMarkings(scene)
	buildGoal(scene)
	buildBoards(scene)
	buildStand(scene, rng)
	buildFloodlights(scene)
	buildSkyline(scene, rng)
	buildSkyBackdrop(scene, rng)
	buildPlayLights(scene)
	scene.Parent = workspace

	setupLighting()
	print(string.format("[SceneBuilder] Stadium built (%d objects)", #scene:GetDescendants()))
	return scene
end

return SceneBuilder
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="17">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CareerService</string>
          <string name="Source"><![CDATA[-- Owns each player's career: loads and saves it (DataStore), validates new careers and settings,
-- and hands the player to EpisodeService for training. The client asks through the CareerRequest
-- RemoteFunction: (action, payload) -> { ok = true, ... } or { ok = false, error = CODE }.
--
-- Actions:
--   GET             -> career?, settings, persistent (false: progress won't survive this session)
--   CREATE          { clubId, firstName, lastName, number, replace } -> career
--   START_TRAINING  -> stage; puts the player into training at the career's saved stage
--   SETTINGS        { shake, bigUi } -> settings
--   DELETE          -> removes the career
--
-- Training progress (career.training: SHOT -> PASS -> DONE) only moves forward, and only when
-- EpisodeService reports a completed task, so the client can't skip it.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CareerConfig = require(Shared:WaitForChild("CareerConfig"))
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))

local STORE_NAME = "NfsCareer_v1"
local DATA_VERSION = 1
local LOAD_ATTEMPTS = 3
local LOAD_WAIT = 15 -- seconds a request waits for the player's save to load
local MIN_REQUEST_INTERVAL = 0.2
local TRAINING_ORDER = { SHOT = 1, PASS = 2, DONE = 3 }

type Career = {
	clubId: string,
	firstName: string,
	lastName: string,
	number: number,
	ovr: number,
	level: number,
	training: string, -- SHOT | PASS | DONE
	createdAt: number,
}
type Settings = { shake: boolean, bigUi: boolean }
type Profile = {
	loaded: boolean,
	persistent: boolean,
	career: Career?,
	settings: Settings,
	lastRequestAt: number,
	busy: boolean,
	saving: boolean,
	dirty: boolean,
}

local CareerService = {}

local profiles: { [Player]: Profile } = {}
local hooks = nil :: { beginTraining: (Player, string) -> (), stopTraining: (Player) -> () }?

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[CareerService] DataStore unavailable, careers last for this session only:", result)
	end
end

local function defaultSettings(): Settings
	return { shake = true, bigUi = false }
end

local function key(player: Player): string
	return "player_" .. player.UserId
end

-- Saved data comes back exactly as stored, but is checked anyway so a bad record can't break
-- the menus or the training.
local function readCareer(data: any): Career?
	if typeof(data) ~= "table" then
		return nil
	end
	local club = CareerConfig.club(data.clubId)
	local first = CareerConfig.cleanName(data.firstName)
	local last = CareerConfig.cleanName(data.lastName)
	if not (club and first and last and CareerConfig.validNumber(data.number) and TRAINING_ORDER[data.training]) then
		return nil
	end
	return {
		clubId = club.id,
		firstName = first,
		lastName = last,
		number = data.number,
		ovr = if typeof(data.ovr) == "number" then data.ovr else CareerConfig.StartOvr,
		level = if typeof(data.level) == "number" then data.level else 1,
		training = data.training,
		createdAt = if typeof(data.createdAt) == "number" then data.createdAt else 0,
	}
end

local function readSettings(data: any): Settings
	local settings = defaultSettings()
	if typeof(data) == "table" then
		if typeof(data.shake) == "boolean" then
			settings.shake = data.shake
		end
		if typeof(data.bigUi) == "boolean" then
			settings.bigUi = data.bigUi
		end
	end
	return settings
end

local function save(player: Player, profile: Profile)
	if not (store and profile.persistent) then
		return
	end
	if profile.saving then
		profile.dirty = true
		return
	end
	profile.saving = true
	repeat
		profile.dirty = false
		local data = { version = DATA_VERSION, career = profile.career, settings = profile.settings }
		local ok, err = pcall(function()
			(store :: DataStore):SetAsync(key(player), data, { player.UserId })
		end)
		if not ok then
			warn(string.format("[CareerService] %s: save failed: %s", player.Name, tostring(err)))
		end
	until not profile.dirty
	profile.saving = false
end

local function queueSave(player: Player, profile: Profile)
	task.spawn(save, player, profile)
end

local function load(player: Player)
	local profile: Profile = {
		loaded = false,
		persistent = false,
		career = nil,
		settings = defaultSettings(),
		lastRequestAt = -math.huge,
		busy = false,
		saving = false,
		dirty = false,
	}
	profiles[player] = profile
	if store then
		for attempt = 1, LOAD_ATTEMPTS do
			local ok, data = pcall(function()
				return (store :: DataStore):GetAsync(key(player))
			end)
			if ok then
				-- Only a successful load may be saved over; otherwise an outage would wipe the career.
				profile.persistent = true
				if typeof(data) == "table" then
					profile.career = readCareer(data.career)
					profile.settings = readSettings(data.settings)
				end
				break
			end
			warn(string.format("[CareerService] %s: load attempt %d failed: %s", player.Name, attempt, tostring(data)))
			if attempt < LOAD_ATTEMPTS then
				task.wait(attempt)
			end
		end
	end
	profile.loaded = true
	print(string.format(
		"[CareerService] %s: profile loaded (%s, %s)",
		player.Name, if profile.career then "career at " .. profile.career.clubId else "no career", if profile.persistent then "saved" else "session only"
	))
end

local function publicCareer(career: Career?)
	if not career then
		return nil
	end
	return table.clone(career)
end

-- Returns the name as other players would see it, or nil and an error code.
local function filterName(player: Player, name: string): (string?, string?)
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		warn(string.format("[CareerService] %s: text filter failed: %s", player.Name, tostring(result)))
		return nil, "FILTER_FAILED"
	end
	if result ~= name then
		return nil, "NAME_FILTERED"
	end
	return result, nil
end

local function createCareer(player: Player, profile: Profile, payload: any)
	if typeof(payload) ~= "table" then
		return { ok = false, error = "BAD_REQUEST" }
	end
	if profile.career and payload.replace ~= true then
		return { ok = false, error = "CAREER_EXISTS" }
	end
	local club = CareerConfig.club(payload.clubId)
	if not club then
		return { ok = false, error = "BAD_REQUEST" }
	end
	if not club.open then
		return { ok = false, error = "CLUB_LOCKED" }
	end
	local first, firstError = CareerConfig.cleanName(payload.firstName)
	if not first then
		return { ok = false, error = "FIRST_" .. tostring(firstError) }
	end
	local last, lastError = CareerConfig.cleanName(payload.lastName)
	if not last then
		return { ok = false, error = "LAST_" .. tostring(lastError) }
	end
	if not CareerConfig.validNumber(payload.number) then
		return { ok = false, error = "BAD_NUMBER" }
	end
	local filteredFirst, filterError = filterName(player, first)
	if not filteredFirst then
		return { ok = false, error = filterError }
	end
	local filteredLast
	filteredLast, filterError = filterName(player, last)
	if not filteredLast then
		return { ok = false, error = filterError }
	end
	if profiles[player] ~= profile then
		return { ok = false, error = "NOT_LOADED" } -- left while the filter was running
	end

	if hooks then
		hooks.stopTraining(player)
	end
	profile.career = {
		clubId = club.id,
		firstName = filteredFirst,
		lastName = filteredLast,
		number = payload.number,
		ovr = CareerConfig.StartOvr,
		level = 1,
		training = if ShotConfig.Training.StartStage == "PASS" then "PASS" else "SHOT",
		createdAt = os.time(),
	}
	queueSave(player, profile)
	print(string.format("[CareerService] %s: new career at %s, #%d", player.Name, club.id, payload.number))
	return { ok = true, career = publicCareer(profile.career) }
end

local function handle(player: Player, profile: Profile, action: string, payload: any)
	if action == "GET" then
		return { ok = true, career = publicCareer(profile.career), settings = table.clone(profile.settings), persistent = profile.persistent }
	elseif action == "CREATE" then
		return createCareer(player, profile, payload)
	elseif action == "START_TRAINING" then
		local career = profile.career
		if not career then
			return { ok = false, error = "NO_CAREER" }
		end
		if career.training == "DONE" then
			return { ok = false, error = "TRAINING_DONE" }
		end
		if hooks then
			hooks.beginTraining(player, career.training)
		end
		return { ok = true, stage = career.training }
	elseif action == "SETTINGS" then
		if typeof(payload) ~= "table" then
			return { ok = false, error = "BAD_REQUEST" }
		end
		profile.settings = readSettings({
			shake = if typeof(payload.shake) == "boolean" then payload.shake else profile.settings.shake,
			bigUi = if typeof(payload.bigUi) == "boolean" then payload.bigUi else profile.settings.bigUi,
		})
		queueSave(player, profile)
		return { ok = true, settings = table.clone(profile.settings) }
	elseif action == "DELETE" then
		if hooks then
			hooks.stopTraining(player)
		end
		profile.career = nil
		queueSave(player, profile)
		return { ok = true }
	end
	return { ok = false, error = "BAD_REQUEST" }
end

local function onInvoke(player: Player, action: any, payload: any)
	local profile = profiles[player]
	local waited = 0
	while profile and not profile.loaded and waited < LOAD_WAIT do
		waited += task.wait(0.1)
		profile = profiles[player]
	end
	if not (profile and profile.loaded) then
		return { ok = false, error = "NOT_LOADED" }
	end
	if typeof(action) ~= "string" then
		return { ok = false, error = "BAD_REQUEST" }
	end
	local now = os.clock()
	if profile.busy or now - profile.lastRequestAt < MIN_REQUEST_INTERVAL then
		return { ok = false, error = "BUSY" }
	end
	profile.lastRequestAt = now
	profile.busy = true
	local ok, result = pcall(handle, player, profile, action, payload)
	profile.busy = false
	if not ok then
		warn(string.format("[CareerService] %s: %s failed: %s", player.Name, action, tostring(result)))
		return { ok = false, error = "SERVER_ERROR" }
	end
	return result
end

-- EpisodeService: the player finished a training task (stage SHOT or PASS).
function CareerService.onStageCompleted(player: Player, stage: string)
	local profile = profiles[player]
	local career = profile and profile.career
	if not (profile and career) then
		return
	end
	local nextStage = if stage == "SHOT" then "PASS" elseif stage == "PASS" then "DONE" else nil
	if nextStage and TRAINING_ORDER[nextStage] > TRAINING_ORDER[career.training] then
		career.training = nextStage
		queueSave(player, profile)
		print(string.format("[CareerService] %s: training stage %s done -> %s", player.Name, stage, nextStage))
	end
end

function CareerService.init(remote: RemoteFunction, trainingHooks)
	if hooks then
		warn("[CareerService] init called twice; ignoring")
		return
	end
	hooks = trainingHooks
	remote.OnServerInvoke = onInvoke
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local profile = profiles[player]
		profiles[player] = nil
		if profile and profile.loaded then
			save(player, profile)
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player, profile in profiles do
			if profile.loaded then
				pending += 1
				task.spawn(function()
					save(player, profile)
					pending -= 1
				end)
			end
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return CareerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">EpisodeService</string>
          <string name="Source"><![CDATA[-- Owns interactive episodes: hands them out, validates client input and sends back results.
-- The client only ever sends its input; it never reports an outcome.
--
-- Training flow, decided here so the client can't skip it:
--   stage SHOT  TUTORIAL (one guided shot that always scores) -> TASK (score Training.TaskGoals)
--   stage PASS  TUTORIAL (one guided pass that always arrives) -> TASK (PassConfig.Training.TaskPasses good passes)
--   After a TASK the phase is DONE and the menu asks for "RETRY" (task again) or "NEXT" (next stage).
--   "NEXT" after the PASS task ends the training: no more episodes, the client goes back to the menu.
--   A good pass is followed by a SHOT episode (mode FOLLOWUP) from where the receiver took the ball;
--   the pass already counted, the shot only adds to `bonusGoals`. The pass's status (TUTORIAL_DONE,
--   CONTINUE, COMPLETED) is reported with the shot's result.
-- Misses never reset task progress. Only players put into training by CareerService (beginTraining)
-- get episodes; each completed task is reported back through hooks.onStageCompleted.
--
-- Input per episode kind (SubmitEpisodeInput):
--   SHOT  (episodeId, aimX -1..1, aimY 0..1, power 0..1)
--   PASS  (episodeId, dirX -1..1, dirZ -1..1, power 0..1, clientTime) - clientTime: seconds since
--         the client showed the episode; sets where the patrolling defender was, within MaxLag.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local PassConfig = require(Shared:WaitForChild("PassConfig"))
local PassPhysics = require(Shared:WaitForChild("PassPhysics"))
local ShotResolver = require(script.Parent.ShotResolver)
local PassResolver = require(script.Parent.PassResolver)

local Training = ShotConfig.Training
local PassTraining = PassConfig.Training
local MAX_LAG = 0.6 -- seconds a pass's clientTime may trail the server clock
local STAGES = { SHOT = true, PASS = true }

type Episode = {
	id: number,
	kind: string, -- SHOT | PASS
	mode: string, -- TUTORIAL | TASK | FOLLOWUP
	seed: number,
	startedAt: number,
	layout: PassPhysics.Layout?,
	followUp: FollowUp?,
}
type FollowUp = {
	spot: Vector3, -- ball position for the shot
	receiver: number, -- teammate index
	phaseMode: string, -- the pass's mode (TUTORIAL | TASK)
	passStatus: string, -- the pass's training status
}
type PlayerState = {
	nextEpisodeId: number,
	active: Episode?,
	lastRemoteAt: number,
	stage: string, -- SHOT | PASS
	phase: string, -- TUTORIAL | TASK | DONE
	shots: number, -- attempts in the current task
	goals: number, -- goals / good passes
	history: { string }, -- outcome of each attempt, most recent last
	bonusGoals: number, -- pass stage: goals scored after good passes in this task attempt
	followUp: FollowUp?, -- a good pass waiting for its shot
}

local EpisodeService = {}

local states: { [Player]: PlayerState } = {}
local nextIds: { [Player]: number } = {} -- episode ids keep counting across training sessions
local seedSource = Random.new()
local remotes
local hooks = nil :: { onStageCompleted: (Player, string) -> () }?

local function resetCounters(state: PlayerState)
	state.shots, state.goals, state.history, state.bonusGoals = 0, 0, {}, 0
end

local function passesRateLimit(state: PlayerState): boolean
	local now = os.clock()
	if now - state.lastRemoteAt < ShotConfig.Episode.MinRemoteInterval then
		return false
	end
	state.lastRemoteAt = now
	return true
end

-- Rejects non-numbers, NaN, infinities and out-of-range values.
local function isNumberInRange(value: any, min: number, max: number): boolean
	if typeof(value) ~= "number" or value ~= value then
		return false
	end
	local tolerance = ShotConfig.Episode.InputTolerance
	return value >= min - tolerance and value <= max + tolerance
end

local function taskGoal(stage: string): number
	return if stage == "PASS" then PassTraining.TaskPasses else Training.TaskGoals
end

local function progress(state: PlayerState)
	return {
		stage = state.stage,
		goals = state.goals,
		shots = state.shots,
		bonusGoals = state.bonusGoals,
		taskGoals = taskGoal(state.stage),
		history = table.clone(state.history),
	}
end

-- Guided aim for a shot from `spot`: the far top corner, as seen from that side of the pitch.
local function guidedAim(spot: Vector3?): (number, number)
	local x = Training.TutorialAim.X
	if spot and spot.X > 0 then
		x = -x
	end
	return x, Training.TutorialAim.Y
end

local function shotHint(spot: Vector3?)
	local aimX, aimY = guidedAim(spot)
	return {
		aimX = aimX,
		aimY = aimY,
		ringRadius = Training.TutorialRingRadius,
		tapRadius = Training.TutorialTapRadius,
		powerMin = Training.GuidedPowerMin,
		powerMax = Training.GuidedPowerMax,
	}
end

local function passHint(layout: PassPhysics.Layout)
	local mate = layout.teammates[PassTraining.TutorialTarget]
	local distance = Vector3.new(mate.X - layout.origin.X, 0, mate.Z - layout.origin.Z).Magnitude
	return {
		start = layout.origin,
		target = mate,
		targetIndex = PassTraining.TutorialTarget,
		ringRadius = PassTraining.RingRadius,
		tapRadius = PassTraining.TapRadius,
		powerMin = PassPhysics.powerForDistance(distance - 6),
		powerMax = PassPhysics.powerForDistance(distance + 8),
	}
end

local function sendEpisode(player: Player, state: PlayerState, episode: Episode)
	local payload = progress(state)
	payload.episodeId = episode.id
	payload.kind = episode.kind
	payload.mode = episode.mode
	payload.layout = episode.layout
	if episode.followUp then
		payload.spot = episode.followUp.spot
		payload.receiver = episode.followUp.receiver
		payload.phaseMode = episode.followUp.phaseMode
	end
	if episode.mode == "TUTORIAL" then
		if episode.kind == "PASS" then
			payload.hint = passHint(episode.layout :: PassPhysics.Layout)
		else
			payload.hint = shotHint(nil)
		end
	elseif episode.followUp and episode.followUp.phaseMode == "TUTORIAL" then
		payload.hint = shotHint(episode.followUp.spot) -- first shot after the guided pass is guided too
	end
	remotes.EpisodeStarted:FireClient(player, payload)
end

-- choice: what the completion menu asked for ("RETRY" or "NEXT"); ignored in other phases.
local function startEpisode(player: Player, state: PlayerState, choice: string?)
	local followUp = state.followUp
	if followUp then
		-- The shot after a good pass comes first, even if that pass completed the task.
		state.followUp = nil
		local episode = {
			id = state.nextEpisodeId,
			kind = "SHOT",
			mode = "FOLLOWUP",
			seed = seedSource:NextInteger(1, 2 ^ 31 - 1),
			startedAt = os.clock(),
			followUp = followUp,
		}
		state.nextEpisodeId += 1
		state.active = episode
		print(string.format(
			"[EpisodeService] %s: episode #%d started (SHOT FOLLOWUP from (%.1f, %.1f), seed %d)",
			player.Name, episode.id, followUp.spot.X, followUp.spot.Z, episode.seed
		))
		sendEpisode(player, state, episode)
		return
	end
	if state.phase == "DONE" then
		if choice == "NEXT" then
			if state.stage ~= "SHOT" then
				return -- the pass task was the last one: training is over
			end
			state.stage = "PASS"
			state.phase = "TUTORIAL"
		else
			state.phase = "TASK"
		end
		resetCounters(state)
	end
	local seed = seedSource:NextInteger(1, 2 ^ 31 - 1)
	local kind = if state.stage == "PASS" then "PASS" else "SHOT"
	local mode = state.phase
	local layout
	if kind == "PASS" then
		-- The situation is picked from the seed too, so (seed, input) reproduces the whole pass.
		local rng = Random.new(seed)
		local index = if mode == "TUTORIAL" then PassTraining.TutorialLayout else rng:NextInteger(2, #PassConfig.Layouts)
		layout = PassPhysics.layout(index, rng:NextNumber() * 2)
	end
	local episode = { id = state.nextEpisodeId, kind = kind, mode = mode, seed = seed, startedAt = os.clock(), layout = layout }
	state.nextEpisodeId += 1
	state.active = episode
	print(string.format(
		"[EpisodeService] %s: episode #%d started (%s %s%s, seed %d)",
		player.Name, episode.id, kind, mode, if layout then ", layout " .. layout.index else "", seed
	))
	sendEpisode(player, state, episode)
end

local function reject(player: Player, episodeId: any, reason: string)
	warn(string.format("[EpisodeService] %s: rejected input for episode %s (%s)", player.Name, tostring(episodeId), reason))
	remotes.EpisodeResult:FireClient(player, {
		episodeId = if typeof(episodeId) == "number" then episodeId else nil,
		rejected = true,
		reason = reason,
	})
end

local function onRequestEpisode(player: Player, choice: any)
	local state = states[player]
	if not state or not passesRateLimit(state) then
		return
	end

	local active = state.active
	if active and os.clock() - active.startedAt <= ShotConfig.Episode.Timeout then
		-- Client lost track of it (e.g. after a rejection): resend instead of issuing a new one.
		sendEpisode(player, state, active)
		return
	end
	startEpisode(player, state, if typeof(choice) == "string" then choice else nil)
end

-- Updates the training progress after an attempt and returns what happens next:
-- TUTORIAL_DONE | TUTORIAL_RETRY | CONTINUE | COMPLETED
local function advance(state: PlayerState, mode: string, success: boolean, outcome: string): string
	if mode == "TUTORIAL" then
		if not success then
			return "TUTORIAL_RETRY" -- should not happen: guided attempts always succeed
		end
		state.phase = "TASK"
		resetCounters(state)
		return "TUTORIAL_DONE"
	end

	state.shots += 1
	if success then
		state.goals += 1
	end
	table.insert(state.history, outcome)
	if state.goals >= taskGoal(state.stage) then
		state.phase = "DONE"
		return "COMPLETED"
	end
	return "CONTINUE"
end

local function resolveShot(active: Episode, aimX: number, aimY: number, power: number)
	local input = {
		aimX = math.clamp(aimX, -1, 1),
		aimY = math.clamp(aimY, 0, 1),
		power = math.clamp(power, 0, 1),
	}
	local stats = { shooting = ShotConfig.DefaultShooting, keeperSkill = Training.TaskKeeperSkill }
	local options
	local followUp = active.followUp
	if followUp then
		-- Training keeper; the first one (after the guided pass) is a sure goal like the guided shot.
		options = { start = followUp.spot, keeperDelay = Training.TaskKeeperDelay }
		if followUp.phaseMode == "TUTORIAL" then
			local guideX, guideY = guidedAim(followUp.spot)
			options.guided = { aimX = guideX, aimY = guideY }
		end
	elseif active.mode == "TUTORIAL" then
		local guideX, guideY = guidedAim(nil)
		options = { guided = { aimX = guideX, aimY = guideY } }
	else
		options = { keeperDelay = Training.TaskKeeperDelay }
	end
	local result = ShotResolver.resolve(input, stats, Random.new(active.seed), options)
	local used = result.input
	local sim = result.sim
	-- The client replays this exact path, so what it shows always matches the outcome.
	local payload = {
		path = sim.path,
		sampleStep = ShotConfig.Physics.SampleStep,
		events = sim.events,
		spin = result.spin,
		held = sim.held,
		decisiveTime = result.decisiveTime,
		keeperTime = sim.keeperTime,
		keeperTarget = result.keeperTarget,
		keeperReaction = result.keeperReaction,
		keeperDives = result.keeperDives,
		keeperKind = sim.keeperKind,
	}
	local summary = string.format("aim=(%.2f, %.2f) power=%.2f", used.aimX, used.aimY, used.power)
	return result.outcome == "GOAL", result.outcome, result.detail, result.speedKmh, payload, summary
end

local function resolvePass(active: Episode, dirX: number, dirZ: number, power: number, clientTime: any)
	if Vector3.new(dirX, 0, dirZ).Magnitude < 0.1 then
		return nil
	end
	-- Where the defender was: the client's clock, but never ahead of ours or more than MAX_LAG behind.
	local elapsed = os.clock() - active.startedAt
	local releaseTime = elapsed - 0.1
	if typeof(clientTime) == "number" and clientTime == clientTime then
		releaseTime = math.clamp(clientTime, math.max(0, elapsed - MAX_LAG), elapsed)
	end
	local input = { dirX = dirX, dirZ = dirZ, power = math.clamp(power, 0, 1) }
	local options = { releaseTime = releaseTime, guided = nil :: { target: number }? }
	if active.mode == "TUTORIAL" then
		options.guided = { target = PassTraining.TutorialTarget }
	end
	local result = PassResolver.resolve(input, active.layout :: PassPhysics.Layout, PassConfig.DefaultPassing, Random.new(active.seed), options)
	local sim = result.sim
	local payload = {
		sampleStep = PassConfig.SampleStep,
		releaseTime = releaseTime,
		ball = sim.ball,
		defender = sim.defender,
		receiver = sim.receiver,
		receiverTrack = sim.receiverTrack,
		eventTime = sim.eventTime,
		endTime = sim.endTime,
	}
	local used = result.input
	local summary = string.format("dir=(%.2f, %.2f) power=%.2f t=%.2f", used.dirX, used.dirZ, used.power, releaseTime)
	return result.outcome == "GOOD", result.outcome, result.detail, result.speedKmh, payload, summary
end

local function onSubmitEpisodeInput(player: Player, episodeId: any, a: any, b: any, power: any, clientTime: any)
	local state = states[player]
	if not state or not passesRateLimit(state) then
		return
	end

	local active = state.active
	if not active or episodeId ~= active.id then
		reject(player, episodeId, "unknown or already finished episode")
		return
	end
	local bMin = if active.kind == "PASS" then -1 else 0
	if not (isNumberInRange(a, -1, 1) and isNumberInRange(b, bMin, 1) and isNumberInRange(power, 0, 1)) then
		reject(player, episodeId, "invalid input values")
		return
	end

	local elapsed = os.clock() - active.startedAt
	if elapsed < ShotConfig.Episode.MinThinkTime then
		reject(player, episodeId, "input too early")
		return
	end
	if elapsed > ShotConfig.Episode.Timeout then
		state.active = nil
		reject(player, episodeId, "episode expired")
		return
	end

	local success, outcome, detail, speedKmh, payload, summary
	if active.kind == "PASS" then
		success, outcome, detail, speedKmh, payload, summary = resolvePass(active, math.clamp(a, -1, 1), math.clamp(b, -1, 1), power, clientTime)
		if success == nil then
			reject(player, episodeId, "invalid input values")
			return
		end
	else
		success, outcome, detail, speedKmh, payload, summary = resolveShot(active, a, b, power)
	end

	-- Consume the episode once it has a result, so it can never produce a second one.
	state.active = nil
	local status
	local followUp = active.followUp
	if followUp then
		status = followUp.passStatus -- the pass already counted
		if success and followUp.phaseMode == "TASK" then
			state.bonusGoals += 1
		end
	else
		status = advance(state, active.mode, success, outcome)
		if status == "COMPLETED" and hooks then
			hooks.onStageCompleted(player, state.stage)
		end
		if active.kind == "PASS" and success and payload.receiver and payload.receiverTrack then
			-- The receiver takes it towards goal and shoots next.
			local meet = payload.receiverTrack[#payload.receiverTrack]
			local toGoal = Vector3.new(-meet.X, 0, -meet.Z).Unit
			local ground = meet + toGoal * PassConfig.Teammate.Reach * 0.7
			state.followUp = {
				spot = Vector3.new(ground.X, ShotConfig.Ball.Radius, ground.Z),
				receiver = payload.receiver,
				phaseMode = active.mode,
				passStatus = status,
			}
			payload.followUp = true
		end
	end
	print(string.format(
		"[EpisodeService] %s: episode #%d %s %s %s -> %s/%s, %d km/h, %s (%d of %d)",
		player.Name, active.id, active.kind, active.mode, summary, outcome, detail, speedKmh,
		status, state.goals, state.shots
	))

	local info = progress(state)
	for key, value in info do
		payload[key] = value
	end
	payload.episodeId = active.id
	payload.kind = active.kind
	payload.mode = active.mode
	payload.status = status
	payload.outcome = outcome
	payload.detail = detail
	payload.speedKmh = speedKmh
	remotes.EpisodeResult:FireClient(player, payload)
end

-- Starts (or restarts) the training at `stage` (SHOT | PASS), from its guided attempt.
function EpisodeService.beginTraining(player: Player, stage: string)
	local old = states[player]
	if old then
		nextIds[player] = old.nextEpisodeId
	end
	states[player] = {
		nextEpisodeId = nextIds[player] or 1,
		active = nil,
		lastRemoteAt = -math.huge,
		stage = if STAGES[stage] then stage else "SHOT",
		phase = "TUTORIAL",
		shots = 0,
		goals = 0,
		history = {},
		bonusGoals = 0,
	}
end

-- Back to the menus: any open episode is dropped and further requests are ignored.
function EpisodeService.stopTraining(player: Player)
	local state = states[player]
	if state then
		nextIds[player] = state.nextEpisodeId
		states[player] = nil
	end
end

-- trainingHooks.onStageCompleted(player, stage) runs when a SHOT or PASS task is completed.
function EpisodeService.init(remoteEvents, trainingHooks)
	if remotes then
		warn("[EpisodeService] init called twice; ignoring")
		return
	end
	remotes = remoteEvents
	hooks = trainingHooks
	remotes.RequestEpisode.OnServerEvent:Connect(onRequestEpisode)
	remotes.SubmitEpisodeInput.OnServerEvent:Connect(onSubmitEpisodeInput)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
		nextIds[player] = nil
	end)
end

return EpisodeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">PassResolver</string>
          <string name="Source"><![CDATA[-- Server-only: turns validated pass input into a simulated pass. Never runs on the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PassConfig = require(Shared:WaitForChild("PassConfig"))
local PassPhysics = require(Shared:WaitForChild("PassPhysics"))

export type PassInput = { dirX: number, dirZ: number, power: number }
-- guided: tutorial pass to teammate `target` that always arrives (no error, no interception).
-- releaseTime: seconds since the episode started when the pass was played (sets the patrol).
export type PassOptions = { guided: { target: number }?, releaseTime: number }
export type PassResult = {
	input: PassInput,
	outcome: string, -- GOOD | INTERCEPTED | MISS (task progress / history)
	detail: string, -- GOOD | INTERCEPTED | TOO_HARD | SHORT | WIDE (what the player sees)
	speedKmh: number,
	sim: PassPhysics.PassSim,
}

local PassResolver = {}

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function gaussian(rng: Random): number
	local u1 = math.max(rng:NextNumber(), 1e-9)
	local u2 = rng:NextNumber()
	return math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
end

function PassResolver.resolve(input: PassInput, layout: PassPhysics.Layout, passing: number, rng: Random, options: PassOptions): PassResult
	local accuracy = PassConfig.Accuracy
	local start = layout.origin
	local dir = Vector3.new(input.dirX, 0, input.dirZ).Unit
	local distance = PassPhysics.distanceForPower(input.power)

	local guided = options.guided
	-- Random parts are always drawn, in the same order, so (seed, input) reproduces a result.
	local skill = math.clamp(passing, 0, 100) / 100
	local cap = accuracy.MaxSigmas
	local angle = math.rad(math.clamp(gaussian(rng), -cap, cap) * lerp(accuracy.AngleAtZeroSkill, accuracy.AngleAtMaxSkill, skill))
	local stretch = 1 + math.clamp(gaussian(rng), -cap, cap) * lerp(accuracy.DistanceAtZeroSkill, accuracy.DistanceAtMaxSkill, skill)
	local reaction = PassConfig.Defender.Reaction + (rng:NextNumber() * 2 - 1) * PassConfig.Defender.ReactionJitter

	if guided then
		local target = layout.teammates[guided.target]
		local toTarget = Vector3.new(target.X - start.X, 0, target.Z - start.Z)
		dir, distance = toTarget.Unit, toTarget.Magnitude
		input = { dirX = dir.X, dirZ = dir.Z, power = PassPhysics.powerForDistance(distance) }
	else
		local c, s = math.cos(angle), math.sin(angle)
		dir = Vector3.new(dir.X * c - dir.Z * s, 0, dir.X * s + dir.Z * c)
		distance *= stretch
	end

	local sim = PassPhysics.simulate(layout, start, dir, distance, options.releaseTime, reaction, guided ~= nil)
	return {
		input = input,
		outcome = sim.outcome,
		detail = sim.detail,
		speedKmh = math.floor(sim.speed + 0.5),
		sim = sim,
	}
end

return PassResolver
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ShotResolver</string>
          <string name="Source"><![CDATA[-- Server-only: turns validated shot input into a fully simulated shot. Never runs on the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local ShotPhysics = require(Shared:WaitForChild("ShotPhysics"))

local Goal = ShotConfig.Goal
local Keeper = ShotConfig.Goalkeeper

export type ShotInput = { aimX: number, aimY: number, power: number }
export type ShotStats = { shooting: number, keeperSkill: number }
-- guided: tutorial shot that always scores. Unsafe aims are moved to (aimX, aimY), power is kept
-- in a comfortable range, there is no scatter and the keeper dives too late.
-- keeperDelay: extra keeper reaction time in seconds (easier keeper for the training task).
-- start: ball position (default: the penalty-area spot); a shot after a pass starts at the receiver.
export type ShotOptions = { guided: { aimX: number, aimY: number }?, keeperDelay: number?, start: Vector3? }
export type ShotResult = {
	input: ShotInput, -- the input actually used (guided shots may move the aim)
	outcome: string, -- "GOAL" | "SAVE" | "POST" | "MISS" (series history / scoring)
	detail: string, -- GOAL | POST_IN | CATCH | PARRY | POST | BAR | WIDE | OVER (what the player sees)
	start: Vector3,
	target: Vector3, -- where the unobstructed flight would cross the goal plane
	velocity: Vector3,
	spin: Vector3,
	speedKmh: number,
	sim: ShotPhysics.SimResult,
	decisiveTime: number, -- moment the result is clear (goal, save, frame or the ball passing the line)
	keeperTarget: Vector3, -- where the keeper's body centre gets to (logic coordinates)
	keeperReaction: number,
	keeperDives: boolean,
}

local ShotResolver = {}

-- Speed readout: the goal is oversized for readability, so use a fixed, believable scale.
local KMH_PER_STUD_PER_SECOND = 1.0

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Standard normal sample (Box-Muller).
local function gaussian(rng: Random): number
	local u1 = math.max(rng:NextNumber(), 1e-9)
	local u2 = rng:NextNumber()
	return math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
end

-- A guided shot keeps the player's aim only where it is a sure goal: well inside the frame
-- and out of the keeper's reach.
function ShotResolver.isSafeGuidedAim(aimX: number, aimY: number): boolean
	local margin = ShotConfig.Training.GuidedSafeMargin
	local point = ShotPhysics.aimToGoalPoint(aimX, aimY)
	local fromKeeper = Vector3.new(point.X - Keeper.HomeX, point.Y - Keeper.HomeY, 0).Magnitude
	return math.abs(point.X) <= Goal.Width / 2 - margin
		and point.Y >= ShotConfig.Ball.Radius + 0.5
		and point.Y <= Goal.Height - margin
		and fromKeeper >= Keeper.Reach + margin
end

function ShotResolver.resolve(input: ShotInput, stats: ShotStats, rng: Random, options: ShotOptions?): ShotResult
	local accuracy = ShotConfig.Accuracy
	local guided = options and options.guided
	if guided then
		local training = ShotConfig.Training
		local aimX, aimY = input.aimX, input.aimY
		if not ShotResolver.isSafeGuidedAim(aimX, aimY) then
			aimX, aimY = guided.aimX, guided.aimY
		end
		input = { aimX = aimX, aimY = aimY, power = math.clamp(input.power, training.GuidedPowerMin, training.GuidedPowerMax) }
	end

	-- 1. Inaccuracy: better shooters scatter less; overpowered shots scatter more and rise.
	local skill = math.clamp(stats.shooting, 0, 100) / 100
	local overpower = math.max(0, (input.power - accuracy.OverpowerFrom) / (1 - accuracy.OverpowerFrom))
	local sigma = lerp(accuracy.ScatterAtZeroSkill, accuracy.ScatterAtMaxSkill, skill)
		+ overpower * accuracy.OverpowerScatter
	local cap = accuracy.MaxSigmas
	local offsetX = math.clamp(gaussian(rng), -cap, cap) * sigma
	local offsetY = math.clamp(gaussian(rng), -cap, cap) * sigma + overpower * accuracy.OverpowerLift
	if guided then
		offsetX, offsetY = 0, 0
	end

	local intended = ShotPhysics.aimToGoalPoint(input.aimX, input.aimY)
	local target = Vector3.new(intended.X + offsetX, math.max(ShotConfig.Ball.Radius, intended.Y + offsetY), 0)

	-- 2. Spin and the launch velocity that flies (with drag and curl) to the target.
	local jitter = ShotConfig.Physics.SpinJitter
	local jitterX, jitterY = (rng:NextNumber() * 2 - 1) * jitter, (rng:NextNumber() * 2 - 1) * jitter
	if guided then
		jitterX, jitterY = 0, 0
	end
	local spin = ShotPhysics.spinFor(input.aimX, input.power, jitterX, jitterY)
	local start = (options and options.start) or ShotPhysics.ballSpot()
	local velocity = ShotPhysics.solveLaunch(start, target, input.power, spin)

	-- 3. Goalkeeper: reacts after a short delay, then moves at a skill-based speed. He only
	-- dives for shots heading for the frame; when the ball reaches him he catches or parries.
	local reaction = Keeper.ReactionTime + (rng:NextNumber() * 2 - 1) * Keeper.ReactionJitter
	if guided then
		reaction += ShotConfig.Training.GuidedKeeperDelay
		-- From further out the ball is in the air longer; he is late by the same margin anyway.
		local extra = (target - start).Magnitude - (ShotPhysics.aimToGoalPoint(input.aimX, input.aimY) - ShotPhysics.ballSpot()).Magnitude
		reaction += math.max(0, extra) / ShotPhysics.ballSpeed(input.power)
	elseif options and options.keeperDelay then
		reaction += options.keeperDelay
	end
	local diveSpeed = lerp(Keeper.DiveSpeedAtZeroSkill, Keeper.DiveSpeedAtMaxSkill, math.clamp(stats.keeperSkill, 0, 100) / 100)
	local zone = ShotPhysics.classify(target)
	local keeperDives = Keeper.Enabled
		and (zone ~= ShotPhysics.Zone.Wide or (math.abs(target.X) < Goal.Width / 2 + 2.5 and target.Y < Goal.Height + 2.5))
	local home = Vector3.new(Keeper.HomeX, Keeper.HomeY, 0)
	local keeperTarget = home

	local function keeperResponse(t: number, at: Vector3, vel: Vector3)
		if not Keeper.Enabled then
			return nil
		end
		local toBall = Vector3.new(at.X, at.Y, 0) - home
		local distance = toBall.Magnitude
		local direction = if distance > 1e-3 then toBall / distance else Vector3.zero
		local canTravel = diveSpeed * math.max(0, t - reaction)
		local mustTravel = math.max(0, distance - Keeper.Reach)
		if not keeperDives then
			keeperTarget = home + direction * math.min(canTravel, 1.5) -- a step towards it, then watches it go
			return nil
		end
		keeperTarget = home + direction * math.min(canTravel, mustTravel)
		if canTravel < mustTravel then
			return nil -- beaten
		end

		local speed = vel.Magnitude
		local atBody = distance < Keeper.Reach * 0.7 and speed <= Keeper.CatchMaxSpeed * 1.3
		local comfortable = canTravel - mustTravel >= Keeper.CatchMargin and speed <= Keeper.CatchMaxSpeed
		if atBody or comfortable then
			return { kind = "CATCH" }
		end
		-- Parry: tip high balls over the bar, push the rest wide and back out.
		local side = math.sign(at.X - Keeper.HomeX)
		if side == 0 then
			side = if rng:NextNumber() < 0.5 then -1 else 1
		end
		local parried
		if at.Y > Goal.Height - 2.5 and math.abs(at.X) < Goal.Width / 2 - 3 then
			parried = Vector3.new(vel.X * 0.2 + (rng:NextNumber() * 2 - 1) * 3, 16 + rng:NextNumber() * 6, vel.Z * 0.12)
		else
			parried = Vector3.new(side * (10 + rng:NextNumber() * 8), 5 + rng:NextNumber() * 7, 2 - vel.Z * 0.18)
		end
		return { kind = "PARRY", velocity = parried }
	end

	local sim = ShotPhysics.simulate(start, velocity, spin, Keeper.HomeZ, keeperResponse)

	-- 4. Outcome from what actually happened in the simulation.
	local outcome, detail, decisiveTime
	if sim.keeperKind == "CATCH" then
		outcome, detail, decisiveTime = "SAVE", "CATCH", sim.keeperTime
	elseif sim.goalTime then
		outcome, decisiveTime = "GOAL", sim.goalTime
		detail = if sim.frameTime and sim.frameTime < sim.goalTime then "POST_IN" else "GOAL"
	elseif sim.keeperKind == "PARRY" then
		outcome, detail, decisiveTime = "SAVE", "PARRY", sim.keeperTime
	elseif sim.frameTime then
		outcome, decisiveTime = "POST", sim.frameTime
		detail = if sim.framePart == "Crossbar" then "BAR" else "POST"
	else
		outcome = "MISS"
		local cross = sim.crossPoint or target
		detail = if cross.Y > Goal.Height + Goal.PostRadius and math.abs(cross.X) < Goal.Width / 2 + 2 then "OVER" else "WIDE"
		decisiveTime = sim.crossTime or sim.duration
	end

	return {
		input = input,
		outcome = outcome,
		detail = detail,
		start = start,
		target = target,
		velocity = velocity,
		spin = spin,
		speedKmh = math.floor(velocity.Magnitude * KMH_PER_STUD_PER_SECOND + 0.5),
		sim = sim,
		decisiveTime = decisiveTime,
		keeperTarget = keeperTarget,
		keeperReaction = reaction,
		keeperDives = keeperDives,
	}
end

return ShotResolver
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="24">
        <Properties>
          <string name="Name">ShotClient</string>
          <string name="Source"><![CDATA[-- Client entry point: the career menus first (CareerMenu), then the shot and pass training, which
-- wires input, both drills' 3D visuals, the HUD and the finger hint to the server remotes. The
-- client sends only its input; the server decides outcomes and the training flow (shot: guided ->
-- task, pass: guided -> task). After the pass task the player goes back to the career menu.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ShotConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShotConfig"))
local CareerConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CareerConfig"))
local InputController = require(script:WaitForChild("InputController"))
local ShotVisuals = require(script:WaitForChild("ShotVisuals"))
local ShotHud = require(script:WaitForChild("ShotHud"))
local ImageLoader = require(script:WaitForChild("ImageLoader"))
local TutorialHint = require(script:WaitForChild("TutorialHint"))
local PassVisuals = require(script:WaitForChild("PassVisuals"))
local CareerMenu = require(script:WaitForChild("CareerMenu"))

local CARD_DELAY = 0.55 -- let the player see the ball hit the net before the card covers the goal
local FOLLOW_UP_DELAY = 0.75 -- after a good pass: the receiver controls it, then the shot camera

local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
if not Remotes then
	warn("[ShotClient] Still waiting for ReplicatedStorage.Remotes. The server script (Main) has not started; check Output for red [Main] errors.")
	Remotes = ReplicatedStorage:WaitForChild("Remotes")
end
local RequestEpisode = Remotes:WaitForChild("RequestEpisode")
local EpisodeStarted = Remotes:WaitForChild("EpisodeStarted")
local SubmitEpisodeInput = Remotes:WaitForChild("SubmitEpisodeInput")
local EpisodeResult = Remotes:WaitForChild("EpisodeResult")
local CareerRequest = Remotes:WaitForChild("CareerRequest")

-- Default movement controls are useless here and would cover the screen on phones.
task.spawn(function()
	local playerModule = Players.LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)
	if playerModule then
		local ok, err = pcall(function()
			require(playerModule):GetControls():Disable()
		end)
		if not ok then
			warn("[ShotClient] Could not disable default controls:", err)
		end
	end
end)

local hud = ShotHud.new()
hud:setVisible(false) -- the career menu comes first
ImageLoader.watch() -- stadium banners, keeper kit and players' faces
local visuals = ShotVisuals.new()
visuals:setActive(false) -- the menu owns the camera until the training starts
local passVisuals = PassVisuals.new()
local input = InputController.new()
local hint = TutorialHint.new()
local currentEpisode = nil
local currentScene = nil -- SHOT | PASS | FOLLOWUP (the shot after a good pass); nil in the menus
local SCENE_BLEND = 0.9 -- camera glide between scenes; input waits for it
local waitingForEpisode = false
local bestSpeed = 0 -- fastest goal in the current task attempt, for the completion menu
local inTraining = false
local lastCompletedStage = nil -- stage of the last completed task (SHOT | PASS)

-- choice: "RETRY" or "NEXT" from the completion menu, otherwise nil.
local function requestEpisode(choice: string?)
	if not inTraining then
		return
	end
	waitingForEpisode = true
	RequestEpisode:FireServer(choice)
end

local function continueWith(choice: string?)
	if waitingForEpisode then
		return
	end
	hud:hideCard()
	requestEpisode(choice)
end

hud.onContinue = function()
	continueWith(nil)
end
hud.onRetry = function()
	continueWith("RETRY")
end

-- Goals panel: one pip per goal / good pass still needed in the task.
local function showProgress(info)
	local done = {}
	for _ = 1, info.goals do
		table.insert(done, if info.stage == "PASS" then "GOOD" else "GOAL")
	end
	hud:setSeries(info.goals, info.taskGoals, done)
end

-- Switches the 3D scene: SHOT (shot drill), PASS (pass drill), FOLLOWUP (pass drill's players,
-- shot drill's camera and ball), nil (menus: both drills put away). Returns whether the camera moves.
local function setScene(scene: string?): boolean
	if scene == currentScene then
		return false
	end
	currentScene = scene
	if scene == nil then
		visuals:setActive(false)
		passVisuals:exit()
	elseif scene == "PASS" then
		visuals:setActive(false)
		passVisuals:enter()
	elseif scene == "FOLLOWUP" then
		visuals:setActive(true) -- passVisuals stays, its players are on the pitch
	else
		passVisuals:exit()
		visuals:setActive(true)
	end
	return true
end

input.onShoot = function(a, b, power)
	local episode = currentEpisode
	if not episode then
		return
	end
	input:setEnabled(false)
	hint:hide()
	hud:setPowerZone(nil)
	if episode.kind == "PASS" then
		passVisuals:onPassReleased()
		hud:setTitle("PassFlying")
		SubmitEpisodeInput:FireServer(episode.episodeId, a, b, power, passVisuals:clockTime())
	else
		if episode.mode == "FOLLOWUP" then
			passVisuals:followUpKick()
		end
		visuals:onShotReleased()
		hud:setTitle("Flying")
		SubmitEpisodeInput:FireServer(episode.episodeId, a, b, power)
	end
end

EpisodeStarted.OnClientEvent:Connect(function(episode)
	if not inTraining or typeof(episode) ~= "table" or (episode.kind ~= "SHOT" and episode.kind ~= "PASS") then
		return
	end
	waitingForEpisode = false
	currentEpisode = episode
	input:setEnabled(false)
	local pass = episode.kind == "PASS"
	local followUp = episode.mode == "FOLLOWUP"
	local moved = setScene(if pass then "PASS" elseif followUp then "FOLLOWUP" else "SHOT")
	if pass then
		passVisuals:reset(episode.layout)
		input:setMode("PASS", episode.layout.origin)
	elseif followUp then
		visuals:reset(episode.spot)
		passVisuals:beginFollowUp(episode.receiver, episode.spot, ShotVisuals.cameraPosition(episode.spot))
		input:setMode("SHOT")
		moved = true
	else
		visuals:reset()
		input:setMode("SHOT")
	end
	hud:hideCard()
	hud:setPower(0)
	showProgress(episode)
	hud:setMode(episode.stage, if followUp then episode.phaseMode else episode.mode, episode.taskGoals, episode.kind)
	if episode.shots == 0 and not followUp then
		bestSpeed = 0
	end

	local guide = episode.hint -- only sent for guided attempts
	if guide then
		hint:show(episode.kind, guide)
		hud:setPowerZone(guide.powerMin, guide.powerMax)
		input:setGuide({
			aimX = if pass then nil else guide.aimX,
			aimY = if pass then nil else guide.aimY,
			accepts = function(aimX, aimY)
				return hint:accepts(aimX, aimY)
			end,
			acceptsTarget = function(target)
				return hint:acceptsTarget(target)
			end,
			onRejected = function()
				hint:nudge()
			end,
		})
		passVisuals:setHighlight(if pass then guide.targetIndex else nil)
	else
		hint:hide()
		hud:setPowerZone(nil)
		input:setGuide(nil)
		passVisuals:setHighlight(nil)
	end
	hud:setTitle(if pass then (if guide then "PassTutorialReady" else "PassReady") elseif guide then "TutorialReady" elseif followUp then "FollowUpReady" else "Ready")

	task.delay(if moved then math.max(SCENE_BLEND, ShotConfig.Input.ReadyDelay) else ShotConfig.Input.ReadyDelay, function()
		if currentEpisode == episode then
			input:setEnabled(true)
		end
	end)
end)

-- What the card says after each attempt, by the server's training status. In the pass stage the
-- card comes after the shot that follows a good pass, or straight after a failed pass.
local function showOutcome(result)
	local status = result.status
	local passStage = result.stage == "PASS"
	local key = if result.kind == "PASS" then "PASS_" .. result.detail else result.detail
	local speed = result.speedKmh
	if status == "COMPLETED" then
		lastCompletedStage = result.stage
		hud:showComplete({ kind = result.stage, goals = result.goals, shots = result.shots, bestSpeed = bestSpeed, bonusGoals = result.bonusGoals })
	elseif status == "TUTORIAL_DONE" then
		hud:showResult(key, {
			subtitle = string.format(if passStage then hud.text.PassTutorialDone else hud.text.TutorialDone, result.taskGoals),
			button = hud.text.ToTask,
			speedKmh = speed,
		})
	elseif status == "TUTORIAL_RETRY" then
		hud:showResult(key, { subtitle = hud.text.TutorialRetry, speedKmh = speed })
	else
		local left = result.taskGoals - result.goals
		local subtitle = nil
		if result.mode == "FOLLOWUP" then
			subtitle = string.format(if result.outcome == "GOAL" then hud.text.FollowUpGoal else hud.text.FollowUpMiss, left)
		elseif result.mode == "TASK" and result.stage == "SHOT" and result.outcome == "GOAL" then
			subtitle = string.format(hud.text.TaskLeft, left)
		end
		hud:showResult(key, { subtitle = subtitle, speedKmh = speed })
	end
end

EpisodeResult.OnClientEvent:Connect(function(result)
	if result.rejected then
		warn("[ShotClient] Server rejected the input:", result.reason)
		currentEpisode = nil
		input:setEnabled(false)
		task.delay(0.5, requestEpisode) -- the server resends the open episode or starts a new one
		return
	end
	if not currentEpisode or result.episodeId ~= currentEpisode.episodeId then
		return
	end
	currentEpisode = nil
	local pass = result.kind == "PASS"
	if not pass and result.mode == "TASK" and result.outcome == "GOAL" then
		bestSpeed = math.max(bestSpeed, result.speedKmh or 0)
	end

	local function onDecisive()
		if result.mode == "FOLLOWUP" and result.outcome == "GOAL" then
			passVisuals:celebrateGoal()
		end
		if result.mode == "TASK" then
			showProgress(result)
			if result.outcome == (if pass then "GOOD" else "GOAL") then
				hud:bumpGoals()
			end
		end
		if result.followUp then
			-- Good pass: no card, the receiver shoots next.
			hud:setTitle("PassReceived")
			task.delay(FOLLOW_UP_DELAY, function()
				if not currentEpisode and not waitingForEpisode then
					requestEpisode()
				end
			end)
			return
		end
		hud:setTitle(if pass then "PassAfter" else "AfterShot")
		task.delay(CARD_DELAY, function()
			if not currentEpisode and not waitingForEpisode then
				showOutcome(result)
			end
		end)
	end
	if pass then
		passVisuals:playPass(result, onDecisive)
	else
		visuals:playShot(result, onDecisive)
	end
end)

-- Career menu: main menu -> club -> player -> training. It owns the camera while open.
local menu = CareerMenu.new(CareerRequest)
menu.onSettingsChanged = function(settings)
	visuals:setShakeEnabled(settings.shake)
	hud:setUiBoost(if settings.bigUi then 1.15 else 1)
end
menu.onStartTraining = function(career)
	local club = CareerConfig.club(career.clubId)
	if club then
		passVisuals:setTeamKit(CareerConfig.kit(club), career.number)
	end
	inTraining = true
	lastCompletedStage = nil
	bestSpeed = 0
	hud:setVisible(true)
	requestEpisode()
end

-- After the pass task: put the drills away and go back to the career menu.
local function leaveTraining()
	inTraining = false
	currentEpisode = nil
	waitingForEpisode = false
	input:setEnabled(false)
	hint:hide()
	hud:hideCard()
	hud:setPowerZone(nil)
	hud:setVisible(false)
	setScene(nil)
	menu:open(true)
end

hud.onNext = function()
	if lastCompletedStage == "PASS" then
		leaveTraining()
	else
		continueWith("NEXT")
	end
end

-- Space / Enter / gamepad A press the card button.
UserInputService.InputBegan:Connect(function(inputObject, gameProcessed)
	if gameProcessed or not hud:isCardVisible() then
		return
	end
	local key = inputObject.KeyCode
	if key == Enum.KeyCode.Space or key == Enum.KeyCode.Return or key == Enum.KeyCode.ButtonA then
		hud:pressContinue()
	end
end)

local wasHolding = false
RunService.RenderStepped:Connect(function(dt)
	menu:update(dt) -- camera, blur and the player preview while the menu is open
	local pass = currentScene == "PASS"
	visuals:update(dt) -- keeper (and the camera while the shot drill is active)
	passVisuals:update(dt)
	input:update()
	if input.enabled then
		local guided = hint:isActive()
		local demoPower = hint:update(dt, input.holding, input.power, hud.scale, input.target)
		if pass then
			passVisuals:updateAiming(true, input.target, input.power, input.holding)
		else
			visuals:updateAiming(true, input.aimX, input.aimY, input.power, input.holding)
		end
		hud:setPower(if input.holding or not demoPower then (if input.holding then input.power else 0) else demoPower)
		local prefix = if pass then "Pass" else ""
		if guided then
			hud:setTitle(prefix .. (if input.holding then "TutorialHolding" else "TutorialReady"))
		else
			hud:setTitle(if pass then (if input.holding then "PassHolding" else "PassReady") else (if input.holding then "Holding" else "Ready"))
		end
	end
	-- The keeper gets set (hop + lower stance) while the player charges a shot.
	local holding = input.enabled and input.holding and not pass
	if holding ~= wasHolding then
		wasHolding = holding
		visuals:setCharging(holding)
	end
end)

print("[ShotClient] ready")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">CareerMenu</string>
            <string name="Source"><![CDATA[-- Career menus, shown before any training: main menu (new career / continue / settings), the
-- league's club picker (3 of 8 clubs open), player creation with the 3D preview in the club's kit,
-- the signed-contract card that leads to training, and the "next match" card after training.
-- The 3D stadium stays behind every screen; this module owns the camera while it is open.
--
-- Server calls go through the CareerRequest RemoteFunction (see CareerService); the server
-- validates and filters everything, the checks here only give instant feedback.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CareerConfig = require(Shared:WaitForChild("CareerConfig"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local ImageLoader = require(script.Parent:WaitForChild("ImageLoader"))
local PlayerPreview = require(script.Parent:WaitForChild("PlayerPreview"))

local create, frame, text, corner, stroke, outline = UiKit.create, UiKit.frame, UiKit.text, UiKit.corner, UiKit.stroke, UiKit.outline
local NAVY, VIOLET, GLOW, LILAC, GOLD, LIME, RED, RED_LIGHT = UiKit.NAVY, UiKit.VIOLET, UiKit.GLOW, UiKit.LILAC, UiKit.GOLD, UiKit.LIME, UiKit.RED, UiKit.RED_LIGHT
local INK, CREAM, WHITE = UiKit.INK, UiKit.CREAM, UiKit.WHITE
local FONT_BOLD, FONT_MEDIUM = UiKit.FONT_BOLD, UiKit.FONT_MEDIUM

-- All player-facing text in one place.
local TEXT = {
	Tagline = 'КАРЬЕРА ФУТБОЛИСТА  •  <font color="#FFBF1F">ОТ НОВИЧКА ДО ЗВЕЗДЫ</font>',
	NewCareer = "НОВАЯ КАРЬЕРА",
	NewCareerSub = "Выбери клуб и создай игрока",
	Continue = "ПРОДОЛЖИТЬ КАРЬЕРУ",
	ContinueNone = "Нет сохранённой карьеры",
	ContinueSub = "%s  ·  №%d %s",
	Settings = "НАСТРОЙКИ",
	Loading = "Загрузка профиля…",
	SessionOnly = "Сохранения недоступны: прогресс останется только до выхода",
	LoadFailed = "Нет связи с сервером. Попробуй перезайти",
	CardLine = "№%d %s  ·  OVR %d  ·  УР. %d",
	CardNext = {
		SHOT = "Далее: тренировка — удар",
		PASS = "Далее: тренировка — пас",
		DONE = "Далее: первый матч сезона (скоро)",
	},
	CardEmptyTitle = "ТВОЙ ПУТЬ К ЗВЁЗДАМ",
	CardEmptyLine = "8 клубов лиги · 3 ждут новичков",
	CardEmptyNext = "Начни карьеру и подпиши контракт",
	-- Club picker
	ClubsTitle = "ВЫБЕРИ КЛУБ",
	League = "🏆 %s  ·  %d КЛУБОВ",
	ClubsInfo = "Твой рейтинг — %d. Пока контракт предлагают только %d клуба из %d. Расти — и топ-клубы заметят тебя!",
	ClubOpen = "ДОСТУПЕН",
	ClubPicked = "✓ ВЫБРАН",
	ClubLocked = "🔒 OVR %d+",
	ClubLockedHint = "%s пока не смотрит в твою сторону. Нужен рейтинг %d+",
	ClubPickHint = "Выбери один из доступных клубов",
	ClubChosenHint = "%s ждёт тебя!",
	Ovr = "OVR %d",
	Back = "‹  НАЗАД",
	Next = "ДАЛЕЕ  ›",
	-- Player creation
	PlayerTitle = "ТВОЙ ИГРОК",
	FirstName = "ИМЯ",
	LastName = "ФАМИЛИЯ",
	Number = "НОМЕР НА ФУТБОЛКЕ",
	FirstPlaceholder = "Например, Алекс",
	LastPlaceholder = "Например, Иванов",
	Confirm = "ПОДТВЕРДИТЬ  ›",
	Saving = "СОХРАНЯЕМ…",
	-- Signed contract
	SignedTitle = "КОНТРАКТ\nПОДПИСАН!",
	SignedPlayer = "%s %s  ·  №%d",
	SignedInfo = "Перед первым матчем — короткая тренировка: удар и пас.",
	Level = "УРОВЕНЬ %d",
	ToTraining = "НА ТРЕНИРОВКУ  ›",
	-- After training / career with training done
	TrainedTitle = "ОБУЧЕНИЕ\nПРОЙДЕНО!",
	CareerTitle = "ТВОЯ\nКАРЬЕРА",
	CareerLine = "%s %s  ·  №%d  ·  %s",
	FirstMatch = "ПЕРВЫЙ МАТЧ СЕЗОНА",
	Soon = "⏳  СКОРО: матчи появятся в следующем обновлении",
	ToMenu = "В ГЛАВНОЕ МЕНЮ",
	-- Settings and confirmations
	SettingsTitle = "НАСТРОЙКИ",
	Shake = "Тряска камеры при ударе",
	BigUi = "Крупный интерфейс",
	DeleteCareer = "УДАЛИТЬ КАРЬЕРУ",
	Done = "ГОТОВО",
	ReplaceTitle = "НОВАЯ КАРЬЕРА?",
	ReplaceBody = "Текущая карьера (%s, №%d %s) будет удалена, когда ты подпишешь новый контракт.",
	ReplaceYes = "НАЧАТЬ",
	DeleteTitle = "УДАЛИТЬ КАРЬЕРУ?",
	DeleteBody = "Карьеру в %s нельзя будет вернуть.",
	DeleteYes = "УДАЛИТЬ",
	Cancel = "ОТМЕНА",
	Errors = {
		FIRST_EMPTY = "Введи имя",
		FIRST_TOO_SHORT = "Имя слишком короткое",
		FIRST_TOO_LONG = "Имя — не длиннее %d символов",
		FIRST_BAD_CHARS = "В имени можно только буквы, пробел и дефис",
		LAST_EMPTY = "Введи фамилию — она будет на футболке",
		LAST_TOO_SHORT = "Фамилия слишком короткая",
		LAST_TOO_LONG = "Фамилия — не длиннее %d символов",
		LAST_BAD_CHARS = "В фамилии можно только буквы, пробел и дефис",
		BAD_NUMBER = "Номер — от 1 до 99",
		NAME_FILTERED = "Такое имя использовать нельзя. Попробуй другое",
		FILTER_FAILED = "Не удалось проверить имя. Попробуй ещё раз",
		CLUB_LOCKED = "Этот клуб пока закрыт",
		CAREER_EXISTS = "Карьера уже есть. Начни новую из главного меню",
		BUSY = "Секунду…",
		NOT_LOADED = "Профиль ещё загружается…",
		NETWORK = "Нет связи с сервером",
		Other = "Что-то пошло не так (%s)",
	},
}

local LAYOUT_SIZE = Vector2.new(920, 456) -- the biggest screen (club picker) must fit on phones
local SCREEN_SIZE = Vector2.new(900, 436)
local CARD_SIZE = Vector2.new(216, 142)
local CARD_GAP = 12
local CARD_TOP = 84

-- Camera over the training stadium (the goal is at z = 0, see ShotConfig); CREATE frames the
-- player (PlayerPreview).
local MENU_CAMERA = { from = Vector3.new(0, 9, 92), to = Vector3.new(0, 5.5, 0), fov = 36 }
local CLUBS_CAMERA = { from = Vector3.new(6, 8, 86), to = Vector3.new(0, 5.5, 0), fov = 36 }
-- The creation screen keeps the player sharp and softens the stadium with depth of field instead.
local BLUR = { MENU = 6, CREATE = 0, CLUBS = 16, NEXT = 12 }
local DEPTH = { CREATE = true }
-- Screen shade: darker behind the panels. The main menu shades both sides and keeps the middle open.
local SHADE_LEFT = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.12),
	NumberSequenceKeypoint.new(0.45, 0.55),
	NumberSequenceKeypoint.new(1, 0.85),
})
local SHADE_SIDES = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.35),
	NumberSequenceKeypoint.new(0.3, 0.95),
	NumberSequenceKeypoint.new(0.6, 0.95),
	NumberSequenceKeypoint.new(1, 0.3),
})

local CareerMenu = {}
CareerMenu.__index = CareerMenu

local function errorText(code: string?): string
	local message = TEXT.Errors[code or "NETWORK"]
	if not message then
		return string.format(TEXT.Errors.Other, tostring(code))
	end
	if string.find(message, "%%d") then
		return string.format(message, CareerConfig.Name.MaxLength)
	end
	return message
end

-- Keeps a TextBox to `max` characters (UTF-8 aware).
local function limitLength(box: TextBox, max: number)
	local value = box.Text
	local length = utf8.len(value)
	if length and length > max then
		box.Text = string.sub(value, 1, (utf8.offset(value, max + 1) or (#value + 1)) - 1)
	end
end

function CareerMenu.new(remote: RemoteFunction)
	local self = setmetatable({}, CareerMenu)
	self.remote = remote
	self.career = nil
	self.settings = { shake = true, bigUi = false }
	self.persistent = true
	self.loaded = false
	self.active = true
	self.busy = false
	self.replace = false
	self.selectedClub = nil
	self.onStartTraining = nil :: ((any) -> ())?
	self.onSettingsChanged = nil :: ((any) -> ())?
	self.cameraMode = "MENU"
	self.clock = 0
	self.preview = PlayerPreview.new()

	local gui = UiKit.screenGui("CareerMenu", 5)
	self.gui = gui
	self.scaler = UiKit.scaler(gui, LAYOUT_SIZE)

	-- Darker on the left where the menus sit; the stadium shows through on the right.
	local shade = frame({ Name = "Shade", Position = UDim2.fromOffset(-200, -120), Size = UDim2.new(1, 400, 1, 240), BackgroundColor3 = INK, Parent = gui })
	self.shadeGradient = create("UIGradient", { Transparency = SHADE_LEFT, Parent = shade })
	self.shade = shade

	self.screens = {}
	self:_buildMain()
	self:_buildClubs()
	self:_buildPlayer()
	self:_buildNextMatch()
	self:_buildOverlay()

	local camera = workspace.CurrentCamera
	self.blur = create("BlurEffect", { Name = "MenuBlur", Size = 0, Parent = camera })
	self.depth = create("DepthOfFieldEffect", {
		Name = "MenuDepth",
		FarIntensity = 0.45,
		NearIntensity = 0,
		FocusDistance = 16,
		InFocusRadius = 6,
		Parent = camera,
	})
	self.camCFrame, self.camFov = CFrame.lookAt(MENU_CAMERA.from, MENU_CAMERA.to), MENU_CAMERA.fov

	self:_show("MAIN")
	task.spawn(function()
		self:_load()
	end)
	return self
end

function CareerMenu:_request(action: string, payload: any?): { [string]: any }
	local ok, result = pcall(function()
		return self.remote:InvokeServer(action, payload)
	end)
	if not ok or typeof(result) ~= "table" then
		warn("[CareerMenu]", action, "failed:", if ok then "bad reply" else result)
		return { ok = false, error = "NETWORK" }
	end
	return result
end

-- Every screen: a full-size root, a centred holder at viewport scale and a nested pop scale.
function CareerMenu:_screen(name: string, size: Vector2, anchor: Vector2?, position: UDim2?)
	local root = frame({ Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = self.gui })
	local holder = frame({
		Name = "Holder",
		AnchorPoint = anchor or Vector2.new(0.5, 0.5),
		Position = position or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundTransparency = 1,
		Parent = root,
	})
	self.scaler:add(holder)
	local content = frame({ Name = "Content", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = holder })
	local pop = create("UIScale", { Parent = content })
	local screen = { root = root, content = content, pop = pop }
	self.screens[name] = screen
	return screen
end

---------------------------------------------------------------- main menu

-- Spread over the screen: logo top left, buttons on the right, career card bottom left, the
-- stadium in between.
function CareerMenu:_buildMain()
	local root = frame({ Name = "MAIN", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = self.gui })
	local function group(name: string, anchor: Vector2, position: UDim2, size: Vector2): Frame
		local holder = frame({ Name = name, AnchorPoint = anchor, Position = position, Size = UDim2.fromOffset(size.X, size.Y), BackgroundTransparency = 1, Parent = root })
		self.scaler:add(holder)
		return holder
	end

	-- Logo and tagline
	local top = group("Brand", Vector2.new(0, 0), UDim2.fromOffset(16, 4), Vector2.new(330, 172))
	local logo = frame({ Name = "Logo", Size = UDim2.fromOffset(330, 136), BackgroundTransparency = 1, Parent = top })
	local embedded = ImageLoader.get("Logo/Logo")
	if embedded then
		create("ImageLabel", { Name = "LogoImage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ImageContent = embedded, ScaleType = Enum.ScaleType.Fit, Parent = logo })
	else
		UiKit.bigText({ Name = "Wordmark", Text = 'NEW FOOTBALL <font color="#FF2D55">STAR</font> <font color="#FFBF1F">★</font>', TextSize = 36, Position = UDim2.fromOffset(4, 44), Size = UDim2.fromOffset(322, 48), Parent = logo }, 3.5, Vector2.new(3, 4))
	end
	local tagline = frame({ Name = "Tagline", Position = UDim2.fromOffset(10, 140), Size = UDim2.fromOffset(310, 26), BackgroundColor3 = NAVY, BackgroundTransparency = 0.1, Parent = top })
	corner(tagline, 6)
	stroke(tagline, VIOLET, 2)
	local accent = frame({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0), Size = UDim2.fromOffset(5, 12), BackgroundColor3 = RED, Parent = tagline })
	corner(accent, 1)
	local taglineText = text({ Position = UDim2.fromOffset(20, 2), Size = UDim2.new(1, -26, 1, -4), Text = TEXT.Tagline, TextSize = 11, Parent = tagline })
	UiKit.sizeLimit(taglineText, 11)
	outline(taglineText, 1.2)

	-- Buttons
	local right = group("Buttons", Vector2.new(1, 0.5), UDim2.new(1, -24, 0.5, 0), Vector2.new(290, 236))
	local c = frame({ Name = "Content", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = right })
	local pop = create("UIScale", { Parent = c })
	UiKit.slashes(c, UDim2.new(1, -48, 0, -6), 18, GLOW)
	self.newButton = UiKit.button(c, { Name = "NewCareer", Position = UDim2.fromOffset(0, 14), Size = UDim2.fromOffset(290, 60), TextSize = 22 }, TEXT.NewCareer, function()
		self:_onNewCareer()
	end, "primary", TEXT.NewCareerSub)
	self.continueButton = UiKit.button(c, { Name = "Continue", Position = UDim2.fromOffset(0, 84), Size = UDim2.fromOffset(290, 60), TextSize = 19 }, TEXT.Continue, function()
		self:_onContinue()
	end, "secondary", TEXT.ContinueNone)
	self.settingsButton = UiKit.button(c, { Name = "Settings", Position = UDim2.fromOffset(0, 154), Size = UDim2.fromOffset(290, 46), TextSize = 19 }, "⚙  " .. TEXT.Settings, function()
		self:_openSettings()
	end, "secondary")
	self.status = text({ Name = "Status", Position = UDim2.fromOffset(4, 204), Size = UDim2.fromOffset(282, 30), Text = TEXT.Loading, TextSize = 11, FontFace = FONT_MEDIUM, TextColor3 = LILAC, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, Parent = c })
	outline(self.status, 1)
	self.newButton:setEnabled(false)
	self.continueButton:setEnabled(false)

	-- Career card
	local cardHolder = group("CareerCard", Vector2.new(0, 1), UDim2.new(0, 16, 1, -12), Vector2.new(330, 88))
	local card = UiKit.panel({ Name = "Card", Size = UDim2.fromScale(1, 1), Parent = cardHolder }, 12)
	self.cardCrest = frame({ Name = "CrestHolder", Position = UDim2.fromOffset(12, 15), Size = UDim2.fromOffset(58, 58), BackgroundTransparency = 1, Parent = card })
	self.cardTitle = text({ Name = "Title", Position = UDim2.fromOffset(82, 10), Size = UDim2.fromOffset(238, 24), Text = "", TextSize = 18, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	outline(self.cardTitle, 1.5)
	self.cardLine = text({ Name = "Line", Position = UDim2.fromOffset(82, 36), Size = UDim2.fromOffset(238, 20), Text = "", TextSize = 14, FontFace = FONT_BOLD, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	outline(self.cardLine, 1)
	self.cardNext = text({ Name = "Next", Position = UDim2.fromOffset(82, 58), Size = UDim2.fromOffset(238, 18), Text = "", TextSize = 12, FontFace = FONT_BOLD, TextColor3 = GOLD, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	outline(self.cardNext, 1)

	self.screens.MAIN = { root = root, content = c, pop = pop }
end

function CareerMenu:_refreshMain()
	local career = self.career
	local club = career and CareerConfig.club(career.clubId)
	self.newButton:setEnabled(self.loaded)
	self.continueButton:setEnabled(club ~= nil)
	for _, child in self.cardCrest:GetChildren() do
		child:Destroy()
	end
	if career and club then
		self.continueButton:setText(TEXT.Continue, string.format(TEXT.ContinueSub, club.name, career.number, career.lastName))
		UiKit.crest(self.cardCrest, { Size = UDim2.fromOffset(58, 58) }, club)
		self.cardTitle.Text = club.name
		self.cardLine.Text = string.format(TEXT.CardLine, career.number, CareerConfig.upper(career.lastName), career.ovr, career.level)
		self.cardNext.Text = TEXT.CardNext[career.training] or ""
	else
		self.continueButton:setText(TEXT.Continue, TEXT.ContinueNone)
		UiKit.crest(self.cardCrest, { Size = UDim2.fromOffset(58, 58) }, CareerConfig.Mascot)
		self.cardTitle.Text = TEXT.CardEmptyTitle
		self.cardLine.Text = TEXT.CardEmptyLine
		self.cardNext.Text = TEXT.CardEmptyNext
	end
	if not self.loaded then
		self.status.Text = TEXT.Loading
	elseif not self.persistent then
		self.status.Text = TEXT.SessionOnly
	else
		self.status.Text = ""
	end
	self.deleteButton.button.Visible = career ~= nil
	if self.loaded then
		self.newButton:playShine()
	end
end

function CareerMenu:_load()
	local result
	for attempt = 1, 3 do
		result = self:_request("GET")
		if result.ok or result.error ~= "BUSY" then
			break
		end
		task.wait(attempt * 0.5)
	end
	if not result.ok then
		self.status.Text = TEXT.LoadFailed
		return
	end
	self.loaded = true
	self.career = result.career
	self.persistent = result.persistent ~= false
	if typeof(result.settings) == "table" then
		self:_applySettings(result.settings)
	end
	self:_refreshMain()
end

function CareerMenu:_onNewCareer()
	if not self.loaded then
		return
	end
	local career = self.career
	local club = career and CareerConfig.club(career.clubId)
	if career and club then
		self:_confirm(TEXT.ReplaceTitle, string.format(TEXT.ReplaceBody, club.name, career.number, career.lastName), TEXT.ReplaceYes, false, function()
			self:_startNew(true)
		end)
	else
		self:_startNew(false)
	end
end

function CareerMenu:_startNew(replace: boolean)
	self.replace = replace
	self.selectedClub = nil
	self:_refreshCards()
	self:_show("CLUBS")
end

function CareerMenu:_onContinue()
	local career = self.career
	if not career or self.busy then
		return
	end
	if career.training == "DONE" then
		self:_showNext(false)
	else
		self:_startTraining(self.continueButton)
	end
end

---------------------------------------------------------------- club picker

function CareerMenu:_buildClubs()
	local screen = self:_screen("CLUBS", SCREEN_SIZE)
	local c = screen.content
	UiKit.bigText({ Name = "Title", Text = TEXT.ClubsTitle, TextSize = 38, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(520, 44), Parent = c }, 3.5, Vector2.new(3, 4))
	local league = UiKit.chip(c, { Name = "League", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 8) }, string.format(TEXT.League, CareerConfig.League.Name, #CareerConfig.Clubs), GOLD)
	league.Size = UDim2.fromOffset(0, 32)

	local openCount = 0
	for _, club in CareerConfig.Clubs do
		if club.open then
			openCount += 1
		end
	end
	local info = text({
		Name = "Info",
		Position = UDim2.fromOffset(2, 48),
		Size = UDim2.fromOffset(SCREEN_SIZE.X, 30),
		Text = string.format(TEXT.ClubsInfo, CareerConfig.StartOvr, openCount, #CareerConfig.Clubs),
		TextSize = 15,
		FontFace = FONT_BOLD,
		TextWrapped = true,
		Parent = c,
	})
	outline(info, 1.5)

	self.cards = {}
	for i, club in CareerConfig.Clubs do
		local col, row = (i - 1) % 4, (i - 1) // 4
		self.cards[club.id] = self:_buildCard(c, club, Vector2.new(col * (CARD_SIZE.X + CARD_GAP), CARD_TOP + row * (CARD_SIZE.Y + CARD_GAP)))
	end

	local footerY = CARD_TOP + 2 * CARD_SIZE.Y + CARD_GAP + 12
	UiKit.button(c, { Name = "Back", Position = UDim2.fromOffset(0, footerY), Size = UDim2.fromOffset(170, 50) }, TEXT.Back, function()
		self:_show("MAIN")
	end, "secondary")
	self.clubHint = text({
		Name = "Hint",
		Position = UDim2.fromOffset(186, footerY),
		Size = UDim2.fromOffset(SCREEN_SIZE.X - 186 - 226, 44),
		Text = TEXT.ClubPickHint,
		TextSize = 15,
		FontFace = FONT_BOLD,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = c,
	})
	outline(self.clubHint, 1.5)
	self.clubNext = UiKit.button(c, { Name = "Next", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, footerY), Size = UDim2.fromOffset(210, 50) }, TEXT.Next, function()
		if self.selectedClub then
			self:_enterPlayer()
		end
	end, "primary")
end

function CareerMenu:_buildCard(parent: Instance, club, position: Vector2)
	local button = create("TextButton", {
		Name = club.id,
		Position = UDim2.fromOffset(position.X, position.Y),
		Size = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = parent,
	})
	local body, glows, border = UiKit.panel({ Name = "Card", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), Parent = button }, 12)
	local pop = create("UIScale", { Parent = body })

	UiKit.crest(body, { Name = "Crest", Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(52, 52) }, club)
	local name = text({ Name = "ClubName", Position = UDim2.fromOffset(74, 10), Size = UDim2.fromOffset(CARD_SIZE.X - 84, 56), Text = club.name, TextSize = 18, TextWrapped = true, Parent = body })
	outline(name, 1.5)
	UiKit.stars(body, { Name = "Stars", Position = UDim2.fromOffset(12, 74) }, club.stars, 20)
	UiKit.chip(body, { Name = "Ovr", Position = UDim2.fromOffset(12, 104) }, string.format(TEXT.Ovr, club.ovr), LILAC)

	local lock = nil
	if not club.open then
		lock = frame({ Name = "Locked", Size = UDim2.fromScale(1, 1), BackgroundColor3 = INK, BackgroundTransparency = 0.42, ZIndex = 4, Parent = body })
		corner(lock, 12)
	end
	local tag = frame({
		Name = "Tag",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -10),
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = if club.open then LIME else NAVY,
		ZIndex = 6,
		Parent = body,
	})
	corner(tag, 7)
	stroke(tag, if club.open then INK else LILAC, 2)
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = tag })
	local tagText = text({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = if club.open then TEXT.ClubOpen else string.format(TEXT.ClubLocked, club.unlockOvr or 99),
		TextSize = 13,
		TextColor3 = if club.open then INK else LILAC,
		Parent = tag,
	})

	button.Activated:Connect(function()
		if club.open then
			self.selectedClub = club
			self:_refreshCards()
			UiKit.pop(pop, 0.92)
		else
			self.clubHint.Text = string.format(TEXT.ClubLockedHint, club.name, club.unlockOvr or 99)
			self.clubHint.TextColor3 = RED_LIGHT
			body.Rotation = 4
			TweenService:Create(body, TweenInfo.new(0.45, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
		end
	end)
	return { club = club, glows = glows, border = border, tag = tag, tagText = tagText }
end

function CareerMenu:_refreshCards()
	local selected = self.selectedClub
	for _, card in self.cards do
		local picked = card.club == selected
		for _, glow in card.glows do
			glow.Color = if picked then GOLD else GLOW
			glow.Enabled = card.club.open
		end
		card.border.Color = if picked then GOLD else VIOLET
		card.border.Thickness = if picked then 3 else 2
		if card.club.open then
			card.tagText.Text = if picked then TEXT.ClubPicked else TEXT.ClubOpen
			card.tag.BackgroundColor3 = if picked then GOLD else LIME
		end
	end
	self.clubNext:setEnabled(selected ~= nil)
	self.clubHint.TextColor3 = CREAM
	self.clubHint.Text = if selected then string.format(TEXT.ClubChosenHint, selected.name) else TEXT.ClubPickHint
	if selected then
		self.clubNext:playShine()
	end
end

---------------------------------------------------------------- player creation

function CareerMenu:_buildPlayer()
	local screen = self:_screen("PLAYER", SCREEN_SIZE)
	local c = screen.content

	-- Form
	local form = UiKit.panel({ Name = "Form", Size = UDim2.fromOffset(400, SCREEN_SIZE.Y), Parent = c }, 16)
	self.form = form
	UiKit.slashes(form, UDim2.new(1, -66, 0, 14), 22, GLOW)
	UiKit.bigText({ Name = "Title", Text = TEXT.PlayerTitle, TextSize = 30, Position = UDim2.fromOffset(20, 12), Size = UDim2.fromOffset(300, 38), Parent = form }, 3, Vector2.new(2, 3))
	self.formCrestHolder = frame({ Name = "Club", Position = UDim2.fromOffset(20, 56), Size = UDim2.fromOffset(360, 32), BackgroundTransparency = 1, Parent = form })

	local function label(y: number, value: string)
		local l = text({ Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(360, 18), Text = value, TextSize = 14, FontFace = FONT_BOLD, TextColor3 = LILAC, Parent = form })
		outline(l, 1)
	end
	label(96, TEXT.FirstName)
	self.firstBox = UiKit.textBox(form, { Name = "FirstName", Position = UDim2.fromOffset(20, 116), Size = UDim2.fromOffset(360, 42) }, TEXT.FirstPlaceholder)
	label(166, TEXT.LastName)
	self.lastBox = UiKit.textBox(form, { Name = "LastName", Position = UDim2.fromOffset(20, 186), Size = UDim2.fromOffset(360, 42) }, TEXT.LastPlaceholder)
	label(236, TEXT.Number)

	UiKit.button(form, { Name = "Minus", Position = UDim2.fromOffset(20, 256), Size = UDim2.fromOffset(46, 46), TextSize = 26 }, "−", function()
		self:_setNumber(((self.number or CareerConfig.Number.Default) - 2) % CareerConfig.Number.Max + 1)
	end, "secondary")
	self.numberBox = UiKit.textBox(form, { Name = "Number", Position = UDim2.fromOffset(74, 256), Size = UDim2.fromOffset(78, 42), TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center }, "10")
	UiKit.button(form, { Name = "Plus", Position = UDim2.fromOffset(160, 256), Size = UDim2.fromOffset(46, 46), TextSize = 26 }, "+", function()
		self:_setNumber((self.number or CareerConfig.Number.Default) % CareerConfig.Number.Max + 1)
	end, "secondary")

	self.picks = {}
	for i, value in CareerConfig.Number.Picks do
		local pick = create("TextButton", {
			Name = "Pick" .. value,
			Position = UDim2.fromOffset(20 + (i - 1) * 61, 310),
			Size = UDim2.fromOffset(52, 32),
			BackgroundColor3 = NAVY,
			AutoButtonColor = false,
			Text = tostring(value),
			TextSize = 17,
			FontFace = UiKit.FONT_HEAVY,
			TextColor3 = CREAM,
			BorderSizePixel = 0,
			Parent = form,
		})
		corner(pick, 8)
		self.picks[value] = stroke(pick, VIOLET, 2)
		pick.Activated:Connect(function()
			self:_setNumber(value)
		end)
	end

	self.formError = text({ Name = "Error", Position = UDim2.fromOffset(20, 348), Size = UDim2.fromOffset(360, 20), Text = "", TextSize = 14, FontFace = FONT_BOLD, TextColor3 = RED_LIGHT, TextWrapped = true, Parent = form })
	outline(self.formError, 1)

	UiKit.button(form, { Name = "Back", Position = UDim2.fromOffset(20, 376), Size = UDim2.fromOffset(124, 52) }, TEXT.Back, function()
		if not self.busy then
			self:_show("CLUBS")
		end
	end, "secondary")
	self.confirmButton = UiKit.button(form, { Name = "Confirm", Position = UDim2.fromOffset(156, 376), Size = UDim2.fromOffset(224, 52) }, TEXT.Confirm, function()
		self:_submit()
	end, "primary")

	self.firstBox:GetPropertyChangedSignal("Text"):Connect(function()
		limitLength(self.firstBox, CareerConfig.Name.MaxLength)
		self.formError.Text = ""
	end)
	self.lastBox:GetPropertyChangedSignal("Text"):Connect(function()
		limitLength(self.lastBox, CareerConfig.Name.MaxLength)
		self.formError.Text = ""
		self.preview:setIdentity(self.lastBox.Text, self.number)
	end)
	self.numberBox:GetPropertyChangedSignal("Text"):Connect(function()
		local digits = string.sub(string.gsub(self.numberBox.Text, "%D", ""), 1, 2)
		if digits ~= self.numberBox.Text then
			self.numberBox.Text = digits -- fires this handler again with the clean text
			return
		end
		local value = tonumber(digits)
		self.number = if value and CareerConfig.validNumber(value) then value else nil
		self:_refreshPicks()
		self.formError.Text = ""
		self.preview:setIdentity(self.lastBox.Text, self.number)
	end)
	self.firstBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			self.lastBox:CaptureFocus()
		end
	end)

	self:_buildSigned(c)
end

-- Same spot as the form: replaces it once the server has accepted the player.
function CareerMenu:_buildSigned(parent: Instance)
	local signed = UiKit.panel({ Name = "Signed", Size = UDim2.fromOffset(400, SCREEN_SIZE.Y), Visible = false, Parent = parent }, 16, GOLD)
	self.signed = signed
	self.signedPop = create("UIScale", { Parent = signed })
	UiKit.slashes(signed, UDim2.fromOffset(16, 12), 22, GLOW)
	UiKit.slashes(signed, UDim2.new(1, -66, 0, 12), 22, GLOW)
	local title = UiKit.bigText({ Name = "Title", Text = TEXT.SignedTitle, TextSize = 40, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(20, 34), Size = UDim2.fromOffset(360, 96), Parent = signed }, 4, Vector2.new(0, 4), 40)
	create("UIGradient", { Rotation = 90, Color = ColorSequence.new(CREAM, GOLD), Parent = title })
	self.signedCrestHolder = frame({ Name = "CrestHolder", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 140), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, Parent = signed })
	self.signedClub = text({ Name = "Club", Position = UDim2.fromOffset(20, 210), Size = UDim2.fromOffset(360, 28), Text = "", TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, Parent = signed })
	outline(self.signedClub, 2)
	self.signedPlayer = text({ Name = "Player", Position = UDim2.fromOffset(20, 240), Size = UDim2.fromOffset(360, 24), Text = "", TextSize = 18, FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Center, Parent = signed })
	outline(self.signedPlayer, 1.5)

	local chips = frame({ Name = "Chips", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 274), Size = UDim2.fromOffset(360, 28), BackgroundTransparency = 1, Parent = signed })
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = chips })
	local _, ovr = UiKit.chip(chips, { LayoutOrder = 1 }, "", LIME)
	local _, level = UiKit.chip(chips, { LayoutOrder = 2 }, "", GOLD)
	self.signedOvr, self.signedLevel = ovr, level

	local info = text({ Name = "Info", Position = UDim2.fromOffset(24, 312), Size = UDim2.fromOffset(352, 44), Text = TEXT.SignedInfo, TextSize = 15, FontFace = FONT_MEDIUM, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, Parent = signed })
	outline(info, 1)
	self.trainingButton = UiKit.button(signed, { Name = "ToTraining", Position = UDim2.fromOffset(20, 376), Size = UDim2.fromOffset(360, 52) }, TEXT.ToTraining, function()
		self:_startTraining(self.trainingButton)
	end, "primary")
end

function CareerMenu:_setNumber(value: number)
	self.numberBox.Text = tostring(value) -- the Text handler updates the preview
end

function CareerMenu:_refreshPicks()
	for value, pickStroke in self.picks do
		local on = value == self.number
		pickStroke.Color = if on then GOLD else VIOLET
		pickStroke.Thickness = if on then 3 else 2
	end
end

function CareerMenu:_enterPlayer()
	local club = self.selectedClub
	for _, child in self.formCrestHolder:GetChildren() do
		child:Destroy()
	end
	UiKit.crest(self.formCrestHolder, { Size = UDim2.fromOffset(32, 32) }, club)
	local clubName = text({ Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -42, 1, 0), Text = club.name, TextSize = 18, FontFace = FONT_BOLD, Parent = self.formCrestHolder })
	outline(clubName, 1.5)

	self.form.Visible = true
	self.signed.Visible = false
	self.formError.Text = ""
	self.confirmButton:setText(TEXT.Confirm)
	self.confirmButton:setEnabled(true)
	self:_show("PLAYER")
	self.preview:show(club, self.lastBox.Text, nil)
	if self.numberBox.Text == "" then
		self:_setNumber(CareerConfig.Number.Default)
	else
		self.preview:setIdentity(self.lastBox.Text, self.number, true)
	end
	self.confirmButton:playShine()
end

function CareerMenu:_submit()
	if self.busy then
		return
	end
	local _, firstError = CareerConfig.cleanName(self.firstBox.Text)
	local _, lastError = CareerConfig.cleanName(self.lastBox.Text)
	local problem = if firstError then "FIRST_" .. firstError elseif lastError then "LAST_" .. lastError elseif not self.number then "BAD_NUMBER" else nil
	if problem then
		self.formError.Text = errorText(problem)
		return
	end

	self.busy = true
	self.confirmButton:setText(TEXT.Saving)
	self.confirmButton:setEnabled(false)
	task.spawn(function()
		local result = self:_request("CREATE", {
			clubId = self.selectedClub.id,
			firstName = self.firstBox.Text,
			lastName = self.lastBox.Text,
			number = self.number,
			replace = self.replace,
		})
		self.busy = false
		self.confirmButton:setText(TEXT.Confirm)
		self.confirmButton:setEnabled(true)
		if not result.ok then
			self.formError.Text = errorText(result.error)
			return
		end
		self.career = result.career
		self.replace = false
		self:_refreshMain()
		self:_showSigned()
	end)
end

function CareerMenu:_showSigned()
	local career = self.career
	local club = CareerConfig.club(career.clubId)
	for _, child in self.signedCrestHolder:GetChildren() do
		child:Destroy()
	end
	UiKit.crest(self.signedCrestHolder, { Size = UDim2.fromOffset(64, 64) }, club)
	self.signedClub.Text = club.name
	self.signedPlayer.Text = string.format(TEXT.SignedPlayer, career.firstName, career.lastName, career.number)
	self.signedOvr.Text = string.format(TEXT.Ovr, career.ovr)
	self.signedLevel.Text = string.format(TEXT.Level, career.level)
	self.form.Visible = false
	self.signed.Visible = true
	UiKit.pop(self.signedPop, 0.6)
	self.trainingButton:setEnabled(true)
	self.trainingButton:playShine()
	-- The shirt shows the name exactly as the server saved it.
	self.preview:setIdentity(career.lastName, career.number, true)
	self.preview:celebrate()
end

function CareerMenu:_startTraining(button)
	if self.busy then
		return
	end
	self.busy = true
	button:setEnabled(false)
	task.spawn(function()
		local result = self:_request("START_TRAINING")
		self.busy = false
		button:setEnabled(true)
		if result.ok then
			self:close()
			if self.onStartTraining then
				self.onStartTraining(self.career)
			end
		elseif result.error == "TRAINING_DONE" then
			self.career.training = "DONE"
			self:_showNext(false)
		else
			self.status.Text = errorText(result.error)
			self:_show("MAIN")
		end
	end)
end

---------------------------------------------------------------- next match (after training)

function CareerMenu:_buildNextMatch()
	local screen = self:_screen("NEXT", SCREEN_SIZE)
	local body = UiKit.panel({ Name = "Card", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(540, 384), Parent = screen.content }, 16, GOLD)
	UiKit.slashes(body, UDim2.fromOffset(16, 12), 24, GLOW)
	UiKit.slashes(body, UDim2.new(1, -66, 0, 12), 24, GLOW)
	local title, titleShadow = UiKit.bigText({ Name = "Title", Text = TEXT.TrainedTitle, TextSize = 40, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(20, 22), Size = UDim2.new(1, -40, 0, 96), Parent = body }, 4, Vector2.new(0, 4), 40)
	create("UIGradient", { Rotation = 90, Color = ColorSequence.new(CREAM, GOLD), Parent = title })
	self.nextTitle = title
	self.nextTitleShadow = titleShadow
	self.nextPlayer = text({ Name = "Player", Position = UDim2.fromOffset(20, 124), Size = UDim2.new(1, -40, 0, 22), Text = "", TextSize = 16, FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, Parent = body })
	outline(self.nextPlayer, 1.5)

	local fixture = frame({ Name = "Fixture", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 156), Size = UDim2.fromOffset(480, 128), BackgroundColor3 = NAVY, Parent = body })
	corner(fixture, 12)
	stroke(fixture, VIOLET, 2)
	local heading = text({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 20), Text = TEXT.FirstMatch, TextSize = 15, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Center, Parent = fixture })
	outline(heading, 1.5)
	local versus = UiKit.bigText({ Name = "Vs", Text = "VS", TextSize = 34, TextColor3 = RED, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 46), Size = UDim2.fromOffset(80, 40), Parent = fixture }, 3, Vector2.new(2, 3))
	versus.ZIndex = 2
	self.fixtureSides = {}
	for i, x in { 0.25, 0.75 } do
		local side = frame({ Name = "Side" .. i, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(x, 0, 0, 32), Size = UDim2.fromOffset(200, 90), BackgroundTransparency = 1, Parent = fixture })
		local crestHolder = frame({ Name = "CrestHolder", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(56, 56), BackgroundTransparency = 1, Parent = side })
		local name = text({ Name = "ClubName", Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 22), Text = "", TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Parent = side })
		outline(name, 1.5)
		self.fixtureSides[i] = { crest = crestHolder, name = name }
	end

	local soon = text({ Name = "Soon", Position = UDim2.fromOffset(20, 292), Size = UDim2.new(1, -40, 0, 20), Text = TEXT.Soon, TextSize = 14, FontFace = FONT_BOLD, TextColor3 = LILAC, TextXAlignment = Enum.TextXAlignment.Center, Parent = body })
	outline(soon, 1)
	self.menuButton = UiKit.button(body, { Name = "ToMenu", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 322), Size = UDim2.fromOffset(300, 52) }, TEXT.ToMenu, function()
		self:_show("MAIN")
	end, "primary")
end

function CareerMenu:_showNext(justTrained: boolean)
	local career = self.career
	local club = career and CareerConfig.club(career.clubId)
	if not (career and club) then
		self:_show("MAIN")
		return
	end
	local title = if justTrained then TEXT.TrainedTitle else TEXT.CareerTitle
	self.nextTitle.Text = title
	if self.nextTitleShadow then
		self.nextTitleShadow.Text = title
	end
	self.nextPlayer.Text = string.format(TEXT.CareerLine, career.firstName, career.lastName, career.number, club.name)
	for i, side in { club, CareerConfig.firstOpponent(club) } do
		local slot = self.fixtureSides[i]
		for _, child in slot.crest:GetChildren() do
			child:Destroy()
		end
		UiKit.crest(slot.crest, { Size = UDim2.fromOffset(56, 56) }, side)
		slot.name.Text = side.name
	end
	self:_show("NEXT")
	self.menuButton:playShine()
end

---------------------------------------------------------------- settings and confirmations

function CareerMenu:_buildOverlay()
	local overlay = frame({ Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 30, Parent = self.gui })
	self.overlay = overlay
	self.overlayDim = frame({ Name = "Dim", Position = UDim2.fromOffset(-200, -120), Size = UDim2.new(1, 400, 1, 240), BackgroundColor3 = INK, BackgroundTransparency = 0.45, Parent = overlay })

	local function modal(name: string, size: Vector2)
		local holder = frame({ Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size.X, size.Y), BackgroundTransparency = 1, Visible = false, Parent = overlay })
		self.scaler:add(holder)
		local body = UiKit.panel({ Name = "Body", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), Parent = holder }, 16)
		return holder, body, create("UIScale", { Parent = body })
	end

	-- Settings
	local settings, sBody, sPop = modal("Settings", Vector2.new(460, 330))
	self.settingsModal, self.settingsPop = settings, sPop
	UiKit.bigText({ Name = "Title", Text = TEXT.SettingsTitle, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(20, 16), Size = UDim2.new(1, -40, 0, 40), Parent = sBody }, 3, Vector2.new(2, 3))
	local function row(y: number, label: string, key: string)
		local l = text({ Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(300, 34), Text = label, TextSize = 17, FontFace = FONT_BOLD, Parent = sBody })
		outline(l, 1.5)
		return UiKit.toggle(sBody, { Name = key, Position = UDim2.new(1, -100, 0, y) }, self.settings[key], function(value)
			self:_changeSetting(key, value)
		end)
	end
	self.toggles = { shake = row(80, TEXT.Shake, "shake"), bigUi = row(128, TEXT.BigUi, "bigUi") }
	self.deleteButton = UiKit.button(sBody, { Name = "Delete", Position = UDim2.fromOffset(24, 188), Size = UDim2.fromOffset(412, 48) }, TEXT.DeleteCareer, function()
		self:_askDelete()
	end, "danger")
	self.deleteButton.button.Visible = false
	UiKit.button(sBody, { Name = "Done", Position = UDim2.fromOffset(24, 260), Size = UDim2.fromOffset(412, 52) }, TEXT.Done, function()
		self:_closeOverlay()
	end, "primary")

	-- Yes / no
	local confirm, cBody, cPop = modal("Confirm", Vector2.new(480, 256))
	self.confirmModal, self.confirmPop = confirm, cPop
	self.confirmTitle, self.confirmTitleShadow = UiKit.bigText({ Name = "Title", Text = "", TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(20, 18), Size = UDim2.new(1, -40, 0, 38), Parent = cBody }, 3, Vector2.new(2, 3))
	self.confirmBody = text({ Name = "Body", Position = UDim2.fromOffset(24, 70), Size = UDim2.new(1, -48, 0, 90), Text = "", TextSize = 17, FontFace = FONT_MEDIUM, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, Parent = cBody })
	outline(self.confirmBody, 1)
	UiKit.button(cBody, { Name = "Cancel", Position = UDim2.fromOffset(24, 184), Size = UDim2.fromOffset(204, 52) }, TEXT.Cancel, function()
		self:_closeOverlay()
	end, "secondary")
	local function yes()
		local action = self.confirmAction
		self:_closeOverlay()
		if action then
			action()
		end
	end
	self.confirmYes = UiKit.button(cBody, { Name = "Yes", Position = UDim2.fromOffset(252, 184), Size = UDim2.fromOffset(204, 52) }, "", yes, "primary")
	self.confirmDanger = UiKit.button(cBody, { Name = "YesDanger", Position = UDim2.fromOffset(252, 184), Size = UDim2.fromOffset(204, 52) }, "", yes, "danger")
end

function CareerMenu:_openOverlay(modal: Frame, pop: UIScale)
	self.overlay.Visible = true
	self.settingsModal.Visible = modal == self.settingsModal
	self.confirmModal.Visible = modal == self.confirmModal
	UiKit.pop(pop, 0.6)
end

function CareerMenu:_closeOverlay()
	self.overlay.Visible = false
	self.confirmAction = nil
end

function CareerMenu:_openSettings()
	for key, toggle in self.toggles do
		toggle:set(self.settings[key])
	end
	self.deleteButton.button.Visible = self.career ~= nil
	self:_openOverlay(self.settingsModal, self.settingsPop)
end

function CareerMenu:_confirm(title: string, body: string, yesText: string, danger: boolean, action: () -> ())
	self.confirmTitle.Text = title
	if self.confirmTitleShadow then
		self.confirmTitleShadow.Text = title
	end
	self.confirmBody.Text = body
	self.confirmYes.button.Visible = not danger
	self.confirmDanger.button.Visible = danger
	local button = if danger then self.confirmDanger else self.confirmYes
	button:setText(yesText)
	self.confirmAction = action
	self:_openOverlay(self.confirmModal, self.confirmPop)
end

function CareerMenu:_askDelete()
	local club = self.career and CareerConfig.club(self.career.clubId)
	if not club then
		return
	end
	self:_confirm(TEXT.DeleteTitle, string.format(TEXT.DeleteBody, club.name), TEXT.DeleteYes, true, function()
		task.spawn(function()
			local result = self:_request("DELETE")
			if result.ok then
				self.career = nil
			else
				self.status.Text = errorText(result.error)
			end
			self:_refreshMain()
		end)
	end)
end

function CareerMenu:_applySettings(settings)
	self.settings = { shake = settings.shake ~= false, bigUi = settings.bigUi == true }
	self.scaler:setBoost(if self.settings.bigUi then 1.15 else 1)
	if self.onSettingsChanged then
		self.onSettingsChanged(self.settings)
	end
end

function CareerMenu:_changeSetting(key: string, value: boolean)
	local settings = table.clone(self.settings)
	settings[key] = value
	self:_applySettings(settings)
	-- Applied at once, saved once the toggling stops (the server rate-limits requests).
	self.settingsToken = (self.settingsToken or 0) + 1
	local token = self.settingsToken
	task.delay(0.6, function()
		if token ~= self.settingsToken then
			return
		end
		local result = self:_request("SETTINGS", self.settings)
		if not result.ok then
			warn("[CareerMenu] settings not saved:", result.error)
		end
	end)
end

---------------------------------------------------------------- screens, camera, open / close

function CareerMenu:_show(name: string)
	for key, screen in self.screens do
		screen.root.Visible = key == name
	end
	local screen = self.screens[name]
	UiKit.pop(screen.pop, 0.94)
	self.current = name
	self.cameraMode = if name == "MAIN" then "MENU" elseif name == "PLAYER" then "CREATE" elseif name == "CLUBS" then "CLUBS" else "NEXT"
	self.shade.Visible = name ~= "NEXT"
	self.shadeGradient.Transparency = if name == "MAIN" then SHADE_SIDES else SHADE_LEFT
	if name ~= "PLAYER" then
		self.preview:hide()
	end
	if name == "MAIN" then
		self:_refreshMain()
	end
end

-- Back from the training. justTrained: the pass task was just completed.
function CareerMenu:open(justTrained: boolean?)
	self.active = true
	self.gui.Enabled = true
	self.blur.Enabled = true
	self.depth.Enabled = true
	self.camCFrame = workspace.CurrentCamera.CFrame -- glide from wherever the training left it
	self.camFov = workspace.CurrentCamera.FieldOfView
	if justTrained and self.career then
		self.career.training = "DONE" -- the server marked it when the task was completed
		self:_showNext(true)
	else
		self:_show("MAIN")
	end
	task.spawn(function()
		local result = self:_request("GET")
		if result.ok then
			self.career = result.career
			if self.current == "MAIN" then
				self:_refreshMain()
			end
		end
	end)
end

function CareerMenu:close()
	self.active = false
	self.gui.Enabled = false
	self.blur.Enabled = false
	self.depth.Enabled = false
	self.overlay.Visible = false
	self.preview:hide()
end

function CareerMenu:isOpen(): boolean
	return self.active
end

-- Per-frame while open: camera glide between framings, blur / depth of field and the player.
function CareerMenu:update(dt: number)
	if not self.active then
		return
	end
	self.clock += dt
	self.preview:update(dt)

	local mode = self.cameraMode
	local t = self.clock
	local target, fov, focus
	if mode == "CREATE" then
		target, fov, focus = PlayerPreview.cameraTarget(mode)
	else
		local framing = if mode == "MENU" then MENU_CAMERA else CLUBS_CAMERA
		local sway = Vector3.new(math.sin(t * 0.13) * 6, math.sin(t * 0.09) * 1.2, 0)
		target, fov = CFrame.lookAt(framing.from + sway, framing.to), framing.fov
	end
	local k = 1 - math.exp(-3 * dt)
	self.camCFrame = self.camCFrame:Lerp(target, k)
	self.camFov += (fov - self.camFov) * k
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = self.camCFrame
	camera.FieldOfView = self.camFov
	self.blur.Size += ((BLUR[mode] or 0) - self.blur.Size) * k
	self.depth.Enabled = DEPTH[mode] == true
	if focus then
		self.depth.FocusDistance = focus
	end
end

return CareerMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">FigureAnimator</string>
            <string name="Source"><![CDATA[-- Procedural animation for the outfield players of the pass drill (FigureBuilder rigs).
-- Same joint conventions as KeeperAnimator: degrees around the rig's own axes, +X swings a
-- hanging limb forward, +Z swings it to the rig's right; knees bend with -X.
-- Feed it a ground position and facing every frame (moveTo); it derives the run cycle from
-- the speed and overlays one-shot or looping actions.

local FigureAnimator = {}
FigureAnimator.__index = FigureAnimator

local JOINT_NAMES = {
	"Waist", "Neck",
	"LeftShoulder", "LeftElbow", "LeftWrist", "RightShoulder", "RightElbow", "RightWrist",
	"LeftHip", "LeftKnee", "LeftAnkle", "RightHip", "RightKnee", "RightAnkle",
}

-- One-shot actions and their length in seconds; WAVE and CHEER loop until replaced.
local DURATION = { KICK = 0.5, TRAP = 0.55, LUNGE = 0.8, NOD = 0.8 }

local function J(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

local function smooth(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

function FigureAnimator.new(model: Model, rootHeight: number, scale: number)
	local self = setmetatable({}, FigureAnimator)
	self.model = model
	self.rootHeight = rootHeight
	self.scale = scale
	self.motors = {}
	for _, name in JOINT_NAMES do
		local motor = model:FindFirstChild(name, true)
		if motor and motor:IsA("Motor6D") then
			self.motors[name] = { motor = motor, base = motor.C0 }
		end
	end
	self.joints = {}
	self.position = Vector3.zero
	self.facing = Vector3.new(0, 0, -1)
	self.speed = 0
	self.phase = math.random() * math.pi * 2
	self.clock = math.random() * 10
	self.action = nil
	self.actionTime = 0
	self.drop = 0
	return self
end

-- Jumps straight there (new episode).
function FigureAnimator:place(position: Vector3, facing: Vector3?)
	self.position = Vector3.new(position.X, 0, position.Z)
	if facing and facing.Magnitude > 1e-3 then
		self.facing = Vector3.new(facing.X, 0, facing.Z).Unit
	end
	self.speed = 0
end

-- Moves there this frame; the run cycle follows the distance covered.
function FigureAnimator:moveTo(position: Vector3, facing: Vector3?, dt: number)
	local flat = Vector3.new(position.X, 0, position.Z)
	local speed = if dt > 0 then (flat - self.position).Magnitude / dt else 0
	self.speed += (speed - self.speed) * math.min(1, dt * 12)
	self.position = flat
	if facing and facing.Magnitude > 1e-3 then
		local f = Vector3.new(facing.X, 0, facing.Z).Unit
		self.facing = self.facing:Lerp(f, math.min(1, dt * 10))
		if self.facing.Magnitude < 1e-3 then
			self.facing = f
		end
		self.facing = self.facing.Unit
	end
end

-- KICK | TRAP | LUNGE | NOD (one-shot), WAVE | CHEER (loop), nil = back to idle/run.
function FigureAnimator:play(action: string?)
	if self.action == action and (action == "WAVE" or action == "CHEER") then
		return
	end
	self.action = action
	self.actionTime = 0
end

function FigureAnimator:_pose(): (Vector3, number)
	local run = math.clamp(self.speed / 9, 0, 1)
	local s = math.sin(self.phase)
	local c = math.cos(self.phase)
	local breathe = math.sin(self.clock * 2.2)
	local joints = {
		Waist = J(-10 * run, 0, 0),
		Neck = J(4 * run, 0, 0),
		LeftShoulder = J(-34 * run * s, 0, -8 - 2 * breathe),
		RightShoulder = J(34 * run * s, 0, 8 + 2 * breathe),
		LeftElbow = J(18 + 50 * run, 0, 0),
		RightElbow = J(18 + 50 * run, 0, 0),
		LeftWrist = J(0, 0, 0),
		RightWrist = J(0, 0, 0),
		LeftHip = J(4 + 40 * run * s, 0, -3),
		RightHip = J(4 - 40 * run * s, 0, 3),
		LeftKnee = J(-8 - 55 * run * math.max(0, -c), 0, 0),
		RightKnee = J(-8 - 55 * run * math.max(0, c), 0, 0),
		LeftAnkle = J(4, 0, 0),
		RightAnkle = J(4, 0, 0),
	}
	local bob = math.abs(s) * 0.22 * run + 0.03 * breathe * (1 - run)
	local drop = 0

	local action, t = self.action, self.actionTime
	if action == "KICK" then
		-- Inside-foot pass with the right foot: wind up, swing through, follow through.
		local back = smooth(t / 0.16) * (1 - smooth((t - 0.16) / 0.1))
		local through = smooth((t - 0.16) / 0.1) * (1 - smooth((t - 0.32) / 0.18))
		joints.RightHip = J(-38 * back + 48 * through, 0, 8 * through)
		joints.RightKnee = J(-70 * back - 10 * through, 0, 0)
		joints.RightAnkle = J(10, 0, 0)
		joints.LeftKnee = J(-18 * (back + through), 0, 0)
		joints.LeftShoulder = J(10, 0, -40 * (back + through))
		joints.RightShoulder = J(-20 * through, 0, 32 * (back + through))
		joints.Waist = J(-8, 12 * back - 10 * through, 0)
		drop = 0.15 * (back + through)
	elseif action == "TRAP" then
		local k = smooth(t / 0.15) * (1 - smooth((t - 0.38) / 0.17))
		joints.RightHip = J(28 * k, 0, 6 * k)
		joints.RightKnee = J(-34 * k, 0, 0)
		joints.RightAnkle = J(-18 * k, 0, 0)
		joints.LeftKnee = J(-16 * k, 0, 0)
		joints.LeftShoulder = J(8, 0, -30 * k)
		joints.RightShoulder = J(8, 0, 30 * k)
		joints.Neck = J(18 * k, 0, 0) -- eyes on the ball
		drop = 0.12 * k
	elseif action == "LUNGE" then
		-- Slide in with the right leg stretched towards the ball.
		local k = smooth(t / 0.18) * (1 - smooth((t - 0.55) / 0.25))
		joints.RightHip = J(72 * k, 0, 0)
		joints.RightKnee = J(-4 * k, 0, 0)
		joints.LeftHip = J(-12 * k, 0, 0)
		joints.LeftKnee = J(-75 * k, 0, 0)
		joints.Waist = J(16 * k, 0, 0)
		joints.LeftShoulder = J(30 * k, 0, -55 * k)
		joints.RightShoulder = J(-10 * k, 0, 55 * k)
		drop = 0.75 * k
	elseif action == "WAVE" then
		-- Calling for the ball: right arm up, waving.
		joints.RightShoulder = J(150, 0, 18 + 14 * math.sin(self.clock * 9))
		joints.RightElbow = J(20, 0, 0)
	elseif action == "CHEER" then
		-- Goal celebration with both feet on the ground: right fist pumping, left arm out.
		local pump = math.sin(self.clock * 7)
		joints.RightShoulder = J(150 + 10 * pump, 0, 14)
		joints.RightElbow = J(35 + 15 * pump, 0, 0)
		joints.LeftShoulder = J(10, 0, -55)
		joints.LeftElbow = J(30, 0, 0)
		joints.Waist = J(-6, 0, 0)
		joints.Neck = J(-12, 0, 0)
	elseif action == "NOD" then
		-- Contract signed: arms stay relaxed, one short nod towards the camera.
		local nod = math.max(0, math.sin(math.min(t, 0.8) / 0.8 * math.pi))
		joints.Neck = J(16 * nod, 0, 0)
	end
	return joints, bob - drop
end

function FigureAnimator:update(dt: number)
	self.clock += dt
	local cadence = 1.6 + self.speed * 0.42 -- strides per second grow with speed
	self.phase += dt * cadence * math.pi
	if self.action then
		self.actionTime += dt
		local duration = DURATION[self.action]
		if duration and self.actionTime >= duration then
			self.action = nil
		end
	end

	local joints, lift = self:_pose()
	local k = 1 - math.exp(-20 * dt)
	for name, entry in self.motors do
		local target = joints[name] or Vector3.zero
		local current = self.joints[name] or target
		current = current:Lerp(target, k)
		self.joints[name] = current
		entry.motor.C0 = entry.base * CFrame.Angles(math.rad(current.X), math.rad(current.Y), math.rad(current.Z))
	end
	self.drop += (lift - self.drop) * k
	local base = self.position + Vector3.new(0, self.rootHeight + self.drop * self.scale, 0)
	self.model:PivotTo(CFrame.lookAt(base, base + self.facing))
end

return FigureAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ImageLoader</string>
            <string name="Source"><![CDATA[-- Turns the packed images in ReplicatedStorage.Shared.Images (made by tools/assets/build_images.py)
-- into EditableImages and shows them wherever the server tagged an instance:
--   CollectionService tag "NfsImage" + attribute Image = "<Module>/<Key>", e.g. "Banners/Logo".
-- ImageLabels get ImageContent and become visible; Decals get TextureContent.
-- If EditableImage is unavailable (published place without "Allow Mesh / Image APIs", or the
-- device's memory budget is used up) nothing breaks: the tagged objects keep their plain fallback look.

local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TAG = "NfsImage"

local ImageLoader = {}

local imagesFolder = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Images")
local modules: { [string]: { [string]: string } } = {}
local cache: { [string]: Content | false } = {}
local disabledReason: string? = nil

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_VALUE = {}
for i = 1, 64 do
	B64_VALUE[string.byte(B64, i)] = i - 1
end

local function base64Decode(text: string): buffer
	text = string.gsub(text, "[^%w%+/]", "") -- drop line breaks and '=' padding
	local length = #text
	local out = buffer.create(length * 3 // 4)
	local o = 0
	for i = 1, length - 3, 4 do
		local a, b, c, d = string.byte(text, i, i + 3)
		local n = B64_VALUE[a] * 262144 + B64_VALUE[b] * 4096 + B64_VALUE[c] * 64 + B64_VALUE[d]
		buffer.writeu8(out, o, n // 65536)
		buffer.writeu8(out, o + 1, n // 256 % 256)
		buffer.writeu8(out, o + 2, n % 256)
		o += 3
	end
	local rest = length % 4
	if rest >= 2 then
		local i = length - rest + 1
		local n = B64_VALUE[string.byte(text, i)] * 262144 + B64_VALUE[string.byte(text, i + 1)] * 4096
		if rest == 3 then
			n += B64_VALUE[string.byte(text, i + 2)] * 64
		end
		buffer.writeu8(out, o, n // 65536)
		if rest == 3 then
			buffer.writeu8(out, o + 1, n // 256 % 256)
		end
	end
	return out
end

-- Packed format: u16 width, u16 height, u16 palette size, palette (RGBA bytes), then LZ tokens:
-- byte c < 128 -> c+1 literal indices follow; c >= 128 -> copy c-125 indices from u16 offset back.
function ImageLoader.decode(packed: string): (number, number, buffer)
	local data = base64Decode(packed)
	local width = buffer.readu16(data, 0)
	local height = buffer.readu16(data, 2)
	local colors = buffer.readu16(data, 4)
	local paletteStart = 6
	local pos = paletteStart + colors * 4
	local dataEnd = buffer.len(data)

	local count = width * height
	local indices = buffer.create(count)
	local o = 0
	while pos < dataEnd and o < count do
		local token = buffer.readu8(data, pos)
		pos += 1
		if token < 128 then
			local n = token + 1
			buffer.copy(indices, o, data, pos, n)
			pos += n
			o += n
		else
			local n = token - 125
			local from = o - buffer.readu16(data, pos)
			pos += 2
			if o - from >= n then
				buffer.copy(indices, o, indices, from, n)
			else -- overlapping run: copy byte by byte so it repeats
				for k = 0, n - 1 do
					buffer.writeu8(indices, o + k, buffer.readu8(indices, from + k))
				end
			end
			o += n
		end
	end
	assert(o == count, "image data is truncated")

	local pixels = buffer.create(count * 4)
	for i = 0, count - 1 do
		-- Palette entries are RGBA bytes, so a little-endian u32 copy keeps the byte order.
		buffer.writeu32(pixels, i * 4, buffer.readu32(data, paletteStart + buffer.readu8(indices, i) * 4))
	end
	return width, height, pixels
end

local function packedData(key: string): string?
	local moduleName, imageName = string.match(key, "^([^/]+)/(.+)$")
	if not moduleName then
		return nil
	end
	local images = modules[moduleName]
	if not images then
		local module = imagesFolder:FindFirstChild(moduleName)
		if not (module and module:IsA("ModuleScript")) then
			return nil
		end
		images = require(module) :: any
		modules[moduleName] = images
	end
	return images[imageName]
end

-- Returns a Content for the image, or nil if it can't be shown. Each image is decoded once
-- and the same EditableImage is shared by every object that shows it.
function ImageLoader.get(key: string): Content?
	local cached = cache[key]
	if cached ~= nil then
		return cached or nil
	end
	if disabledReason then
		return nil
	end
	local packed = packedData(key)
	if not packed then
		warn("[ImageLoader] Unknown image:", key)
		cache[key] = false
		return nil
	end
	local ok, result = pcall(function()
		local width, height, pixels = ImageLoader.decode(packed)
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(width, height) })
		if not image then
			error("device image memory budget is used up", 0)
		end
		image:WritePixelsBuffer(Vector2.zero, image.Size, pixels)
		return Content.fromObject(image)
	end)
	if not ok then
		-- Usually the experience setting is off; stop trying so we warn only once.
		disabledReason = tostring(result)
		warn("[ImageLoader] Images unavailable, using plain fallbacks (" .. disabledReason .. "). In a published game enable Game Settings → Security → Allow Mesh / Image APIs.")
		cache[key] = false
		return nil
	end
	cache[key] = result
	return result
end

local function apply(instance: Instance)
	local key = instance:GetAttribute("Image")
	if type(key) ~= "string" then
		return
	end
	local content = ImageLoader.get(key)
	if not content then
		return
	end
	if instance:IsA("ImageLabel") then
		instance.ImageContent = content
		instance.Visible = true
	elseif instance:IsA("Decal") then
		instance.TextureContent = content
	end
end

-- Fills every tagged object now and as new ones replicate. Decoding is spread over frames.
function ImageLoader.watch()
	local queue = {}
	local running = false
	local function push(instance: Instance)
		table.insert(queue, instance)
		if running then
			return
		end
		running = true
		task.spawn(function()
			while #queue > 0 do
				local item = table.remove(queue, 1)
				local key = item:GetAttribute("Image")
				local fresh = type(key) == "string" and cache[key] == nil
				apply(item)
				if fresh then
					task.wait() -- one new decode per frame keeps the start-up smooth
				end
			end
			running = false
		end)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(push)
	for _, instance in CollectionService:GetTagged(TAG) do
		push(instance)
	end
end

ImageLoader.TAG = TAG

return ImageLoader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[-- Turns mouse or touch into shot or pass input.
--   SHOT: press on the goal to aim (X -1..1, Y 0..1), hold to charge the power meter, release.
--   PASS: press and drag; the point on the grass under the finger is where the ball goes, its
--         distance from the ball is the power. Release to pass (drags shorter than MinRange cancel).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local ShotPhysics = require(Shared:WaitForChild("ShotPhysics"))
local PassConfig = require(Shared:WaitForChild("PassConfig"))

local InputController = {}
InputController.__index = InputController

type Guide = {
	-- SHOT: presses only count near (aimX, aimY) and the aim stays there.
	aimX: number?,
	aimY: number?,
	accepts: (aimX: number, aimY: number) -> boolean,
	-- PASS: whether a release at this ground point counts.
	acceptsTarget: ((target: Vector3) -> boolean)?,
	onRejected: (() -> ())?,
}

function InputController.new()
	local self = setmetatable({
		enabled = false,
		holding = false,
		mode = "SHOT",
		aimX = 0,
		aimY = 0.5,
		power = 0,
		target = nil :: Vector3?, -- PASS: drop point on the ground
		passOrigin = PassConfig.Origin,
		-- SHOT: (aimX, aimY, power); PASS: (dirX, dirZ, power)
		onShoot = nil :: ((a: number, b: number, power: number) -> ())?,
		guide = nil :: Guide?,
		_activeInput = nil :: InputObject?,
		_holdStartedAt = 0,
	}, InputController)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		self:_onBegan(input, gameProcessed)
	end)
	UserInputService.InputChanged:Connect(function(input)
		self:_onChanged(input)
	end)
	UserInputService.InputEnded:Connect(function(input)
		self:_onEnded(input)
	end)
	return self
end

function InputController:setMode(mode: string, passOrigin: Vector3?)
	self.mode = mode
	self.passOrigin = passOrigin or PassConfig.Origin
	self.target = nil
	self.power = 0
end

function InputController:setEnabled(enabled: boolean)
	self.enabled = enabled
	if not enabled then
		self.holding = false
		self._activeInput = nil
		self.power = 0
		self.target = nil
	end
end

-- Call every frame: advances the shot power meter while held.
function InputController:update()
	if not self.holding or self.mode ~= "SHOT" then
		return
	end
	local phase = ((os.clock() - self._holdStartedAt) / ShotConfig.Input.PowerCycleSeconds) % 1
	self.power = 1 - math.abs(1 - 2 * phase) -- 0 -> 1 -> 0
end

function InputController:setGuide(guide: Guide?)
	self.guide = guide
	if guide and guide.aimX and guide.aimY then
		self.aimX, self.aimY = guide.aimX, guide.aimY
	end
end

local function screenRay(position: Vector3): Ray?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	return camera:ScreenPointToRay(position.X, position.Y)
end

-- Projects a screen point onto the goal plane (Z = 0).
local function screenToAim(position: Vector3): (number?, number?)
	local ray = screenRay(position)
	if not ray or ray.Direction.Z > -1e-4 then
		return nil, nil
	end
	local point = ray.Origin + ray.Direction * (-ray.Origin.Z / ray.Direction.Z)
	return ShotPhysics.goalPointToAim(point)
end

-- Projects a screen point onto the grass (Y = 0), limited to the longest pass.
function InputController:_screenToGround(position: Vector3): Vector3?
	local ray = screenRay(position)
	if not ray or ray.Direction.Y > -1e-4 then
		return nil
	end
	local point = ray.Origin + ray.Direction * (-ray.Origin.Y / ray.Direction.Y)
	local origin = self.passOrigin
	local delta = Vector3.new(point.X - origin.X, 0, point.Z - origin.Z)
	local maxRange = PassConfig.Ball.MaxRange
	if delta.Magnitude > maxRange then
		delta = delta.Unit * maxRange
	end
	return origin + delta
end

function InputController:_aimAt(position: Vector3)
	if self.mode == "PASS" then
		local target = self:_screenToGround(position)
		if target then
			self.target = target
			local origin = self.passOrigin
			self.power = Vector3.new(target.X - origin.X, 0, target.Z - origin.Z).Magnitude / PassConfig.Ball.MaxRange
		end
		return
	end
	if self.guide then
		return
	end
	local aimX, aimY = screenToAim(position)
	if aimX then
		self.aimX, self.aimY = aimX, aimY
	end
end

function InputController:_onBegan(input: InputObject, gameProcessed: boolean)
	if gameProcessed or not self.enabled or self.holding then
		return
	end
	local inputType = input.UserInputType
	if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
		local guide = self.guide
		if guide and self.mode == "SHOT" then
			local aimX, aimY = screenToAim(input.Position)
			if not (aimX and guide.accepts(aimX, aimY)) then
				if guide.onRejected then
					guide.onRejected()
				end
				return
			end
		end
		self.holding = true
		self._activeInput = input
		self._holdStartedAt = os.clock()
		self.power = 0
		self:_aimAt(input.Position)
	end
end

function InputController:_onChanged(input: InputObject)
	if not self.enabled then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		if self.mode == "SHOT" or self.holding then
			self:_aimAt(input.Position) -- PC: the shot marker follows the mouse even before clicking
		end
	elseif input.UserInputType == Enum.UserInputType.Touch and input == self._activeInput then
		self:_aimAt(input.Position)
	end
end

function InputController:_onEnded(input: InputObject)
	if not self.holding then
		return
	end
	local active = self._activeInput
	local isMouseRelease = input.UserInputType == Enum.UserInputType.MouseButton1
		and active ~= nil
		and active.UserInputType == Enum.UserInputType.MouseButton1
	if not (isMouseRelease or input == active) then
		return
	end

	self.holding = false
	self._activeInput = nil
	if not (self.enabled and self.onShoot) then
		return
	end
	if self.mode == "PASS" then
		local target = self.target
		local origin = self.passOrigin
		local delta = target and Vector3.new(target.X - origin.X, 0, target.Z - origin.Z)
		if not delta or delta.Magnitude < PassConfig.Ball.MinRange then
			self.target, self.power = nil, 0 -- a tap or a tiny drag: no pass
			return
		end
		local guide = self.guide
		if guide and guide.acceptsTarget and not guide.acceptsTarget(target :: Vector3) then
			if guide.onRejected then
				guide.onRejected()
			end
			self.target, self.power = nil, 0
			return
		end
		local dir = delta.Unit
		self.onShoot(dir.X, dir.Z, math.clamp(delta.Magnitude / PassConfig.Ball.MaxRange, 0, 1))
		return
	end
	self.onShoot(self.aimX, self.aimY, self.power)
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">KeeperAnimator</string>
            <string name="Source"><![CDATA[-- Procedural goalkeeper animation for the R15 rig (no animation assets needed).
-- Poses are joint rotations in degrees around the rig's own axes (X right, Y up, Z back;
-- +X swings a hanging limb forward, +Z swings it to the rig's right), blended with
-- exponential smoothing. Dives are authored towards world +X and mirrored for -X.
-- Client-only: the server's model never moves, every player animates their own keeper.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShotConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShotConfig"))

local Keeper = ShotConfig.Goalkeeper
local S = Keeper.ModelScale / 1.4 -- poses below were tuned at scale 1.4

local JOINT_NAMES = {
	"Waist", "Neck",
	"LeftShoulder", "LeftElbow", "LeftWrist", "RightShoulder", "RightElbow", "RightWrist",
	"LeftHip", "LeftKnee", "LeftAnkle", "RightHip", "RightKnee", "RightAnkle",
}

type Joints = { [string]: Vector3 }
type Plan = {
	reaction: number,
	impactTime: number, -- when the ball reaches the keeper's plane
	target: Vector3, -- body centre at impact, logic coordinates (see ShotConfig.Goalkeeper)
	kind: string?, -- "CATCH" | "PARRY" | nil (beaten or not diving)
	dives: boolean,
}

local function J(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

-- Ready stance; depth 0 = relaxed, 1 = set (player is charging the shot).
local function readyJoints(depth: number): Joints
	local hip, knee = 36 + 14 * depth, -(60 + 18 * depth)
	local spread = 32 + 8 * depth
	return {
		Waist = J(-16 - 6 * depth, 0, 0),
		Neck = J(12 + 4 * depth, 0, 0),
		LeftShoulder = J(26, 0, -spread), RightShoulder = J(26, 0, spread),
		LeftElbow = J(38, 0, 0), RightElbow = J(38, 0, 0),
		LeftWrist = J(-10, 0, 0), RightWrist = J(-10, 0, 0),
		LeftHip = J(hip, 0, -9), RightHip = J(hip, 0, 9),
		LeftKnee = J(knee, 0, 0), RightKnee = J(knee, 0, 0),
		LeftAnkle = J(24 + 4 * depth, 0, 0), RightAnkle = J(24 + 4 * depth, 0, 0),
	}
end

local function readyDrop(depth: number): number
	return -(0.45 + 0.2 * depth) * S
end

-- Towards world +X, which is the keeper's LEFT (he faces the shooter).
local LOAD: Joints = {
	Waist = J(-20, 0, 6), Neck = J(10, 0, 0),
	LeftShoulder = J(30, 0, -60), RightShoulder = J(30, 0, 40),
	LeftElbow = J(30, 0, 0), RightElbow = J(30, 0, 0),
	LeftWrist = J(-15, 0, 0), RightWrist = J(-15, 0, 0),
	LeftHip = J(28, 0, -24), RightHip = J(52, 0, 6),
	LeftKnee = J(-40, 0, 0), RightKnee = J(-85, 0, 0),
	LeftAnkle = J(18, 0, 0), RightAnkle = J(30, 0, 0),
}
local FLIGHT: Joints = {
	Waist = J(-4, 0, 10), Neck = J(6, 0, 12),
	LeftShoulder = J(12, 0, -158), RightShoulder = J(12, 0, 172),
	LeftElbow = J(6, 0, 0), RightElbow = J(8, 0, 0),
	LeftWrist = J(-25, 0, 0), RightWrist = J(-25, 0, 0),
	LeftHip = J(8, 0, -6), RightHip = J(-6, 0, 28),
	LeftKnee = J(-18, 0, 0), RightKnee = J(-10, 0, 0),
	LeftAnkle = J(25, 0, 0), RightAnkle = J(25, 0, 0),
}
local HUG: Joints = { -- ball pulled into the chest
	Waist = J(-22, 0, 4), Neck = J(-8, 0, 6),
	LeftShoulder = J(66, 0, -18), RightShoulder = J(66, 0, 18),
	LeftElbow = J(100, 0, 0), RightElbow = J(100, 0, 0),
	LeftWrist = J(0, 0, 0), RightWrist = J(0, 0, 0),
	LeftHip = J(48, 0, -8), RightHip = J(55, 0, 8),
	LeftKnee = J(-75, 0, 0), RightKnee = J(-85, 0, 0),
	LeftAnkle = J(20, 0, 0), RightAnkle = J(20, 0, 0),
}
local LYING: Joints = { -- after a parry or a goal: stretched out on the grass
	Waist = J(-2, 0, 4), Neck = J(4, 0, 8),
	LeftShoulder = J(10, 0, -150), RightShoulder = J(14, 0, 162),
	LeftElbow = J(12, 0, 0), RightElbow = J(15, 0, 0),
	LeftWrist = J(-10, 0, 0), RightWrist = J(-10, 0, 0),
	LeftHip = J(14, 0, -4), RightHip = J(22, 0, 14),
	LeftKnee = J(-30, 0, 0), RightKnee = J(-40, 0, 0),
	LeftAnkle = J(15, 0, 0), RightAnkle = J(15, 0, 0),
}
local DEJECTED: Joints = table.clone(LYING)
DEJECTED.Neck = J(-30, 0, 4)
DEJECTED.LeftShoulder = J(40, 0, -60)
DEJECTED.RightShoulder = J(40, 0, 70)

local JUMP: Joints = { -- central high ball: both arms straight up, knees tucked
	Waist = J(4, 0, 0), Neck = J(20, 0, 0),
	LeftShoulder = J(8, 0, -172), RightShoulder = J(8, 0, 172),
	LeftElbow = J(4, 0, 0), RightElbow = J(4, 0, 0),
	LeftWrist = J(-20, 0, 0), RightWrist = J(-20, 0, 0),
	LeftHip = J(40, 0, -6), RightHip = J(40, 0, 6),
	LeftKnee = J(-80, 0, 0), RightKnee = J(-80, 0, 0),
	LeftAnkle = J(30, 0, 0), RightAnkle = J(30, 0, 0),
}
local BLOCK: Joints = { -- central low/mid ball: get down behind it, hands in front
	Waist = J(-30, 0, 0), Neck = J(18, 0, 0),
	LeftShoulder = J(72, 0, -10), RightShoulder = J(72, 0, 10),
	LeftElbow = J(50, 0, 0), RightElbow = J(50, 0, 0),
	LeftWrist = J(-15, 0, 0), RightWrist = J(-15, 0, 0),
	LeftHip = J(78, 0, -14), RightHip = J(78, 0, 14),
	LeftKnee = J(-105, 0, 0), RightKnee = J(-105, 0, 0),
	LeftAnkle = J(30, 0, 0), RightAnkle = J(30, 0, 0),
}

local function mirror(joints: Joints): Joints
	local out = {}
	for name, v in joints do
		local swapped = if string.sub(name, 1, 4) == "Left" then "Right" .. string.sub(name, 5)
			elseif string.sub(name, 1, 5) == "Right" then "Left" .. string.sub(name, 6)
			else name
		out[swapped] = Vector3.new(v.X, -v.Y, -v.Z)
	end
	return out
end

local function blend(a: Joints, b: Joints, t: number): Joints
	local out = {}
	for _, name in JOINT_NAMES do
		local va, vb = a[name] or Vector3.zero, b[name] or Vector3.zero
		out[name] = va:Lerp(vb, t)
	end
	return out
end

local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function easeOut(t: number): number
	t = math.clamp(t, 0, 1)
	return 1 - (1 - t) * (1 - t)
end

local KeeperAnimator = {}
KeeperAnimator.__index = KeeperAnimator

function KeeperAnimator.new(model: Model)
	local self = setmetatable({}, KeeperAnimator)
	self.model = model
	self.home = model:GetPivot()
	self.homeRotation = self.home.Rotation
	self.motors = {}
	for _, name in JOINT_NAMES do
		local motor = model:FindFirstChild(name, true)
		if motor and motor:IsA("Motor6D") then
			self.motors[name] = { motor = motor, base = motor.C0 }
		end
	end
	self.leftHand = model:FindFirstChild("LeftHand", true)
	self.rightHand = model:FindFirstChild("RightHand", true)

	-- Current (smoothed) pose.
	self.joints = readyJoints(0)
	self.pos = Vector3.new(0, readyDrop(0), 0)
	self.roll = 0
	self.yaw = 0
	self.clock = 0
	self.state = "ready"
	self.charging = false
	self.chargeStarted = -math.huge
	self.lyingOffset = 0.95 * Keeper.ModelScale - self.home.Position.Y
	return self
end

function KeeperAnimator:setCharging(on: boolean)
	if on and not self.charging then
		self.chargeStarted = self.clock -- split-step hop as the shooter shapes up
	end
	self.charging = on
end

function KeeperAnimator:startShot(plan: Plan)
	self.state = "shot"
	self.plan = plan
	self.shotTime = 0
	self.charging = false
	local offset = Vector3.new(plan.target.X - Keeper.HomeX, plan.target.Y - Keeper.HomeY, 0)
	offset = Vector3.new(offset.X, math.max(offset.Y, self.lyingOffset * 0.55), 0)
	self.diveOffset = offset
	self.side = if offset.X >= 0 then 1 else -1
	-- Central balls are blocked or jumped for; everything else is a dive.
	if not plan.dives then
		self.style = "watch"
	elseif math.abs(offset.X) < 2.2 then
		self.style = if offset.Y > 1.2 then "jump" else "block"
	else
		self.style = "dive"
	end
	-- Lean from the feet towards the ball (world roll; negative leans to +X).
	local fromFeet = Vector3.new(offset.X, offset.Y + Keeper.HomeY, 0)
	self.diveRoll = math.clamp(math.deg(math.atan2(-fromFeet.X, fromFeet.Y)), -92, 92)
end

function KeeperAnimator:recover()
	self.state = "recover"
	self.recoverStarted = self.clock
	self.plan = nil
end

function KeeperAnimator:handsPosition(): Vector3?
	if self.leftHand and self.rightHand then
		return (self.leftHand.Position + self.rightHand.Position) / 2
	end
	return nil
end

-- Desired pose for this frame: joints, root offset, roll, yaw and smoothing rates.
function KeeperAnimator:_target(): (Joints, Vector3, number, number, number, number)
	local t = self.clock
	if self.state ~= "shot" then
		local depth = if self.charging then 1 else 0
		local joints = readyJoints(depth)
		local sway = if self.charging then 0 else math.sin(t * 2.1) * 0.45 * S
		local bounce = math.abs(math.sin(t * 4.2)) * 0.1 * S
		-- Weight shifts from foot to foot with the sway.
		local shift = math.sin(t * 2.1) * 6 * (1 - depth)
		joints.LeftHip += J(0, 0, -shift)
		joints.RightHip += J(0, 0, -shift)
		local hop = t - self.chargeStarted
		local lift = if hop < 0.32 then math.sin(hop / 0.32 * math.pi) * 0.6 * S else 0
		local pos = Vector3.new(sway, readyDrop(depth) + bounce + lift, 0)
		local rate = if self.state == "recover" and t - self.recoverStarted < 0.6 then 9 else 14
		return joints, pos, 0, 0, rate, rate
	end

	local plan = self.plan :: Plan
	local st = self.shotTime
	local side = self.side
	local offset = self.diveOffset
	local function sided(joints: Joints): Joints
		return if side > 0 then joints else mirror(joints)
	end

	if self.style == "watch" then
		local joints = readyJoints(0.4)
		joints.Neck += J(0, 40 * side, 0)
		joints.Waist += J(0, 15 * side, 0)
		local step = smoothstep((st - plan.reaction) / 0.4)
		return joints, Vector3.new(offset.X * step, readyDrop(0.4), 0), 0, 0, 12, 12
	end

	local reach = math.max(plan.impactTime - plan.reaction, 0.12)
	local alpha = (st - plan.reaction) / reach
	local after = st - plan.impactTime
	local caught = plan.kind == "CATCH"

	if alpha < 0 then
		return readyJoints(1), Vector3.new(0, readyDrop(1), 0), 0, 0, 16, 16
	end

	if self.style == "jump" or self.style == "block" then
		local high = self.style == "jump"
		local pose = if high then JUMP else BLOCK
		local landed = math.clamp(after / 0.35, 0, 1)
		local up = easeOut(alpha) * offset.Y
		local pos = Vector3.new(offset.X * easeOut(alpha), if high then up else readyDrop(1) - 0.35 * S, 0)
		if after > 0 then
			pos = Vector3.new(offset.X, if high then up * (1 - landed * landed) else pos.Y, 0)
			pose = if caught then HUG else blend(pose, readyJoints(1), landed * 0.5)
		end
		return pose, pos, 0, 0, 22, 26
	end

	-- Side dive: load, launch, stretch to the ball, then land on the side.
	local loadEnd = 0.18
	if alpha < loadEnd then
		local k = alpha / loadEnd
		local pos = Vector3.new(offset.X * 0.06 * k, readyDrop(1) - 0.25 * S * k, 0)
		return sided(blend(readyJoints(1), LOAD, k)), pos, self.diveRoll * 0.08 * k, 0, 28, 28
	end
	if after <= 0 then
		local u = (alpha - loadEnd) / (1 - loadEnd)
		local arc = if offset.Y > -1 then math.sin(u * math.pi) * 0.9 * S else 0
		local pos = offset * easeOut(u) + Vector3.new(0, arc, 0)
		return sided(blend(LOAD, FLIGHT, smoothstep(u * 1.6))), pos, self.diveRoll * smoothstep(u), 0, 30, 30
	end

	-- Landing: fall to the ground on the dive side, keep sliding a little.
	local land = math.clamp(after / 0.42, 0, 1)
	local fall = land * land
	local x = offset.X + side * 0.7 * S * easeOut(land)
	local y = offset.Y + (self.lyingOffset - offset.Y) * fall
	local roll = self.diveRoll + (-90 * side - self.diveRoll) * smoothstep(land)
	local pose = if caught then HUG elseif plan.kind == "PARRY" then LYING else (if after > 1.1 then DEJECTED else LYING)
	return sided(pose), Vector3.new(x, y, 0), roll, 0, 18, 12
end

function KeeperAnimator:update(dt: number)
	self.clock += dt
	if self.state == "shot" then
		self.shotTime += dt
	end
	local joints, pos, roll, yaw, rootRate, jointRate = self:_target()

	local jk = 1 - math.exp(-jointRate * dt)
	local rk = 1 - math.exp(-rootRate * dt)
	for _, name in JOINT_NAMES do
		local current = self.joints[name] or Vector3.zero
		self.joints[name] = current:Lerp(joints[name] or Vector3.zero, jk)
	end
	self.pos = self.pos:Lerp(pos, rk)
	self.roll += (roll - self.roll) * rk
	self.yaw += (yaw - self.yaw) * rk

	local root = CFrame.new(self.home.Position + self.pos) * CFrame.Angles(0, 0, math.rad(self.roll)) * self.homeRotation
	self.model:PivotTo(root * CFrame.Angles(0, math.rad(self.yaw), 0))
	for name, entry in self.motors do
		local a = self.joints[name]
		entry.motor.C0 = entry.base * CFrame.Angles(math.rad(a.X), math.rad(a.Y), math.rad(a.Z))
	end
end

return KeeperAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PassVisuals</string>
            <string name="Source"><![CDATA[-- 3D side of the pass drill: camera, the four players, ball, ground markers, the aiming line,
-- and the replay of the server's simulated pass. Everything is local to this client.
-- After a good pass the receiver shoots (beginFollowUp): the shot drill (ShotVisuals) owns the
-- camera and the ball then, and this keeps the players on the pitch, lines the receiver up
-- behind the ball and fades anyone standing between the camera and the goal while aiming.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local PassConfig = require(Shared:WaitForChild("PassConfig"))
local PassPhysics = require(Shared:WaitForChild("PassPhysics"))
local FigureBuilder = require(Shared:WaitForChild("FigureBuilder"))
local FigureAnimator = require(script.Parent:WaitForChild("FigureAnimator"))

local BALL_RADIUS = ShotConfig.Ball.Radius
local SCALE = ShotConfig.Goalkeeper.ModelScale
local LINE_DOTS = 22
local CAMERA_BLEND = 0.9
local FADE = 0.65 -- LocalTransparencyModifier for players blocking the view of the goal
local FADE_WIDTH = 4.5 -- studs either side of the camera-to-goal line

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local GOLD = rgb(255, 191, 31)
local LILAC = rgb(190, 168, 255)
local RED = rgb(255, 45, 85)

local SKIN = rgb(214, 132, 82)
local HAIR = rgb(52, 32, 26)
-- Our team in gold and purple until the career's club kit is set; the rival in red/black stripes
-- like the character sheet's opponent. Skin and hair come from each character's look.
local TEAM_KIT = { skin = SKIN, shirt = GOLD, shorts = rgb(43, 18, 80), socks = GOLD, boots = rgb(20, 14, 30), hair = HAIR, trim = rgb(43, 18, 80), band = rgb(43, 18, 80), print = rgb(43, 18, 80) }
local BLACK = rgb(24, 18, 26)
local OPPONENT_KIT = { skin = SKIN, shirt = rgb(204, 26, 44), stripes = BLACK, shorts = BLACK, socks = rgb(240, 236, 244), band = BLACK, trim = BLACK, boots = BLACK, print = WHITE, hair = HAIR, number = 9 }

local PassVisuals = {}
PassVisuals.__index = PassVisuals

local function create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function makePart(props: { [string]: any }): Part
	props.Anchored = true
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	props.CastShadow = props.CastShadow or false
	props.Material = props.Material or Enum.Material.SmoothPlastic
	return create("Part", props)
end

-- Flat circle on the grass, drawn as a crisp GUI on the part's top face.
local function groundCircle(parent: Instance, name: string, radius: number, color: Color3, fill: number)
	local part = makePart({ Name = name, Size = Vector3.new(radius * 2, 0.05, radius * 2), Transparency = 1, Parent = parent })
	local gui = create("SurfaceGui", {
		Face = Enum.NormalId.Top,
		LightInfluence = 0,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 24,
		Parent = part,
	})
	local circle = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -8, 1, -8),
		BackgroundColor3 = color,
		BackgroundTransparency = fill,
		Parent = gui,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = circle })
	local stroke = create("UIStroke", { Color = color, Thickness = 4, Parent = circle })
	return { part = part, frame = circle, stroke = stroke, gui = gui }
end

local function icosahedronDirections(): { Vector3 }
	local phi = (1 + math.sqrt(5)) / 2
	local dirs = {}
	for _, a in { -1, 1 } do
		for _, b in { -phi, phi } do
			table.insert(dirs, Vector3.new(0, a, b).Unit)
			table.insert(dirs, Vector3.new(a, b, 0).Unit)
			table.insert(dirs, Vector3.new(b, 0, a).Unit)
		end
	end
	return dirs
end

-- Position on a sampled track at time t (linear between samples).
local function trackAt(track: { Vector3 }, step: number, t: number): Vector3
	local f = math.max(t, 0) / step
	local i = math.floor(f)
	if i >= #track - 1 then
		return track[#track]
	end
	return track[i + 1]:Lerp(track[i + 2], f - i)
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function PassVisuals.new()
	local self = setmetatable({}, PassVisuals)
	self.clock = 0
	self.frozen = false
	self.token = 0
	self.ballRotation = CFrame.identity
	self.active = false

	local folder = create("Folder", { Name = "PassVisuals" })
	self.folder = folder

	-- Ball, same look as the shot drill's.
	local ballModel = create("Model", { Name = "Ball", Parent = folder })
	local shell = makePart({ Name = "Shell", Shape = Enum.PartType.Ball, Size = Vector3.one * BALL_RADIUS * 2, Color = WHITE, CastShadow = true, Parent = ballModel })
	self.ballParts = { { shell, CFrame.identity } }
	for _, dir in icosahedronDirections() do
		local reference = if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis
		local patch = makePart({
			Name = "Panel",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, BALL_RADIUS * 0.66, BALL_RADIUS * 0.66),
			Color = rgb(28, 18, 48),
			Parent = ballModel,
		})
		table.insert(self.ballParts, { patch, CFrame.fromMatrix(dir * BALL_RADIUS * 0.985, dir, dir:Cross(reference).Unit) })
	end

	local function figure(name: string, kit, look: string, number: number?)
		local dressed = table.clone(kit)
		dressed.number = number or kit.number
		local model, rootHeight = FigureBuilder.build(name, dressed, SCALE, "head", look)
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CastShadow = true
			end
		end
		model.Parent = folder
		local animator = FigureAnimator.new(model, rootHeight, SCALE)
		animator.fadeParts = {}
		animator.fade = 0
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("SurfaceGui") then
				table.insert(animator.fadeParts, d)
			end
		end
		return animator
	end
	-- You pass; the teammates receive and shoot; the rival defends.
	self.passer = figure("Passer", TEAM_KIT, "MAIN", 10)
	self.mates = { figure("Teammate1", TEAM_KIT, "TEAMMATE", 8), figure("Teammate2", TEAM_KIT, "TEAMMATE", 7) }
	self.defender = figure("Defender", OPPONENT_KIT, "RIVAL")

	-- Ground markers: where teammates can take the ball, and the defender's reach.
	self.mateRings = {
		groundCircle(folder, "MateRing1", PassConfig.Teammate.Reach + 0.8, LILAC, 0.85),
		groundCircle(folder, "MateRing2", PassConfig.Teammate.Reach + 0.8, LILAC, 0.85),
	}
	self.defenderZone = groundCircle(folder, "DefenderZone", PassConfig.Defender.Reach, RED, 0.7)
	self.targetRing = groundCircle(folder, "Target", 1.6, GOLD, 0.6)
	self.dots = {}
	for i = 1, LINE_DOTS do
		self.dots[i] = makePart({
			Name = "LineDot",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.06, 0.55, 0.55),
			Color = GOLD,
			Material = Enum.Material.Neon,
			Transparency = 1,
			Parent = folder,
		})
	end
	return self
end

-- The passer (you, with your number) and his teammates wear the player's club kit.
function PassVisuals:setTeamKit(kit, number: number?)
	for _, animator in { self.passer, self.mates[1], self.mates[2] } do
		FigureBuilder.applyKit(animator.model, kit)
	end
	if number then
		FigureBuilder.setNumber(self.passer.model, number)
	end
end

-- Shows the drill (parents everything into the workspace) and moves the camera over.
function PassVisuals:enter()
	if self.active and not self.followUp then
		return
	end
	self:_endFollowUp()
	self.active = true
	self.folder.Parent = workspace
	local camera = workspace.CurrentCamera
	self.blendFrom, self.blendFov, self.blendT = camera.CFrame, camera.FieldOfView, 0
end

function PassVisuals:exit()
	self:_endFollowUp()
	self.active = false
	self.folder.Parent = nil
end

local function setFade(animator, amount: number)
	if animator.fade == amount then
		return
	end
	animator.fade = amount
	for _, part in animator.fadeParts do
		if part:IsA("SurfaceGui") then
			part.Enabled = amount < 0.5 -- faces and prints can't fade, so they hide with the body
		else
			part.LocalTransparencyModifier = amount
		end
	end
end

function PassVisuals:_figures()
	return { self.passer, self.mates[1], self.mates[2], self.defender }
end

function PassVisuals:_endFollowUp()
	self.followUp = nil
	for _, figure in self:_figures() do
		setFade(figure, 0)
	end
end

-- The shot after a good pass: receiver index, ball spot and the shot camera's position.
function PassVisuals:beginFollowUp(receiver: number, spot: Vector3, cameraPosition: Vector3)
	if not (self.active and self.layout and self.mates[receiver]) then
		return -- nothing on the pitch to line up (e.g. joined mid-way); the shot still works
	end
	self.replay = nil
	self.frozen = true
	self.highlight = nil
	local toGoal = flat(-spot)
	toGoal = if toGoal.Magnitude > 1e-3 then toGoal.Unit else Vector3.new(0, 0, -1)
	local right = toGoal:Cross(Vector3.yAxis)
	self.followUp = {
		receiver = receiver,
		spot = spot,
		camera = flat(cameraPosition),
		stand = flat(spot - toGoal * 1.3 - right * 0.8), -- ball on his right foot
		toGoal = toGoal,
		kicked = false,
	}
	self:_setBall(Vector3.new(0, -50, 0)) -- the shot drill's ball takes over
	for _, ring in self.mateRings do
		ring.part.Parent = nil
	end
	self.defenderZone.part.Parent = nil
	self:updateAiming(false, nil, 0, false)
	self.mates[receiver]:play(nil)
end

-- The player released the shot: the receiver strikes it, everyone visible again.
function PassVisuals:followUpKick()
	local fu = self.followUp
	if fu then
		fu.kicked = true
		self.mates[fu.receiver]:play("KICK")
	end
end

-- The shot after the pass went in: the scorer celebrates.
function PassVisuals:celebrateGoal()
	local fu = self.followUp
	if fu then
		local scorer = self.mates[fu.receiver]
		task.delay(0.3, function()
			if self.followUp == fu then
				scorer:play("CHEER")
			end
		end)
	end
end

function PassVisuals:_updateFollowUp(dt: number)
	local fu = self.followUp
	local receiver = self.mates[fu.receiver]
	-- Receiver jogs the last steps to the ball; the others turn to watch.
	local towards = fu.stand - receiver.position
	local stepLen = math.min(towards.Magnitude, 9 * dt)
	local nextPos = if towards.Magnitude > 1e-3 then receiver.position + towards.Unit * stepLen else fu.stand
	receiver:moveTo(nextPos, fu.toGoal, dt)
	for _, figure in self:_figures() do
		if figure ~= receiver then
			figure:moveTo(figure.position, flat(fu.spot - figure.position), dt)
		end
	end
	-- Fade whoever stands between the camera and the goal (until the kick).
	local line = -fu.camera
	local lengthSq = line:Dot(line)
	for _, figure in self:_figures() do
		local rel = figure.position - fu.camera
		local t = rel:Dot(line) / lengthSq
		local lateral = (rel - line * t).Magnitude
		setFade(figure, if not fu.kicked and t > 0 and t < 1 and lateral < FADE_WIDTH then FADE else 0)
	end
end

function PassVisuals:_setBall(position: Vector3)
	local base = CFrame.new(position) * self.ballRotation
	for _, entry in self.ballParts do
		entry[1].CFrame = base * entry[2]
	end
	self.ballPosition = position
end

function PassVisuals:_placeRing(ring, position: Vector3)
	ring.part.CFrame = CFrame.new(position.X, 0.06, position.Z)
end

-- New episode: everyone back on their marks for this situation.
function PassVisuals:reset(layout)
	self.token += 1
	self.layout = layout
	self.clock = 0
	self.frozen = false
	self.replay = nil
	self.highlight = nil
	self:_endFollowUp()
	self.ballRotation = CFrame.identity
	local origin = layout.origin
	self:_setBall(origin + Vector3.new(0, BALL_RADIUS, 0))
	local toGoal = Vector3.new(0, 0, -1)
	self.aimFacing = toGoal
	self.passer:play(nil)
	self.passer:place(origin - toGoal * 1.5 + Vector3.new(-0.7, 0, 0), toGoal)
	for i, mate in self.mates do
		local at = layout.teammates[i]
		mate:play(nil)
		mate:place(at, flat(origin - at))
		self:_placeRing(self.mateRings[i], at)
		self.mateRings[i].part.Parent = self.folder
	end
	self.defender:play(nil)
	self.defender:place(PassPhysics.patrolAt(layout.defender, 0), flat(origin - PassPhysics.patrolAt(layout.defender, 0)))
	self.defenderZone.part.Parent = self.folder
	self:updateAiming(false, nil, 0, false)
end

-- Seconds since this episode was shown, stopped at the moment of the pass (sent to the server).
function PassVisuals:clockTime(): number
	return self.clock
end

-- Pulses one teammate's ring (the tutorial's target), or none.
function PassVisuals:setHighlight(index: number?)
	self.highlight = index
end

-- target: the drag point on the ground while holding (nil = not aiming).
function PassVisuals:updateAiming(enabled: boolean, target: Vector3?, power: number, holding: boolean)
	local layout = self.layout
	local show = enabled and holding and target ~= nil and layout ~= nil
	self.targetRing.part.Parent = if show then self.folder else nil
	for _, dot in self.dots do
		dot.Transparency = 1
	end
	self.aimTarget = if show then target else nil
	if not show then
		return
	end
	local origin = layout.origin
	local delta = flat((target :: Vector3) - origin)
	local length = delta.Magnitude
	if length < 1e-3 then
		return
	end
	local dir = delta / length
	self.aimFacing = dir
	self:_placeRing(self.targetRing, origin + delta)
	-- Dotted line from the ball to the drop point; gold within reach, lilac when too short to pass.
	local tooShort = length < PassConfig.Ball.MinRange
	local count = math.clamp(math.floor(length / 2.2), 2, LINE_DOTS)
	for i, dot in self.dots do
		if i <= count then
			local p = origin + dir * (length * i / (count + 1))
			dot.CFrame = CFrame.new(p.X, 0.08, p.Z) * CFrame.Angles(0, 0, math.pi / 2)
			dot.Color = if tooShort then LILAC else GOLD
			dot.Transparency = 0.15 + 0.5 * i / count
		end
	end
	self.targetRing.stroke.Color = if tooShort then LILAC else GOLD
	self.targetRing.frame.BackgroundColor3 = if tooShort then LILAC else GOLD
end

function PassVisuals:onPassReleased()
	self.frozen = true
	self.passer:play("KICK")
	self:updateAiming(false, nil, 0, false)
	for _, mate in self.mates do
		mate:play(nil)
	end
end

-- Replays the server's pass. onDecisive runs when the result is clear on screen.
function PassVisuals:playPass(result, onDecisive: () -> ())
	self.replay = {
		token = self.token,
		result = result,
		t = 0,
		onDecisive = onDecisive,
		decided = false,
		reacted = false,
	}
	self.defenderZone.part.Parent = nil
end

function PassVisuals:_updateReplay(dt: number)
	local replay = self.replay
	local result = replay.result
	local step = result.sampleStep
	replay.t += dt
	local t = replay.t

	local ball = trackAt(result.ball, step, t)
	local previous = self.ballPosition
	local position = Vector3.new(ball.X, BALL_RADIUS, ball.Z)
	-- Rolling: spin about the axis perpendicular to the motion.
	local moved = flat(position - previous)
	if moved.Magnitude > 1e-4 then
		local axis = Vector3.yAxis:Cross(moved.Unit)
		self.ballRotation = CFrame.fromAxisAngle(axis, moved.Magnitude / BALL_RADIUS) * self.ballRotation
	end
	self:_setBall(position)

	local defender = trackAt(result.defender, step, t)
	local defenderVelocity = trackAt(result.defender, step, t + 0.05) - defender
	local facing = if defenderVelocity.Magnitude > 0.05 then defenderVelocity else (position - defender)
	self.defender:moveTo(defender, facing, dt)

	for i, mate in self.mates do
		local home = self.layout.teammates[i]
		if result.receiver == i and result.receiverTrack then
			mate:moveTo(trackAt(result.receiverTrack, step, t), flat(position - mate.position), dt)
		else
			mate:moveTo(home, flat(position - home), dt)
		end
	end
	self.passer:moveTo(self.passer.position, flat(position - self.passer.position), dt)

	-- Reactions just before the decisive moment, so the pose lands with the ball.
	if not replay.reacted and t >= result.eventTime - 0.12 then
		replay.reacted = true
		local detail = result.detail
		local receiver = result.receiver and self.mates[result.receiver]
		if detail == "GOOD" and receiver then
			receiver:play("TRAP")
		elseif detail == "INTERCEPTED" then
			self.defender:play("LUNGE")
		elseif detail == "TOO_HARD" and receiver then
			receiver:play("LUNGE")
		end
	end
	if not replay.decided and t >= result.eventTime then
		replay.decided = true
		-- A good pass is just received (the TRAP above); celebrating is for goals.
		if result.detail == "INTERCEPTED" then
			task.delay(0.6, function()
				if self.replay == replay then
					self.defender:play("CHEER")
				end
			end)
		end
		replay.onDecisive()
	end
end

-- Per-frame: camera, the defender's patrol, idle players and the replay.
function PassVisuals:update(dt: number)
	if not self.active or not self.layout then
		return
	end
	if self.followUp then
		self:_updateFollowUp(dt)
		self.passer:update(dt)
		for _, mate in self.mates do
			mate:update(dt)
		end
		self.defender:update(dt)
		return
	end
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	local target = CFrame.lookAt(PassConfig.Camera.Position, PassConfig.Camera.LookAt)
	local fov = PassConfig.Camera.FieldOfView
	if self.blendT < 1 then
		self.blendT = math.min(1, self.blendT + dt / CAMERA_BLEND)
		local k = self.blendT * self.blendT * (3 - 2 * self.blendT)
		camera.CFrame = self.blendFrom:Lerp(target, k)
		camera.FieldOfView = self.blendFov + (fov - self.blendFov) * k
	else
		camera.CFrame = target
		camera.FieldOfView = fov
	end

	local layout = self.layout
	local origin = layout.origin
	if self.replay and self.replay.token == self.token then
		self:_updateReplay(dt)
	else
		if not self.frozen then
			self.clock += dt
		end
		local def = PassPhysics.patrolAt(layout.defender, self.clock)
		self.defender:moveTo(def, flat(self.ballPosition - def), if self.frozen then 0 else dt)
		self:_placeRing(self.defenderZone, def)
		local aim = self.aimTarget
		for i, mate in self.mates do
			local home = layout.teammates[i]
			mate:moveTo(home, flat(origin - home), dt)
			-- The teammate the line points at (or the tutorial target) calls for the ball.
			local calling = (aim and flat(aim - home).Magnitude < 7) or (self.highlight == i and not self.frozen)
			if not self.frozen then
				mate:play(if calling then "WAVE" else nil)
			end
		end
		-- The passer turns to where he's about to play it.
		local facing = self.aimFacing
		local stand = origin - facing * 1.5 - facing:Cross(Vector3.yAxis) * 0.7 -- ball on his right foot
		self.passer:moveTo(stand, facing, dt)
	end

	local pulse = 0.5 + 0.5 * math.sin(os.clock() * 6)
	for i, ring in self.mateRings do
		local lit = self.highlight == i and not self.frozen
		ring.stroke.Color = if lit then GOLD else LILAC
		ring.frame.BackgroundColor3 = if lit then GOLD else LILAC
		ring.frame.BackgroundTransparency = if lit then 0.75 - 0.15 * pulse else 0.85
		ring.stroke.Thickness = if lit then 5 + 3 * pulse else 4
	end

	self.passer:update(dt)
	for _, mate in self.mates do
		mate:update(dt)
	end
	self.defender:update(dt)
end

return PassVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">PlayerPreview</string>
            <string name="Source"><![CDATA[-- The player's footballer on the pitch during career creation, in the character sheet's MAIN
-- look and the chosen club's kit. He appears facing the camera (gold flash, sparkles), then turns
-- round to show the surname and number on his back; every change turns him to the back again.
-- Everything here is local to this client; CareerMenu drives it and owns the camera.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local CareerConfig = require(Shared:WaitForChild("CareerConfig"))
local FigureBuilder = require(Shared:WaitForChild("FigureBuilder"))
local FigureAnimator = require(script.Parent:WaitForChild("FigureAnimator"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local SCALE = ShotConfig.Goalkeeper.ModelScale -- same size as the training players
-- He stands between the shot spot and the camera, with the goal and the stand behind him.
local STAGE = Vector3.new(0, 0, 56)
-- Camera offset from his feet and the point it looks at, shifted left so he stands in the right
-- half of the screen, next to the creation form.
local FRAMINGS = {
	CREATE = { offset = Vector3.new(-4.6, 4.4, 17), look = Vector3.new(-4.6, 3.7, 0), fov = 40 },
}
local FADE_IN = 0.55
local FRONT_HOLD = 1.5 -- seconds facing the camera before the first turn (CREATE)
local TURN_TIME = 0.9
local PRINT_PIXELS = 60 -- SurfaceGui pixels per stud on the shirt

local PlayerPreview = {}
PlayerPreview.__index = PlayerPreview

local function smooth(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function facingFor(angle: number): Vector3
	return Vector3.new(math.sin(angle), 0, math.cos(angle))
end

-- Angle at which he faces the camera of a framing.
local function frontAngle(framing): number
	return math.atan2(framing.offset.X, framing.offset.Z)
end

local function makePart(props: { [string]: any }): Part
	props.Anchored = true
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	props.CastShadow = props.CastShadow or false
	props.TopSurface = Enum.SurfaceType.Smooth
	props.BottomSurface = Enum.SurfaceType.Smooth
	return UiKit.create("Part", props)
end

function PlayerPreview.new()
	local self = setmetatable({}, PlayerPreview)
	self.folder = UiKit.create("Folder", { Name = "CareerPreview" })
	self.visible = false
	self.clock = 0
	self.club = nil
	self.animator = nil
	self.framing = FRAMINGS.CREATE
	self.front = frontAngle(self.framing)
	self.angle = self.front
	self.turnFrom, self.turnTo, self.turnStart = self.angle, self.angle, -math.huge
	self.facingBack = false
	self.introAt = nil :: number?
	self.appearStart = 0
	self.fadeParts = {}
	self.fadeGuis = {}
	self.prints = {}

	-- Showcase lighting: warm key light from the camera side, violet rim from behind.
	local key = makePart({ Name = "KeyLight", Size = Vector3.one * 0.2, Transparency = 1, Position = STAGE + Vector3.new(-2, 8, 9), Parent = self.folder })
	UiKit.create("PointLight", { Color = UiKit.rgb(255, 232, 200), Brightness = 1.6, Range = 18, Shadows = false, Parent = key })
	local rim = makePart({ Name = "RimLight", Size = Vector3.one * 0.2, Transparency = 1, Position = STAGE + Vector3.new(2.5, 8, -4), Parent = self.folder })
	UiKit.create("PointLight", { Color = UiKit.GLOW, Brightness = 3, Range = 13, Shadows = false, Parent = rim })

	-- Thin gold ring under his feet (a flat SurfaceGui, so it stays a clean outline).
	local ringPart = makePart({ Name = "Ring", Size = Vector3.new(6.4, 0.05, 6.4), Transparency = 1, Position = STAGE + Vector3.new(0, 0.05, 0), Parent = self.folder })
	local ringGui = UiKit.create("SurfaceGui", { Face = Enum.NormalId.Top, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40, LightInfluence = 0, Parent = ringPart })
	local ring = UiKit.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = UiKit.GLOW, BackgroundTransparency = 0.88, Parent = ringGui })
	UiKit.corner(ring)
	self.ringStroke = UiKit.stroke(ring, UiKit.GOLD, 6, 0.2)

	self.flash = makePart({
		Name = "Flash",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.05, 2, 2),
		CFrame = CFrame.new(STAGE + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = UiKit.GOLD,
		Material = Enum.Material.Neon,
		Transparency = 1,
		Parent = self.folder,
	})
	local sparkleCarrier = makePart({ Name = "Sparkles", Size = Vector3.one * 0.2, Transparency = 1, Position = STAGE + Vector3.new(0, 4.2, 0), Parent = self.folder })
	self.sparkles = UiKit.create("ParticleEmitter", {
		Enabled = false,
		Color = ColorSequence.new(UiKit.GOLD_LIGHT, UiKit.GOLD),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new(0.1),
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(7, 14),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -10, 0),
		Drag = 2,
		Parent = sparkleCarrier,
	})
	return self
end

-- Where the camera looks at him from, its field of view and how far he is.
function PlayerPreview.cameraTarget(mode: string): (CFrame, number, number)
	local framing = FRAMINGS[mode] or FRAMINGS.CREATE
	return CFrame.lookAt(STAGE + framing.offset, STAGE + framing.look), framing.fov, framing.offset.Magnitude
end

-- Shirt prints: number and badge on the chest, surname and big number on the back.
function PlayerPreview:_dressShirt(model: Model, club)
	local torso = model:FindFirstChild("UpperTorso") :: BasePart
	local function makePrint(face: Enum.NormalId, name: string): SurfaceGui
		return UiKit.create("SurfaceGui", {
			Name = name,
			Face = face,
			SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
			PixelsPerStud = PRINT_PIXELS,
			LightInfluence = 1,
			ZOffset = 1, -- above the collar drawn by FigureBuilder
			Parent = torso,
		})
	end
	local function numberLabel(parent: Instance, position: UDim2, size: UDim2): TextLabel
		return UiKit.text({
			Name = "Number",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = size,
			Text = "",
			FontFace = UiKit.FONT_PRINT,
			TextColor3 = club.print,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextScaled = true,
			Parent = parent,
		})
	end

	local back = makePrint(Enum.NormalId.Back, "BackPrint")
	self.backName = UiKit.text({
		Name = "Surname",
		Position = UDim2.fromScale(0.06, 0.07),
		Size = UDim2.fromScale(0.88, 0.2),
		Text = "",
		FontFace = UiKit.FONT_PRINT,
		TextColor3 = club.print,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = back,
	})
	UiKit.sizeLimit(self.backName, 40)
	local numberHolder = UiKit.frame({ Name = "NumberHolder", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.62), Size = UDim2.fromScale(0.8, 0.64), BackgroundTransparency = 1, Parent = back })
	self.numberPop = UiKit.create("UIScale", { Parent = numberHolder })
	self.backNumber = numberLabel(numberHolder, UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1))

	local front = makePrint(Enum.NormalId.Front, "FrontPrint")
	self.frontNumber = numberLabel(front, UDim2.fromScale(0.5, 0.58), UDim2.fromScale(0.42, 0.5))
	UiKit.crest(front, { Name = "Badge", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.8, 0.24), Size = UDim2.fromOffset(28, 28) }, club)
	self.prints = { back, front }
end

function PlayerPreview:_build(club)
	if self.animator then
		self.animator.model:Destroy()
	end
	local model, rootHeight = FigureBuilder.build("CareerPlayer", CareerConfig.kit(club), SCALE, "head", "MAIN")
	self.fadeParts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CastShadow = true
			table.insert(self.fadeParts, d)
		elseif d:IsA("SurfaceGui") then
			table.insert(self.fadeGuis, d)
		end
	end
	self:_dressShirt(model, club)
	model.Parent = self.folder
	self.animator = FigureAnimator.new(model, rootHeight, SCALE)
	self.club = club
end

function PlayerPreview:_setFade(amount: number)
	for _, part in self.fadeParts do
		part.LocalTransparencyModifier = amount
	end
	for _, gui in self.prints do
		gui.Enabled = amount < 0.5
	end
	for _, gui in self.fadeGuis do
		gui.Enabled = amount < 0.5
	end
end

function PlayerPreview:_turn(delta: number)
	self.turnFrom = self.angle
	self.turnTo += delta
	self.turnStart = self.clock
end

function PlayerPreview:showBack()
	if not self.facingBack then
		self.facingBack = true
		self:_turn(math.pi)
	end
end

function PlayerPreview:showFront()
	if self.facingBack then
		self.facingBack = false
		self:_turn(math.pi)
	end
end

function PlayerPreview:_appear(club, mode: string)
	if club ~= self.club then
		self.fadeGuis = {}
		self:_build(club)
	end
	self.mode = mode
	self.framing = FRAMINGS[mode]
	self.front = frontAngle(self.framing)
	self.folder.Parent = workspace
	self.visible = true
	self.angle, self.turnFrom, self.turnTo, self.turnStart = self.front, self.front, self.front, -math.huge
	self.facingBack = false
	self.animator:place(STAGE, facingFor(self.front))
	self.animator:play(nil)
	self.appearStart = self.clock
	self:_setFade(1)

	self.flash.Size = Vector3.new(0.05, 2, 2)
	self.flash.Transparency = 0.1
	TweenService:Create(self.flash, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.05, 15, 15), Transparency = 1 }):Play()
	task.delay(0.12, function()
		if self.visible then
			self.sparkles:Emit(36)
		end
	end)
end

-- Player creation: appears in the club's kit facing the camera, then turns to show the back.
function PlayerPreview:show(club, lastName: string, number: number?)
	self:_appear(club, "CREATE")
	self.introAt = self.clock + FRONT_HOLD
	self:setIdentity(lastName, number, true)
end

-- Updates the shirt prints. Unless `quiet`, he turns to show the back and the number pops.
function PlayerPreview:setIdentity(lastName: string, number: number?, quiet: boolean?)
	if not self.animator then
		return
	end
	local surname = CareerConfig.upper(lastName)
	local digits = if number then tostring(number) else ""
	local changed = self.backName.Text ~= surname or self.backNumber.Text ~= digits
	self.backName.Text = surname
	self.backNumber.Text = digits
	self.frontNumber.Text = digits
	if quiet or not changed or self.introAt then
		return
	end
	self:showBack()
	self.numberPop.Scale = 1.3
	TweenService:Create(self.numberPop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Contract signed: turns to the camera and gives a short nod.
function PlayerPreview:celebrate()
	self.introAt = nil
	self:showFront()
	if self.animator then
		self.animator:play("NOD")
	end
	self.sparkles:Emit(24)
end

function PlayerPreview:hide()
	self.visible = false
	self.mode = nil
	self.folder.Parent = nil
	if self.animator then
		self.animator:play(nil)
	end
end

function PlayerPreview:update(dt: number)
	if not (self.visible and self.animator) then
		return
	end
	self.clock += dt
	self:_setFade(1 - smooth((self.clock - self.appearStart) / FADE_IN))
	if self.introAt and self.clock >= self.introAt then
		self.introAt = nil
		self:showBack()
	end
	self.angle = self.turnFrom + (self.turnTo - self.turnFrom) * smooth((self.clock - self.turnStart) / TURN_TIME)
	self.animator:place(STAGE, facingFor(self.angle))
	self.animator:update(dt)
	self.ringStroke.Transparency = 0.15 + 0.3 * (0.5 + 0.5 * math.sin(self.clock * 2.4))
end

return PlayerPreview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ShotHud</string>
            <string name="Source"><![CDATA[-- Screen UI for the shot drill in the purple "pixel UI kit" style: logo + stage, goals counter,
-- bottom power panel and the result card. Layout is designed at 1280x720 and scaled per panel.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local ImageLoader = require(script.Parent:WaitForChild("ImageLoader"))

local ShotHud = {}
ShotHud.__index = ShotHud

-- Optional uploaded copy of the logo, e.g. "rbxassetid://1234567890". Empty = the logo PNG
-- embedded in Images/Logo.lua; the text wordmark is only used if images are unavailable.
local LOGO_IMAGE = ""

-- All player-facing text in one place.
local TEXT = {
	LogoTop = "NEW",
	LogoMiddle = "FOOTBALL",
	LogoBottom = "STAR",
	Mode = 'ОБУЧЕНИЕ  •  <font color="#FFBF1F">УДАРЫ</font>',
	ModePass = 'ОБУЧЕНИЕ  •  <font color="#FFBF1F">ПАС</font>',
	Stage = "Этап %d из 2",
	StageFree = "Обучение пройдено",
	Goals = "ГОЛЫ",
	Power = "СИЛА %d%%",
	PowerHint = "55–85% — удобно   ·   100% — мяч летит выше",
	Ready = "Зажми точку у ворот и отпусти для удара",
	Holding = "Отпусти, чтобы ударить",
	Flying = "Удар!",
	AfterShot = "Выбери точку удара и попробуй ещё",
	TutorialReady = "Повтори за пальцем: нажми на кружок и держи",
	TutorialHolding = "Отпусти, когда сила в зелёной зоне",
	PowerZone = "ЗОНА УДАРА",
	PassPowerZone = "ДО ПАРТНЁРА",
	PassPowerHint = "Сила = длина паса   ·   дальше партнёра — не удержит",
	PassReady = "Нажми и веди к партнёру, отпусти — пас",
	PassHolding = "Отпусти, чтобы отдать пас",
	PassFlying = "Пас!",
	PassAfter = "Выбери свободного партнёра",
	PassTutorialReady = "Повтори за пальцем: веди от мяча к партнёру",
	PassTutorialHolding = "Отпусти на партнёре",
	PassReceived = "Принял! Теперь удар",
	FollowUpReady = "Партнёр принял пас — бей по воротам!",
	FollowUpGoal = "Пас и гол! Осталось пасов: %d",
	FollowUpMiss = "Пас засчитан. Осталось пасов: %d",
	CompleteBonus = "Голов после паса: %d",
	NextShot = "ЕЩЁ УДАР  ›",
	Speed = "%d км/ч",
	-- Training
	GoalsTutorial = "ПОДСКАЗКА",
	GoalsTask = "ЗАДАНИЕ: ЗАБЕЙ %d",
	GoalsTaskPass = "ЗАДАНИЕ: %d ТОЧНЫХ ПАСОВ",
	PassTutorialDone = "Отличный пас! Теперь сделай %d точных пасов",
	PassLeft = "Осталось пасов: %d",
	TutorialDone = "Так и бей! Теперь забей %d голов",
	ToTask = "К ЗАДАНИЮ  ›",
	TutorialRetry = "Попробуй ещё раз по подсказке",
	TaskLeft = "Осталось забить: %d",
	CompleteTitle = "ТРЕНИРОВКА\nПРОЙДЕНА!",
	CompleteSubtitle = "%d голов за %d ударов",
	CompleteSubtitlePass = "%d точных пасов за %d попыток",
	CompleteSpeed = "Лучший удар: %d км/ч",
	CompleteStage = "Этап %d из 2 пройден",
	PlayAgain = "ЕЩЁ РАЗ",
	Next = "ДАЛЕЕ  ›",
	Finish = "ГОТОВО  ›", -- after the last stage: back to the career menu
	Outcomes = {
		GOAL = { "ГОЛ!", "Отличное попадание в створ" },
		POST_IN = { "ГОЛ!", "От штанги в сетку!" },
		CATCH = { "ПОЙМАЛ!", "Вратарь забрал мяч. Бей ближе к углу" },
		PARRY = { "ОТБИЛ!", "Вратарь дотянулся. Ещё чуть точнее" },
		SAVE = { "СЕЙВ!", "Вратарь успел. Целься ближе к углу" },
		POST = { "ШТАНГА!", "Совсем рядом. Чуть ближе к центру" },
		BAR = { "ПЕРЕКЛАДИНА!", "Совсем рядом. Чуть ниже" },
		WIDE = { "МИМО!", "Мяч прошёл мимо ворот" },
		OVER = { "ВЫШЕ ВОРОТ!", "Слишком сильно. Сбавь силу" },
		PASS_GOOD = { "ТОЧНЫЙ ПАС!", "Партнёр принял мяч" },
		PASS_INTERCEPTED = { "ПЕРЕХВАТ!", "Защитник успел. Пасуй свободному или дождись момента" },
		PASS_TOO_HARD = { "СЛИШКОМ СИЛЬНО!", "Партнёр не удержал. Отпускай ближе к нему" },
		PASS_SHORT = { "НЕ ДОШЁЛ!", "Слабый пас. Веди палец до партнёра" },
		PASS_WIDE = { "МИМО!", "Пас ушёл мимо партнёра" },
	},
}

local rgb = Color3.fromRGB
local NAVY = rgb(18, 11, 36)
local PANEL_TOP = rgb(43, 18, 80)
local PANEL_BOTTOM = rgb(27, 15, 51)
local VIOLET = rgb(90, 47, 194)
local GLOW = rgb(123, 77, 255)
local LILAC = rgb(190, 168, 255)
local RED = rgb(255, 45, 85)
local RED_LIGHT = rgb(255, 150, 170)
local GOLD = rgb(255, 191, 31)
local GOLD_LIGHT = rgb(255, 226, 120)
local LIME = rgb(170, 240, 40)
local ORANGE = rgb(255, 159, 10)
local LIP = rgb(178, 84, 0)
local CREAM = rgb(247, 236, 214)
local INK = rgb(18, 6, 31)
local SHADOW = rgb(46, 16, 92)
local WHITE = Color3.new(1, 1, 1)

-- Card look per result kind: title gradient (top -> bottom), glow accent and badge glyph.
local KIND_STYLE = {
	GOAL = { top = CREAM, bottom = GOLD, accent = GOLD, icon = "⚽", sparkle = true },
	POST_IN = { top = CREAM, bottom = GOLD, accent = GOLD, icon = "⚽", sparkle = true },
	CATCH = { top = CREAM, bottom = LILAC, accent = GLOW, icon = "🧤" },
	PARRY = { top = CREAM, bottom = LILAC, accent = GLOW, icon = "🧤" },
	SAVE = { top = CREAM, bottom = LILAC, accent = GLOW, icon = "🧤" },
	POST = { top = GOLD_LIGHT, bottom = ORANGE, accent = ORANGE, icon = "🥅" },
	BAR = { top = GOLD_LIGHT, bottom = ORANGE, accent = ORANGE, icon = "🥅" },
	WIDE = { top = RED_LIGHT, bottom = RED, accent = RED, icon = "❌" },
	OVER = { top = RED_LIGHT, bottom = RED, accent = RED, icon = "❌" },
	PASS_GOOD = { top = CREAM, bottom = GOLD, accent = GOLD, icon = "👟", sparkle = true },
	PASS_INTERCEPTED = { top = CREAM, bottom = LILAC, accent = GLOW, icon = "✋" },
	PASS_TOO_HARD = { top = GOLD_LIGHT, bottom = ORANGE, accent = ORANGE, icon = "💨" },
	PASS_SHORT = { top = RED_LIGHT, bottom = RED, accent = RED, icon = "❌" },
	PASS_WIDE = { top = RED_LIGHT, bottom = RED, accent = RED, icon = "❌" },
}
local PIP_COLORS = { GOAL = GOLD, SAVE = GLOW, POST = CREAM, MISS = RED, GOOD = GOLD, INTERCEPTED = GLOW }

local MONTSERRAT = "rbxasset://fonts/families/Montserrat.json"
local FONT_HEAVY = Font.new(MONTSERRAT, Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
local FONT_BOLD = Font.new(MONTSERRAT, Enum.FontWeight.Bold, Enum.FontStyle.Italic)
local FONT_MEDIUM = Font.new(MONTSERRAT, Enum.FontWeight.Medium)

local DESIGN_SIZE = Vector2.new(1280, 720)
-- Phone layout: screens whose short side is under PHONE_HEIGHT get PHONE_BOOST, limited so the
-- widest row (power panel) and the tallest panel (completion menu) still fit.
local PHONE_HEIGHT = 500
local PHONE_BOOST = 1.7
local PHONE_MIN_WIDTH = 680
local PHONE_MIN_HEIGHT = 400
local PHONE_LOGO = 0.8 -- the logo panel is decoration; on phones it gives its room to the goal
local PHONE_GOALS = 0.68 -- the goals panel sits over the pitch on phones, so it is drawn smaller
local POWER_SEGMENTS = 20
local POWER_WARN = 0.85
local STAGE_COUNT = 2 -- training stages: shot, pass

local function create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function frame(props: { [string]: any }): Frame
	props.BorderSizePixel = 0
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 0
	end
	return create("Frame", props)
end

local function text(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = 1
	props.RichText = true
	props.FontFace = props.FontFace or FONT_HEAVY
	props.TextColor3 = props.TextColor3 or CREAM
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return create("TextLabel", props)
end

local function corner(parent: Instance, radius: number?)
	create("UICorner", { CornerRadius = if radius then UDim.new(0, radius) else UDim.new(1, 0), Parent = parent })
end

-- Border stroke for frames and buttons.
local function stroke(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	return create("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

-- Text outline; mitred joins keep the chunky pixel-kit corners.
local function outline(label: TextLabel, thickness: number, color: Color3?): UIStroke
	return create("UIStroke", {
		Color = color or INK,
		Thickness = thickness,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = label,
	})
end

local function sizeLimit(label: TextLabel, maxSize: number)
	label.TextScaled = true
	create("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8, Parent = label })
end

-- Outlined text with a hard drop shadow (a sibling label, so it cannot be a child of the text).
local shadowOf = setmetatable({}, { __mode = "k" })

local function bigText(props: { [string]: any }, thickness: number, offset: Vector2, maxSize: number?): TextLabel
	local shadowProps = table.clone(props)
	shadowProps.Name = (props.Name or "Text") .. "Shadow"
	shadowProps.TextColor3 = SHADOW
	shadowProps.Position = (props.Position or UDim2.new()) + UDim2.fromOffset(offset.X, offset.Y)
	shadowProps.Text = string.gsub(props.Text or "", "<[^>]+>", "")
	local shadow = text(shadowProps)
	outline(shadow, thickness)
	local main = text(table.clone(props))
	outline(main, thickness)
	if maxSize then
		sizeLimit(shadow, maxSize)
		sizeLimit(main, maxSize)
	end
	shadowOf[main] = shadow
	return main
end

local function setBigText(label: TextLabel, value: string)
	label.Text = value
	local shadow = shadowOf[label]
	if shadow then
		shadow.Text = string.gsub(value, "<[^>]+>", "")
	end
end

-- Dark purple panel: vertical gradient, violet border and a soft glow from stacked strokes.
-- Returns the root and its glow strokes so callers can recolour them.
local function panel(props: { [string]: any }, radius: number, glowColor: Color3?): (Frame, { UIStroke })
	props.BackgroundTransparency = 1
	local root = frame(props)
	local glows = {}
	for _, layer in { { 4, 0.7 }, { 9, 0.84 }, { 16, 0.93 } } do
		local halo = frame({ Name = "Glow", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, Parent = root })
		corner(halo, radius)
		table.insert(glows, stroke(halo, glowColor or GLOW, layer[1], layer[2]))
	end
	local bg = frame({ Name = "Background", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.04, ZIndex = 0, Parent = root })
	corner(bg, radius)
	create("UIGradient", { Color = ColorSequence.new(PANEL_TOP, PANEL_BOTTOM), Rotation = 90, Parent = bg })
	stroke(bg, VIOLET, 2)
	-- Thin top highlight, like the bevel on the reference panels.
	frame({
		Name = "Sheen",
		Position = UDim2.new(0, radius, 0, 3),
		Size = UDim2.new(1, -radius * 2, 0, 2),
		BackgroundColor3 = LILAC,
		BackgroundTransparency = 0.7,
		ZIndex = 0,
		Parent = root,
	})
	return root, glows
end

local function iconBox(parent: Instance, position: UDim2, size: number, accent: Color3): Frame
	local box = frame({ Name = "IconBox", Position = position, Size = UDim2.fromOffset(size, size), BackgroundColor3 = NAVY, Parent = parent })
	corner(box, 8)
	stroke(box, accent, 2)
	frame({ Name = "Bevel", Position = UDim2.fromOffset(4, 3), Size = UDim2.new(1, -8, 0, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0.88, Parent = box })
	return box
end

local function emoji(parent: Instance, glyph: string, size: number): TextLabel
	return text({
		Name = "Glyph",
		Size = UDim2.fromScale(1, 1),
		Text = glyph,
		TextSize = size,
		FontFace = FONT_MEDIUM,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = parent,
	})
end

local function crosshairIcon(parent: Instance)
	local ring = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(28, 28), BackgroundTransparency = 1, Parent = parent })
	corner(ring)
	stroke(ring, GOLD, 3)
	local dot = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = RED, Parent = ring })
	corner(dot, 1)
	for _, tick in { { 0.5, 0, 3, 10 }, { 0.5, 1, 3, 10 }, { 0, 0.5, 10, 3 }, { 1, 0.5, 10, 3 } } do
		frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(tick[1], tick[2]),
			Size = UDim2.fromOffset(tick[3], tick[4]),
			BackgroundColor3 = GOLD,
			Parent = ring,
		})
	end
end

-- Decorative "////" slashes from the reference panels.
local function slashes(parent: Instance, position: UDim2, size: number, color: Color3)
	text({
		Name = "Slashes",
		Position = position,
		Size = UDim2.fromOffset(size * 2.2, size),
		TextSize = size,
		Text = "////",
		TextColor3 = color,
		TextTransparency = 0.75,
		Parent = parent,
	})
end

-- Gold arc: a pill-shaped stroke whose middle is faded out, leaving two curved ends.
local function swoosh(parent: Instance, position: UDim2, size: UDim2, thickness: number, rotation: number)
	local ring = frame({ Name = "Swoosh", AnchorPoint = Vector2.new(0.5, 0.5), Position = position, Size = size, BackgroundTransparency = 1, ZIndex = 0, Parent = parent })
	corner(ring)
	local s = stroke(ring, WHITE, thickness)
	create("UIGradient", {
		Color = ColorSequence.new(GOLD_LIGHT, ORANGE),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(0.3, 1),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Rotation = rotation,
		Parent = s,
	})
end

local function logoImageId(): string?
	if LOGO_IMAGE == "" then
		return nil
	end
	return if string.match(LOGO_IMAGE, "^%d+$") then "rbxassetid://" .. LOGO_IMAGE else LOGO_IMAGE
end

-- "NEW / FOOTBALL / STAR ★" stacked and tilted, cream + red with gold swooshes.
local function buildWordmark(parent: Instance): Frame
	local tilt = frame({ Name = "Tilt", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), Rotation = -8, BackgroundTransparency = 1, Parent = parent })
	swoosh(tilt, UDim2.new(0.5, 10, 0.5, 4), UDim2.fromOffset(296, 116), 5, -28)
	swoosh(tilt, UDim2.new(0.5, 18, 0.5, 8), UDim2.fromOffset(262, 96), 2, -20)

	bigText({ Name = "New", Text = TEXT.LogoTop, TextSize = 34, Position = UDim2.fromOffset(36, 4), Size = UDim2.fromOffset(120, 34), Parent = tilt }, 3, Vector2.new(3, 4))
	bigText({ Name = "Football", Text = TEXT.LogoMiddle, TextSize = 44, Position = UDim2.fromOffset(10, 34), Size = UDim2.fromOffset(276, 44), Parent = tilt }, 3.5, Vector2.new(3, 4))
	bigText({ Name = "Star", Text = TEXT.LogoBottom, TextSize = 50, TextColor3 = RED, Position = UDim2.fromOffset(46, 76), Size = UDim2.fromOffset(148, 48), Parent = tilt }, 4, Vector2.new(3, 4))

	local starHolder = frame({ Name = "StarIcon", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(218, 98), Size = UDim2.fromOffset(52, 52), BackgroundTransparency = 1, Parent = tilt })
	bigText({ Text = "★", TextSize = 48, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = starHolder }, 3, Vector2.new(2, 3))
	return starHolder
end

function ShotHud.new()
	local self = setmetatable({}, ShotHud)
	self.text = TEXT -- shared with the entry script for training messages
	self.scales = {}
	self.onContinue = nil :: (() -> ())?
	self.onRetry = nil :: (() -> ())? -- completion menu buttons
	self.onNext = nil :: (() -> ())?
	self.scale = 1
	self.uiBoost = 1 -- "large interface" setting

	local gui = create("ScreenGui", {
		Name = "ShotHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	self.gui = gui

	self:_buildLogo()
	self:_buildGoals()
	self:_buildPowerPanel()
	self:_buildCard()
	self:_buildCompleteMenu()

	-- Measured in GUI units (inside the safe area), so it matches what the panels are laid out in.
	local function rescale()
		local size = gui.AbsoluteSize
		if size.X < 1 or size.Y < 1 then
			return
		end
		local scale = math.min(size.X / DESIGN_SIZE.X, size.Y / DESIGN_SIZE.Y)
		local phone = math.min(size.X, size.Y) < PHONE_HEIGHT
		if phone then
			-- Phones: the design-size fit makes text tiny, so go bigger while everything still fits.
			scale = math.min(scale * PHONE_BOOST, (size.X - 40) / PHONE_MIN_WIDTH, (size.Y - 20) / PHONE_MIN_HEIGHT)
		end
		scale = math.clamp(scale, 0.5, 1.3)
		if self.uiBoost ~= 1 then
			-- Bigger, but never past the edges the phone limits above protect.
			scale = math.min(scale * self.uiBoost, (size.X - 40) / PHONE_MIN_WIDTH, (size.Y - 20) / PHONE_MIN_HEIGHT)
		end
		self.scale = scale
		for _, uiScale in self.scales do
			uiScale.Scale = scale
		end
		self.logoScale.Scale = if phone then scale * PHONE_LOGO else scale
		self.goalsScale.Scale = if phone then scale * PHONE_GOALS else scale
	end
	rescale()
	self._rescale = rescale
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	return self
end

-- Hidden while the career menus are open.
function ShotHud:setVisible(visible: boolean)
	self.gui.Enabled = visible
end

function ShotHud:setUiBoost(boost: number)
	self.uiBoost = boost
	self._rescale()
end

-- Viewport scale for a top-level panel. Pop animations use their own nested UIScale.
function ShotHud:_scaled(target: GuiObject): UIScale
	local uiScale = create("UIScale", { Parent = target })
	table.insert(self.scales, uiScale)
	return uiScale
end

function ShotHud:_buildLogo()
	local root = frame({ Name = "Logo", Position = UDim2.fromOffset(14, 4), Size = UDim2.fromOffset(300, 196), BackgroundTransparency = 1, Parent = self.gui })
	self.logoScale = self:_scaled(root)

	local mark = frame({ Name = "Wordmark", Size = UDim2.fromOffset(300, 130), BackgroundTransparency = 1, Parent = root })
	local imageId = logoImageId()
	local embedded = if imageId then nil else ImageLoader.get("Logo/Logo")
	if imageId then
		create("ImageLabel", { Name = "LogoImage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = imageId, ScaleType = Enum.ScaleType.Fit, Parent = mark })
	elseif embedded then
		create("ImageLabel", { Name = "LogoImage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ImageContent = embedded, ScaleType = Enum.ScaleType.Fit, Parent = mark })
	else
		local star = buildWordmark(mark)
		local starScale = create("UIScale", { Parent = star })
		TweenService:Create(starScale, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.12 }):Play()
	end

	local mode = frame({ Name = "Mode", Position = UDim2.fromOffset(8, 136), Size = UDim2.fromOffset(250, 30), BackgroundColor3 = NAVY, BackgroundTransparency = 0.1, Parent = root })
	corner(mode, 6)
	stroke(mode, VIOLET, 2)
	local accent = frame({ Name = "Accent", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(6, 14), BackgroundColor3 = RED, Parent = mode })
	corner(accent, 1)
	local modeText = text({ Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -30, 1, 0), Text = TEXT.Mode, TextSize = 16, Parent = mode })
	outline(modeText, 1.5)
	self.modeText = modeText

	local stage = text({ Name = "Stage", Position = UDim2.fromOffset(12, 172), Size = UDim2.fromOffset(112, 20), Text = string.format(TEXT.Stage, 1), TextSize = 15, FontFace = FONT_BOLD, TextTransparency = 0.15, Parent = root })
	sizeLimit(stage, 15)
	outline(stage, 1.5)
	self.stageText = stage
	self.stageDots = {}
	for i = 1, STAGE_COUNT do
		local current = i == 1
		local dot = frame({
			Name = "StageDot" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(134 + (i - 1) * 22, 182),
			Size = if current then UDim2.fromOffset(13, 13) else UDim2.fromOffset(10, 10),
			BackgroundColor3 = if current then GOLD else NAVY,
			Rotation = 45,
			Parent = root,
		})
		corner(dot, 2)
		self.stageDotStrokes = self.stageDotStrokes or {}
		self.stageDotStrokes[i] = stroke(dot, if current then INK else VIOLET, 2)
		self.stageDots[i] = dot
	end
end

function ShotHud:_buildGoals()
	local root = panel({ Name = "Goals", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 14), Size = UDim2.fromOffset(292, 104) }, 10)
	root.Parent = self.gui
	self.goalsScale = self:_scaled(root)

	local trophy = iconBox(root, UDim2.fromOffset(14, 12), 50, GOLD)
	self.trophy = trophy
	emoji(trophy, "🏆", 28)

	local label
	label = text({ Name = "GoalsLabel", Position = UDim2.fromOffset(78, 10), Size = UDim2.fromOffset(150, 18), Text = TEXT.Goals, TextSize = 15, TextColor3 = LILAC, Parent = root })
	sizeLimit(label, 15)
	outline(label, 1.5)
	self.goalsLabel = label

	-- Centre-anchored holder so the bump scales around the number, not the panel corner.
	local countHolder = frame({ Name = "Count", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(76, 46), Size = UDim2.fromOffset(150, 36), BackgroundTransparency = 1, Parent = root })
	self.countScale = create("UIScale", { Parent = countHolder })
	self.goalsText = bigText({ Text = "0 / 10", TextSize = 32, Size = UDim2.fromScale(1, 1), Parent = countHolder }, 2.5, Vector2.new(2, 3))

	slashes(root, UDim2.fromOffset(222, 14), 22, GLOW)

	self.pips = frame({ Name = "Pips", Position = UDim2.fromOffset(14, 74), Size = UDim2.new(1, -28, 0, 18), BackgroundTransparency = 1, Parent = root })
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = self.pips,
	})
	self.pipFrames = {}
	self.pipStrokes = {}
end

function ShotHud:_buildPowerPanel()
	local root = panel({ Name = "PowerPanel", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(680, 116) }, 12)
	root.Parent = self.gui
	self:_scaled(root)

	local icon = iconBox(root, UDim2.fromOffset(14, 16), 56, GOLD)
	crosshairIcon(icon)

	self.title = text({ Name = "Instruction", Position = UDim2.fromOffset(84, 10), Size = UDim2.new(1, -100, 0, 28), Text = TEXT.Ready, TextSize = 20, Parent = root })
	sizeLimit(self.title, 20)
	outline(self.title, 2)
	self.titleKind = "Ready"

	local pill = frame({ Name = "PowerPill", Position = UDim2.fromOffset(84, 46), Size = UDim2.fromOffset(118, 28), BackgroundColor3 = NAVY, Parent = root })
	corner(pill, 6)
	self.pillStroke = stroke(pill, GOLD, 2)
	self.powerText = text({ Size = UDim2.fromScale(1, 1), Text = string.format(TEXT.Power, 0), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Parent = pill })
	outline(self.powerText, 1.5)

	local track = frame({ Name = "PowerBar", Position = UDim2.fromOffset(214, 49), Size = UDim2.new(1, -230, 0, 22), BackgroundColor3 = NAVY, Parent = root })
	corner(track, 5)
	stroke(track, INK, 2)
	local segmentsFrame = frame({ Name = "Segments", Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), BackgroundTransparency = 1, Parent = track })
	self.segments = {}
	self.segmentColors = {}
	self.segmentOff = {}
	for i = 1, POWER_SEGMENTS do
		local warn = (i - 1) / POWER_SEGMENTS >= POWER_WARN - 1e-6
		local seg = frame({
			Name = "Segment" .. i,
			Position = UDim2.new((i - 1) / POWER_SEGMENTS, 1, 0, 0),
			Size = UDim2.new(1 / POWER_SEGMENTS, -2, 1, 0),
			Parent = segmentsFrame,
		})
		corner(seg, 2)
		self.segments[i] = seg
		self.segmentColors[i] = if warn then RED else GOLD:Lerp(ORANGE, (i - 1) / (POWER_SEGMENTS * POWER_WARN))
		self.segmentOff[i] = if warn then rgb(74, 20, 48) else rgb(44, 28, 78)
		seg.BackgroundColor3 = self.segmentOff[i]
	end
	local zone = frame({
		Name = "PowerZone",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = LIME,
		BackgroundTransparency = 0.72,
		Visible = false,
		ZIndex = 2,
		Parent = track,
	})
	corner(zone, 4)
	stroke(zone, LIME, 2.5)
	local zoneLabel
	zoneLabel = text({
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 3),
		Size = UDim2.fromOffset(120, 16),
		Text = TEXT.PowerZone,
		TextSize = 13,
		TextColor3 = LIME,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = zone,
	})
	outline(zoneLabel, 1.5)
	self.powerZoneLabel = zoneLabel
	TweenService:Create(zone, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { BackgroundTransparency = 0.45 }):Play()
	self.powerZone = zone

	local marker = frame({ Name = "WarnMarker", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(POWER_WARN, 0.5), Size = UDim2.new(0, 4, 1, 12), BackgroundColor3 = CREAM, ZIndex = 2, Parent = track })
	corner(marker, 1)
	stroke(marker, INK, 1.5)

	local hint = text({ Name = "Hint", Position = UDim2.fromOffset(84, 84), Size = UDim2.new(1, -100, 0, 18), Text = TEXT.PowerHint, TextSize = 14, FontFace = FONT_MEDIUM, TextTransparency = 0.25, Parent = root })
	sizeLimit(hint, 14)
	self.powerHint = hint

	slashes(root, UDim2.new(1, -62, 0, 84), 18, GLOW)

	self.lastPercent = -1
	self.litCount = 0
	self.powerWarn = false
end

function ShotHud:_buildCompleteMenu()
	local root = frame({ Name = "TrainingComplete", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 20, Parent = self.gui })
	self.complete = root
	self.completeDim = frame({ Name = "Dim", Position = UDim2.fromOffset(-200, -120), Size = UDim2.new(1, 400, 1, 240), BackgroundColor3 = INK, BackgroundTransparency = 0.45, Parent = root })

	local holder = frame({ Name = "Holder", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(500, 380), BackgroundTransparency = 1, Parent = root })
	self:_scaled(holder)
	local body, glows = panel({ Name = "Pop", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1) }, 16, GOLD)
	body.Parent = holder
	for _, g in glows do
		g.Color = GOLD
	end
	self.completePop = create("UIScale", { Parent = body })
	slashes(body, UDim2.fromOffset(16, 12), 24, GLOW)
	slashes(body, UDim2.new(1, -66, 0, 12), 24, GLOW)

	local badge = frame({ Name = "Badge", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(84, 84), BackgroundTransparency = 1, ZIndex = 3, Parent = body })
	local diamond = frame({ Name = "Diamond", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(60, 60), Rotation = 45, BackgroundColor3 = NAVY, Parent = badge })
	corner(diamond, 8)
	stroke(diamond, GOLD, 3.5)
	stroke(frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, Parent = diamond }), GOLD, 10, 0.75)
	emoji(badge, "🏆", 36)
	for _, side in { -1, 1 } do
		local sparkle = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, side * 66, 0.5, 6), Size = UDim2.fromOffset(28, 28), Text = "★", TextSize = 26, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Center, Parent = badge })
		outline(sparkle, 2)
	end
	self.completeBadge = badge

	local title = bigText({ Name = "Title", Text = TEXT.CompleteTitle, TextSize = 46, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(20, 50), Size = UDim2.new(1, -40, 0, 104), Parent = body }, 4, Vector2.new(0, 5), 46)
	create("UIGradient", { Rotation = 90, Color = ColorSequence.new(CREAM, GOLD), Parent = title })

	self.completeSubtitle = text({ Name = "Subtitle", Position = UDim2.fromOffset(20, 160), Size = UDim2.new(1, -40, 0, 24), Text = "", TextSize = 20, FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Center, Parent = body })
	outline(self.completeSubtitle, 1.5)

	local balls = frame({ Name = "Balls", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 192), Size = UDim2.fromOffset(300, 36), BackgroundTransparency = 1, Parent = body })
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = balls })
	self.completeBalls = {}
	for i = 1, 8 do
		local ball = text({ Name = "Ball" .. i, LayoutOrder = i, Size = UDim2.fromOffset(34, 34), Text = "⚽", TextSize = 30, FontFace = FONT_MEDIUM, TextXAlignment = Enum.TextXAlignment.Center, Visible = false, Parent = balls })
		create("UIScale", { Parent = ball })
		self.completeBalls[i] = ball
	end

	local chips = frame({ Name = "Chips", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 240), Size = UDim2.fromOffset(460, 30), BackgroundTransparency = 1, Parent = body })
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = chips })
	local function chip(order: number, icon: string, value: string, color: Color3): (Frame, TextLabel, TextLabel)
		local c = frame({ Name = "Chip", LayoutOrder = order, Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = NAVY, Parent = chips })
		corner(c, 8)
		stroke(c, color, 2)
		create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12), Parent = c })
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = c })
		local iconLabel = text({ LayoutOrder = 1, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Text = icon, TextSize = 16, FontFace = FONT_MEDIUM, Parent = c })
		local label = text({ LayoutOrder = 2, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Text = value, TextSize = 16, Parent = c })
		outline(label, 1.5)
		return c, label, iconLabel
	end
	local _, stageChipText = chip(1, "✅", string.format(TEXT.CompleteStage, 1), LIME)
	self.completeStageText = stageChipText
	self.completeSpeed, self.completeSpeedText, self.completeSpeedIcon = chip(2, "⚡", "", GOLD)

	-- Two buttons: replay the task (secondary) and go on (primary).
	self.retryButton = self:_buildButton(body, TEXT.PlayAgain, function()
		self:_choose(self.onRetry)
	end, true)
	self.retryButton.button.Position = UDim2.new(0.5, -116, 0, 296)
	self.retryButton.button.Size = UDim2.fromOffset(212, 52)
	self.completeButton = self:_buildButton(body, TEXT.Next, function()
		self:_choose(self.onNext)
	end)
	self.completeButton.button.Position = UDim2.new(0.5, 116, 0, 296)
	self.completeButton.button.Size = UDim2.fromOffset(212, 52)
end

-- Gold primary button (or violet secondary): dark lip below, gradient face clipped by a
-- CanvasGroup with a moving shine. onActivated defaults to the result card's continue.
function ShotHud:_buildButton(parent: Instance, labelText: string, onActivated: (() -> ())?, secondary: boolean?)
	local button = create("TextButton", {
		Name = "Continue",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 172),
		Size = UDim2.fromOffset(280, 52),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = parent,
	})
	local lip = frame({ Name = "Lip", Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = if secondary then rgb(40, 16, 96) else LIP, Parent = button })
	corner(lip, 9)
	stroke(lip, INK, 2.5)

	local body = frame({ Name = "Body", Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, Parent = button })
	local face = create("CanvasGroup", { Name = "Face", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = body })
	corner(face, 9)
	local fill = frame({ Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = face })
	create("UIGradient", { Color = if secondary then ColorSequence.new(rgb(150, 110, 255), VIOLET) else ColorSequence.new(rgb(255, 214, 74), ORANGE), Rotation = 90, Parent = fill })
	frame({ Name = "Sheen", Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0.42, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.72, Parent = face })
	local shine = frame({
		Name = "Shine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(-0.3, 0.5),
		Size = UDim2.new(0, 34, 2, 0),
		Rotation = 22,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.45,
		Parent = face,
	})
	local edge = frame({ Name = "Outline", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = body })
	corner(edge, 9)
	stroke(edge, INK, 2.5)
	local label = text({ Name = "Label", Size = UDim2.fromScale(1, 1), Text = labelText, TextSize = 24, TextColor3 = if secondary then CREAM else INK, TextXAlignment = Enum.TextXAlignment.Center, Parent = body })
	if secondary then
		outline(label, 2)
	else
		outline(label, 1.5, GOLD_LIGHT).Transparency = 0.4
	end

	local shineTween = TweenService:Create(
		shine,
		TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, false, 1.6),
		{ Position = UDim2.fromScale(1.3, 0.5) }
	)

	local pressInfo = TweenInfo.new(0.07, Enum.EasingStyle.Quad)
	local function setPressed(pressed: boolean)
		TweenService:Create(body, pressInfo, { Position = UDim2.fromOffset(0, if pressed then 5 else 0) }):Play()
	end
	button.MouseButton1Down:Connect(function()
		setPressed(true)
	end)
	button.MouseButton1Up:Connect(function()
		setPressed(false)
	end)
	button.MouseLeave:Connect(function()
		setPressed(false)
	end)
	button.Activated:Connect(function()
		if onActivated then
			onActivated()
		else
			self:_continue()
		end
	end)

	return { button = button, body = body, shine = shine, label = label, shineTween = shineTween }
end

local function playShine(parts)
	parts.body.Position = UDim2.fromOffset(0, 0)
	parts.shine.Position = UDim2.fromScale(-0.3, 0.5)
	parts.shineTween:Play()
end

function ShotHud:_buildCard()
	local card = frame({
		Name = "ResultCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(400, 240),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
		Parent = self.gui,
	})
	self:_scaled(card)
	self.card = card

	local body, glows = panel({ Name = "Pop", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1) }, 14)
	body.Parent = card
	self.cardGlows = glows
	self.cardPop = create("UIScale", { Parent = body })

	slashes(body, UDim2.fromOffset(14, 10), 22, GLOW)
	slashes(body, UDim2.new(1, -62, 0, 10), 22, GLOW)

	-- Badge sitting on the top edge.
	local badge = frame({ Name = "Badge", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, ZIndex = 3, Parent = body })
	local diamond = frame({ Name = "Diamond", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(46, 46), Rotation = 45, BackgroundColor3 = NAVY, Parent = badge })
	corner(diamond, 6)
	self.badgeStroke = stroke(diamond, GOLD, 3)
	self.badgeGlow = stroke(frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, Parent = diamond }), GOLD, 8, 0.8)
	self.badgeIcon = emoji(badge, "⚽", 26)
	self.badge = badge
	self.sparkles = {}
	for _, side in { -1, 1 } do
		local sparkle = text({
			Name = "Sparkle",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, side * 52, 0.5, 4),
			Size = UDim2.fromOffset(24, 24),
			Text = "★",
			TextSize = 22,
			TextColor3 = GOLD,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = badge,
		})
		outline(sparkle, 2)
		table.insert(self.sparkles, sparkle)
	end

	local titleHolder = frame({ Name = "Title", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 66), Size = UDim2.new(1, -36, 0, 64), BackgroundTransparency = 1, Parent = body })
	self.titlePop = create("UIScale", { Parent = titleHolder })
	self.cardTitle = bigText({ Text = "", TextSize = 56, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = titleHolder }, 4, Vector2.new(0, 5), 56)
	-- The gradient tints the text white -> kind colour; the dark outline stays dark under any tint.
	self.titleGradient = create("UIGradient", { Rotation = 90, Parent = self.cardTitle })

	self.cardSubtitle = text({ Name = "Subtitle", Position = UDim2.fromOffset(20, 100), Size = UDim2.new(1, -40, 0, 24), Text = "", TextSize = 18, FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Center, Parent = body })
	sizeLimit(self.cardSubtitle, 18)
	outline(self.cardSubtitle, 1.5)

	local chip = frame({
		Name = "SpeedChip",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 134),
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = NAVY,
		Visible = false,
		Parent = body,
	})
	corner(chip, 8)
	stroke(chip, GOLD, 2)
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12), Parent = chip })
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chip,
	})
	text({ Name = "Bolt", LayoutOrder = 1, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Text = "⚡", TextSize = 16, FontFace = FONT_MEDIUM, Parent = chip })
	self.speedText = text({ Name = "Value", LayoutOrder = 2, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Text = "", TextSize = 17, Parent = chip })
	outline(self.speedText, 1.5)
	self.speedChip = chip

	local parts = self:_buildButton(body, TEXT.NextShot)
	self.cardButton = parts
	self.button = parts.button
	self.buttonLabel = parts.label
end

function ShotHud:_continue()
	if self.card.Visible and self.onContinue then
		self.onContinue()
	end
end

function ShotHud:_choose(callback: (() -> ())?)
	if self.complete.Visible and callback then
		callback()
	end
end

-- Called by keyboard / gamepad shortcuts: the primary button of whatever is open.
function ShotHud:pressContinue()
	if self.complete.Visible then
		self:_choose(self.onNext)
	else
		self:_continue()
	end
end

function ShotHud:isCardVisible(): boolean
	return self.card.Visible or self.complete.Visible
end

-- kind: Ready | Holding | Flying | AfterShot. Called every frame while aiming, so it skips repeats.
function ShotHud:setTitle(kind: string)
	if self.titleKind == kind then
		return
	end
	self.titleKind = kind
	self.title.Text = TEXT[kind] or kind
end

-- Called every frame while aiming: only touches properties that actually changed.
function ShotHud:setPower(power: number)
	local p = math.clamp(power, 0, 1)
	local percent = math.floor(p * 100 + 0.5)
	if percent == self.lastPercent then
		return
	end
	self.lastPercent = percent
	self.powerText.Text = string.format(TEXT.Power, percent)

	local lit = math.clamp(math.ceil(p * POWER_SEGMENTS - 1e-6), 0, POWER_SEGMENTS)
	if lit ~= self.litCount then
		local from, to = math.min(lit, self.litCount) + 1, math.max(lit, self.litCount)
		for i = from, to do
			self.segments[i].BackgroundColor3 = if i <= lit then self.segmentColors[i] else self.segmentOff[i]
		end
		self.litCount = lit
	end

	local warn = p >= POWER_WARN
	if warn ~= self.powerWarn then
		self.powerWarn = warn
		self.pillStroke.Color = if warn then RED else GOLD
		self.powerText.TextColor3 = if warn then RED_LIGHT else CREAM
	end
end

-- goals: big number; seriesLength: number of result pips; history: outcome per pip.
-- total: number after the slash (defaults to seriesLength).
function ShotHud:setSeries(goals: number, seriesLength: number, history: { string }?, total: number?)
	local shots = history or {}
	setBigText(self.goalsText, string.format('<font color="#FFBF1F">%d</font> / %d', goals, total or seriesLength))

	for i = #self.pipFrames + 1, seriesLength do
		local pip = frame({ Name = "Pip" .. i, LayoutOrder = i, Size = UDim2.fromOffset(18, 18), BackgroundColor3 = NAVY, Parent = self.pips })
		corner(pip, 4)
		self.pipStrokes[i] = stroke(pip, VIOLET, 2)
		self.pipFrames[i] = pip
	end

	local nextIndex = #shots + 1
	for i, pip in self.pipFrames do
		local outcome = shots[i]
		pip.Visible = i <= seriesLength
		pip.BackgroundColor3 = if outcome then PIP_COLORS[outcome] or CREAM else NAVY
		local s = self.pipStrokes[i]
		s.Color = if outcome then INK elseif i == nextIndex then CREAM else VIOLET
		s.Transparency = 0
	end

	-- Gentle pulse on the outline of the shot about to be taken.
	if self.pulseIndex ~= nextIndex then
		if self.pulseTween then
			self.pulseTween:Cancel()
		end
		self.pulseTween = nil
		self.pulseIndex = nextIndex
		local s = self.pipStrokes[nextIndex]
		if s and nextIndex <= seriesLength then
			self.pulseTween = TweenService:Create(s, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.75 })
			self.pulseTween:Play()
		end
	end
end

function ShotHud:bumpGoals()
	self.countScale.Scale = 1.45
	TweenService:Create(self.countScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	self.trophy.Rotation = -18
	TweenService:Create(self.trophy, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
end

-- kind: GOAL | POST_IN | CATCH | PARRY | POST | BAR | WIDE | OVER
-- options: subtitle (replaces the outcome tip), button (label), speedKmh
function ShotHud:showResult(kind: string, options: { subtitle: string?, button: string?, speedKmh: number? }?)
	local style = KIND_STYLE[kind] or KIND_STYLE.WIDE
	local info = TEXT.Outcomes[kind] or { kind, "" }
	options = options or {}

	setBigText(self.cardTitle, info[1])
	self.titleGradient.Color = ColorSequence.new(style.top, style.bottom)
	self.cardSubtitle.Text = options.subtitle or info[2]
	self.buttonLabel.Text = options.button or TEXT.NextShot

	local speed = options.speedKmh
	local hasChip = type(speed) == "number" and speed > 0
	self.speedChip.Visible = hasChip
	if hasChip then
		self.speedText.Text = string.format(TEXT.Speed, math.floor(speed + 0.5))
	end
	-- Without the chip the card closes up around the button.
	self.card.Size = UDim2.fromOffset(400, if hasChip then 240 else 206)
	self.button.Position = UDim2.new(0.5, 0, 0, if hasChip then 172 else 138)

	for _, s in self.cardGlows do
		s.Color = style.accent
	end
	self.badgeStroke.Color = style.accent
	self.badgeGlow.Color = style.accent
	self.badgeIcon.Text = style.icon
	for _, sparkle in self.sparkles do
		sparkle.Visible = style.sparkle == true
	end

	self.card.Visible = true
	self.cardPop.Scale = 0.55
	TweenService:Create(self.cardPop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	self.titlePop.Scale = 1.5
	TweenService:Create(self.titlePop, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.08), { Scale = 1 }):Play()
	self.badge.Rotation = -120
	TweenService:Create(self.badge, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	playShine(self.cardButton)
end

function ShotHud:hideCard()
	self.card.Visible = false
	self.cardButton.shineTween:Cancel()
	self.complete.Visible = false
	self.completeButton.shineTween:Cancel()
	self.retryButton.shineTween:Cancel()
end

-- Stage dots: done = lime, current = gold and larger, still to come = dark. STAGE_COUNT + 1 = all done.
function ShotHud:_setStage(stage: number)
	for i, dot in self.stageDots do
		local done, current = i < stage, i == stage
		dot.BackgroundColor3 = if done then LIME elseif current then GOLD else NAVY
		dot.Size = if current then UDim2.fromOffset(13, 13) else UDim2.fromOffset(10, 10)
		self.stageDotStrokes[i].Color = if done or current then INK else VIOLET
	end
	self.stageText.Text = if stage > STAGE_COUNT then TEXT.StageFree else string.format(TEXT.Stage, stage)
end

-- Labels for the current part of the training. stage: SHOT | PASS; mode: TUTORIAL | TASK (of
-- the stage); kind: what the player is doing now, SHOT or PASS (power bar texts).
function ShotHud:setMode(stage: string, mode: string, taskGoals: number, kind: string)
	local pass = stage == "PASS"
	if mode == "TUTORIAL" then
		self.goalsLabel.Text = TEXT.GoalsTutorial
	else
		self.goalsLabel.Text = string.format(if pass then TEXT.GoalsTaskPass else TEXT.GoalsTask, taskGoals)
	end
	self.modeText.Text = if pass then TEXT.ModePass else TEXT.Mode
	local passing = kind == "PASS"
	self.powerHint.Text = if passing then TEXT.PassPowerHint else TEXT.PowerHint
	self.powerZoneLabel.Text = if passing then TEXT.PassPowerZone else TEXT.PowerZone
	self:_setStage(if pass then 2 else 1)
end

-- Highlights the power range that the guided shot asks for (nil hides it).
function ShotHud:setPowerZone(min: number?, max: number?)
	local zone = self.powerZone
	-- The zone label sits where the general power tip is, so they take turns.
	self.powerHint.Visible = not (min and max)
	if not (min and max) then
		zone.Visible = false
		return
	end
	zone.Position = UDim2.fromScale(min, 0.5)
	zone.Size = UDim2.new(max - min, 0, 1, 10)
	zone.Visible = true
end

-- Completion menu after a task is done. stats: { kind, goals, shots, bestSpeed, bonusGoals }
function ShotHud:showComplete(stats: { kind: string, goals: number, shots: number, bestSpeed: number?, bonusGoals: number? })
	self.card.Visible = false
	self.cardButton.shineTween:Cancel()
	local stage = if stats.kind == "PASS" then 2 else 1
	self.completeSubtitle.Text = string.format(if stats.kind == "PASS" then TEXT.CompleteSubtitlePass else TEXT.CompleteSubtitle, stats.goals, stats.shots)
	self.completeStageText.Text = string.format(TEXT.CompleteStage, stage)
	-- Second chip: the fastest goal (shot stage) or goals scored after passes (pass stage).
	if stats.kind == "PASS" then
		self.completeSpeed.Visible = true
		self.completeSpeedIcon.Text = "⚽"
		self.completeSpeedText.Text = string.format(TEXT.CompleteBonus, stats.bonusGoals or 0)
	else
		local hasSpeed = type(stats.bestSpeed) == "number" and stats.bestSpeed > 0
		self.completeSpeed.Visible = hasSpeed
		self.completeSpeedIcon.Text = "⚡"
		if hasSpeed then
			self.completeSpeedText.Text = string.format(TEXT.CompleteSpeed, math.floor(stats.bestSpeed + 0.5))
		end
	end
	for i, ball in self.completeBalls do
		ball.Visible = i <= stats.goals
	end
	self:_setStage(stage + 1)
	-- The pass task is the last stage: its primary button leaves the training.
	self.completeButton.label.Text = if stage >= STAGE_COUNT then TEXT.Finish else TEXT.Next

	self.complete.Visible = true
	self.completeDim.BackgroundTransparency = 1
	TweenService:Create(self.completeDim, TweenInfo.new(0.3), { BackgroundTransparency = 0.45 }):Play()
	self.completePop.Scale = 0.5
	TweenService:Create(self.completePop, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	for i, ball in self.completeBalls do
		local holderScale = ball:FindFirstChildOfClass("UIScale")
		holderScale.Scale = 0
		TweenService:Create(holderScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.25 + i * 0.09), { Scale = 1 }):Play()
	end
	self.completeBadge.Rotation = -140
	TweenService:Create(self.completeBadge, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	playShine(self.completeButton)
	self.retryButton.body.Position = UDim2.fromOffset(0, 0)
end

return ShotHud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ShotVisuals</string>
            <string name="Source"><![CDATA[-- Client-only 3D visuals: camera, ball replay, goalkeeper animation, aim crosshair, trajectory
-- preview and effects. Everything here is local to this player and has no effect on the outcome.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local ShotPhysics = require(Shared:WaitForChild("ShotPhysics"))
local KeeperAnimator = require(script.Parent:WaitForChild("KeeperAnimator"))

local Keeper = ShotConfig.Goalkeeper
local BALL_RADIUS = ShotConfig.Ball.Radius
local PREVIEW_DOTS = 16
local AFTER_PATH_SECONDS = 0.4 -- linger after the replayed path ends

local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 191, 31)
local RED = Color3.fromRGB(255, 45, 85)
local VIOLET = Color3.fromRGB(123, 77, 255)
local CREAM = Color3.fromRGB(247, 236, 214)

local ShotVisuals = {}
ShotVisuals.__index = ShotVisuals

local function create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function makePart(props: { [string]: any }): Part
	props.Anchored = true
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	props.Material = props.Material or Enum.Material.SmoothPlastic
	return create("Part", props)
end

local function icosahedronDirections(): { Vector3 }
	local phi = (1 + math.sqrt(5)) / 2
	local dirs = {}
	for _, a in { -1, 1 } do
		for _, b in { -phi, phi } do
			table.insert(dirs, Vector3.new(0, a, b).Unit)
			table.insert(dirs, Vector3.new(a, b, 0).Unit)
			table.insert(dirs, Vector3.new(b, 0, a).Unit)
		end
	end
	return dirs
end

-- Position on the replayed path at time t (linear between samples).
local function pathAt(path: { Vector3 }, sampleStep: number, t: number): Vector3
	local f = t / sampleStep
	local i = math.floor(f)
	if i >= #path - 1 then
		return path[#path]
	end
	return path[i + 1]:Lerp(path[i + 2], f - i)
end

function ShotVisuals.new()
	local self = setmetatable({}, ShotVisuals)
	self.token = 0
	self.clock = 0
	self.shake = 0
	self.fovKick = 0
	self.ballRotation = CFrame.identity
	self.active = true
	self.blendT = 1
	self.spot = ShotPhysics.ballSpot()

	local folder = create("Folder", { Name = "ShotVisuals", Parent = workspace })

	-- Ball: white sphere with 12 flat dark panels, plus a trail for hard shots.
	local ballModel = create("Model", { Name = "Ball", Parent = folder })
	local shell = makePart({ Name = "Shell", Shape = Enum.PartType.Ball, Size = Vector3.one * BALL_RADIUS * 2, Color = WHITE, Parent = ballModel })
	self.ballParts = { { shell, CFrame.identity } }
	for _, dir in icosahedronDirections() do
		local reference = if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis
		local patch = makePart({
			Name = "Panel",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, BALL_RADIUS * 0.66, BALL_RADIUS * 0.66),
			Color = Color3.fromRGB(28, 18, 48),
			CastShadow = false,
			Parent = ballModel,
		})
		table.insert(self.ballParts, { patch, CFrame.fromMatrix(dir * BALL_RADIUS * 0.985, dir, dir:Cross(reference).Unit) })
	end
	-- The trail hangs off a separate carrier so the ball's spin doesn't twist it.
	local carrier = makePart({ Name = "TrailCarrier", Size = Vector3.one * 0.2, Transparency = 1, Parent = folder })
	local a0 = create("Attachment", { Position = Vector3.new(0, 0.55, 0), Parent = carrier })
	local a1 = create("Attachment", { Position = Vector3.new(0, -0.55, 0), Parent = carrier })
	self.trail = create("Trail", {
		Attachment0 = a0,
		Attachment1 = a1,
		Lifetime = 0.22,
		MinLength = 0.05,
		FaceCamera = true,
		LightEmission = 0.7,
		Color = ColorSequence.new(CREAM, GOLD),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
		WidthScale = NumberSequence.new(1, 0.2),
		Enabled = false,
		Parent = carrier,
	})
	self.trailCarrier = carrier

	-- Crosshair on the goal plane, the size of the ball, drawn on top of everything.
	local aimPart = makePart({ Name = "Crosshair", Size = Vector3.new(3, 3, 0.05), Transparency = 1, CastShadow = false, Parent = folder })
	local aimGui = create("SurfaceGui", {
		Face = Enum.NormalId.Back,
		AlwaysOnTop = true,
		LightInfluence = 0,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 60,
		Enabled = false,
		Parent = aimPart,
	})
	local ring = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(2 * BALL_RADIUS / 3, 2 * BALL_RADIUS / 3),
		BackgroundColor3 = GOLD,
		BackgroundTransparency = 0.82,
		Parent = aimGui,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ring })
	create("UIStroke", { Color = GOLD, Thickness = 6, Parent = ring })
	create("UIStroke", { Color = Color3.fromRGB(43, 18, 80), Thickness = 2, Transparency = 0.2, Parent = create("Frame", {
		Size = UDim2.new(1, 14, 1, 14), Position = UDim2.fromOffset(-7, -7), BackgroundTransparency = 1, Parent = ring,
	}) })
	local dot = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = CREAM, Parent = aimGui })
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
	for _, tick in { { 0.5, 0.06, 6, 22 }, { 0.5, 0.94, 6, 22 }, { 0.06, 0.5, 22, 6 }, { 0.94, 0.5, 22, 6 } } do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(tick[1], tick[2]),
			Size = UDim2.fromOffset(tick[3], tick[4]),
			BackgroundColor3 = GOLD,
			BorderSizePixel = 0,
			Parent = aimGui,
		})
	end
	self.aimPart, self.aimGui = aimPart, aimGui

	self.dots = {}
	for i = 1, PREVIEW_DOTS do
		self.dots[i] = makePart({
			Name = "PreviewDot",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (0.42 - 0.22 * i / PREVIEW_DOTS),
			Color = GOLD,
			Material = Enum.Material.Neon,
			CastShadow = false,
			Transparency = 1,
			Parent = folder,
		})
	end
	self.previewKey = ""

	local function emitter(name: string, position: Vector3, props: { [string]: any })
		local holder = makePart({ Name = name, Size = Vector3.one, Transparency = 1, CFrame = CFrame.new(position), Parent = folder })
		props.Enabled = false
		props.Parent = holder
		return create("ParticleEmitter", props), holder
	end
	self.confetti = emitter("Confetti", Vector3.new(0, ShotConfig.Goal.Height + 1, -ShotConfig.Goal.NetDepth / 2), {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, GOLD),
			ColorSequenceKeypoint.new(0.35, RED),
			ColorSequenceKeypoint.new(0.7, VIOLET),
			ColorSequenceKeypoint.new(1, CREAM),
		}),
		Size = NumberSequence.new(0.55, 0.15),
		Speed = NumberRange.new(28, 50),
		SpreadAngle = Vector2.new(75, 75),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -40, 0),
		Drag = 1.5,
		Lifetime = NumberRange.new(1.6, 2.6),
		RotSpeed = NumberRange.new(-220, 220),
		LightEmission = 0.6,
	})
	-- Small burst of chalk/grass at bounces and white flashes on the frame.
	self.impact, self.impactHolder = emitter("Impact", Vector3.zero, {
		Color = ColorSequence.new(CREAM),
		Size = NumberSequence.new(0.5, 0),
		Speed = NumberRange.new(6, 14),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -30, 0),
		Lifetime = NumberRange.new(0.25, 0.45),
		LightEmission = 0.8,
	})

	self:_findScene()
	self:reset()
	return self
end

function ShotVisuals:_findScene()
	local scene = workspace:WaitForChild("FootballScene", 15)
	if not scene then
		warn("[ShotVisuals] workspace.FootballScene not found; is the server Main script running?")
		return
	end
	local net = scene:FindFirstChild("NetBack", true)
	if net and net:IsA("BasePart") then
		self.netBack, self.netBackHome = net, net.CFrame
	end
	local keeper = Keeper.Enabled and scene:WaitForChild("Goalkeeper", 10)
	if keeper then
		self.keeper = KeeperAnimator.new(keeper)
	end
end

function ShotVisuals:_setBall(position: Vector3)
	local base = CFrame.new(position) * self.ballRotation
	for _, entry in self.ballParts do
		entry[1].CFrame = base * entry[2]
	end
	self.trailCarrier.CFrame = CFrame.new(position)
	self.ballPosition = position
end

function ShotVisuals:_spinBall(angularVelocity: Vector3, dt: number)
	local speed = angularVelocity.Magnitude
	if speed > 1e-3 then
		self.ballRotation = CFrame.fromAxisAngle(angularVelocity / speed, speed * dt) * self.ballRotation
	end
end

-- spot: where the ball is (default: the shot drill's spot; a shot after a pass starts at the receiver).
function ShotVisuals:reset(spot: Vector3?)
	self.token += 1
	self.holdBall = false
	self.ballRotation = CFrame.identity
	self.trail.Enabled = false
	local newSpot = spot or ShotPhysics.ballSpot()
	if self.active and self.spot and (newSpot - self.spot).Magnitude > 0.1 then
		-- New shooting position: glide the camera over instead of cutting.
		local camera = workspace.CurrentCamera
		self.blendFrom, self.blendFov, self.blendT = camera.CFrame, camera.FieldOfView, 0
	end
	self.spot = newSpot
	self:_setBall(self.spot)
	if self.keeper then
		self.keeper:recover()
	end
	if self.netBack then
		self.netBack.CFrame = self.netBackHome
	end
	self:updateAiming(false, 0, 0.5, 0, false)
end

-- The shot camera sits behind the ball on the line to the goal, as far back and as high as for the
-- shot drill's own spot (where this gives exactly ShotConfig.Camera.Position).
function ShotVisuals.cameraPosition(spot: Vector3): Vector3
	local cam = ShotConfig.Camera.Position
	local home = ShotPhysics.ballSpot()
	local back = Vector3.new(cam.X - home.X, 0, cam.Z - home.Z).Magnitude
	local away = Vector3.new(spot.X, 0, spot.Z)
	away = if away.Magnitude > 1e-3 then away.Unit else Vector3.new(0, 0, 1)
	return Vector3.new(spot.X, cam.Y, spot.Z) + away * back
end

-- Off while another drill (the pass) owns the camera: the ball is put away, the keeper idles.
function ShotVisuals:setActive(active: boolean)
	if self.active == active then
		return
	end
	self.active = active
	if active then
		local camera = workspace.CurrentCamera
		self.blendFrom, self.blendFov, self.blendT = camera.CFrame, camera.FieldOfView, 0
		self:reset()
	else
		self.token += 1 -- stops any replay in progress
		self.holdBall = false
		if self.keeper then
			self.keeper:recover() -- back on his feet after the last shot
		end
		self.trail.Enabled = false
		self:_setBall(Vector3.new(0, -50, 0))
		self:updateAiming(false, 0, 0.5, 0, false)
	end
end

function ShotVisuals:setCharging(on: boolean)
	if self.keeper then
		self.keeper:setCharging(on)
	end
end

-- Settings: camera shake on goals and frame hits.
function ShotVisuals:setShakeEnabled(enabled: boolean)
	self.shakeEnabled = enabled
end

-- Per-frame: camera (with shake and kick) and the keeper.
function ShotVisuals:update(dt: number)
	self.clock += dt
	self.shake = math.max(0, self.shake - dt * 2.5)
	self.fovKick = math.max(0, self.fovKick - dt * 10)

	if self.active then
		local camera = workspace.CurrentCamera
		camera.CameraType = Enum.CameraType.Scriptable
		local fov = ShotConfig.Camera.FieldOfView - self.fovKick
		local base = CFrame.lookAt(ShotVisuals.cameraPosition(self.spot), ShotConfig.Camera.LookAt)
		if self.shake > 0 and self.shakeEnabled ~= false then
			local t = self.clock * 25
			local amount = self.shake * 0.3
			base *= CFrame.new(math.noise(t, 1) * amount, math.noise(t, 2) * amount, 0)
		end
		if self.blendT < 1 then
			-- Coming back from the pass drill: glide to the shot camera.
			self.blendT = math.min(1, self.blendT + dt / 0.9)
			local k = self.blendT * self.blendT * (3 - 2 * self.blendT)
			base = self.blendFrom:Lerp(base, k)
			fov = self.blendFov + (fov - self.blendFov) * k
		end
		camera.FieldOfView = fov
		camera.CFrame = base
	end

	if self.keeper then
		self.keeper:update(dt)
		if self.holdBall then
			local hands = self.keeper:handsPosition()
			if hands then
				self:_setBall(self.ballPosition:Lerp(hands, math.min(1, dt * 25)))
			end
		end
	end
end

-- Shows the crosshair, and while holding, the predicted arc including curl (no random error).
function ShotVisuals:updateAiming(enabled: boolean, aimX: number, aimY: number, power: number, holding: boolean)
	local point = ShotPhysics.aimToGoalPoint(aimX, aimY)
	self.aimGui.Enabled = enabled
	self.aimPart.CFrame = CFrame.new(point + Vector3.new(0, 0, 0.25))

	local showArc = enabled and holding
	for i, dot in self.dots do
		dot.Transparency = if showArc then 0.1 + 0.55 * i / PREVIEW_DOTS else 1
	end
	if not showArc then
		self.previewKey = ""
		return
	end
	-- Re-solve only when the input actually changed.
	local key = string.format("%.3f|%.3f|%.2f", aimX, aimY, power)
	if key == self.previewKey then
		return
	end
	self.previewKey = key
	local points = ShotPhysics.previewPath(point, power, ShotPhysics.spinFor(aimX, power), PREVIEW_DOTS, self.spot)
	for i, dot in self.dots do
		local p = points[i]
		if p then
			dot.CFrame = CFrame.new(p)
		else
			dot.Transparency = 1
		end
	end
end

function ShotVisuals:onShotReleased()
	self.fovKick = 1.8
	self:updateAiming(false, 0, 0.5, 0, false)
	if self.keeper then
		self.keeper:setCharging(false)
	end
end

function ShotVisuals:_bulgeNet(at: Vector3)
	local net = self.netBack
	if not net then
		return
	end
	local depth = math.clamp(1.2 - math.abs(at.X) / ShotConfig.Goal.Width, 0.5, 1.2)
	net.CFrame = self.netBackHome * CFrame.new(0, 0, -depth)
	TweenService:Create(net, TweenInfo.new(0.7, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { CFrame = self.netBackHome }):Play()
end

function ShotVisuals:_puff(at: Vector3, count: number)
	self.impactHolder.CFrame = CFrame.new(at)
	self.impact:Emit(count)
end

-- Replays the server-simulated shot. Calls onDecisive at the moment the result is clear,
-- and yields until the replay ends or reset() is called.
function ShotVisuals:playShot(result, onDecisive: () -> ())
	self.token += 1
	local token = self.token
	local path: { Vector3 } = result.path
	local sampleStep: number = result.sampleStep
	local duration = (#path - 1) * sampleStep
	local spin: Vector3 = result.spin or Vector3.zero

	if self.keeper then
		self.keeper:startShot({
			reaction = result.keeperReaction,
			impactTime = result.keeperTime or result.decisiveTime,
			target = result.keeperTarget,
			kind = result.keeperKind,
			dives = result.keeperDives,
		})
	end

	-- Effects keyed to simulation events.
	local pending = table.clone(result.events)
	table.sort(pending, function(a, b)
		return a.t < b.t
	end)
	local decisiveFired = false
	self.trail.Enabled = (result.speedKmh or 0) >= 85

	local t, last = 0, self.spot
	while t < duration + AFTER_PATH_SECONDS do
		local dt = RunService.RenderStepped:Wait()
		if self.token ~= token then
			return
		end
		t += dt

		while pending[1] and pending[1].t <= t do
			local e = table.remove(pending, 1)
			if e.kind == "goal" then
				self.shake = 1
				self.confetti:Emit(160)
			elseif e.kind == "net" then
				self:_bulgeNet(e.pos)
			elseif e.kind == "frame" then
				self.shake = math.max(self.shake, 0.6)
				self:_puff(e.pos, 14)
			elseif e.kind == "keeper" then
				self.shake = math.max(self.shake, 0.35)
				if e.part == "CATCH" then
					self.holdBall = true -- update() keeps it in the gloves from now on
					self.trail.Enabled = false
				else
					self:_puff(e.pos, 10)
				end
			elseif e.kind == "bounce" or e.kind == "board" then
				self:_puff(e.pos, 6)
			end
		end
		if not decisiveFired and t >= result.decisiveTime then
			decisiveFired = true
			onDecisive()
		end

		if not self.holdBall then
			local position = pathAt(path, sampleStep, math.min(t, duration))
			local velocity = (position - last) / math.max(dt, 1e-3)
			local onGround = position.Y <= BALL_RADIUS + 0.05
			-- In the air the ball shows its real spin (exaggerated); on the ground it rolls.
			local angular = if onGround then Vector3.new(velocity.Z, 0, -velocity.X) / BALL_RADIUS else spin * 3 + Vector3.new(-velocity.Magnitude * 0.15, 0, 0)
			self:_spinBall(angular, dt)
			if velocity.Magnitude < 40 then
				self.trail.Enabled = false
			end
			self:_setBall(position)
			last = position
		end
	end
	if not decisiveFired then
		onDecisive()
	end
	self.trail.Enabled = false
end

return ShotVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">TutorialHint</string>
            <string name="Source"><![CDATA[-- Finger hint for the guided first shot and first pass.
--   SHOT: a pulsing ring on the goal; the finger shows press → hold (power bar to the green
--         zone) → release.
--   PASS: the target teammate's ground ring pulses (PassVisuals); the finger presses at the ball,
--         drags to the teammate and lets go, while the power bar fills.
-- The ring and callout sit in a BillboardGui anchored at the target, the finger in another one
-- whose anchor moves, so everything lines up with the 3D scene on any screen. Sizes in pixels are
-- multiplied by the HUD scale (readable on phones).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotPhysics = require(Shared:WaitForChild("ShotPhysics"))
local PassConfig = require(Shared:WaitForChild("PassConfig"))
local ImageLoader = require(script.Parent:WaitForChild("ImageLoader"))

local rgb = Color3.fromRGB
local GOLD = rgb(255, 191, 31)
local LIME = rgb(170, 240, 40)
local PINK = rgb(255, 120, 140)
local CREAM = rgb(247, 236, 214)
local INK = rgb(18, 6, 31)
local NAVY = rgb(18, 11, 36)
local FONT = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)

local TEXT = {
	Press = "НАЖМИ И ДЕРЖИ",
	Hold = "ДЕРЖИ…",
	Release = "ОТПУСТИ!",
	Wait = "ДЕРЖИ ДО ЗЕЛЁНОЙ ЗОНЫ",
	Missed = "НАЖМИ НА КРУЖОК",
	PassPress = "ВЕДИ К ПАРТНЁРУ",
	PassRelease = "ОТПУСТИ!",
	PassMissed = "ОТПУСТИ У ПАРТНЁРА",
}

local MARGIN = 360 -- pixels around the shot ring for the callout
local FINGER_SIZE = 96 -- pixels at HUD scale 1
local CALLOUT_HEIGHT = 8.6 -- studs above a pass target (over the teammate's head)

-- Demo timelines (seconds in a loop).
local SHOT_LOOP = 2.6
local ARRIVE, PRESS, RELEASE, FADE = 0.55, 0.7, 1.35, 1.7
local DEMO_POWER = 0.68 -- where the shot demo releases (middle of the green zone)
local PASS_LOOP = 2.9
local P_ARRIVE, P_PRESS, P_DRAG, P_RELEASE = 0.35, 0.5, 1.55, 1.85

local TutorialHint = {}
TutorialHint.__index = TutorialHint

local function create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	props.Parent = nil
	for key, value in props do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function circle(parent: Instance, name: string, color: Color3, thickness: number): (Frame, UIStroke)
	local f = create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = f })
	local s = create("UIStroke", { Color = color, Thickness = thickness, Parent = f })
	return f, s
end

local function easeOut(t: number): number
	t = math.clamp(t, 0, 1)
	return 1 - (1 - t) ^ 3
end

local function easeInOut(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- Plain finger made of frames, used only if images are unavailable.
local function fallbackFinger(parent: Instance): { GuiObject }
	local parts = {}
	local function piece(name: string, position: UDim2, size: UDim2, radius: number)
		local f = create("Frame", { Name = name, Position = position, Size = size, BackgroundColor3 = CREAM, BorderSizePixel = 0, Parent = parent })
		create("UICorner", { CornerRadius = UDim.new(radius, 0), Parent = f })
		create("UIStroke", { Color = INK, Thickness = 3, Parent = f })
		table.insert(parts, f)
	end
	piece("Index", UDim2.fromScale(0.38, 0.02), UDim2.fromScale(0.22, 0.55), 0.5)
	piece("Palm", UDim2.fromScale(0.22, 0.42), UDim2.fromScale(0.56, 0.42), 0.3)
	piece("Cuff", UDim2.fromScale(0.3, 0.82), UDim2.fromScale(0.4, 0.14), 0.4)
	return parts
end

function TutorialHint.new()
	local self = setmetatable({}, TutorialHint)
	self.hint = nil
	self.kind = "SHOT"
	self.clock = 0
	self.nudgeUntil = -1
	self.misses = 0
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	self.anchor = create("Attachment", { Name = "TutorialHintAnchor" })
	self.fingerAnchor = create("Attachment", { Name = "TutorialFingerAnchor" })

	-- Ring + callout, anchored at the target.
	local gui = create("BillboardGui", {
		Name = "TutorialHint",
		Adornee = self.anchor,
		AlwaysOnTop = true,
		LightInfluence = 0,
		ClipsDescendants = false,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
		Parent = playerGui,
	})
	self.gui = gui

	local target = create("Frame", {
		Name = "Target",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -2 * MARGIN, 1, -2 * MARGIN),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	self.target = target
	local fill = create("Frame", {
		Name = "Fill",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = GOLD,
		BackgroundTransparency = 0.82,
		Parent = target,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
	self.fill = fill
	circle(target, "Outline", INK, 6)
	local _, ring = circle(target, "Ring", GOLD, 3.5)
	self.ringStroke = ring
	local dot = create("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.16, 0.16),
		BackgroundColor3 = GOLD,
		Parent = target,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
	create("UIStroke", { Color = INK, Thickness = 2, Parent = dot })
	self.dot = dot
	self.ripples = {}
	for i = 1, 2 do
		local ripple, stroke = circle(target, "Ripple" .. i, GOLD, 3)
		self.ripples[i] = { frame = ripple, stroke = stroke }
	end

	local bubble = create("Frame", {
		Name = "Callout",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = NAVY,
		BackgroundTransparency = 0.05,
		ZIndex = 4,
		Parent = gui,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = bubble })
	self.bubbleStroke = create("UIStroke", { Color = GOLD, Thickness = 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = bubble })
	create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = bubble })
	self.bubbleScale = create("UIScale", { Parent = bubble })
	self.label = create("TextLabel", {
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		FontFace = FONT,
		TextSize = 24,
		TextColor3 = CREAM,
		Text = TEXT.Press,
		ZIndex = 5,
		Parent = bubble,
	})
	create("UIStroke", { Color = INK, Thickness = 2, Parent = self.label })
	self.bubble = bubble
	local tail = create("Frame", {
		Name = "Tail",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 1),
		Size = UDim2.fromOffset(12, 12),
		Rotation = 45,
		BackgroundColor3 = NAVY,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = bubble,
	})
	self.tailStroke = create("UIStroke", { Color = GOLD, Thickness = 2.5, Parent = tail })
	self.popScale = 1

	-- Finger, in its own billboard so it can travel (the pass drag). Its anchor point is the fingertip.
	local fingerGui = create("BillboardGui", {
		Name = "TutorialFinger",
		Adornee = self.fingerAnchor,
		AlwaysOnTop = true,
		LightInfluence = 0,
		ClipsDescendants = false,
		ResetOnSpawn = false,
		Size = UDim2.fromOffset(FINGER_SIZE * 3, FINGER_SIZE * 3),
		Enabled = false,
		Parent = playerGui,
	})
	self.fingerGui = fingerGui
	local image = ImageLoader.get("Ui/Finger")
	local uiImages = Shared:FindFirstChild("Images") and Shared.Images:FindFirstChild("Ui")
	local tip = uiImages and (require(uiImages) :: any).FingerTip
	local finger
	if image then
		finger = create("ImageLabel", {
			Name = "Finger",
			AnchorPoint = if tip then Vector2.new(tip[1], tip[2]) else Vector2.new(0.5, 0.03),
			BackgroundTransparency = 1,
			ImageContent = image,
			Parent = fingerGui,
		})
	else
		finger = create("Frame", { Name = "Finger", AnchorPoint = Vector2.new(0.49, 0.03), BackgroundTransparency = 1, Parent = fingerGui })
		self.fingerParts = fallbackFinger(finger)
	end
	self.finger = finger
	self.fingerScale = create("UIScale", { Parent = finger })
	return self
end

-- kind: SHOT | PASS. hint from the server's tutorial episode:
--   SHOT { aimX, aimY, ringRadius, tapRadius, powerMin, powerMax }
--   PASS { start, target, ringRadius, tapRadius, powerMin, powerMax }
function TutorialHint:show(kind: string, hint)
	self.kind = kind
	self.hint = hint
	self.clock = 0
	self.nudgeUntil = -1
	self.misses = 0
	self.anchor.Parent = workspace.Terrain
	self.fingerAnchor.Parent = workspace.Terrain
	if kind == "PASS" then
		self.point = hint.target
		self.start = hint.start
		self.anchor.WorldPosition = hint.target + Vector3.new(0, CALLOUT_HEIGHT, 0)
		self.gui.Size = UDim2.fromOffset(2 * MARGIN, 2 * MARGIN)
		self.target.Visible = false -- the teammate's own ground ring pulses instead
	else
		self.point = ShotPhysics.aimToGoalPoint(hint.aimX, hint.aimY)
		self.start = nil
		self.anchor.WorldPosition = self.point
		local d = hint.ringRadius * 2
		self.gui.Size = UDim2.new(d, 2 * MARGIN, d, 2 * MARGIN)
		self.target.Visible = true
	end
	self.fingerAnchor.WorldPosition = self.start or self.point
	self.gui.Enabled = true
	self.fingerGui.Enabled = true
end

function TutorialHint:hide()
	self.hint = nil
	self.gui.Enabled = false
	self.fingerGui.Enabled = false
	self.anchor.Parent = nil
	self.fingerAnchor.Parent = nil
end

function TutorialHint:isActive(): boolean
	return self.hint ~= nil
end

-- A miss is ignored once with a nudge; after that anything counts (the guided attempt keeps the
-- hinted target anyway).
function TutorialHint:_judge(distance: number): boolean
	if distance <= self.hint.tapRadius then
		return true
	end
	self.misses += 1
	return self.misses > 1
end

-- SHOT: whether a press at this aim counts (distance on the goal plane, in studs).
function TutorialHint:accepts(aimX: number, aimY: number): boolean
	if not self.hint then
		return true
	end
	local p = ShotPhysics.aimToGoalPoint(aimX, aimY)
	return self:_judge((Vector3.new(p.X, p.Y, 0) - Vector3.new(self.point.X, self.point.Y, 0)).Magnitude)
end

-- PASS: whether a release at this ground point counts.
function TutorialHint:acceptsTarget(target: Vector3): boolean
	if not self.hint then
		return true
	end
	return self:_judge(Vector3.new(target.X - self.point.X, 0, target.Z - self.point.Z).Magnitude)
end

-- Pressed / released somewhere else: shake the finger and show the target again.
function TutorialHint:nudge()
	self.nudgeUntil = self.clock + 1.2
end

function TutorialHint:_setLabel(text: string, color: Color3)
	if self.label.Text ~= text then
		self.label.Text = text
		self.popScale = 1.15
	end
	self.label.TextColor3 = color
	self.bubbleStroke.Color = color
	self.tailStroke.Color = color
end

function TutorialHint:_setFinger(scale: number, alpha: number)
	self.fingerScale.Scale = scale
	if self.fingerParts then
		for _, part in self.fingerParts do
			part.BackgroundTransparency = alpha
			local stroke = part:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Transparency = alpha
			end
		end
	else
		self.finger.ImageTransparency = alpha
	end
end

-- Shot demo; returns the power to show on the bar (nil = leave it to the player).
function TutorialHint:_updateShot(holding: boolean, power: number, s: number, radius: number, pulse: number): (Vector2, number, number, number?, number)
	local hint = self.hint
	local fingerOffset, fingerScale, fingerAlpha, demoPower = Vector2.zero, 1, 0, nil
	local rippleT = (self.clock % 1.1) / 1.1
	local inZone = power >= hint.powerMin and power <= hint.powerMax
	if holding then
		fingerScale = 0.86
		if inZone then
			self:_setLabel(TEXT.Release, LIME)
			self.popScale = math.max(self.popScale, 1 + 0.08 * pulse)
		else
			self:_setLabel(TEXT.Wait, GOLD)
		end
	elseif self.clock < self.nudgeUntil then
		fingerOffset = Vector2.new(math.sin(self.clock * 40) * 10 * s * (self.nudgeUntil - self.clock), 0)
		self:_setLabel(TEXT.Missed, PINK)
	else
		local t = self.clock % SHOT_LOOP
		local start = Vector2.new(radius * 1.2 + 60 * s, radius * 1.4 + 90 * s)
		if t < ARRIVE then
			local k = easeOut(t / ARRIVE)
			fingerOffset = start:Lerp(Vector2.zero, k)
			fingerAlpha = 1 - k
			self:_setLabel(TEXT.Press, GOLD)
		elseif t < PRESS then
			fingerScale = 1 - 0.14 * easeOut((t - ARRIVE) / (PRESS - ARRIVE))
			rippleT = (t - ARRIVE) / 1.1
			self:_setLabel(TEXT.Press, GOLD)
		elseif t < RELEASE then
			fingerScale = 0.86
			rippleT = (t - ARRIVE) / 1.1
			demoPower = DEMO_POWER * (t - PRESS) / (RELEASE - PRESS)
			self:_setLabel(TEXT.Hold, GOLD)
		elseif t < FADE then
			local k = easeOut((t - RELEASE) / (FADE - RELEASE))
			fingerScale = 0.86 + 0.14 * k
			fingerOffset = Vector2.new(10 * s * k, -16 * s * k)
			fingerAlpha = k
			demoPower = DEMO_POWER
			self:_setLabel(TEXT.Release, LIME)
		else
			fingerAlpha = 1
			demoPower = 0
			self:_setLabel(TEXT.Press, GOLD)
		end
	end
	local accent = if holding and inZone then LIME else GOLD
	self.ringStroke.Color = accent
	self.fill.BackgroundColor3 = accent
	self.dot.BackgroundColor3 = accent
	self.fill.BackgroundTransparency = 0.86 - 0.1 * pulse
	for i, ripple in self.ripples do
		local k = (rippleT + (i - 1) * 0.5) % 1
		ripple.frame.Size = UDim2.fromScale(1 + k * 0.9, 1 + k * 0.9)
		ripple.stroke.Transparency = 0.2 + 0.8 * k
		ripple.stroke.Color = accent
	end
	self.fingerAnchor.WorldPosition = self.point
	return fingerOffset, fingerScale, fingerAlpha, demoPower, 0
end

-- Pass demo: press at the ball, drag to the teammate, let go.
function TutorialHint:_updatePass(holding: boolean, aimTarget: Vector3?, s: number): (Vector2, number, number, number?)
	local fingerScale, fingerAlpha, demoPower = 1, 0, nil
	local fingerOffset = Vector2.zero
	local start, point = self.start :: Vector3, self.point
	local ground = Vector3.new(point.X, 0, point.Z)
	local fullPower = Vector3.new(point.X - start.X, 0, point.Z - start.Z).Magnitude / PassConfig.Ball.MaxRange
	if holding then
		fingerAlpha = 1 -- the player's own finger is there now
		local near = aimTarget and Vector3.new(aimTarget.X - point.X, 0, aimTarget.Z - point.Z).Magnitude <= self.hint.tapRadius
		if near then
			self:_setLabel(TEXT.PassRelease, LIME)
		else
			self:_setLabel(TEXT.PassPress, GOLD)
		end
		self.fingerAnchor.WorldPosition = ground
	elseif self.clock < self.nudgeUntil then
		fingerOffset = Vector2.new(math.sin(self.clock * 40) * 10 * s * (self.nudgeUntil - self.clock), 0)
		self.fingerAnchor.WorldPosition = ground
		self:_setLabel(TEXT.PassMissed, PINK)
	else
		local t = self.clock % PASS_LOOP
		local at = start
		if t < P_ARRIVE then
			fingerAlpha = 1 - easeOut(t / P_ARRIVE)
			fingerOffset = Vector2.new(0, 40 * s * (1 - easeOut(t / P_ARRIVE)))
		elseif t < P_PRESS then
			fingerScale = 1 - 0.14 * easeOut((t - P_ARRIVE) / (P_PRESS - P_ARRIVE))
			demoPower = 0
		elseif t < P_DRAG then
			local k = easeInOut((t - P_PRESS) / (P_DRAG - P_PRESS))
			fingerScale = 0.86
			at = start:Lerp(ground, k)
			demoPower = fullPower * k
		elseif t < P_RELEASE then
			local k = easeOut((t - P_DRAG) / (P_RELEASE - P_DRAG))
			at = ground
			fingerScale = 0.86 + 0.14 * k
			fingerOffset = Vector2.new(0, -16 * s * k)
			fingerAlpha = k
			demoPower = fullPower
		else
			at = ground
			fingerAlpha = 1
			demoPower = 0
		end
		self.fingerAnchor.WorldPosition = Vector3.new(at.X, 0, at.Z)
		self:_setLabel(if t >= P_DRAG and t < P_RELEASE then TEXT.PassRelease else TEXT.PassPress, if t >= P_DRAG and t < P_RELEASE then LIME else GOLD)
	end
	return fingerOffset, fingerScale, fingerAlpha, demoPower
end

-- Call every frame with the HUD scale. aimTarget: the pass drop point while dragging.
-- Returns the demo power to show on the power bar while the player isn't holding.
function TutorialHint:update(dt: number, holding: boolean, power: number, uiScale: number, aimTarget: Vector3?): number?
	local hint = self.hint
	if not hint then
		return nil
	end
	self.clock += dt
	local s = uiScale
	self.popScale += (1 - self.popScale) * math.min(1, dt * 10)
	local pulse = 0.5 + 0.5 * math.sin(self.clock * 6)

	local radius = if self.kind == "SHOT" then math.max(12, self.target.AbsoluteSize.X / 2) else 0
	local fingerOffset, fingerScale, fingerAlpha, demoPower
	if self.kind == "PASS" then
		fingerOffset, fingerScale, fingerAlpha, demoPower = self:_updatePass(holding, aimTarget, s)
	else
		fingerOffset, fingerScale, fingerAlpha, demoPower = self:_updateShot(holding, power, s, radius, pulse)
	end

	self.bubble.Position = UDim2.new(0.5, 0, 0.5, -radius - 12 * s)
	self.bubbleScale.Scale = s * self.popScale

	local size = FINGER_SIZE * s
	self.fingerGui.Size = UDim2.fromOffset(size * 3, size * 3)
	self.finger.Size = UDim2.fromOffset(size, size)
	self.finger.Position = UDim2.new(0.5, fingerOffset.X, 0.5, fingerOffset.Y)
	self:_setFinger(fingerScale, fingerAlpha)
	return demoPower
end

return TutorialHint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">UiKit</string>
            <string name="Source"><![CDATA[-- Building blocks for the career menus in the same purple "pixel UI kit" style as ShotHud:
-- palette, fonts, glowing panels, gold/violet buttons, club crests, star ratings, text fields,
-- toggles and the viewport scaler.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UiKit = {}

local rgb = Color3.fromRGB
UiKit.rgb = rgb
UiKit.NAVY = rgb(18, 11, 36)
UiKit.PANEL_TOP = rgb(43, 18, 80)
UiKit.PANEL_BOTTOM = rgb(27, 15, 51)
UiKit.VIOLET = rgb(90, 47, 194)
UiKit.GLOW = rgb(123, 77, 255)
UiKit.LILAC = rgb(190, 168, 255)
UiKit.RED = rgb(255, 45, 85)
UiKit.RED_LIGHT = rgb(255, 150, 170)
UiKit.GOLD = rgb(255, 191, 31)
UiKit.GOLD_LIGHT = rgb(255, 226, 120)
UiKit.LIME = rgb(170, 240, 40)
UiKit.ORANGE = rgb(255, 159, 10)
UiKit.LIP = rgb(178, 84, 0)
UiKit.CREAM = rgb(247, 236, 214)
UiKit.INK = rgb(18, 6, 31)
UiKit.SHADOW = rgb(46, 16, 92)
UiKit.WHITE = Color3.new(1, 1, 1)

local MONTSERRAT = "rbxasset://fonts/families/Montserrat.json"
UiKit.FONT_HEAVY = Font.new(MONTSERRAT, Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
UiKit.FONT_BOLD = Font.new(MONTSERRAT, Enum.FontWeight.Bold, Enum.FontStyle.Italic)
UiKit.FONT_MEDIUM = Font.new(MONTSERRAT, Enum.FontWeight.Medium)
UiKit.FONT_PRINT = Font.new(MONTSERRAT, Enum.FontWeight.Heavy) -- shirt lettering

local NAVY, VIOLET, GLOW, LILAC, GOLD, GOLD_LIGHT = UiKit.NAVY, UiKit.VIOLET, UiKit.GLOW, UiKit.LILAC, UiKit.GOLD, UiKit.GOLD_LIGHT
local INK, CREAM, WHITE, SHADOW, ORANGE, LIP, RED = UiKit.INK, UiKit.CREAM, UiKit.WHITE, UiKit.SHADOW, UiKit.ORANGE, UiKit.LIP, UiKit.RED

function UiKit.create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end
local create = UiKit.create

function UiKit.frame(props: { [string]: any }): Frame
	props.BorderSizePixel = 0
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 0
	end
	return create("Frame", props)
end
local frame = UiKit.frame

function UiKit.text(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = 1
	props.RichText = true
	props.FontFace = props.FontFace or UiKit.FONT_HEAVY
	props.TextColor3 = props.TextColor3 or CREAM
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return create("TextLabel", props)
end
local text = UiKit.text

function UiKit.corner(parent: Instance, radius: number?)
	create("UICorner", { CornerRadius = if radius then UDim.new(0, radius) else UDim.new(1, 0), Parent = parent })
end
local corner = UiKit.corner

function UiKit.stroke(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	return create("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end
local stroke = UiKit.stroke

-- Text outline; mitred joins keep the chunky pixel-kit corners.
function UiKit.outline(label: TextLabel | TextBox, thickness: number, color: Color3?): UIStroke
	return create("UIStroke", {
		Color = color or INK,
		Thickness = thickness,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = label,
	})
end
local outline = UiKit.outline

function UiKit.sizeLimit(label: TextLabel, maxSize: number)
	label.TextScaled = true
	create("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8, Parent = label })
end

-- Outlined title with a hard drop shadow (a sibling label underneath).
function UiKit.bigText(props: { [string]: any }, thickness: number, offset: Vector2, maxSize: number?): (TextLabel, TextLabel)
	local shadowProps = table.clone(props)
	shadowProps.Name = (props.Name or "Text") .. "Shadow"
	shadowProps.TextColor3 = SHADOW
	shadowProps.Position = (props.Position or UDim2.new()) + UDim2.fromOffset(offset.X, offset.Y)
	shadowProps.Text = string.gsub(props.Text or "", "<[^>]+>", "")
	local shadow = text(shadowProps)
	outline(shadow, thickness)
	local main = text(table.clone(props))
	outline(main, thickness)
	if maxSize then
		UiKit.sizeLimit(shadow, maxSize)
		UiKit.sizeLimit(main, maxSize)
	end
	return main, shadow
end

-- Dark purple panel: vertical gradient, violet border and a soft glow from stacked strokes.
function UiKit.panel(props: { [string]: any }, radius: number, glowColor: Color3?): (Frame, { UIStroke }, UIStroke)
	props.BackgroundTransparency = 1
	local root = frame(props)
	local glows = {}
	for _, layer in { { 4, 0.7 }, { 9, 0.84 }, { 16, 0.93 } } do
		local halo = frame({ Name = "Glow", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, Parent = root })
		corner(halo, radius)
		table.insert(glows, stroke(halo, glowColor or GLOW, layer[1], layer[2]))
	end
	local bg = frame({ Name = "Background", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.04, ZIndex = 0, Parent = root })
	corner(bg, radius)
	create("UIGradient", { Color = ColorSequence.new(UiKit.PANEL_TOP, UiKit.PANEL_BOTTOM), Rotation = 90, Parent = bg })
	local border = stroke(bg, VIOLET, 2)
	frame({
		Name = "Sheen",
		Position = UDim2.new(0, radius, 0, 3),
		Size = UDim2.new(1, -radius * 2, 0, 2),
		BackgroundColor3 = LILAC,
		BackgroundTransparency = 0.7,
		ZIndex = 0,
		Parent = root,
	})
	return root, glows, border
end

-- Decorative "////" slashes from the reference panels.
function UiKit.slashes(parent: Instance, position: UDim2, size: number, color: Color3)
	text({ Name = "Slashes", Position = position, Size = UDim2.fromOffset(size * 2.2, size), TextSize = size, Text = "////", TextColor3 = color, TextTransparency = 0.75, Parent = parent })
end

-- Small rounded tag: icon + text on navy with a coloured border.
function UiKit.chip(parent: Instance, props: { [string]: any }, value: string, color: Color3): (Frame, TextLabel)
	props.Size = props.Size or UDim2.fromOffset(0, 28)
	props.AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.X
	props.BackgroundColor3 = props.BackgroundColor3 or NAVY
	props.Parent = parent
	local c = frame(props)
	corner(c, 8)
	stroke(c, color, 2)
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = c })
	local label = text({ Name = "Label", Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Text = value, TextSize = 14, Parent = c })
	outline(label, 1.5)
	return c, label
end

export type Button = {
	button: TextButton,
	body: Frame,
	label: TextLabel,
	sub: TextLabel?,
	shine: Frame,
	shineTween: Tween,
	setText: (Button, string, string?) -> (),
	setEnabled: (Button, boolean) -> (),
	playShine: (Button) -> (),
	enabled: boolean,
}

local STYLES = {
	primary = { face = { rgb(255, 214, 74), ORANGE }, lip = LIP, text = INK },
	secondary = { face = { rgb(150, 110, 255), VIOLET }, lip = rgb(40, 16, 96), text = CREAM },
	danger = { face = { rgb(255, 120, 140), RED }, lip = rgb(120, 10, 40), text = CREAM },
}

-- Gold primary / violet secondary / red danger button: dark lip below, gradient face clipped by
-- a CanvasGroup with a moving shine. `sub` adds a small second line under the label.
function UiKit.button(parent: Instance, props: { [string]: any }, labelText: string, onActivated: () -> (), style: string?, sub: string?): Button
	local look = STYLES[style or "primary"]
	local height = props.Size and props.Size.Y.Offset or 52
	local faceHeight = height - 6
	props.BackgroundTransparency = 1
	props.AutoButtonColor = false
	props.Text = ""
	props.Parent = parent
	local button = create("TextButton", props)

	local lip = frame({ Name = "Lip", Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, faceHeight), BackgroundColor3 = look.lip, Parent = button })
	corner(lip, 9)
	stroke(lip, INK, 2.5)
	local body = frame({ Name = "Body", Size = UDim2.new(1, 0, 0, faceHeight), BackgroundTransparency = 1, Parent = button })
	local face = create("CanvasGroup", { Name = "Face", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = body })
	corner(face, 9)
	local fill = frame({ Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = face })
	create("UIGradient", { Color = ColorSequence.new(look.face[1], look.face[2]), Rotation = 90, Parent = fill })
	frame({ Name = "Sheen", Size = UDim2.new(1, 0, 0.42, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.72, Parent = face })
	local shine = frame({
		Name = "Shine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(-0.3, 0.5),
		Size = UDim2.new(0, 34, 2, 0),
		Rotation = 22,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.45,
		Parent = face,
	})
	local edge = frame({ Name = "Outline", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = body })
	corner(edge, 9)
	stroke(edge, INK, 2.5)

	local labelSize = if sub then UDim2.new(1, -20, 0.62, 0) else UDim2.new(1, -16, 1, 0)
	local label = text({
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, if sub then 0.06 else 0),
		Size = labelSize,
		Text = labelText,
		TextSize = props.TextSize or (if faceHeight >= 46 then 24 else 20),
		TextColor3 = look.text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = body,
	})
	if look.text == INK then
		outline(label, 1.5, GOLD_LIGHT).Transparency = 0.4
	else
		outline(label, 2)
	end
	local subLabel = nil
	if sub then
		subLabel = text({
			Name = "Sub",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.6),
			Size = UDim2.new(1, -20, 0.32, 0),
			Text = sub,
			TextSize = 14,
			FontFace = UiKit.FONT_BOLD,
			TextColor3 = look.text,
			TextTransparency = 0.15,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = body,
		})
	end
	local dim = frame({ Name = "Disabled", Size = UDim2.new(1, 0, 1, 6), BackgroundColor3 = INK, BackgroundTransparency = 0.45, Visible = false, ZIndex = 5, Parent = button })
	corner(dim, 9)

	local self = {
		button = button,
		body = body,
		label = label,
		sub = subLabel,
		shine = shine,
		enabled = true,
		shineTween = TweenService:Create(shine, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, false, 1.6), { Position = UDim2.fromScale(1.3, 0.5) }),
	}

	function self.setText(_, value: string, subValue: string?)
		label.Text = value
		if subLabel and subValue then
			subLabel.Text = subValue
		end
	end
	function self.setEnabled(_, enabled: boolean)
		self.enabled = enabled
		dim.Visible = not enabled
		if not enabled then
			self.shineTween:Cancel()
			shine.Position = UDim2.fromScale(-0.3, 0.5)
		end
	end
	function self.playShine(_)
		if self.enabled then
			shine.Position = UDim2.fromScale(-0.3, 0.5)
			self.shineTween:Play()
		end
	end

	local pressInfo = TweenInfo.new(0.07, Enum.EasingStyle.Quad)
	local function setPressed(pressed: boolean)
		TweenService:Create(body, pressInfo, { Position = UDim2.fromOffset(0, if pressed and self.enabled then 5 else 0) }):Play()
	end
	button.MouseButton1Down:Connect(function()
		setPressed(true)
	end)
	button.MouseButton1Up:Connect(function()
		setPressed(false)
	end)
	button.MouseLeave:Connect(function()
		setPressed(false)
	end)
	button.Activated:Connect(function()
		if self.enabled then
			onActivated()
		end
	end)
	return self :: any
end

-- Round club badge: shirt-to-shorts gradient, ink rim and the club's letters.
function UiKit.crest(parent: Instance, props: { [string]: any }, club): Frame
	local size = props.Size and props.Size.X.Offset or 56
	props.BackgroundColor3 = WHITE
	props.Parent = parent
	local badge = frame(props)
	corner(badge)
	create("UIGradient", { Color = ColorSequence.new(club.shirt, club.shorts), Rotation = 125, Parent = badge })
	stroke(badge, INK, 2.5)
	local ring = frame({ Name = "Ring", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -8, 1, -8), BackgroundTransparency = 1, Parent = badge })
	corner(ring)
	stroke(ring, WHITE, 1.5, 0.45)
	local letters = text({
		Name = "Letters",
		Size = UDim2.fromScale(1, 1),
		Text = club.short,
		TextSize = math.floor(size * 0.36),
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = badge,
	})
	outline(letters, 2)
	return badge
end

-- Five stars filled in half steps (rating 0..5).
function UiKit.stars(parent: Instance, props: { [string]: any }, rating: number, starSize: number): Frame
	props.BackgroundTransparency = 1
	props.Size = props.Size or UDim2.fromOffset(starSize * 5 + 4 * 2, starSize)
	props.Parent = parent
	local row = frame(props)
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
	for i = 1, 5 do
		local slot = frame({ Name = "Star" .. i, LayoutOrder = i, Size = UDim2.fromOffset(starSize, starSize), BackgroundTransparency = 1, Parent = row })
		local back = text({ Size = UDim2.fromScale(1, 1), Text = "★", TextSize = starSize, TextColor3 = SHADOW, TextXAlignment = Enum.TextXAlignment.Center, Parent = slot })
		outline(back, 1.5)
		local fill = math.clamp(rating - (i - 1), 0, 1)
		if fill > 0 then
			local clip = frame({ Name = "Fill", Size = UDim2.fromScale(fill, 1), BackgroundTransparency = 1, ClipsDescendants = true, Parent = slot })
			local gold = text({ Size = UDim2.fromOffset(starSize, starSize), Text = "★", TextSize = starSize, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Center, Parent = clip })
			outline(gold, 1.5)
		end
	end
	return row
end

-- Navy input field; the border turns gold while typing.
function UiKit.textBox(parent: Instance, props: { [string]: any }, placeholder: string): TextBox
	local holder = frame({ Name = (props.Name or "Field") .. "Holder", Position = props.Position, Size = props.Size, BackgroundColor3 = NAVY, Parent = parent })
	corner(holder, 8)
	local border = stroke(holder, VIOLET, 2)
	frame({ Name = "Bevel", Position = UDim2.fromOffset(6, 3), Size = UDim2.new(1, -12, 0, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0.9, Parent = holder })
	local box = create("TextBox", {
		Name = props.Name or "Field",
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Text = "",
		PlaceholderText = placeholder,
		PlaceholderColor3 = LILAC,
		TextColor3 = CREAM,
		TextSize = props.TextSize or 20,
		FontFace = UiKit.FONT_BOLD,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
		Parent = holder,
	})
	box.Focused:Connect(function()
		border.Color = GOLD
	end)
	box.FocusLost:Connect(function()
		border.Color = VIOLET
	end)
	return box
end

-- On/off pill. onChanged(value) fires on taps; set(value) updates without firing.
function UiKit.toggle(parent: Instance, props: { [string]: any }, value: boolean, onChanged: (boolean) -> ())
	props.Size = props.Size or UDim2.fromOffset(76, 34)
	props.BackgroundColor3 = NAVY
	props.AutoButtonColor = false
	props.Text = ""
	props.BorderSizePixel = 0
	props.Parent = parent
	local pill = create("TextButton", props)
	corner(pill)
	local border = stroke(pill, VIOLET, 2)
	local knob = frame({ Name = "Knob", AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = CREAM, Parent = pill })
	corner(knob)
	stroke(knob, INK, 2)
	local state = text({ Name = "State", Size = UDim2.fromScale(1, 1), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Parent = pill })
	outline(state, 1.5)
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = state })
	local toggle = { value = value }
	function toggle.set(_, on: boolean)
		toggle.value = on
		pill.BackgroundColor3 = if on then rgb(92, 150, 20) else NAVY
		border.Color = if on then UiKit.LIME else VIOLET
		state.Text = if on then "ВКЛ" else "ВЫКЛ"
		state.TextXAlignment = if on then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right
		TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Position = if on then UDim2.new(1, -30, 0.5, 0) else UDim2.new(0, 4, 0.5, 0) }):Play()
	end
	pill.Activated:Connect(function()
		toggle:set(not toggle.value)
		onChanged(toggle.value)
	end)
	toggle:set(value)
	return toggle
end

-- Keeps every registered UIScale at the viewport scale: as big as `layoutSize` (design units of
-- the largest screen) can be while still fitting, between 0.5 and 1.15. boost: "large interface".
function UiKit.scaler(gui: ScreenGui, layoutSize: Vector2)
	local scaler = { scales = {} :: { UIScale }, boost = 1, scale = 1 }
	function scaler.rescale(_)
		local size = gui.AbsoluteSize
		if size.X < 1 or size.Y < 1 then
			return
		end
		local fit = math.min((size.X - 40) / layoutSize.X, (size.Y - 24) / layoutSize.Y)
		local scale = math.clamp(fit, 0.5, 1.15)
		if scaler.boost ~= 1 then
			scale = math.max(math.min(scale * scaler.boost, fit), 0.5)
		end
		scaler.scale = scale
		for _, uiScale in scaler.scales do
			uiScale.Scale = scale
		end
	end
	function scaler.add(_, target: GuiObject): UIScale
		local uiScale = create("UIScale", { Parent = target })
		table.insert(scaler.scales, uiScale)
		uiScale.Scale = scaler.scale
		return uiScale
	end
	function scaler.setBoost(_, boost: number)
		scaler.boost = boost
		scaler:rescale()
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		scaler:rescale()
	end)
	scaler:rescale()
	return scaler
end

function UiKit.screenGui(name: string, displayOrder: number): ScreenGui
	return create("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
end

-- Pop-in for a panel: its nested UIScale grows from `from` to 1 with an overshoot.
function UiKit.pop(uiScale: UIScale, from: number?)
	uiScale.Scale = from or 0.85
	TweenService:Create(uiScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

return UiKit
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
