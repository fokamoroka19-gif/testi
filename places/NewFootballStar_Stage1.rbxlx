        <Properties>
          <string name="Name">ShotConfig</string>
          <string name="Source"><![CDATA[-- Tuning values for the Stage 1 shot, shared by the server (outcome) and the client (visuals)
-- so both sides agree on goal geometry and ball flight.
--
-- World layout (studs): the goal line is the plane Z = 0, the goal is centred on X = 0,
-- the ground is Y = 0, and the shooter stands at +Z shooting towards -Z.

local ShotConfig = {}

ShotConfig.Goal = {
	Width = 24, -- inside width, post to post
	Height = 8, -- inside height, ground to crossbar
	PostRadius = 0.35,
	NetDepth = 6,
	-- Fraction of the ball radius that must overlap the frame to count as POST;
	-- lighter touches deflect in (goal side) or out (wide side).
	FrameHitDepth = 0.5,
}

ShotConfig.Ball = {
	Radius = 1,
}

ShotConfig.ShotDistance = 36 -- goal line to ball spot

-- Lower than workspace.Gravity on purpose: weak shots get a visible loop, hard shots stay flat.
ShotConfig.Gravity = 60
ShotConfig.MinBallSpeed = 40 -- power 0
ShotConfig.MaxBallSpeed = 110 -- power 1

ShotConfig.Accuracy = {
	-- Standard deviation (studs) of the random offset from the aim point, by Shooting skill.
	ScatterAtZeroSkill = 2.6,
	ScatterAtMaxSkill = 0.5,
	MaxSigmas = 2.5, -- cap so a single shot is never wildly off
	-- Power above this threshold is less accurate and tends to rise over the bar.
	OverpowerFrom = 0.85,
	OverpowerScatter = 1.5,
	OverpowerLift = 2.5,
}

ShotConfig.Goalkeeper = {
	Enabled = true,
	Skill = 60, -- 0..100, opponent goalkeeper rating
	HomeX = 0,
	HomeY = 3.5, -- body centre
	HomeZ = 1.2, -- stands just in front of the line
	Reach = 3, -- distance the hands cover without moving
	ReactionTime = 0.22,
	ReactionJitter = 0.06, -- +/- random part of the reaction time
	DiveSpeedAtZeroSkill = 10,
	DiveSpeedAtMaxSkill = 26,
	ModelScale = 1.15, -- R15 rig scale; ~6 studs tall next to the 8-stud goal
}

-- Placeholder until career data exists (GDD: new players start around OVR 40).
ShotConfig.DefaultShooting = 42

ShotConfig.Drill = {
	ShotsPerSeries = 10,
}

ShotConfig.Episode = {
	MinThinkTime = 0.3, -- seconds between episode start and an accepted input
	Timeout = 120, -- an unanswered episode expires after this
	MinRemoteInterval = 0.2, -- per-player rate limit for remote calls
	InputTolerance = 1e-3, -- float slack allowed on input ranges
}

ShotConfig.Input = {
	PowerCycleSeconds = 1.6, -- power meter goes 0 -> 1 -> 0 over this time while held
	ReadyDelay = 0.35, -- pause after a new episode before input is accepted
}

-- Far and narrow, so the ball sits just above the bottom panel and the goal fills the middle.
ShotConfig.Camera = {
	Position = Vector3.new(0, 6, 72),
	LookAt = Vector3.new(0, 2.5, 0),
	FieldOfView = 28,
}

return ShotConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">ShotPhysics</string>
          <string name="Source"><![CDATA[-- Pure shot geometry and ball flight. Used by the server to decide outcomes and by the
-- client to draw the exact same arc, so what the player sees matches what was decided.

local ShotConfig = require(script.Parent.ShotConfig)

local Goal = ShotConfig.Goal
local BALL_RADIUS = ShotConfig.Ball.Radius
local GRAVITY = Vector3.new(0, -ShotConfig.Gravity, 0)

local ShotPhysics = {}

-- Where the ball crosses the goal plane relative to the frame.
ShotPhysics.Zone = {
	OnTarget = "ON_TARGET", -- fully inside the goal mouth
	Frame = "FRAME", -- solid contact with a post or the crossbar
	Wide = "WIDE", -- wide or over
}

function ShotPhysics.ballSpot(): Vector3
	return Vector3.new(0, BALL_RADIUS, ShotConfig.ShotDistance)
end

-- Aim X in -1..1 and Y in 0..1 cover exactly the area where the whole ball fits inside the
-- goal mouth, so aiming at the edge means grazing the frame.
function ShotPhysics.aimToGoalPoint(aimX: number, aimY: number): Vector3
	local halfWidth = Goal.Width / 2 - BALL_RADIUS
	local x = math.clamp(aimX, -1, 1) * halfWidth
	local y = BALL_RADIUS + math.clamp(aimY, 0, 1) * (Goal.Height - 2 * BALL_RADIUS)
	return Vector3.new(x, y, 0)
end

function ShotPhysics.goalPointToAim(point: Vector3): (number, number)
	local halfWidth = Goal.Width / 2 - BALL_RADIUS
	local aimX = math.clamp(point.X / halfWidth, -1, 1)
	local aimY = math.clamp((point.Y - BALL_RADIUS) / (Goal.Height - 2 * BALL_RADIUS), 0, 1)
	return aimX, aimY
end

function ShotPhysics.ballSpeed(power: number): number
	local p = math.clamp(power, 0, 1)
	return ShotConfig.MinBallSpeed + (ShotConfig.MaxBallSpeed - ShotConfig.MinBallSpeed) * p
end

function ShotPhysics.flightTime(start: Vector3, target: Vector3, power: number): number
	return (target - start).Magnitude / ShotPhysics.ballSpeed(power)
end

-- Initial velocity of a projectile that leaves `start` and is at `target` after `flightTime`.
function ShotPhysics.launchVelocity(start: Vector3, target: Vector3, flightTime: number): Vector3
	return (target - start) / flightTime - GRAVITY * (flightTime / 2)
end

function ShotPhysics.positionAt(start: Vector3, velocity: Vector3, t: number): Vector3
	return start + velocity * t + GRAVITY * (0.5 * t * t)
end

function ShotPhysics.velocityAt(velocity: Vector3, t: number): Vector3
	return velocity + GRAVITY * t
end

function ShotPhysics.gravity(): Vector3
	return GRAVITY
end

local function distanceToSegment(px: number, py: number, ax: number, ay: number, bx: number, by: number): number
	local abx, aby = bx - ax, by - ay
	local t = math.clamp(((px - ax) * abx + (py - ay) * aby) / (abx * abx + aby * aby), 0, 1)
	local dx, dy = px - (ax + abx * t), py - (ay + aby * t)
	return math.sqrt(dx * dx + dy * dy)
end

-- Classifies the ball centre where it crosses the goal plane (Z = 0).
function ShotPhysics.classify(point: Vector3): string
	local postX = Goal.Width / 2 + Goal.PostRadius
	local barY = Goal.Height + Goal.PostRadius
	local x, y = point.X, point.Y

	local frameDistance = math.min(
		distanceToSegment(x, y, -postX, 0, -postX, barY),
		distanceToSegment(x, y, postX, 0, postX, barY),
		distanceToSegment(x, y, -postX, barY, postX, barY)
	)
	if frameDistance < Goal.PostRadius + BALL_RADIUS * (1 - Goal.FrameHitDepth) then
		return ShotPhysics.Zone.Frame
	end
	if math.abs(x) < postX and y < barY then
		return ShotPhysics.Zone.OnTarget
	end
	return ShotPhysics.Zone.Wide
end

return ShotPhysics
]]></string>
        </Properties>
      </Item>
    </Item>
