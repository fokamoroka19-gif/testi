    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Server entry point for the Stage 1 shot prototype.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- First, before anything can yield: no avatar in Stage 1 (fixed camera, and phones would
-- otherwise show the thumbstick and jump button over the goal).
Players.CharacterAutoLoads = false
for _, player in Players:GetPlayers() do
	if player.Character then
		player.Character:Destroy()
	end
end

if ReplicatedStorage:GetAttribute("ShotServerRunning") then
	warn("[Main] Another copy of the Main script is already running. Delete the duplicate.")
	return
end
ReplicatedStorage:SetAttribute("ShotServerRunning", true)

-- Modules are looked up by name anywhere under ServerScriptService, so it doesn't matter
-- whether they sit next to this script or inside a Services folder.
local function requireServerModule(name: string)
	local module = ServerScriptService:FindFirstChild(name, true)
	if not (module and module:IsA("ModuleScript")) then
		error(string.format("[Main] ModuleScript '%s' was not found in ServerScriptService. See README > Setup.", name), 0)
	end
	return require(module)
end

local shared = ReplicatedStorage:FindFirstChild("Shared")
for _, name in { "ShotConfig", "ShotPhysics" } do
	if not (shared and shared:FindFirstChild(name)) then
		error(string.format("[Main] ReplicatedStorage > Shared > %s (ModuleScript) is missing. See README > Setup.", name), 0)
	end
end

local REMOTE_NAMES = { "RequestEpisode", "EpisodeStarted", "SubmitEpisodeInput", "EpisodeResult" }

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local remotes = {}
for _, name in REMOTE_NAMES do
	local remote = remotesFolder:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = remotesFolder
	end
	remotes[name] = remote
end

local SceneBuilder = requireServerModule("SceneBuilder")
local EpisodeService = requireServerModule("EpisodeService")

SceneBuilder.build()
EpisodeService.init(remotes)

print("[Main] Stage 1 shot prototype ready")
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">SceneBuilder</string>
        <string name="Source"><![CDATA[-- Builds the training ground at runtime: pitch, markings, goal with net, back wall with
-- boards, the goalkeeper and lighting. Goal dimensions come from ShotConfig so the visuals
-- always match the geometry the server uses for outcomes.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShotConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShotConfig"))

local Goal = ShotConfig.Goal
local Keeper = ShotConfig.Goalkeeper
local VERTICAL = CFrame.Angles(0, 0, math.pi / 2) -- cylinder parts are long along X

local WHITE = Color3.new(1, 1, 1)
local LIME = Color3.fromRGB(163, 230, 53)
local WALL = Color3.fromRGB(10, 22, 18)
local BOARD = Color3.fromRGB(16, 34, 29)
local GRASS_A = Color3.fromRGB(46, 101, 54)
local GRASS_B = Color3.fromRGB(41, 92, 49)
local MONTSERRAT = "rbxasset://fonts/families/Montserrat.json"

local PITCH_HALF_WIDTH = 120
local PITCH_BACK, PITCH_FRONT = -16, 130
local STRIPE_DEPTH = 9
local WALL_Z, WALL_HEIGHT = -16, 7

local SceneBuilder = {}

-- Decorative, anchored, no collisions: nothing in Stage 1 relies on Roblox physics.
local function makePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	part.Parent = parent
	return part
end

local function create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function folder(name: string, parent: Instance): Folder
	return create("Folder", { Name = name, Parent = parent })
end

-- The default "Baseplate" template has a baseplate at ground level (flickers through the
-- pitch) and a SpawnLocation in the goal mouth. Removed for this play session only.
local function clearDefaultTemplate()
	for _, child in workspace:GetChildren() do
		if child:IsA("SpawnLocation") or (child.Name == "Baseplate" and child:IsA("BasePart")) then
			child:Destroy()
		end
	end
end

local function buildPitch(scene: Instance)
	local pitch = folder("Pitch", scene)
	makePart({
		Name = "Surround",
		Size = Vector3.new(600, 1, 600),
		CFrame = CFrame.new(0, -0.6, 60),
		Color = Color3.fromRGB(36, 80, 43),
		Material = Enum.Material.Grass,
		Parent = pitch,
	})
	local stripes = math.ceil((PITCH_FRONT - PITCH_BACK) / STRIPE_DEPTH)
	for i = 0, stripes - 1 do
		makePart({
			Name = "Stripe",
			Size = Vector3.new(PITCH_HALF_WIDTH * 2, 1, STRIPE_DEPTH),
			CFrame = CFrame.new(0, -0.5, PITCH_BACK + STRIPE_DEPTH * (i + 0.5)),
			Color = if i % 2 == 0 then GRASS_A else GRASS_B,
			Material = Enum.Material.Grass,
			Parent = pitch,
		})
	end

	-- Real-world scale (goal width 7.32 m = 24 studs), so the ball sits on the penalty spot.
	local lines = folder("Markings", scene)
	local width = 0.45
	local function line(x1: number, z1: number, x2: number, z2: number)
		makePart({
			Name = "Line",
			Size = Vector3.new(math.abs(x2 - x1) + width, 0.06, math.abs(z2 - z1) + width),
			CFrame = CFrame.new((x1 + x2) / 2, 0, (z1 + z2) / 2),
			Color = WHITE,
			CastShadow = false,
			Parent = lines,
		})
	end
	line(-PITCH_HALF_WIDTH, 0, PITCH_HALF_WIDTH, 0)
	for _, box in { { 30, 18 }, { 66, 54 } } do -- six-yard box, penalty box
		local halfWidth, depth = box[1], box[2]
		line(-halfWidth, 0, -halfWidth, depth)
		line(halfWidth, 0, halfWidth, depth)
		line(-halfWidth, depth, halfWidth, depth)
	end

	-- Lime ring around the ball spot, drawn as a crisp SurfaceGui circle.
	local spot = makePart({
		Name = "BallSpotRing",
		Size = Vector3.new(4, 0.05, 4),
		CFrame = CFrame.new(0, 0.04, ShotConfig.ShotDistance),
		Transparency = 1,
		CastShadow = false,
		Parent = lines,
	})
	local gui = create("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 50,
		LightInfluence = 0,
		Brightness = 1.5,
		Parent = spot,
	})
	local ring = create("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -12, 1, -12),
		BackgroundColor3 = LIME,
		BackgroundTransparency = 0.85,
		Parent = gui,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ring })
	create("UIStroke", { Color = LIME, Thickness = 6, Parent = ring })
end

-- Transparent panel with a 1-stud grid of lines drawn on one face. SurfaceGui lines are
-- filtered like a texture, so they stay crisp at distance instead of flickering like thin parts.
local function netPanel(parent: Instance, name: string, size: Vector3, cframe: CFrame, face: Enum.NormalId, u: number, v: number)
	local part = makePart({ Name = name, Size = size, CFrame = cframe, Transparency = 1, CastShadow = false, Parent = parent })
	local gui = create("SurfaceGui", {
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 32,
		LightInfluence = 0.4,
		Parent = part,
	})
	create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.94, BorderSizePixel = 0, Parent = gui })
	local cellsU, cellsV = math.max(1, math.round(u)), math.max(1, math.round(v))
	for i = 0, cellsU do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(i / cellsU, 0),
			Size = UDim2.new(0, 3, 1, 0),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			Parent = gui,
		})
	end
	for j = 0, cellsV do
		create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, j / cellsV),
			Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			Parent = gui,
		})
	end
	return part
end

local function buildGoal(scene: Instance)
	local goal = Instance.new("Model")
	goal.Name = "Goal"

	local W, H, D = Goal.Width, Goal.Height, Goal.NetDepth
	local hw = W / 2
	local postX = hw + Goal.PostRadius
	local postLength = H + 2 * Goal.PostRadius
	local diameter = 2 * Goal.PostRadius
	for _, side in { -1, 1 } do
		makePart({
			Name = if side < 0 then "LeftPost" else "RightPost",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(postLength, diameter, diameter),
			CFrame = CFrame.new(side * postX, postLength / 2, 0) * VERTICAL,
			Color = WHITE,
			Reflectance = 0.05,
			Parent = goal,
		})
	end
	makePart({
		Name = "Crossbar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(W + 4 * Goal.PostRadius, diameter, diameter),
		CFrame = CFrame.new(0, H + Goal.PostRadius, 0),
		Color = WHITE,
		Reflectance = 0.05,
		Parent = goal,
	})

	-- Thin support frame at the back of the net.
	local support = Color3.fromRGB(215, 220, 218)
	local function rod(from: Vector3, to: Vector3)
		local delta = to - from
		makePart({
			Name = "Support",
			Size = Vector3.new(math.abs(delta.X) + 0.18, math.abs(delta.Y) + 0.18, math.abs(delta.Z) + 0.18),
			CFrame = CFrame.new((from + to) / 2),
			Color = support,
			Parent = goal,
		})
	end
	rod(Vector3.new(-hw, 0, -D), Vector3.new(-hw, H, -D))
	rod(Vector3.new(hw, 0, -D), Vector3.new(hw, H, -D))
	rod(Vector3.new(-hw, H, -D), Vector3.new(hw, H, -D))
	rod(Vector3.new(-hw, H, 0), Vector3.new(-hw, H, -D))
	rod(Vector3.new(hw, H, 0), Vector3.new(hw, H, -D))

	local net = folder("Net", goal)
	-- Faces point into the goal, towards the camera.
	netPanel(net, "NetBack", Vector3.new(W, H, 0.05), CFrame.new(0, H / 2, -D), Enum.NormalId.Back, W, H)
	netPanel(net, "NetLeft", Vector3.new(0.05, H, D), CFrame.new(-hw, H / 2, -D / 2), Enum.NormalId.Right, D, H)
	netPanel(net, "NetRight", Vector3.new(0.05, H, D), CFrame.new(hw, H / 2, -D / 2), Enum.NormalId.Left, D, H)
	netPanel(net, "NetTop", Vector3.new(W, 0.05, D), CFrame.new(0, H, -D / 2), Enum.NormalId.Bottom, W, D)

	goal.Parent = scene
end

local function buildWall(scene: Instance)
	local wall = folder("Wall", scene)
	local length = PITCH_HALF_WIDTH * 2
	makePart({
		Name = "Wall",
		Size = Vector3.new(length, WALL_HEIGHT, 1),
		CFrame = CFrame.new(0, WALL_HEIGHT / 2, WALL_Z - 0.5),
		Color = WALL,
		Parent = wall,
	})
	makePart({
		Name = "TopStrip",
		Size = Vector3.new(length, 0.22, 1.1),
		CFrame = CFrame.new(0, WALL_HEIGHT + 0.11, WALL_Z - 0.5),
		Color = LIME,
		Material = Enum.Material.Neon,
		CastShadow = false,
		Parent = wall,
	})

	for _, x in { -46, -28, 28, 46 } do
		local board = makePart({
			Name = "Board",
			Size = Vector3.new(16, 3.2, 0.3),
			CFrame = CFrame.new(x, 3.2, WALL_Z + 0.2),
			Color = BOARD,
			Parent = wall,
		})
		local gui = create("SurfaceGui", {
			Face = Enum.NormalId.Back, -- faces the pitch (+Z)
			SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
			PixelsPerStud = 40,
			LightInfluence = 0.3,
			Parent = board,
		})
		create("UIStroke", { Color = LIME, Thickness = 2, Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = create("Frame", {
			Size = UDim2.new(1, -8, 1, -8),
			Position = UDim2.fromOffset(4, 4),
			BackgroundTransparency = 1,
			Parent = gui,
		}) })
		create("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.9, 0.34),
			BackgroundTransparency = 1,
			RichText = true,
			TextScaled = true,
			FontFace = Font.new(MONTSERRAT, Enum.FontWeight.Heavy, Enum.FontStyle.Italic),
			TextColor3 = WHITE,
			Text = '<font color="#A3E635">///  NFS</font> / TRAINING GROUND',
			Parent = gui,
		})
	end
end

local KEEPER_COLORS = {
	Head = Color3.fromRGB(234, 192, 160),
	UpperTorso = Color3.fromRGB(255, 140, 0),
	LowerTorso = Color3.fromRGB(28, 28, 32),
	LeftUpperArm = Color3.fromRGB(255, 140, 0),
	RightUpperArm = Color3.fromRGB(255, 140, 0),
	LeftLowerArm = Color3.fromRGB(255, 140, 0),
	RightLowerArm = Color3.fromRGB(255, 140, 0),
	LeftHand = LIME, -- gloves
	RightHand = LIME,
	LeftUpperLeg = Color3.fromRGB(28, 28, 32),
	RightUpperLeg = Color3.fromRGB(28, 28, 32),
	LeftLowerLeg = Color3.fromRGB(255, 140, 0),
	RightLowerLeg = Color3.fromRGB(255, 140, 0),
	LeftFoot = Color3.fromRGB(20, 20, 22),
	RightFoot = Color3.fromRGB(20, 20, 22),
}

local function makeRigKeeper(): Model
	local description = Instance.new("HumanoidDescription")
	local model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	model.Name = "Goalkeeper"
	local bodyColors = model:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors:Destroy() -- otherwise it overrides the kit colours below
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			local color = KEEPER_COLORS[part.Name]
			if color then
				part.Color = color
			end
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true -- anchors the whole rig; the client moves it with PivotTo
	model.PrimaryPart = root
	model:ScaleTo(Keeper.ModelScale)
	return model
end

-- Simple block figure, used only if the R15 rig can't be created.
local function makeBlockKeeper(): Model
	local model = Instance.new("Model")
	model.Name = "Goalkeeper"
	local specs = {
		{ "Torso", Vector3.new(2.2, 2.2, 1.1), Vector3.new(0, 4.2, 0), KEEPER_COLORS.UpperTorso },
		{ "Head", Vector3.new(1.3, 1.3, 1.3), Vector3.new(0, 6, 0), KEEPER_COLORS.Head },
		{ "LeftLeg", Vector3.new(0.9, 3, 0.9), Vector3.new(-0.55, 1.5, 0), KEEPER_COLORS.LeftUpperLeg },
		{ "RightLeg", Vector3.new(0.9, 3, 0.9), Vector3.new(0.55, 1.5, 0), KEEPER_COLORS.RightUpperLeg },
		{ "LeftArm", Vector3.new(0.75, 2.4, 0.75), Vector3.new(-1.55, 4.1, 0), KEEPER_COLORS.LeftUpperArm },
		{ "RightArm", Vector3.new(0.75, 2.4, 0.75), Vector3.new(1.55, 4.1, 0), KEEPER_COLORS.RightUpperArm },
	}
	for _, spec in specs do
		local part = makePart({ Name = spec[1], Size = spec[2], CFrame = CFrame.new(spec[3]), Color = spec[4], Parent = model })
		if spec[1] == "Torso" then
			model.PrimaryPart = part
		end
	end
	return model
end

local function buildKeeper(scene: Instance)
	if not Keeper.Enabled then
		return
	end
	local ok, model = pcall(makeRigKeeper)
	if not ok then
		warn("[SceneBuilder] Could not create the R15 goalkeeper, using a simple one:", model)
		model = makeBlockKeeper()
	end
	-- Face the shooter (+Z) and stand with the feet on the ground.
	local facing = CFrame.Angles(0, math.pi, 0)
	model:PivotTo(facing)
	local box, size = model:GetBoundingBox()
	local lift = -(box.Position.Y - size.Y / 2)
	model:PivotTo(CFrame.new(Keeper.HomeX, lift, Keeper.HomeZ) * facing)
	model.Parent = scene
end

local function ensureChild(parent: Instance, className: string, name: string): any
	local existing = parent:FindFirstChildOfClass(className)
	if existing then
		return existing
	end
	return create(className, { Name = name, Parent = parent })
end

local function setupLighting()
	Lighting.ClockTime = 13.8
	Lighting.GeographicLatitude = 25
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(70, 80, 75)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 160, 155)
	Lighting.EnvironmentDiffuseScale = 0.7
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25

	local atmosphere = ensureChild(Lighting, "Atmosphere", "Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(198, 222, 236)
	atmosphere.Decay = Color3.fromRGB(120, 140, 155)
	atmosphere.Glare = 0
	atmosphere.Haze = 0.6

	local bloom = ensureChild(Lighting, "BloomEffect", "Bloom")
	bloom.Intensity = 0.6
	bloom.Size = 22
	bloom.Threshold = 1.4

	local grading = ensureChild(Lighting, "ColorCorrectionEffect", "ColorCorrection")
	grading.Saturation = 0.12
	grading.Contrast = 0.1
	grading.Brightness = 0
	grading.TintColor = Color3.fromRGB(255, 252, 245)

	local rays = ensureChild(Lighting, "SunRaysEffect", "SunRays")
	rays.Intensity = 0.02
	rays.Spread = 0.5
end

function SceneBuilder.build(): Folder
	local old = workspace:FindFirstChild("FootballScene")
	if old then
		old:Destroy()
	end
	clearDefaultTemplate()

	local scene = Instance.new("Folder")
	scene.Name = "FootballScene"
	buildPitch(scene)
	buildGoal(scene)
	buildWall(scene)
	buildKeeper(scene)
	scene.Parent = workspace

	setupLighting()
	print(string.format("[SceneBuilder] Training ground built (%d objects)", #scene:GetDescendants()))
	return scene
end

return SceneBuilder
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">EpisodeService</string>
          <string name="Source"><![CDATA[-- Owns interactive episodes: hands them out, validates client input and sends back results.
-- The client only ever sends {episodeId, aimX, aimY, power}; it never reports an outcome.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShotConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShotConfig"))
local ShotResolver = require(script.Parent.ShotResolver)

type Episode = { id: number, kind: string, seed: number, startedAt: number }
type PlayerState = {
	nextEpisodeId: number,
	active: Episode?,
	lastRemoteAt: number,
	shots: number, -- shots taken in the current series
	goals: number,
	history: { string }, -- outcome of each shot in the current series
}

local SERIES_LENGTH = ShotConfig.Drill.ShotsPerSeries

local EpisodeService = {}

local states: { [Player]: PlayerState } = {}
local seedSource = Random.new()
local remotes

local function getState(player: Player): PlayerState
	local state = states[player]
	if not state then
		state = { nextEpisodeId = 1, active = nil, lastRemoteAt = -math.huge, shots = 0, goals = 0, history = {} }
		states[player] = state
	end
	return state
end

local function passesRateLimit(state: PlayerState): boolean
	local now = os.clock()
	if now - state.lastRemoteAt < ShotConfig.Episode.MinRemoteInterval then
		return false
	end
	state.lastRemoteAt = now
	return true
end

-- Rejects non-numbers, NaN, infinities and out-of-range values.
local function isNumberInRange(value: any, min: number, max: number): boolean
	if typeof(value) ~= "number" or value ~= value then
		return false
	end
	local tolerance = ShotConfig.Episode.InputTolerance
	return value >= min - tolerance and value <= max + tolerance
end

local function sendEpisode(player: Player, state: PlayerState, episode: Episode)
	remotes.EpisodeStarted:FireClient(player, {
		episodeId = episode.id,
		kind = episode.kind,
		shotNumber = state.shots + 1,
		seriesLength = SERIES_LENGTH,
		goals = state.goals,
		history = table.clone(state.history),
	})
end

local function startEpisode(player: Player, state: PlayerState)
	if state.shots >= SERIES_LENGTH then
		state.shots, state.goals, state.history = 0, 0, {}
	end
	local episode = {
		id = state.nextEpisodeId,
		kind = "SHOT",
		-- Logged so any result can be reproduced from (seed, input).
		seed = seedSource:NextInteger(1, 2 ^ 31 - 1),
		startedAt = os.clock(),
	}
	state.nextEpisodeId += 1
	state.active = episode
	print(string.format("[EpisodeService] %s: episode #%d started (SHOT, seed %d)", player.Name, episode.id, episode.seed))
	sendEpisode(player, state, episode)
end

local function reject(player: Player, episodeId: any, reason: string)
	warn(string.format("[EpisodeService] %s: rejected input for episode %s (%s)", player.Name, tostring(episodeId), reason))
	remotes.EpisodeResult:FireClient(player, {
		episodeId = if typeof(episodeId) == "number" then episodeId else nil,
		rejected = true,
		reason = reason,
	})
end

local function onRequestEpisode(player: Player)
	local state = getState(player)
	if not passesRateLimit(state) then
		return
	end

	local active = state.active
	if active and os.clock() - active.startedAt <= ShotConfig.Episode.Timeout then
		-- Client lost track of it (e.g. after a rejection): resend instead of issuing a new one.
		sendEpisode(player, state, active)
		return
	end
	startEpisode(player, state)
end

local function onSubmitEpisodeInput(player: Player, episodeId: any, aimX: any, aimY: any, power: any)
	local state = getState(player)
	if not passesRateLimit(state) then
		return
	end

	local active = state.active
	if not active or episodeId ~= active.id then
		reject(player, episodeId, "unknown or already finished episode")
		return
	end
	if not (isNumberInRange(aimX, -1, 1) and isNumberInRange(aimY, 0, 1) and isNumberInRange(power, 0, 1)) then
		reject(player, episodeId, "invalid input values")
		return
	end

	local elapsed = os.clock() - active.startedAt
	if elapsed < ShotConfig.Episode.MinThinkTime then
		reject(player, episodeId, "input too early")
		return
	end
	if elapsed > ShotConfig.Episode.Timeout then
		state.active = nil
		reject(player, episodeId, "episode expired")
		return
	end

	-- Consume before resolving so the same episode can never produce a second result.
	state.active = nil

	local input = {
		aimX = math.clamp(aimX, -1, 1),
		aimY = math.clamp(aimY, 0, 1),
		power = math.clamp(power, 0, 1),
	}
	local stats = { shooting = ShotConfig.DefaultShooting, keeperSkill = ShotConfig.Goalkeeper.Skill }
	local result = ShotResolver.resolve(input, stats, Random.new(active.seed))

	state.shots += 1
	if result.outcome == "GOAL" then
		state.goals += 1
	end
	table.insert(state.history, result.outcome)
	local seriesOver = state.shots >= SERIES_LENGTH

	print(string.format(
		"[EpisodeService] %s: episode #%d aim=(%.2f, %.2f) power=%.2f -> %s (%d goals from %d/%d shots)",
		player.Name, active.id, input.aimX, input.aimY, input.power, result.outcome, state.goals, state.shots, SERIES_LENGTH
	))
	if seriesOver then
		print(string.format("[EpisodeService] %s: series finished, %d/%d goals", player.Name, state.goals, SERIES_LENGTH))
	end

	remotes.EpisodeResult:FireClient(player, {
		episodeId = active.id,
		outcome = result.outcome,
		start = result.start,
		target = result.target,
		flightTime = result.flightTime,
		keeperTarget = result.keeperTarget,
		keeperReaction = result.keeperReaction,
		shots = state.shots,
		goals = state.goals,
		seriesLength = SERIES_LENGTH,
		seriesOver = seriesOver,
		history = table.clone(state.history),
	})
end

function EpisodeService.init(remoteEvents)
	if remotes then
		warn("[EpisodeService] init called twice; ignoring")
		return
	end
	remotes = remoteEvents
	remotes.RequestEpisode.OnServerEvent:Connect(onRequestEpisode)
	remotes.SubmitEpisodeInput.OnServerEvent:Connect(onSubmitEpisodeInput)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

return EpisodeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ShotResolver</string>
          <string name="Source"><![CDATA[-- Server-only: turns validated shot input into an outcome. Never runs on the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local ShotPhysics = require(Shared:WaitForChild("ShotPhysics"))

export type ShotInput = { aimX: number, aimY: number, power: number }
export type ShotStats = { shooting: number, keeperSkill: number }
export type ShotResult = {
	outcome: string, -- "GOAL" | "SAVE" | "POST" | "MISS"
	start: Vector3,
	intended: Vector3, -- aim point before inaccuracy
	target: Vector3, -- where the ball actually crosses the goal plane
	flightTime: number,
	keeperTarget: Vector3, -- where the keeper's body centre gets to (goal plane)
	keeperReaction: number,
}

local ShotResolver = {}

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Standard normal sample (Box-Muller).
local function gaussian(rng: Random): number
	local u1 = math.max(rng:NextNumber(), 1e-9)
	local u2 = rng:NextNumber()
	return math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
end

function ShotResolver.resolve(input: ShotInput, stats: ShotStats, rng: Random): ShotResult
	local accuracy = ShotConfig.Accuracy
	local keeper = ShotConfig.Goalkeeper

	-- 1. Inaccuracy: better shooters scatter less; overpowered shots scatter more and rise.
	local skill = math.clamp(stats.shooting, 0, 100) / 100
	local overpower = math.max(0, (input.power - accuracy.OverpowerFrom) / (1 - accuracy.OverpowerFrom))
	local sigma = lerp(accuracy.ScatterAtZeroSkill, accuracy.ScatterAtMaxSkill, skill)
		+ overpower * accuracy.OverpowerScatter
	local cap = accuracy.MaxSigmas
	local offsetX = math.clamp(gaussian(rng), -cap, cap) * sigma
	local offsetY = math.clamp(gaussian(rng), -cap, cap) * sigma + overpower * accuracy.OverpowerLift

	local intended = ShotPhysics.aimToGoalPoint(input.aimX, input.aimY)
	local target = Vector3.new(
		intended.X + offsetX,
		math.max(ShotConfig.Ball.Radius, intended.Y + offsetY), -- low shots roll along the ground
		0
	)
	local start = ShotPhysics.ballSpot()
	local flightTime = ShotPhysics.flightTime(start, target, input.power)
	local zone = ShotPhysics.classify(target)

	-- 2. Goalkeeper: reacts after a short delay, then moves towards the ball at a skill-based
	-- speed. It is a save if his hands reach the crossing point before the ball does.
	local home = Vector3.new(keeper.HomeX, keeper.HomeY, 0)
	local toBall = Vector3.new(target.X, target.Y, 0) - home
	local reaction = keeper.ReactionTime + (rng:NextNumber() * 2 - 1) * keeper.ReactionJitter
	local diveSpeed = lerp(keeper.DiveSpeedAtZeroSkill, keeper.DiveSpeedAtMaxSkill, math.clamp(stats.keeperSkill, 0, 100) / 100)
	local canTravel = diveSpeed * math.max(0, flightTime - reaction)
	local mustTravel = math.max(0, toBall.Magnitude - keeper.Reach)

	local keeperTarget = home
	if keeper.Enabled and toBall.Magnitude > 1e-3 then
		keeperTarget = home + toBall.Unit * math.min(canTravel, mustTravel)
	end

	local outcome
	if zone == ShotPhysics.Zone.Frame then
		outcome = "POST"
	elseif zone == ShotPhysics.Zone.Wide then
		outcome = "MISS"
	elseif keeper.Enabled and canTravel >= mustTravel then
		outcome = "SAVE"
	else
		outcome = "GOAL"
	end

	return {
		outcome = outcome,
		start = start,
		intended = intended,
		target = target,
		flightTime = flightTime,
		keeperTarget = keeperTarget,
		keeperReaction = reaction,
	}
end

return ShotResolver
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="11">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">ShotClient</string>
          <string name="Source"><![CDATA[-- Client entry point for the Stage 1 shot: wires input, 3D visuals and HUD to the server remotes.
-- The client sends only aim and power; the server decides the outcome.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ShotConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShotConfig"))
local InputController = require(script:WaitForChild("InputController"))
local ShotVisuals = require(script:WaitForChild("ShotVisuals"))
local ShotHud = require(script:WaitForChild("ShotHud"))

local CARD_DELAY = 0.55 -- let the player see the ball hit the net before the card covers the goal

local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
if not Remotes then
	warn("[ShotClient] Still waiting for ReplicatedStorage.Remotes. The server script (Main) has not started; check Output for red [Main] errors.")
	Remotes = ReplicatedStorage:WaitForChild("Remotes")
end
local RequestEpisode = Remotes:WaitForChild("RequestEpisode")
local EpisodeStarted = Remotes:WaitForChild("EpisodeStarted")
local SubmitEpisodeInput = Remotes:WaitForChild("SubmitEpisodeInput")
local EpisodeResult = Remotes:WaitForChild("EpisodeResult")

-- Default movement controls are useless here and would cover the screen on phones.
task.spawn(function()
	local playerModule = Players.LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)
	if playerModule then
		local ok, err = pcall(function()
			require(playerModule):GetControls():Disable()
		end)
		if not ok then
			warn("[ShotClient] Could not disable default controls:", err)
		end
	end
end)

local hud = ShotHud.new()
local visuals = ShotVisuals.new()
local input = InputController.new()
local currentEpisode = nil
local waitingForEpisode = false

local function requestEpisode()
	waitingForEpisode = true
	RequestEpisode:FireServer()
end

-- Splits the server outcome into what the card should say (post vs crossbar, wide vs over).
local function cardKind(result): string
	local goal = ShotConfig.Goal
	if result.outcome == "POST" then
		return if result.target.Y > goal.Height - ShotConfig.Ball.Radius then "BAR" else "POST"
	elseif result.outcome == "MISS" then
		return if result.target.Y > goal.Height + goal.PostRadius then "OVER" else "WIDE"
	end
	return result.outcome
end

hud.onContinue = function()
	if waitingForEpisode then
		return
	end
	hud:hideCard()
	requestEpisode()
end

input.onShoot = function(aimX, aimY, power)
	local episode = currentEpisode
	if not episode then
		return
	end
	input:setEnabled(false)
	visuals:onShotReleased()
	hud:setTitle("Flying")
	SubmitEpisodeInput:FireServer(episode.episodeId, aimX, aimY, power)
end

EpisodeStarted.OnClientEvent:Connect(function(episode)
	if typeof(episode) ~= "table" or episode.kind ~= "SHOT" then
		return
	end
	waitingForEpisode = false
	currentEpisode = episode
	input:setEnabled(false)
	visuals:reset()
	hud:hideCard()
	hud:setTitle("Ready")
	hud:setPower(0)
	hud:setSeries(episode.goals, episode.seriesLength, episode.history)
	task.delay(ShotConfig.Input.ReadyDelay, function()
		if currentEpisode == episode then
			input:setEnabled(true)
		end
	end)
end)

EpisodeResult.OnClientEvent:Connect(function(result)
	if result.rejected then
		warn("[ShotClient] Server rejected the shot:", result.reason)
		currentEpisode = nil
		input:setEnabled(false)
		task.delay(0.5, requestEpisode) -- the server resends the open episode or starts a new one
		return
	end
	if not currentEpisode or result.episodeId ~= currentEpisode.episodeId then
		return
	end
	currentEpisode = nil

	visuals:playShot(result, function()
		hud:setSeries(result.goals, result.seriesLength, result.history)
		if result.outcome == "GOAL" then
			hud:bumpGoals()
		end
		hud:setTitle("AfterShot")
		task.delay(CARD_DELAY, function()
			if not currentEpisode and not waitingForEpisode then
				local seriesText = if result.seriesOver then hud:seriesText(result.goals, result.seriesLength) else nil
				hud:showResult(cardKind(result), seriesText)
			end
		end)
	end)
end)

-- Space / Enter / gamepad A press the card button.
UserInputService.InputBegan:Connect(function(inputObject, gameProcessed)
	if gameProcessed or not hud:isCardVisible() then
		return
	end
	local key = inputObject.KeyCode
	if key == Enum.KeyCode.Space or key == Enum.KeyCode.Return or key == Enum.KeyCode.ButtonA then
		hud:pressContinue()
	end
end)

RunService.RenderStepped:Connect(function(dt)
	visuals:update(dt)
	input:update()
	if input.enabled then
		visuals:updateAiming(true, input.aimX, input.aimY, input.power, input.holding)
		hud:setPower(input.power)
		hud:setTitle(if input.holding then "Holding" else "Ready")
	end
end)

requestEpisode()
print("[ShotClient] ready")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[-- Turns mouse or touch into a normalized aim (X -1..1, Y 0..1) and power (0..1).
-- Press on the goal to aim, hold to charge the power meter, release to shoot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local ShotPhysics = require(Shared:WaitForChild("ShotPhysics"))

local InputController = {}
InputController.__index = InputController

function InputController.new()
	local self = setmetatable({
		enabled = false,
		holding = false,
		aimX = 0,
		aimY = 0.5,
		power = 0,
		onShoot = nil :: ((aimX: number, aimY: number, power: number) -> ())?,
		_activeInput = nil :: InputObject?,
		_holdStartedAt = 0,
	}, InputController)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		self:_onBegan(input, gameProcessed)
	end)
	UserInputService.InputChanged:Connect(function(input)
		self:_onChanged(input)
	end)
	UserInputService.InputEnded:Connect(function(input)
		self:_onEnded(input)
	end)
	return self
end

function InputController:setEnabled(enabled: boolean)
	self.enabled = enabled
	if not enabled then
		self.holding = false
		self._activeInput = nil
		self.power = 0
	end
end

-- Call every frame: advances the power meter while held.
function InputController:update()
	if not self.holding then
		return
	end
	local phase = ((os.clock() - self._holdStartedAt) / ShotConfig.Input.PowerCycleSeconds) % 1
	self.power = 1 - math.abs(1 - 2 * phase) -- 0 -> 1 -> 0
end

-- Projects a screen point onto the goal plane (Z = 0).
function InputController:_aimAt(position: Vector3)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local ray = camera:ScreenPointToRay(position.X, position.Y)
	if ray.Direction.Z > -1e-4 then
		return
	end
	local point = ray.Origin + ray.Direction * (-ray.Origin.Z / ray.Direction.Z)
	self.aimX, self.aimY = ShotPhysics.goalPointToAim(point)
end

function InputController:_onBegan(input: InputObject, gameProcessed: boolean)
	if gameProcessed or not self.enabled or self.holding then
		return
	end
	local inputType = input.UserInputType
	if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
		self.holding = true
		self._activeInput = input
		self._holdStartedAt = os.clock()
		self.power = 0
		self:_aimAt(input.Position)
	end
end

function InputController:_onChanged(input: InputObject)
	if not self.enabled then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		self:_aimAt(input.Position) -- PC: the marker follows the mouse even before clicking
	elseif input.UserInputType == Enum.UserInputType.Touch and input == self._activeInput then
		self:_aimAt(input.Position)
	end
end

function InputController:_onEnded(input: InputObject)
	if not self.holding then
		return
	end
	local active = self._activeInput
	local isMouseRelease = input.UserInputType == Enum.UserInputType.MouseButton1
		and active ~= nil
		and active.UserInputType == Enum.UserInputType.MouseButton1
	if not (isMouseRelease or input == active) then
		return
	end

	self.holding = false
	self._activeInput = nil
	if self.enabled and self.onShoot then
		self.onShoot(self.aimX, self.aimY, self.power)
	end
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">ShotHud</string>
            <string name="Source"><![CDATA[-- Screen UI for the shot drill: logo + stage, goals counter, bottom power panel and the
-- result card. Layout is designed at 1280x720 and scaled per panel to the screen.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local ShotHud = {}
ShotHud.__index = ShotHud

-- All player-facing text in one place.
local TEXT = {
	LogoTop = "NEW",
	LogoBottom = 'FOOTBALL  <font color="#A3E635">STAR</font> <font color="#A3E635" size="22">★</font>',
	Mode = 'ОБУЧЕНИЕ  •  <font color="#A3E635">УДАРЫ</font>',
	Stage = "Этап 1 из 3",
	Goals = "ГОЛЫ",
	Power = 'СИЛА <font color="#A3E635">%d%%</font>',
	PowerHint = "55–85% — удобно   ·   100% — мяч летит выше",
	Ready = "Зажми точку у ворот и отпусти для удара",
	Holding = "Отпусти, чтобы ударить",
	Flying = "Удар!",
	AfterShot = "Выбери точку удара и попробуй ещё",
	NextShot = "ЕЩЁ УДАР  ›",
	NewSeries = "НОВАЯ СЕРИЯ  ›",
	SeriesOver = "Серия окончена: %d из %d голов",
	Outcomes = {
		GOAL = { "ГОЛ!", "Отличное попадание в створ" },
		SAVE = { "СЕЙВ!", "Вратарь успел. Целься ближе к углу" },
		POST = { "ШТАНГА!", "Совсем рядом. Чуть ближе к центру" },
		BAR = { "ПЕРЕКЛАДИНА!", "Совсем рядом. Чуть ниже" },
		WIDE = { "МИМО!", "Мяч прошёл мимо ворот" },
		OVER = { "ВЫШЕ ВОРОТ!", "Слишком сильно. Сбавь силу" },
	},
}

local LIME = Color3.fromRGB(163, 230, 53)
local LIME_DARK = Color3.fromRGB(104, 160, 24)
local WHITE = Color3.new(1, 1, 1)
local MUTED = Color3.fromRGB(184, 198, 192)
local INK = Color3.fromRGB(8, 20, 16)
local PANEL_LEFT = Color3.fromRGB(24, 52, 45)
local PANEL_RIGHT = Color3.fromRGB(7, 18, 15)
local YELLOW = Color3.fromRGB(250, 204, 21)
local RED = Color3.fromRGB(248, 90, 90)

local OUTCOME_COLORS = {
	GOAL = LIME,
	SAVE = WHITE,
	POST = YELLOW,
	BAR = YELLOW,
	WIDE = RED,
	OVER = RED,
}
local PIP_COLORS = { GOAL = LIME, SAVE = WHITE, POST = YELLOW, MISS = RED }

local MONTSERRAT = "rbxasset://fonts/families/Montserrat.json"
local FONT_HEAVY = Font.new(MONTSERRAT, Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
local FONT_BOLD = Font.new(MONTSERRAT, Enum.FontWeight.Bold, Enum.FontStyle.Italic)
local FONT_MEDIUM = Font.new(MONTSERRAT, Enum.FontWeight.Medium)

local DESIGN_SIZE = Vector2.new(1280, 720)

local function create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function frame(props: { [string]: any }): Frame
	props.BorderSizePixel = 0
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 0
	end
	return create("Frame", props)
end

local function text(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = 1
	props.RichText = true
	props.FontFace = props.FontFace or FONT_HEAVY
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return create("TextLabel", props)
end

local function corner(parent: Instance, radius: number?)
	create("UICorner", { CornerRadius = if radius then UDim.new(0, radius) else UDim.new(1, 0), Parent = parent })
end

local function circle(parent: Instance, size: number, props: { [string]: any }?): Frame
	local p = { Size = UDim2.fromOffset(size, size), Parent = parent }
	for key, value in props or {} do
		p[key] = value
	end
	local f = frame(p)
	corner(f)
	return f
end

local function stroke(parent: Instance, color: Color3, thickness: number, transparency: number?)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

-- Lime border with a soft outer glow made of stacked, increasingly transparent strokes.
local function glow(target: GuiObject, radius: number, strength: number?)
	local s = strength or 1
	stroke(target, LIME, 2)
	for _, layer in { { 5, 0.72 }, { 10, 0.86 }, { 16, 0.93 } } do
		local halo = frame({ Name = "Glow", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, Parent = target })
		corner(halo, radius)
		stroke(halo, LIME, layer[1], 1 - (1 - layer[2]) * s)
	end
end

-- Dark panel with a left-to-right gradient, rounded corners and a lime glow.
local function panel(props: { [string]: any }, radius: number): Frame
	props.BackgroundTransparency = 1
	local root = frame(props)
	local bg = frame({ Name = "Background", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, ZIndex = 0, Parent = root })
	corner(bg, radius)
	create("UIGradient", { Color = ColorSequence.new(PANEL_LEFT, PANEL_RIGHT), Parent = bg })
	glow(root, radius)
	return root
end

-- Decorative "////" slashes, as in the reference panels.
local function slashes(parent: Instance, position: UDim2, size: number)
	text({
		Name = "Slashes",
		Position = position,
		Size = UDim2.fromOffset(size * 2.2, size),
		TextSize = size,
		Text = "////",
		TextColor3 = LIME,
		TextTransparency = 0.82,
		Parent = parent,
	})
end

local function trophyIcon(parent: Instance, position: UDim2): Frame
	local icon = frame({ Name = "Trophy", Position = position, Size = UDim2.fromOffset(32, 30), BackgroundTransparency = 1, Parent = parent })
	for _, x in { 2, 22 } do
		local handle = circle(icon, 9, { Position = UDim2.fromOffset(x, 4), BackgroundTransparency = 1 })
		stroke(handle, LIME, 2.5)
	end
	local cup = frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 1), Size = UDim2.fromOffset(18, 15), BackgroundColor3 = LIME, Parent = icon })
	corner(cup, 6)
	frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 15), Size = UDim2.fromOffset(4, 7), BackgroundColor3 = LIME, Parent = icon })
	local base = frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 22), Size = UDim2.fromOffset(16, 5), BackgroundColor3 = LIME, Parent = icon })
	corner(base, 2)
	return icon
end

local function crosshairIcon(parent: Instance, center: UDim2)
	local ring = circle(parent, 30, { AnchorPoint = Vector2.new(0.5, 0.5), Position = center, BackgroundTransparency = 1 })
	stroke(ring, LIME, 2.5)
	circle(ring, 6, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = LIME })
	for _, tick in { { 0.5, 0, 2.5, 9 }, { 0.5, 1, 2.5, 9 }, { 0, 0.5, 9, 2.5 }, { 1, 0.5, 9, 2.5 } } do
		frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(tick[1], tick[2]),
			Size = UDim2.fromOffset(tick[3], tick[4]),
			BackgroundColor3 = LIME,
			Parent = ring,
		})
	end
end

-- Football with a small laurel wreath, sitting on the top edge of the result card.
local function ballBadge(parent: Instance)
	local badge = frame({ Name = "Badge", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(110, 56), BackgroundTransparency = 1, ZIndex = 3, Parent = parent })
	for _, side in { -1, 1 } do
		for k, angle in { -25, 10, 45 } do
			local rad = math.rad(angle)
			local leaf = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, side * math.cos(rad) * 34, 0.5, -math.sin(rad) * 30 + 2),
				Size = UDim2.fromOffset(7, 15 - k),
				Rotation = side * (angle + 20),
				BackgroundColor3 = LIME,
				ZIndex = 3,
				Parent = badge,
			})
			corner(leaf)
		end
	end
	local ball = circle(badge, 46, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = INK, ZIndex = 4 })
	stroke(ball, LIME, 2)
	text({ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Text = "⚽", TextSize = 28, FontFace = FONT_MEDIUM, ZIndex = 5, Parent = ball })
end

function ShotHud.new()
	local self = setmetatable({}, ShotHud)
	self.scales = {}
	self.cardToken = 0

	local gui = create("ScreenGui", {
		Name = "ShotHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	self.gui = gui

	self:_buildLogo()
	self:_buildGoals()
	self:_buildPowerPanel()
	self:_buildCard()

	local function rescale()
		local viewport = workspace.CurrentCamera.ViewportSize
		local scale = math.clamp(math.min(viewport.X / DESIGN_SIZE.X, viewport.Y / DESIGN_SIZE.Y), 0.5, 1.3)
		for _, uiScale in self.scales do
			uiScale.Scale = scale
		end
		self.baseScale = scale
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	return self
end

function ShotHud:_scaled(target: GuiObject): UIScale
	local uiScale = create("UIScale", { Parent = target })
	table.insert(self.scales, uiScale)
	return uiScale
end

function ShotHud:_buildLogo()
	local logo = frame({ Name = "Logo", Position = UDim2.fromOffset(18, 6), Size = UDim2.fromOffset(330, 120), BackgroundTransparency = 1, Parent = self.gui })
	self:_scaled(logo)
	local bar = frame({ Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(13, 52), Rotation = 12, BackgroundColor3 = LIME, Parent = logo })
	corner(bar, 3)
	text({ Position = UDim2.fromOffset(30, 0), Size = UDim2.fromOffset(300, 30), TextSize = 30, Text = TEXT.LogoTop, Parent = logo })
	text({ Position = UDim2.fromOffset(30, 28), Size = UDim2.fromOffset(300, 32), TextSize = 30, Text = TEXT.LogoBottom, Parent = logo })
	frame({ Position = UDim2.fromOffset(30, 70), Size = UDim2.fromOffset(2, 42), BackgroundColor3 = LIME, Parent = logo })
	text({ Position = UDim2.fromOffset(42, 68), Size = UDim2.fromOffset(280, 20), TextSize = 16, FontFace = FONT_BOLD, Text = TEXT.Mode, Parent = logo })
	text({ Position = UDim2.fromOffset(42, 92), Size = UDim2.fromOffset(120, 18), TextSize = 14, FontFace = FONT_MEDIUM, TextColor3 = MUTED, Text = TEXT.Stage, Parent = logo })
	for i = 1, 3 do
		local dot = circle(logo, 9, { Position = UDim2.fromOffset(150 + (i - 1) * 16, 96), BackgroundColor3 = LIME, BackgroundTransparency = if i == 1 then 0 else 1 })
		if i > 1 then
			stroke(dot, MUTED, 1.5, 0.4)
		end
	end
end

function ShotHud:_buildGoals()
	local holder = frame({
		Name = "GoalsHolder",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -22, 0, 14),
		Size = UDim2.fromOffset(250, 90),
		BackgroundTransparency = 1,
		Parent = self.gui,
	})
	self.goalsScale = self:_scaled(holder)
	local box = panel({ Name = "Goals", Size = UDim2.fromOffset(250, 58), Parent = holder }, 16)
	trophyIcon(box, UDim2.fromOffset(20, 14))
	text({ Position = UDim2.fromOffset(70, 0), Size = UDim2.fromOffset(80, 58), TextSize = 20, FontFace = FONT_BOLD, Text = TEXT.Goals, Parent = box })
	self.goalsText = text({ Position = UDim2.fromOffset(140, 0), Size = UDim2.fromOffset(90, 58), TextSize = 24, TextXAlignment = Enum.TextXAlignment.Right, Text = "", Parent = box })

	-- One dot per shot of the series.
	local pips = frame({ Name = "Pips", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 70), Size = UDim2.fromOffset(234, 12), BackgroundTransparency = 1, Parent = holder })
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 7),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = pips,
	})
	self.pips = pips
	self.pipFrames = {}
end

function ShotHud:_buildPowerPanel()
	local root = panel({
		Name = "PowerPanel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(760, 140),
		Parent = self.gui,
	}, 20)
	self:_scaled(root)

	local iconBox = frame({ Position = UDim2.fromOffset(28, 38), Size = UDim2.fromOffset(64, 64), BackgroundColor3 = Color3.fromRGB(22, 44, 38), Parent = root })
	corner(iconBox, 12)
	stroke(iconBox, WHITE, 1.5, 0.82)
	crosshairIcon(iconBox, UDim2.fromScale(0.5, 0.5))

	self.title = text({ Position = UDim2.fromOffset(116, 14), Size = UDim2.fromOffset(600, 32), TextSize = 25, Text = TEXT.Ready, Parent = root })

	local pill = frame({ Position = UDim2.fromOffset(116, 56), Size = UDim2.fromOffset(150, 36), BackgroundColor3 = INK, Parent = root })
	corner(pill, 10)
	stroke(pill, LIME, 2)
	create("UIPadding", { PaddingLeft = UDim.new(0, 14), Parent = pill })
	self.powerText = text({ Size = UDim2.fromScale(1, 1), TextSize = 21, Text = string.format(TEXT.Power, 0), Parent = pill })

	local bar = frame({ Position = UDim2.fromOffset(282, 62), Size = UDim2.fromOffset(450, 24), BackgroundColor3 = Color3.fromRGB(38, 52, 49), Parent = root })
	corner(bar, 12)
	stroke(bar, Color3.fromRGB(200, 212, 206), 1.5, 0.35)
	-- Overpower zone marker (85%+): ball rises and is less accurate.
	frame({ Position = UDim2.new(0.85, 0, 0, 3), Size = UDim2.new(0, 2, 1, -6), BackgroundColor3 = WHITE, BackgroundTransparency = 0.6, Parent = bar })
	-- CanvasGroup clips the stripes to the rounded fill.
	local fill = create("CanvasGroup", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = LIME, BorderSizePixel = 0, Parent = bar })
	corner(fill, 12)
	text({ Position = UDim2.fromOffset(-6, -4), Size = UDim2.fromOffset(470, 32), TextSize = 30, Text = string.rep("/", 48), TextColor3 = LIME_DARK, TextTransparency = 0.35, Parent = fill })
	self.powerFill = fill

	local info = circle(root, 16, { Position = UDim2.fromOffset(116, 105), BackgroundTransparency = 1 })
	stroke(info, MUTED, 1.2, 0.2)
	text({ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, FontFace = FONT_BOLD, TextColor3 = MUTED, Text = "i", Parent = info })
	text({ Position = UDim2.fromOffset(142, 102), Size = UDim2.fromOffset(500, 22), TextSize = 15, FontFace = FONT_MEDIUM, TextColor3 = MUTED, Text = TEXT.PowerHint, Parent = root })

	slashes(root, UDim2.fromOffset(640, 4), 30)
	slashes(root, UDim2.fromOffset(640, 104), 30)
end

function ShotHud:_buildCard()
	local card = panel({
		Name = "ResultCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(380, 186),
		Visible = false,
		Parent = self.gui,
	}, 20)
	self.cardScale = self:_scaled(card)
	ballBadge(card)
	slashes(card, UDim2.fromOffset(12, 8), 26)
	slashes(card, UDim2.fromOffset(306, 150), 26)

	self.cardTitle = text({ Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 60), TextSize = 54, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	self.cardSubtitle = text({ Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 22), TextSize = 17, FontFace = FONT_MEDIUM, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })

	local button = create("TextButton", {
		Name = "Continue",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.fromOffset(272, 50),
		BackgroundColor3 = LIME,
		AutoButtonColor = true,
		BorderSizePixel = 0,
		FontFace = FONT_HEAVY,
		TextSize = 24,
		TextColor3 = INK,
		Text = TEXT.NextShot,
		Parent = card,
	})
	corner(button, 12)
	glow(button, 12, 0.8)
	self.button = button
	self.card = card
	self.onContinue = nil :: (() -> ())?
	button.Activated:Connect(function()
		self:_continue()
	end)
end

function ShotHud:_continue()
	if self.card.Visible and self.onContinue then
		self.onContinue()
	end
end

-- Called by keyboard / gamepad shortcuts.
function ShotHud:pressContinue()
	self:_continue()
end

function ShotHud:isCardVisible(): boolean
	return self.card.Visible
end

function ShotHud:setTitle(kind: string)
	self.title.Text = TEXT[kind] or kind
end

function ShotHud:setPower(power: number)
	local p = math.clamp(power, 0, 1)
	self.powerText.Text = string.format(TEXT.Power, math.floor(p * 100 + 0.5))
	self.powerFill.Size = UDim2.fromScale(p, 1)
	self.powerFill.BackgroundColor3 = if p >= 0.85 then Color3.fromRGB(250, 170, 40) else LIME
end

function ShotHud:setSeries(goals: number, seriesLength: number, history: { string })
	self.goalsText.Text = string.format('<font color="#A3E635">%d</font> / %d', goals, seriesLength)
	for i = #self.pipFrames + 1, seriesLength do
		local pip = circle(self.pips, 13, { LayoutOrder = i, BackgroundTransparency = 1 })
		create("UIStroke", { Color = MUTED, Thickness = 1.5, Transparency = 0.45, Parent = pip })
		self.pipFrames[i] = pip
	end
	for i, pip in self.pipFrames do
		local outcome = history[i]
		pip.Visible = i <= seriesLength
		pip.BackgroundColor3 = if outcome then PIP_COLORS[outcome] or MUTED else MUTED
		pip.BackgroundTransparency = if outcome then 0 else 1
	end
end

function ShotHud:bumpGoals()
	self.goalsScale.Scale = self.baseScale * 1.15
	TweenService:Create(self.goalsScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = self.baseScale }):Play()
end

-- kind: GOAL | SAVE | POST | BAR | WIDE | OVER
function ShotHud:showResult(kind: string, seriesText: string?)
	local info = TEXT.Outcomes[kind] or { kind, "" }
	self.cardTitle.Text = info[1]
	self.cardTitle.TextColor3 = OUTCOME_COLORS[kind] or WHITE
	self.cardSubtitle.Text = seriesText or info[2]
	self.button.Text = if seriesText then TEXT.NewSeries else TEXT.NextShot
	self.card.Visible = true
	self.cardScale.Scale = self.baseScale * 0.6
	TweenService:Create(self.cardScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = self.baseScale }):Play()
end

function ShotHud:seriesText(goals: number, seriesLength: number): string
	return string.format(TEXT.SeriesOver, goals, seriesLength)
end

function ShotHud:hideCard()
	self.card.Visible = false
end

return ShotHud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">ShotVisuals</string>
            <string name="Source"><![CDATA[-- Client-only 3D visuals: camera, ball, goalkeeper animation, aim crosshair, trajectory
-- preview and goal effects. Everything here is local to this player and has no effect on the outcome.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShotConfig = require(Shared:WaitForChild("ShotConfig"))
local ShotPhysics = require(Shared:WaitForChild("ShotPhysics"))

local Keeper = ShotConfig.Goalkeeper
local BALL_RADIUS = ShotConfig.Ball.Radius
local PREVIEW_DOTS = 14
local FOLLOW_THROUGH_SECONDS = 1.6
local KEEPER_MIN_Y = 1.2
local KEEPER_MAX_TILT = math.rad(95)
local ARMS_READY = math.rad(38)
local ARMS_DIVE = math.rad(165)
local BALL_SPIN_RATE = 14 -- radians per second in flight

local WHITE = Color3.new(1, 1, 1)
local LIME = Color3.fromRGB(163, 230, 53)
local YELLOW = Color3.fromRGB(250, 204, 21)

local ShotVisuals = {}
ShotVisuals.__index = ShotVisuals

local function create(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function makePart(props: { [string]: any }): Part
	props.Anchored = true
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	props.Material = props.Material or Enum.Material.SmoothPlastic
	return create("Part", props)
end

local function icosahedronDirections(): { Vector3 }
	local phi = (1 + math.sqrt(5)) / 2
	local dirs = {}
	for _, a in { -1, 1 } do
		for _, b in { -phi, phi } do
			table.insert(dirs, Vector3.new(0, a, b).Unit)
			table.insert(dirs, Vector3.new(a, b, 0).Unit)
			table.insert(dirs, Vector3.new(b, 0, a).Unit)
		end
	end
	return dirs
end

function ShotVisuals.new()
	local self = setmetatable({}, ShotVisuals)
	self.token = 0
	self.clock = 0
	self.shake = 0
	self.fovKick = 0
	self.idle = true

	local folder = create("Folder", { Name = "ShotVisuals", Parent = workspace })

	-- Ball: white sphere with 12 flat dark panels.
	local ballModel = create("Model", { Name = "Ball", Parent = folder })
	self.ballParts = {
		{ makePart({ Name = "Shell", Shape = Enum.PartType.Ball, Size = Vector3.one * BALL_RADIUS * 2, Color = WHITE, Parent = ballModel }), CFrame.identity },
	}
	for _, dir in icosahedronDirections() do
		local reference = if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis
		local up = dir:Cross(reference).Unit
		local patch = makePart({
			Name = "Panel",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, BALL_RADIUS * 0.66, BALL_RADIUS * 0.66),
			Color = Color3.fromRGB(22, 22, 26),
			CastShadow = false,
			Parent = ballModel,
		})
		table.insert(self.ballParts, { patch, CFrame.fromMatrix(dir * BALL_RADIUS * 0.985, dir, up) })
	end

	-- Crosshair on the goal plane, the size of the ball, drawn on top of everything.
	local aimPart = makePart({ Name = "Crosshair", Size = Vector3.new(3, 3, 0.05), Transparency = 1, CastShadow = false, Parent = folder })
	local aimGui = create("SurfaceGui", {
		Face = Enum.NormalId.Back,
		AlwaysOnTop = true,
		LightInfluence = 0,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 60,
		Enabled = false,
		Parent = aimPart,
	})
	local ring = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(2 * BALL_RADIUS / 3, 2 * BALL_RADIUS / 3),
		BackgroundColor3 = LIME,
		BackgroundTransparency = 0.82,
		Parent = aimGui,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ring })
	create("UIStroke", { Color = LIME, Thickness = 6, Parent = ring })
	local dot = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = WHITE, Parent = aimGui })
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
	for _, tick in { { 0.5, 0.06, 6, 22 }, { 0.5, 0.94, 6, 22 }, { 0.06, 0.5, 22, 6 }, { 0.94, 0.5, 22, 6 } } do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(tick[1], tick[2]),
			Size = UDim2.fromOffset(tick[3], tick[4]),
			BackgroundColor3 = LIME,
			BorderSizePixel = 0,
			Parent = aimGui,
		})
	end
	self.aimPart, self.aimGui = aimPart, aimGui

	self.dots = {}
	for i = 1, PREVIEW_DOTS do
		self.dots[i] = makePart({
			Name = "PreviewDot",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (0.42 - 0.22 * i / PREVIEW_DOTS),
			Color = LIME,
			Material = Enum.Material.Neon,
			CastShadow = false,
			Transparency = 1,
			Parent = folder,
		})
	end

	local emitterPart = makePart({
		Name = "Confetti",
		Size = Vector3.one,
		Transparency = 1,
		CFrame = CFrame.new(0, ShotConfig.Goal.Height + 1, -ShotConfig.Goal.NetDepth / 2),
		Parent = folder,
	})
	self.confetti = create("ParticleEmitter", {
		Enabled = false,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, LIME),
			ColorSequenceKeypoint.new(0.5, WHITE),
			ColorSequenceKeypoint.new(1, YELLOW),
		}),
		Size = NumberSequence.new(0.5, 0.15),
		Speed = NumberRange.new(25, 45),
		SpreadAngle = Vector2.new(70, 70),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -40, 0),
		Drag = 1.5,
		Lifetime = NumberRange.new(1.5, 2.5),
		RotSpeed = NumberRange.new(-200, 200),
		LightEmission = 0.6,
		Parent = emitterPart,
	})

	self:_findScene()
	self:reset()
	return self
end

function ShotVisuals:_findScene()
	local scene = workspace:WaitForChild("FootballScene", 15)
	if not scene then
		warn("[ShotVisuals] workspace.FootballScene not found; is the server Main script running?")
		return
	end

	local net = scene:FindFirstChild("NetBack", true)
	if net then
		self.netBack, self.netBackHome = net, net.CFrame
	end

	local keeper = Keeper.Enabled and scene:WaitForChild("Goalkeeper", 10)
	if keeper then
		self.keeper = keeper
		self.keeperHome = keeper:GetPivot()
		self.keeperRotation = self.keeperHome.Rotation
		self.shoulders = {}
		for _, info in { { "LeftShoulder", -1 }, { "RightShoulder", 1 } } do
			local motor = keeper:FindFirstChild(info[1], true)
			if motor and motor:IsA("Motor6D") then
				table.insert(self.shoulders, { motor, motor.C0, info[2] })
			end
		end
	end
end

function ShotVisuals:_setBall(position: Vector3, spin: number)
	local base = CFrame.new(position) * CFrame.Angles(-spin, 0, 0)
	for _, entry in self.ballParts do
		entry[1].CFrame = base * entry[2]
	end
end

-- offset: body movement from the home position; tilt: lean around the view axis; arms: shoulder angle.
function ShotVisuals:_poseKeeper(offset: Vector3, tilt: number, arms: number)
	if not self.keeper then
		return
	end
	local position = self.keeperHome.Position + offset
	self.keeper:PivotTo(CFrame.new(position) * CFrame.Angles(0, 0, tilt) * self.keeperRotation)
	for _, shoulder in self.shoulders do
		shoulder[1].C0 = shoulder[2] * CFrame.Angles(0, 0, shoulder[3] * arms)
	end
end

function ShotVisuals:_diveKeeper(target: Vector3, alpha: number)
	local eased = 1 - (1 - alpha) ^ 2
	local offset = Vector3.new(target.X - Keeper.HomeX, math.max(target.Y, KEEPER_MIN_Y) - Keeper.HomeY, 0)
	local tilt = math.clamp(math.atan2(-offset.X, offset.Y + Keeper.HomeY), -KEEPER_MAX_TILT, KEEPER_MAX_TILT)
	local lean = math.clamp(offset.Magnitude / 4, 0, 1)
	self:_poseKeeper(offset * eased, tilt * lean * eased, ARMS_READY + (ARMS_DIVE - ARMS_READY) * math.min(1, alpha * 2))
end

function ShotVisuals:reset()
	self.token += 1
	self.idle = true
	self:_setBall(ShotPhysics.ballSpot(), 0)
	self:_poseKeeper(Vector3.zero, 0, ARMS_READY)
	if self.netBack then
		self.netBack.CFrame = self.netBackHome
	end
	self:updateAiming(false, 0, 0.5, 0, false)
end

-- Per-frame: camera (with shake and kick) and the keeper's ready stance.
function ShotVisuals:update(dt: number)
	self.clock += dt
	self.shake = math.max(0, self.shake - dt * 2.5)
	self.fovKick = math.max(0, self.fovKick - dt * 10)

	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = ShotConfig.Camera.FieldOfView - self.fovKick
	local base = CFrame.lookAt(ShotConfig.Camera.Position, ShotConfig.Camera.LookAt)
	if self.shake > 0 then
		local t = self.clock * 25
		local amount = self.shake * 0.3
		base *= CFrame.new(math.noise(t, 1) * amount, math.noise(t, 2) * amount, 0)
	end
	camera.CFrame = base

	if self.idle then
		local t = self.clock
		local sway = Vector3.new(math.sin(t * 2.1) * 0.45, math.abs(math.sin(t * 4.2)) * 0.1, 0)
		self:_poseKeeper(sway, 0, ARMS_READY + math.sin(t * 4.2) * 0.06)
	end
end

-- Shows the crosshair, and while holding, the predicted (no-error) arc.
function ShotVisuals:updateAiming(enabled: boolean, aimX: number, aimY: number, power: number, holding: boolean)
	local point = ShotPhysics.aimToGoalPoint(aimX, aimY)
	self.aimGui.Enabled = enabled
	self.aimPart.CFrame = CFrame.new(point + Vector3.new(0, 0, 0.25))

	local showArc = enabled and holding
	local start = ShotPhysics.ballSpot()
	local flightTime = ShotPhysics.flightTime(start, point, power)
	local velocity = ShotPhysics.launchVelocity(start, point, flightTime)
	for i, dot in self.dots do
		dot.Transparency = if showArc then 0.1 + 0.55 * i / PREVIEW_DOTS else 1
		if showArc then
			dot.CFrame = CFrame.new(ShotPhysics.positionAt(start, velocity, flightTime * i / (PREVIEW_DOTS + 1)))
		end
	end
end

function ShotVisuals:onShotReleased()
	self.fovKick = 1.8
	self:updateAiming(false, 0, 0.5, 0, false)
end

function ShotVisuals:_bulgeNet()
	local net = self.netBack
	if not net then
		return
	end
	net.CFrame = self.netBackHome * CFrame.new(0, 0, -0.9)
	TweenService:Create(net, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { CFrame = self.netBackHome }):Play()
end

-- Velocity right after the ball reaches the goal plane / keeper; purely cosmetic.
local function velocityAfterImpact(outcome: string, velocity: Vector3, target: Vector3): Vector3
	if outcome == "GOAL" then
		return velocity * 0.6
	elseif outcome == "SAVE" then
		local side = if target.X >= 0 then 1 else -1
		return Vector3.new(side * 7, 9, -velocity.Z * 0.25)
	elseif outcome == "POST" then
		if target.Y > ShotConfig.Goal.Height - BALL_RADIUS then
			return Vector3.new(velocity.X * 0.5, 10, -velocity.Z * 0.35) -- crossbar
		end
		return Vector3.new(-velocity.X * 0.4, velocity.Y * 0.3 + 3, -velocity.Z * 0.4)
	end
	return velocity
end

-- Plays the server-decided shot. Calls onImpact when the ball reaches the goal or keeper,
-- and yields until the follow-through ends or reset() is called.
function ShotVisuals:playShot(result, onImpact: () -> ())
	self.token += 1
	local token = self.token
	self.idle = false

	local start: Vector3 = result.start
	local target: Vector3 = result.target
	local flightTime: number = result.flightTime
	local velocity = ShotPhysics.launchVelocity(start, target, flightTime)

	-- The keeper stands in front of the line, so a save happens slightly before the goal plane.
	local endTime = flightTime
	if result.outcome == "SAVE" then
		endTime = flightTime * (1 - Keeper.HomeZ / (start.Z - target.Z))
	end
	local reaction: number = result.keeperReaction
	local diveDuration = math.max(endTime - reaction, 0.05)

	local t = 0
	while t < endTime do
		self:_setBall(ShotPhysics.positionAt(start, velocity, t), t * BALL_SPIN_RATE)
		self:_diveKeeper(result.keeperTarget, math.clamp((t - reaction) / diveDuration, 0, 1))
		t += RunService.RenderStepped:Wait()
		if self.token ~= token then
			return
		end
	end

	local position = ShotPhysics.positionAt(start, velocity, endTime)
	local spin = endTime * BALL_SPIN_RATE
	self:_setBall(position, spin)
	self:_diveKeeper(result.keeperTarget, 1)
	if result.outcome == "GOAL" then
		self.shake = 1
		self.confetti:Emit(150)
		self:_bulgeNet()
	else
		self.shake = 0.4
	end
	onImpact()

	-- Follow-through: gravity, ground bounces and the back of the net.
	local vel = velocityAfterImpact(result.outcome, ShotPhysics.velocityAt(velocity, endTime), target)
	local netBack = -ShotConfig.Goal.NetDepth + BALL_RADIUS
	local elapsed = 0
	while elapsed < FOLLOW_THROUGH_SECONDS do
		local dt = math.min(RunService.RenderStepped:Wait(), 1 / 20)
		if self.token ~= token then
			return
		end
		elapsed += dt
		vel += ShotPhysics.gravity() * dt
		position += vel * dt
		if position.Y < BALL_RADIUS then
			position = Vector3.new(position.X, BALL_RADIUS, position.Z)
			vel = Vector3.new(vel.X * 0.8, -vel.Y * 0.5, vel.Z * 0.8)
		end
		if result.outcome == "GOAL" and position.Z < netBack then
			position = Vector3.new(position.X, position.Y, netBack)
			vel = Vector3.new(vel.X * 0.3, vel.Y, 0)
		end
		spin += vel.Magnitude / BALL_RADIUS * dt * 0.5
		self:_setBall(position, spin)
	end
end

return ShotVisuals
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>